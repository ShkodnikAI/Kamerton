     {phase: "inhale", sec: 5.0, intensity: 0.3, cue: "ключ 1: вдох 5 секунд — руки вверх ладонями вверх"},
     {phase: "hold", sec: 5.0, intensity: 0.2, cue: "ключ 1: задержка 5 секунд — руки вверху"},
     {phase: "exhale", sec: 5.0, intensity: 0.2, cue: "ключ 1: выдох 5 секунд — руки вниз"},
     {phase: "inhale", sec: 5.0, intensity: 0.3, cue: "ключ 1: вдох 5 секунд — руки вверх ладонями вверх"},
     {phase: "hold", sec: 5.0, intensity: 0.2, cue: "ключ 1: задержка 5 секунд — руки вверху"},
     {phase: "exhale", sec: 5.0, intensity: 0.2, cue: "ключ 1: выдох 5 секунд — руки вниз"},
     {phase: "inhale", sec: 5.0, intensity: 0.3, cue: "ключ 1: вдох 5 секунд — руки вверх ладонями вверх"},
     {phase: "hold", sec: 5.0, intensity: 0.2, cue: "ключ 1: задержка 5 секунд — руки вверху"},
     {phase: "exhale", sec: 5.0, intensity: 0.2, cue: "ключ 1: выдох 5 секунд — руки вниз"},
     {phase: "inhale", sec: 5.0, intensity: 0.3, cue: "ключ 1: вдох 5 секунд — руки вверх ладонями вверх"},
     {phase: "hold", sec: 5.0, intensity: 0.2, cue: "ключ 1: задержка 5 секунд — руки вверху"},
     {phase: "exhale", sec: 5.0, intensity: 0.2, cue: "ключ 1: выдох 5 секунд — руки вниз"},
     {phase: "move", sec: 30.0, intensity: 0.4, cue: "ключ 2: равновесие — колено к животу, левая нога, дышать ровно"},
     {phase: "rest", sec: 5.0, intensity: 0.1, cue: "отдых 5 секунд — спокойно поменяй ногу"},
     {phase: "move", sec: 30.0, intensity: 0.4, cue: "ключ 2: равновесие — колено к животу, правая нога, дышать ровно"},
     {phase: "rest", sec: 5.0, intensity: 0.1, cue: "отдых 5 секунд — спокойно поменяй ногу"},
     {phase: "move", sec: 30.0, intensity: 0.4, cue: "ключ 2: равновесие — колено к животу, левая нога, дышать ровно"},
     {phase: "rest", sec: 5.0, intensity: 0.1, cue: "отдых 5 секунд — спокойно поменяй ногу"},
     {phase: "move", sec: 30.0, intensity: 0.4, cue: "ключ 2: равновесие — колено к животу, правая нога, дышать ровно"},
     {phase: "rest", sec: 5.0, intensity: 0.1, cue: "отдых 5 секунд — спокойно поменяй ногу"},
     {phase: "move", sec: 30.0, intensity: 0.4, cue: "ключ 2: равновесие — колено к животу, левая нога, дышать ровно"},
     {phase: "rest", sec: 5.0, intensity: 0.1, cue: "отдых 5 секунд — спокойно поменяй ногу"},
     {phase: "move", sec: 30.0, intensity: 0.4, cue: "ключ 2: равновесие — колено к животу, правая нога, дышать ровно"},
     {phase: "move", sec: 180.0, intensity: 0.3, cue: "ключ 3: простукивание 3 минуты — подушечки пальцев, ключицы от центра к плечам, по рукам вниз и вверх, в такт дыханию"},
     {phase: "inhale", sec: 5.0, intensity: 0.3, cue: "ключ 4: поворот корпуса вправо на вдохе"},
     {phase: "hold", sec: 5.0, intensity: 0.3, cue: "ключ 4: крайняя точка — цикл 5-5-5, бёдра неподвижны"},
     {phase: "exhale", sec: 5.0, intensity: 0.3, cue: "ключ 4: возврат на выдохе"},
