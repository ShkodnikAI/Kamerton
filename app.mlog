// ── The schema: the operator-mirror DDL path (§2 declaration) ─────────
// Затык §2 (v0.28.2, заявлен громко в PR/worklog): ONE db-url form for
// BOTH lanes does not exist — `mlog test` (interpreter) requires an
// entity-ref url for the schema replay at declaration time, while the
// serve boot pass refuses entity refs ([UNDEFINED_VARIABLE]) and only
// accepts inline env()/env_or()/literal (№758 lazy). The proposed and
// implemented exit: the schema-as-code block is replaced by the
// ADDITIVE-ONLY idempotent DDL literals of the operator mirror
// (migrations/0001_init.sql, ADR-0183) executed by ensure_schema() —
// called by both ticks and /setup before any query. Byte-equality of
// the DDL to the migration is pinned by the verifier script in the
// worklog.
pattern ensure_schema() -> Unit {
  let _ = db_execute("CREATE TABLE IF NOT EXISTS arm (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT, group_name TEXT, day_window TEXT, duration_min INTEGER DEFAULT '10', prior_mean REAL DEFAULT '0.0', prior_std REAL DEFAULT '1.0', active INTEGER DEFAULT '1', created_at TEXT DEFAULT (datetime('now')))", [])
  let _ = db_execute("CREATE TABLE IF NOT EXISTS note (id INTEGER PRIMARY KEY AUTOINCREMENT, body TEXT, active INTEGER DEFAULT '1', created_at TEXT DEFAULT (datetime('now')))", [])
  let _ = db_execute("CREATE TABLE IF NOT EXISTS trial (id INTEGER PRIMARY KEY AUTOINCREMENT, trial_date TEXT, day_window TEXT, arm_id INTEGER REFERENCES arm(id), note_id INTEGER REFERENCES note(id), status TEXT DEFAULT 'proposed', prediction_depth REAL DEFAULT '0.0', prediction_confidence REAL DEFAULT '0.0', moment_value REAL DEFAULT '0.0', moment_present INTEGER DEFAULT '0', moment_source TEXT DEFAULT '', next_day_value REAL DEFAULT '0.0', next_day_present INTEGER DEFAULT '0', action_value REAL DEFAULT '0.0', action_present INTEGER DEFAULT '0', reward REAL DEFAULT '0.0', free_note TEXT DEFAULT '', closed_at TEXT DEFAULT '', created_at TEXT DEFAULT (datetime('now')))", [])
  let _ = db_execute("CREATE TABLE IF NOT EXISTS response (id INTEGER PRIMARY KEY AUTOINCREMENT, trial_id INTEGER REFERENCES trial(id), kind TEXT, depth REAL DEFAULT '0.0', details TEXT DEFAULT '', created_at TEXT DEFAULT (datetime('now')))", [])
  let _ = db_execute("CREATE TABLE IF NOT EXISTS context (id INTEGER PRIMARY KEY AUTOINCREMENT, trial_id INTEGER REFERENCES trial(id), moon_phase TEXT DEFAULT '', weather TEXT DEFAULT '', sound_mode TEXT DEFAULT '', sleep_quality REAL DEFAULT '0.0', logged_at TEXT DEFAULT (datetime('now')))", [])
  let _ = db_execute("CREATE TABLE IF NOT EXISTS candidate (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT, kind TEXT DEFAULT 'non_periodic', status TEXT DEFAULT 'candidate', stat_value REAL DEFAULT '0.0', threshold REAL DEFAULT '0.0', tested_at TEXT DEFAULT '', note TEXT DEFAULT '')", [])
  let _ = db_execute("CREATE TABLE IF NOT EXISTS practice_session (id INTEGER PRIMARY KEY AUTOINCREMENT, kind TEXT DEFAULT 'pacer', arm_id INTEGER REFERENCES arm(id), trial_id INTEGER REFERENCES trial(id), tempo_bpm REAL DEFAULT '0.0', steps_total INTEGER DEFAULT '0', steps_done INTEGER DEFAULT '0', step_marks TEXT DEFAULT '', rr_json TEXT DEFAULT '', rr_source TEXT DEFAULT '', session_date TEXT DEFAULT '', created_at TEXT DEFAULT (datetime('now')))", [])
  let _ = db_execute("CREATE TABLE IF NOT EXISTS sweep_result (id INTEGER PRIMARY KEY AUTOINCREMENT, session_id INTEGER REFERENCES practice_session(id), result_date TEXT DEFAULT '', resonance_bpm REAL DEFAULT '0.0', peak_freq_bpm REAL DEFAULT '0.0', power_fraction REAL DEFAULT '0.0', p_value REAL DEFAULT '1.0', steps_valid INTEGER DEFAULT '0', steps_total INTEGER DEFAULT '0', prev_resonance_bpm REAL DEFAULT '0.0', freq_delta_bpm REAL DEFAULT '0.0', share_ratio REAL DEFAULT '0.0', verdict TEXT DEFAULT '', created_at TEXT DEFAULT (datetime('now')))", [])
  let _ = db_execute("CREATE TABLE IF NOT EXISTS practice_text (id INTEGER PRIMARY KEY AUTOINCREMENT, group_name TEXT, body TEXT, active INTEGER DEFAULT '1', created_at TEXT DEFAULT (datetime('now')))", [])
  let _ = db_execute("CREATE TABLE IF NOT EXISTS slot (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT, max_active INTEGER DEFAULT '3', created_at TEXT DEFAULT (datetime('now')))", [])
  let _ = db_execute("CREATE TABLE IF NOT EXISTS consent (id INTEGER PRIMARY KEY AUTOINCREMENT, scope TEXT, revoked INTEGER DEFAULT '0', source TEXT DEFAULT '', created_at TEXT DEFAULT (datetime('now')))", [])
  let _ = db_execute("CREATE TABLE IF NOT EXISTS practice_protocol (id INTEGER PRIMARY KEY AUTOINCREMENT, arm_id INTEGER REFERENCES arm(id), slot TEXT DEFAULT '', safety_class TEXT DEFAULT 'A', requires_consent INTEGER DEFAULT '0', max_hold_sec REAL DEFAULT '0.0', session_min REAL DEFAULT '10.0', steps_json TEXT DEFAULT '[]', series_json TEXT DEFAULT '', contraindications TEXT DEFAULT '', source TEXT DEFAULT '', created_at TEXT DEFAULT (datetime('now')))", [])
  let _ = db_execute("CREATE TABLE IF NOT EXISTS arm_journal (id INTEGER PRIMARY KEY AUTOINCREMENT, actor TEXT DEFAULT '', arm_id INTEGER REFERENCES arm(id), action TEXT DEFAULT '', detail TEXT DEFAULT '', created_at TEXT DEFAULT (datetime('now')))", [])
  // Н4-02: the MIND-MASTERY script catalog — the three additive tables
  // (ALTER TABLE is in the forbidden destructive DDL class, №325: new
  // columns cannot be added to the existing tables). Byte-identical to
  // the seed DDL (src/arms/arms.mlog §seed_mm_catalog) and to the
  // operator mirror migrations/0001_init.sql — pinned by verify-mirrors.
  let _ = db_execute("CREATE TABLE IF NOT EXISTS practice_segment (id INTEGER PRIMARY KEY AUTOINCREMENT, arm_id INTEGER REFERENCES arm(id), ord INTEGER DEFAULT '0', kind TEXT DEFAULT '', text_key TEXT DEFAULT '', sec REAL DEFAULT '0.0', phase TEXT DEFAULT '', layer_json TEXT DEFAULT '{}', created_at TEXT DEFAULT (datetime('now')))", [])
  let _ = db_execute("CREATE TABLE IF NOT EXISTS practice_script (id INTEGER PRIMARY KEY AUTOINCREMENT, text_key TEXT, body TEXT, created_at TEXT DEFAULT (datetime('now')))", [])
  let _ = db_execute("CREATE TABLE IF NOT EXISTS practice_profile (id INTEGER PRIMARY KEY AUTOINCREMENT, arm_id INTEGER REFERENCES arm(id), system TEXT DEFAULT '', level INTEGER DEFAULT '0', declared_min REAL DEFAULT '0.0', created_at TEXT DEFAULT (datetime('now')))", [])
  // Н4-03: the day plan (the practices chosen for a date) and the
  // free-session journal (mood + note, outside the reward path).
  // ALTER TABLE is in the forbidden destructive DDL class (№325) — two
  // new ADDITIVE tables. Byte-identical to migrations/0001_init.sql —
  // pinned by verify-mirrors.
  let _ = db_execute("CREATE TABLE IF NOT EXISTS day_plan (id INTEGER PRIMARY KEY AUTOINCREMENT, plan_date TEXT, arm_id INTEGER REFERENCES arm(id), ord INTEGER DEFAULT '0', source TEXT DEFAULT 'owner', status TEXT DEFAULT 'planned', done_at TEXT DEFAULT '', created_at TEXT DEFAULT (datetime('now')))", [])
  let _ = db_execute("CREATE TABLE IF NOT EXISTS free_journal (id INTEGER PRIMARY KEY AUTOINCREMENT, journal_date TEXT, arm_id INTEGER REFERENCES arm(id), mood REAL DEFAULT '0.0', note TEXT DEFAULT '', created_at TEXT DEFAULT (datetime('now')))", [])
  // Н4-07: the admission rules of the MIND-MASTERY systems — the entry
  // gate of the active set (fill: seed_mm_catalog from
  // seeds/mm/progression.json). Byte-identical to the seed DDL
  // (src/arms/arms.mlog §seed_mm_catalog) and to the operator mirror
  // migrations/0001_init.sql — pinned by verify-mirrors.
  let _ = db_execute("CREATE TABLE IF NOT EXISTS practice_admission (id INTEGER PRIMARY KEY AUTOINCREMENT, system TEXT DEFAULT '', level INTEGER DEFAULT '0', min_sessions REAL DEFAULT '0.0', min_minutes REAL DEFAULT '0.0', created_at TEXT DEFAULT (datetime('now')))", [])
  ensure_indexes()
}

pattern ensure_indexes() -> Unit {
  db_execute("CREATE INDEX IF NOT EXISTS idx_trial_date ON trial(trial_date)")
  db_execute("CREATE INDEX IF NOT EXISTS idx_trial_arm ON trial(arm_id)")
  db_execute("CREATE INDEX IF NOT EXISTS idx_trial_status ON trial(status)")
  db_execute("CREATE INDEX IF NOT EXISTS idx_response_trial ON response(trial_id)")
  db_execute("CREATE INDEX IF NOT EXISTS idx_context_trial ON context(trial_id)")
  db_execute("CREATE INDEX IF NOT EXISTS idx_candidate_name ON candidate(name)")
  db_execute("CREATE INDEX IF NOT EXISTS idx_arm_active ON arm(active)")
  // Н4-02: the script catalog uniqueness (idempotent seed discipline)
  db_execute("CREATE UNIQUE INDEX IF NOT EXISTS idx_segment_arm_ord_unique ON practice_segment(arm_id, ord)")
  db_execute("CREATE UNIQUE INDEX IF NOT EXISTS idx_script_key_unique ON practice_script(text_key)")
  db_execute("CREATE UNIQUE INDEX IF NOT EXISTS idx_profile_arm_unique ON practice_profile(arm_id)")
  // Н4-03: the plan uniqueness per day (the idempotent add backstop)
  db_execute("CREATE UNIQUE INDEX IF NOT EXISTS idx_day_plan_date_arm_unique ON day_plan(plan_date, arm_id)")
  db_execute("CREATE INDEX IF NOT EXISTS idx_journal_date ON free_journal(journal_date)")
  // Н4-07: the admission rule uniqueness (one rule per system+level)
  db_execute("CREATE UNIQUE INDEX IF NOT EXISTS idx_admission_system_level_unique ON practice_admission(system, level)")
}

// ── APP-MIRROR-START: store-core (the signatures mirror
//    src/store/store.mlog; equality pinned by the worklog script) ──────

pattern trial_by_id(trial_id: Float) -> List {
  return query("SELECT id, trial_date, day_window, arm_id, status, prediction_depth, prediction_confidence, moment_value, moment_present, moment_source, next_day_value, next_day_present, action_value, action_present, reward FROM trial WHERE id = ?", [trial_id])
}

pattern compute_reward(trial_id: Float) -> Float {
  let rows = query("SELECT moment_value, moment_present, next_day_value, next_day_present, action_value, action_present FROM trial WHERE id = ?", [trial_id])
  if len(rows) == 0.0 {
    return 0.0
  }
  let r = rows[0]
  let mut acc = 0.0
  let mut wsum = 0.0
  if r.moment_present == 1.0 {
    acc = acc + 0.2 * r.moment_value
    wsum = wsum + 0.2
  }
  if r.next_day_present == 1.0 {
    acc = acc + 0.3 * r.next_day_value
    wsum = wsum + 0.3
  }
  if r.action_present == 1.0 {
    acc = acc + 0.5 * r.action_value
    wsum = wsum + 0.5
  }
  if wsum == 0.0 {
    return 0.0
  }
  let reward = acc / wsum
  db_execute("UPDATE trial SET reward = ? WHERE id = ?", [reward, trial_id])
  return reward
}

// ── Sweep protocol (Н2-06): the individual resonance frequency ──────────
// The tempo sweep (4.5–7.0 breaths/min, two minutes per tempo — the
// Н2-04 pacer protocol) walks the protocol while the Н2-05 PPG records
// the pulse on the device; every completed step carries its RR segment
// in the session's step_marks ({"step","tempo_bpm","rr","rr_reason"}).
// The spectrum of each segment is computed by the language's spectral
// contour (№591 builtins lomb_scargle/spectral_peak): sin/cos are
// absent from the 0.30.0 grammar (probe-pinned), so hand-rolling the
// periodogram is impossible — the builtins are the only honest path.
// The resonance frequency is the PACED tempo of the valid step with
// the maximal power fraction. The preregistration (fixed in the
// naryad BEFORE any live data, docs/volna-2-issues.md Н2-06):
//   - a step counts as valid when its mark carries a non-empty rr
//     array whose spectrum is not degraded (the language's own floor
//     is 12 points — probe-pinned Degraded reason);
//   - the protocol is accepted at >= 6 valid steps of the 11;
//   - the repeat protocol reproduces when the resonance tempo stays
//     within 0.3 breaths/min of the previous recorded run and the
//     winner's power fraction stays within the ratio [0.5; 2.0].
// An accepted run is fixed in the sweep_result table (invariant 6: a
// third-party sqlite3 client reads it) AND mirrored into the persisted
// kv (resonance_* keys, data/kamerton-kv.db) for the live process.

pattern sweep_rr_times(rr_ms: List) -> List {
  // Beat arrival times in seconds: the cumulative sums of the RR
  // intervals. The segment carries no timestamps — the intervals are
  // the full information the page sends (invariant 7 data minimum).
  let mut ts = []
  let mut t = 0.0
  each v in rr_ms {
    t = t + to_float(v) / 1000.0
    ts = push(ts, t)
  }
  return ts
}

pattern sweep_step_peak(rr_ms: List) -> Struct {
  // One step's RR segment -> the spectral verdict. Times are the
  // cumulative arrival seconds, values are the RR intervals in ms.
  // Degraded spectra refuse loudly with a reason — never silently.
  if len(rr_ms) < 12.0 {
    return {ok: false, freq_bpm: 0.0, share: 0.0, p_value: 1.0, reason: "RR-ряд короче 12 точек: " + to_string(len(rr_ms))}
  }
  let ts = sweep_rr_times(rr_ms)
  let spec = lomb_scargle(ts, rr_ms)
  let pk = spectral_peak(spec)
  if pk.degraded == true {
    return {ok: false, freq_bpm: 0.0, share: 0.0, p_value: 1.0, reason: "спектр деградировал: точек " + to_string(len(rr_ms))}
  }
  return {ok: true, freq_bpm: pk.freq * 60.0, share: pk.power_fraction, p_value: pk.p_value, reason: ""}
}

pattern sweep_analyze(marks_json: String<public, trusted>) -> Struct {
  // The session's step_marks (the page-written JSON array) -> the sweep
  // verdict. Loud refusals: not a JSON array, zero valid steps, fewer
  // than the preregistered 6 valid steps. Marks predating the Н2-06
  // shape (no rr key — an old-format writer or the toggle off) count as
  // invalid steps; the field probe rides json_encode + contains because
  // a missing struct field fails LOUDLY on 0.30.0 (probe-pinned) and
  // the analyzer must classify, not crash.
  let parsed = parse_json(marks_json)
  if type_of(parsed) != "List" {
    return {ok: false, reason: "step_marks: ожидается JSON-массив отметок шагов", resonance_bpm: 0.0, peak_freq_bpm: 0.0, share: 0.0, p_value: 1.0, steps_valid: 0.0, steps_total: 0.0}
  }
  let mut total = 0.0
  let mut valid = 0.0
  let mut best_bpm = 0.0
  let mut best_freq = 0.0
  let mut best_share = 0.0
  let mut best_p = 1.0
  each m in parsed {
    total = total + 1.0
    let mj = json_encode(m)
    if contains(mj, "\"rr\"") == false {
      let _ = mj
    } else {
      if contains(mj, "\"tempo_bpm\"") == false {
        let _ = mj
      } else {
        if type_of(m.rr) == "List" {
          if len(m.rr) > 0.0 {
            let pk = sweep_step_peak(m.rr)
            if pk.ok == true {
              valid = valid + 1.0
              if pk.share > best_share {
                best_share = pk.share
                best_bpm = to_float(m.tempo_bpm)
                best_freq = pk.freq_bpm
                best_p = pk.p_value
              }
            }
          }
        }
      }
    }
  }
  if valid == 0.0 {
    return {ok: false, reason: "годных RR-сегментов нет: 0 из " + to_string(total), resonance_bpm: 0.0, peak_freq_bpm: 0.0, share: 0.0, p_value: 1.0, steps_valid: 0.0, steps_total: total}
  }
  if valid < 6.0 {
    return {ok: false, reason: "шагов с годным спектром: " + to_string(valid) + " из " + to_string(total) + " — протокол требует не менее 6 (предрегистрация Н2-06)", resonance_bpm: 0.0, peak_freq_bpm: 0.0, share: 0.0, p_value: 1.0, steps_valid: valid, steps_total: total}
  }
  return {ok: true, reason: "", resonance_bpm: best_bpm, peak_freq_bpm: best_freq, share: best_share, p_value: best_p, steps_valid: valid, steps_total: total}
}

pattern sweep_record(sid: Float, res: Struct, result_date: String) -> Struct {
  // Fix the accepted run: the sweep_result row (invariant 6) + the kv
  // mirror. The verdict compares against the previous recorded run per
  // the preregistration: the tempo delta <= 0.3 breaths/min AND the
  // power fraction ratio in [0.5; 2.0]. The first recorded run carries
  // the empty verdict — there is nothing to reproduce against yet.
  let prev = query("SELECT resonance_bpm, power_fraction FROM sweep_result ORDER BY id DESC LIMIT 1", [])
  let mut verdict = ""
  let mut delta = 0.0
  let mut ratio = 0.0
  let mut prev_bpm = 0.0
  if len(prev) > 0.0 {
    prev_bpm = to_float(prev[0].resonance_bpm)
    let prev_share = to_float(prev[0].power_fraction)
    delta = abs(res.resonance_bpm - prev_bpm)
    if prev_share > 0.0 {
      ratio = res.share / prev_share
    }
    if delta <= 0.3 and ratio >= 0.5 and ratio <= 2.0 {
      verdict = "reproducible"
    } else {
      verdict = "divergent"
    }
  }
  let _ = db_execute("INSERT INTO sweep_result (session_id, result_date, resonance_bpm, peak_freq_bpm, power_fraction, p_value, steps_valid, steps_total, prev_resonance_bpm, freq_delta_bpm, share_ratio, verdict) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)", [sid, result_date, res.resonance_bpm, res.peak_freq_bpm, res.share, res.p_value, res.steps_valid, res.steps_total, prev_bpm, delta, ratio, verdict])
  let _ = kv_set("resonance_bpm", to_string(res.resonance_bpm))
  let _ = kv_set("resonance_peak_freq", to_string(res.peak_freq_bpm))
  let _ = kv_set("resonance_share", to_string(res.share))
  let _ = kv_set("resonance_verdict", verdict)
  return {ok: true, resonance_bpm: res.resonance_bpm, peak_freq_bpm: res.peak_freq_bpm, share: res.share, p_value: res.p_value, steps_valid: res.steps_valid, steps_total: res.steps_total, verdict: verdict, freq_delta_bpm: delta, share_ratio: ratio}
}

// ── APP-MIRROR-END: store-core
pattern last_proposed_trial(local_date: String) -> List {
  return query("SELECT id, arm_id, day_window FROM trial WHERE status = 'proposed' AND trial_date = ? ORDER BY id DESC LIMIT 1", [local_date])
}

pattern close_stale_misses(local_date: String) -> Float {
  let stale = query("SELECT id FROM trial WHERE status = 'proposed' AND trial_date < ? AND arm_id IS NOT NULL", [local_date])
  let mut closed = 0.0
  each t in stale {
    let tid = t.id
    let _ = db_execute("UPDATE trial SET status = 'missed', closed_at = datetime('now') WHERE id = ?", [tid])
    closed = closed + 1.0
  }
  return closed
}

pattern apply_answer(tid: Float, ans: Struct) -> String {
  if ans.kind == "prediction" {
    let rows = query("SELECT prediction_depth FROM trial WHERE id = ? AND status = 'proposed'", [tid])
    if len(rows) == 0.0 {
      return "no-open-trial"
    }
    if rows[0].prediction_depth != 0.0 {
      return "prediction-kept"
    }
    let _ = db_execute("UPDATE trial SET prediction_depth = ? WHERE id = ?", [ans.value, tid])
    // Н2-13: the context row is written AT THE RESPONSE TIME (the
    // probe-time write, the context module's decision 1) — blind until
    // the first response row opens the read (invariant 2); the sleep
    // sentinel -1.0 when s: has not been seen (never a fabricated 0;
    // a later s: in the batch updates the row in place).
    let _ = ensure_context_row(tid, 0 - 1.0)
    return "prediction"
  }
  if ans.kind == "moment" {
    let guard = query("SELECT count(*) AS n FROM response WHERE trial_id = ? AND kind = 'moment'", [tid])
    if guard[0].n > 0.0 {
      return "moment-kept"
    }
    let row = {trial_id: tid, kind: "moment", depth: ans.value, details: "telegram m:"}
    let _ = db_insert("response", row)
    let _ = db_execute("UPDATE trial SET moment_value = ?, moment_present = 1, moment_source = 'subjective', status = 'completed' WHERE id = ?", [ans.value, tid])
    let _ = compute_reward(tid)
    let _ = ensure_context_row(tid, 0 - 1.0)
    return "moment"
  }
  // Н2-13: the optional sleep context — the value lands in the trial's
  // context row (in place when one exists, else a fresh row); the row
  // stays BLIND until the first response row (the read guard).
  if ans.kind == "sleep" {
    let rows = query("SELECT id FROM trial WHERE id = ?", [tid])
    if len(rows) == 0.0 {
      return "no-open-trial"
    }
    let ctx = query("SELECT id FROM context WHERE trial_id = ? ORDER BY id DESC LIMIT 1", [tid])
    if len(ctx) > 0.0 {
      let _ = db_execute("UPDATE context SET sleep_quality = ? WHERE id = ?", [ans.value, ctx[0].id])
    } else {
      let _ = collect_context(tid, now_unix(), ans.value)
    }
    return "sleep"
  }
  // Н2-12: the full-reward components (ADR-0001 — the formula is
  // closed, only the INPUTS arrive). The guard rides the presence
  // flag (fill an untouched default exactly once — the prediction
  // precedent); the reward RECOMPUTES as the normalized weighted sum
  // of the present components on every new one, idempotently. A late
  // component on a closed (missed/completed) trial is legal: the flag
  // flips, the reward recomputes, the status stays as the window left
  // it (no backdating — the bandit's own predicate decides what
  // counts).
  if ans.kind == "next_day" {
    let rows = query("SELECT next_day_present FROM trial WHERE id = ?", [tid])
    if len(rows) == 0.0 {
      return "no-open-trial"
    }
    if rows[0].next_day_present == 1.0 {
      return "next_day-kept"
    }
    let row = {trial_id: tid, kind: "next_day", depth: ans.value, details: "telegram nd:"}
    let _ = db_insert("response", row)
    let _ = db_execute("UPDATE trial SET next_day_value = ?, next_day_present = 1 WHERE id = ?", [ans.value, tid])
    let _ = compute_reward(tid)
    return "next_day"
  }
  if ans.kind == "action" {
    let rows = query("SELECT action_present FROM trial WHERE id = ?", [tid])
    if len(rows) == 0.0 {
      return "no-open-trial"
    }
    if rows[0].action_present == 1.0 {
      return "action-kept"
    }
    let row = {trial_id: tid, kind: "action", depth: ans.value, details: "telegram act:"}
    let _ = db_insert("response", row)
    let _ = db_execute("UPDATE trial SET action_value = ?, action_present = 1 WHERE id = ?", [ans.value, tid])
    let _ = compute_reward(tid)
    return "action"
  }
  let rows2 = query("SELECT free_note FROM trial WHERE id = ?", [tid])
  let mut note = ""
  if len(rows2) > 0.0 {
    note = rows2[0].free_note
  }
  let joined = note + " | " + escape_html(ans.text)
  let _ = db_execute("UPDATE trial SET free_note = ? WHERE id = ?", [joined, tid])
  return "note"
}

// Н2-13: the probe-time context write, once per trial — a repeated
// response (prediction after the moment, a note, a second drain) does
// NOT add a second row; the sleep sentinel -1.0 means «не отвечено»
// (the silent zero is forbidden). The blindness of the row is the
// context module's own contract (the read guard).
pattern ensure_context_row(tid: Float, sleep_quality: Float) -> Float {
  let rows = query("SELECT count(*) AS n FROM context WHERE trial_id = ?", [tid])
  if rows[0].n > 0.0 {
    return 0.0
  }
  return collect_context(tid, now_unix(), sleep_quality)
}

// ── H2-07-SPECTRAL-START (byte-mirrored into app.mlog telegram-core) ────
// The M2 projection source (Н2-07, ADR-0001): with a valid practice RR
// series the trial's moment is written by the SPECTRAL source — the
// power fraction in the band around the dominant peak (the honest
// resonance measure per the concept; the №591 builtins do the math,
// sin/cos are absent from the 0.30.0 grammar). The subjective scales
// stay the fallback: their drain path above is guarded by the ANY-moment
// response count, so an existing projection is never silently
// overwritten, and the projection carries the declared PRIORITY over an
// earlier subjective row (both rows remain in response — nothing is
// lost; the trial fixes the source actually used).

pattern moment_spectral_from_rr(rr_ms: List) -> Struct {
  // A practice RR series -> the spectral verdict. Loud refusal on a
  // short or degraded series (the language floor is 12 points,
  // probe-pinned) — the fallback stays untouched, never a fabricated 0.
  if len(rr_ms) < 12.0 {
    return {ok: false, share: 0.0, peak_hz: 0.0, reason: "RR-ряд короче 12 точек: " + to_string(len(rr_ms))}
  }
  let ts = sweep_rr_times(rr_ms)
  let spec = lomb_scargle(ts, rr_ms)
  let pk = spectral_peak(spec)
  if pk.degraded == true {
    return {ok: false, share: 0.0, peak_hz: 0.0, reason: "спектр деградировал: точек " + to_string(len(rr_ms))}
  }
  return {ok: true, share: pk.power_fraction, peak_hz: pk.freq, reason: ""}
}

pattern moment_spectral_write(tid: Float, share: Float, peak_hz: Float) -> Float {
  // The guarded projection write: once per trial (a repeated projection
  // is refused loudly by the caller contract — 0.0, rows untouched).
  // The response row makes the write visible to the drain's ANY-moment
  // guard, so the subjective fallback can never silently replace it.
  let guard = query("SELECT count(*) AS n FROM response WHERE trial_id = ? AND kind = 'moment' AND details LIKE 'spectral%'", [tid])
  if guard[0].n > 0.0 {
    return 0.0
  }
  let row = {trial_id: tid, kind: "moment", depth: share, details: "spectral projection: peak " + to_string(peak_hz) + " Hz"}
  let _ = db_insert("response", row)
  let _ = db_execute("UPDATE trial SET moment_value = ?, moment_present = 1, moment_source = 'spectral', status = 'completed' WHERE id = ?", [share, tid])
  return 1.0
}
// ── H2-07-SPECTRAL-END ───────────────────────────────────────────────────

pattern process_updates(updates: List<public, trusted>, chat_id: String<public, trusted>, now_ts: Float, tz_offset_hours: Float, offset: Float, with_report: Bool) -> Unit {
  // Н2-10: an answer belongs to the trial of the window its MESSAGE fell
  // into (message.date, the Telegram server clock), not to the window of
  // the tick that happens to drain it; a message without a date falls
  // back to the tick moment. The close threshold is the end of the window
  // (window_date of now), so an early manual /fire never closes a live trial.
  // The D2-family posture: the drain is a BARE each (db effects inside
  // the loop are the m0_row-proven shape), every diagnostic lives in
  // counters, ONE summary print after the loop. The chat filter
  // compares SANITIZED projections; the untrusted raw never branches.
  // Н2-11: with_report=false silences the counters message for the
  // 21:30 collect tick — the report stays the 02:00 closing tick's
  // signature; the collect tick speaks only through its ONE request.
  let mut processed = 0.0
  let mut predictions = 0.0
  let mut moments = 0.0
  let mut plans = 0.0
  let mut skipped = 0.0
  let mut last_id = 0 - 1.0
  each u in updates {
    last_id = json_get(u, "update_id", 0.0)
    let chat = to_string(json_get(u, "message.chat.id", 0.0))
    if escape_html(chat) == escape_html(chat_id) {
      let text = json_get(u, "message.text", "")
      if escape_html(text) != "" {
        let ans = parse_chat_text(text)
        // The message clock (Н2-10) — hoisted from the trial routing:
        // the day-plan commands bind to the day their MESSAGE fell
        // into, the same single clock as the answers.
        let mut msg_ts = json_get(u, "message.date", 0.0)
        if msg_ts <= 0.0 {
          msg_ts = now_ts
        }
        // Н4-03: the day-plan commands answer directly (the report
        // family) — the plan show/add/done and the free-session
        // journal. They NEVER touch trial/response: the recommendation
        // is the experiment of the day (Шаг 0), the owner's picks and
        // the journal are free practice outside the reward path. The
        // shape is the tg_moment_tick precedent — sequential positive
        // ifs, ONE send per command, counters inside the same branch;
        // the trial routing below runs only when nothing matched.
        let mut handled = false
        if ans.kind == "plan" {
          handled = true
          let today = owner_date(msg_ts, tz_offset_hours)
          let _ = send_message(chat_id, format_plan(today, plan_for_date(today)))
          plans = plans + 1.0
          processed = processed + 1.0
        }
        if ans.kind == "plan_add" {
          handled = true
          let today = owner_date(msg_ts, tz_offset_hours)
          let cands = plan_arm_candidates(ans.text)
          let mut reply = ""
          if len(cands) == 1.0 {
            if plan_consent_ok(cands[0].id) == false {
              reply = escape_html(cands[0].name) + " — практика класса C: без записи согласия не добавляется (инвариант 5)."
            } else {
              let added = plan_add(today, cands[0].id, "owner")
              if added > 0.0 {
                reply = format_plan(today, plan_for_date(today))
              } else {
                reply = escape_html(cands[0].name) + " уже в плане на " + escape_html(today) + "."
              }
            }
          } else {
            if len(cands) == 0.0 {
              reply = format_plan_notfound(ans.text)
            } else {
              reply = format_plan_candidates(ans.text, cands)
            }
          }
          let _ = send_message(chat_id, reply)
          plans = plans + 1.0
          processed = processed + 1.0
        }
        if ans.kind == "plan_done" {
          handled = true
          let today = owner_date(msg_ts, tz_offset_hours)
          let marked = plan_mark_done_by_pos(today, ans.value)
          let mut reply = ""
          if marked < 0.0 {
            reply = "В плане на " + escape_html(today) + " нет пункта " + escape_html(to_string(ans.value)) + "."
          } else {
            reply = format_plan(today, plan_for_date(today))
          }
          let _ = send_message(chat_id, reply)
          plans = plans + 1.0
          processed = processed + 1.0
        }
        if ans.kind == "journal" {
          handled = true
          let jday = owner_date(msg_ts, tz_offset_hours)
          // The chat journal carries no practice link (the Mini App one
          // binds the plan row) — mood + note for the day, silent like
          // the p:/m: answers.
          let _ = free_journal_add(jday, 0.0, ans.value, escape_html(ans.text))
          plans = plans + 1.0
          processed = processed + 1.0
        }
        // Н4-07: the emergency stop — available ALWAYS (общая с Н4-04:
        // the player reuses the same emergency_stop pattern). ONE data
        // effect: today's proposed trial -> 'stopped' (a new status
        // string, invisible to every analytics filter — a stopped
        // practice is not a miss); the answer names what stopped. The
        // Mini App button calls the /miniapp/stop route (the same
        // pattern).
        if ans.kind == "stop" {
          handled = true
          let today = owner_date(msg_ts, tz_offset_hours)
          let res = emergency_stop(today)
          let mut reply = "Экстренная остановка: открытой пробы на " + escape_html(today) + " нет — останавливать нечего."
          if res.stopped == 1.0 {
            reply = "Экстренная остановка: проба #" + escape_html(to_string(res.trial)) + " остановлена (статус stopped, окно закрыто)."
          }
          let _ = send_message(chat_id, reply)
          processed = processed + 1.0
        }
        // Н2-13: the honesty-valve report on request — the command is
        // answered directly, no trial routing; the text is the
        // escape_html-wrapped SSOT report (the chat form).
        if handled == false {
        if ans.kind == "report" {
          let _ = send_message(chat_id, honesty_report_chat())
          processed = processed + 1.0
        } else {
        // Н2-12: the full-reward answers bind by the PENDING QUESTION,
        // not by the message window — the bot asks about ONE trial per
        // question kind (the kv pendings are set by the morning ask and
        // cleared on a successful write), so «ответ о вчерашней пробе»
        // and «о трёхдневной давности» never cross. A spontaneous
        // answer with no pending question is skipped, never guessed.
        let mut tid = 0.0
        let mut routed = false
        if ans.kind == "next_day" {
          let p = to_float_or(kv_get("nd_pending_trial"), 0.0)
          if p > 0.0 {
            tid = p
            routed = true
          }
        } else {
          if ans.kind == "action" {
            let p2 = to_float_or(kv_get("act_pending_trial"), 0.0)
            if p2 > 0.0 {
              tid = p2
              routed = true
            }
          } else {
            if ans.kind == "sleep" {
              // The sleep note binds to the window's trial in ANY
              // status (the completed trial's day context arrives late).
              let open = latest_window_trial(window_date(msg_ts, tz_offset_hours))
              if len(open) > 0.0 {
                tid = open[0].id
                routed = true
              }
            } else {
              let open = last_proposed_trial(window_date(msg_ts, tz_offset_hours))
              if len(open) > 0.0 {
                tid = open[0].id
                routed = true
              }
            }
          }
        }
        if routed == true {
          let applied = apply_answer(tid, ans)
          if applied == "prediction" {
            predictions = predictions + 1.0
            processed = processed + 1.0
          }
          if applied == "moment" {
            moments = moments + 1.0
            processed = processed + 1.0
          }
          if applied == "next_day" {
            moments = moments + 1.0
            processed = processed + 1.0
            let _ = kv_set("nd_pending_trial", "0")
          }
          if applied == "action" {
            moments = moments + 1.0
            processed = processed + 1.0
            let _ = kv_set("act_pending_trial", "0")
          }
          if applied == "note" {
            processed = processed + 1.0
          }
          if applied == "sleep" {
            processed = processed + 1.0
          }
          if applied == "no-open-trial" {
            skipped = skipped + 1.0
          }
        } else {
          skipped = skipped + 1.0
        }
        }
        }
      } else {
        skipped = skipped + 1.0
      }
    } else {
      skipped = skipped + 1.0
    }
  }
  // The offset advances AFTER the batch; a crash before the kv_set
  // replays the batch into the idempotent guards (design note 4).
  if last_id >= 0.0 {
    let next_offset = last_id + 1.0
    if next_offset != offset {
      let _ = kv_set("tg_offset", to_string(next_offset))
    }
  }
  let closed = close_stale_misses(window_date(now_ts, tz_offset_hours))
  if with_report == true {
    let _ = send_message(chat_id, format_report(processed, closed, predictions, moments))
  }
  print("[telegram] drain: processed=" + to_string(processed) + " closed=" + to_string(closed) + " predictions=" + to_string(predictions) + " moments=" + to_string(moments) + " plans=" + to_string(plans) + " skipped=" + to_string(skipped))
}

pattern has_job(expr: String, target: String) -> Bool {
  // each over the snapshot: the while+len shape misconverges when the
  // body can reach cron_remove (the worklog probe, the new D2-family
  // symptom) — this pass must stay removal-free AND each-shaped.
  let jobs = cron_list()
  let mut found = false
  each j in jobs {
    if j.cron_expr == expr and j.prompt == target {
      found = true
    }
  }
  return found
}

pattern setup_register() -> Unit {
  // The D2-family posture: NO prints and NO mixed statements inside the
  // loop bodies — the stale sweep runs as a bare each, the add phase
  // runs through precomputed flags, ONE summary print after everything
  // (the probe: variant A misconverges, variant B converges).
  // Н2-11: THREE jobs — the morning proposal (07:00), the evening
  // collect request (21:30) and the window-closing drain (02:00); a
  // KAMERTON_TZ_OFFSET change folds every expression and the stale
  // sweep removes the outdated copies by prompt.
  // Н2-13: the FOURTH job — the honesty valve's weekly report
  // (Monday 09:30 local).
  let off = to_float(env_or("KAMERTON_TZ_OFFSET", "0"))
  let morning = cron_expr_for(420.0, off)
  let collect = cron_expr_for(1290.0, off)
  let evening = cron_expr_for(120.0, off)
  let weekly = cron_expr_for(570.0, off)
  // Н4-08: the FIFTH job — the Moment of Power tick, every 10 minutes
  // round the clock ("*/10 * * * *", probe-pinned on v0.38.0): the tick
  // self-guards on the owner's window/secret/text, so the expression
  // does not depend on the window facts.
  let moment = "*/10 * * * *"
  let jobs = cron_list()
  // №706 (mlog 0.33.1): cron_list rows flow as private (prompt/payload
  // are user-authored content — the №689 whole-struct fail-closed
  // posture), and cron_remove/cron_run are decision sinks (№391) — the
  // id takes the sanctioned redact bridge: redact(id,
  // "secrets") sheds the label and passes the id string through
  // unchanged (probe-pinned on 0.33.1: real ids are "cron_<ts>_<n>"
  // strings, the value survives byte-exact); the
  // derived count in the summary print rides the redact bridge
  // (№781, mlog 0.34.0: escape_html restores integrity only and no
  // longer declassifies — redact "secrets" is the legal path down).
  each j in jobs {
    if j.prompt == "tg_morning_tick" and j.cron_expr != morning {
      let _ = cron_remove(redact(j.id, "secrets"))
    }
    if j.prompt == "tg_collect_tick" and j.cron_expr != collect {
      let _ = cron_remove(redact(j.id, "secrets"))
    }
    if j.prompt == "tg_evening_tick" and j.cron_expr != evening {
      let _ = cron_remove(redact(j.id, "secrets"))
    }
    if j.prompt == "tg_weekly_tick" and j.cron_expr != weekly {
      let _ = cron_remove(redact(j.id, "secrets"))
    }
    if j.prompt == "tg_moment_tick" and j.cron_expr != moment {
      let _ = cron_remove(redact(j.id, "secrets"))
    }
  }
  let add_m = has_job(morning, "tg_morning_tick") == false
  if add_m == true {
    let _ = cron_add(morning, "tg_morning_tick")
  }
  let add_c = has_job(collect, "tg_collect_tick") == false
  if add_c == true {
    let _ = cron_add(collect, "tg_collect_tick")
  }
  let add_e = has_job(evening, "tg_evening_tick") == false
  if add_e == true {
    let _ = cron_add(evening, "tg_evening_tick")
  }
  let add_w = has_job(weekly, "tg_weekly_tick") == false
  if add_w == true {
    let _ = cron_add(weekly, "tg_weekly_tick")
  }
  let add_mo = has_job(moment, "tg_moment_tick") == false
  if add_mo == true {
    let _ = cron_add(moment, "tg_moment_tick")
  }
  // VM defect #52 (minimal repro m6b): TWO print-ifs reading flags after
  // executed effect-call if-bodies miscompile on the serve VM lane — the
  // first /setup against an EMPTY store throws [TYPE_MISMATCH] Struct Eq
  // Bool (one pair is clean; the interpreter test lane never sees it, so
  // this suite stays green either way). The registration log is therefore
  // ONE flat summary print — the shape rig-validated clean on the full
  // setup_register body (m7full: 3/3 first-hit clean on an empty store).
  print("[telegram] cron setup: morning=" + morning + " collect=" + collect + " evening=" + evening + " weekly=" + weekly + " moment=" + moment + " jobs=" + redact(to_string(len(cron_list())), "secrets"))
}

// ── Н4-03: the day plan and the free-session journal ──────────────────
// The plan of a day holds the practices chosen for the date: the
// recommendation (the bandit's experimental pick) and the owner's free
// picks. Free sessions NEVER write trial/response (the Шаг 0 default:
// the recommendation is the experiment of the day, everything else is
// free practice — the posterior never sees it). The add resolves a
// name fragment over the WHOLE catalog (active and inactive — the plan
// is not the bandit set); a class-C practice is admitted only with the
// consent row of its class (the same condition eligible_arms applies —
// invariant 5 does not depend on the surface). The
// UNIQUE(plan_date, arm_id) index is the idempotency backstop; the
// guard SELECT is the primary path (db_insert has no OR IGNORE form).
pattern trial_arm_id(tid: Float) -> Float {
  let rows = query("SELECT arm_id FROM trial WHERE id = ?", [tid])
  if len(rows) == 0.0 {
    return 0.0
  }
  return rows[0].arm_id
}

pattern plan_for_date(plan_date: String) -> List {
  return query("SELECT d.id AS id, d.ord AS ord, d.source AS source, d.status AS status, d.done_at AS done_at, a.name AS name FROM day_plan d JOIN arm a ON a.id = d.arm_id WHERE d.plan_date = ? ORDER BY d.ord, d.id", [plan_date])
}

pattern plan_arm_candidates(fragment: String) -> List {
  return query("SELECT id, name FROM arm WHERE name LIKE '%' || ? || '%' ORDER BY id", [fragment])
}

// The consent gate — the eligible_arms condition narrowed to one arm.
pattern plan_consent_ok(arm_id: Float) -> Bool {
  let rows = query("SELECT count(*) AS n FROM arm a LEFT JOIN practice_protocol p ON p.arm_id = a.id WHERE a.id = ? AND (p.arm_id IS NULL OR p.requires_consent = 0 OR EXISTS (SELECT 1 FROM consent c WHERE c.scope = 'class:' || p.safety_class AND c.revoked = 0))", [arm_id])
  return rows[0].n > 0.0
}

// Returns the new row id, or 0.0 when the practice is already planned
// (the repeated command is a no-op — the idempotent add).
pattern plan_add(plan_date: String, arm_id: Float, source: String) -> Float {
  let dup = query("SELECT id FROM day_plan WHERE plan_date = ? AND arm_id = ?", [plan_date, arm_id])
  if len(dup) > 0.0 {
    return 0.0
  }
  let nxt = query("SELECT COALESCE(MAX(ord), 0) + 1 AS o FROM day_plan WHERE plan_date = ?", [plan_date])
  let row = {plan_date: plan_date, arm_id: arm_id, ord: nxt[0].o, source: source}
  return db_insert("day_plan", row)
}

// Marks one plan item done. The date guard keeps a stale id from
// another day's plan out. Returns the updated-row count (0 = already
// done or no such row).
pattern plan_mark_done(plan_id: Float, plan_date: String) -> Float {
  let _ = db_execute("UPDATE day_plan SET status = 'done', done_at = datetime('now') WHERE id = ? AND plan_date = ? AND status != 'done'", [plan_id, plan_date])
  let rows = query("SELECT changes() AS n", [])
  return rows[0].n
}

// The chat surface marks by the POSITION in today's list (1..n — the
// numbering format_plan prints). Returns -1 on a position miss (a loud
// no-op, never a wrong row), else the plan_mark_done count.
pattern plan_mark_done_by_pos(plan_date: String, pos: Float) -> Float {
  let rows = plan_for_date(plan_date)
  if pos < 1.0 {
    return 0 - 1.0
  }
  if pos > len(rows) {
    return 0 - 1.0
  }
  let row = rows[to_int(pos - 1.0)]
  return plan_mark_done(row.id, plan_date)
}

// The arm of one plan row (the Mini App journal binding); the date
// guard mirrors plan_mark_done. 0.0 = no such row this day.
pattern plan_item_arm(plan_id: Float, plan_date: String) -> Float {
  let rows = query("SELECT arm_id FROM day_plan WHERE id = ? AND plan_date = ?", [plan_id, plan_date])
  if len(rows) == 0.0 {
    return 0.0
  }
  if type_of(rows[0].arm_id) != "Float" {
    return 0.0
  }
  return rows[0].arm_id
}

// The free-session journal: mood + note, OUTSIDE the reward path (no
// trial, no response — the posterior cannot see it). arm_id 0 lands as
// SQL NULL (the CASE form — the miniapp_session_open precedent: ONE
// parameterized statement, the FK clauses stay truthful).
pattern free_journal_add(journal_date: String, arm_id: Float, mood: Float, note: String) -> Float {
  let _ = db_execute("INSERT INTO free_journal (journal_date, arm_id, mood, note) VALUES (?, CASE WHEN ? > 0 THEN ? END, ?, ?)", [journal_date, arm_id, arm_id, mood, note])
  let rows = query("SELECT last_insert_rowid() AS id", [])
  return rows[0].id
}

// The catalog names for the Mini App picker (id, name, active — the
// plan may draw from the whole catalog, active or not).
pattern arms_catalog_names() -> List {
  return query("SELECT id, name, active FROM arm ORDER BY id", [])
}

// ── APP-MIRROR-END: db-cycle ─────────────────────────────────────────

// ── APP-MIRROR-START: bandit-core (the signatures mirror
//    src/bandit/bandit.mlog; equality pinned by the worklog script) ────
// Thompson Normal-Normal on the decayed rewards, the 20% forced
// exploration floor, the seed contract. The entity constants below are
// byte-identical to the bandit module's.

entity reward_obs_std: Float = 0.25
entity decay_tau_days: Float = 60.0
entity explore_every: Float = 5.0

pattern today_unix() -> Float {
  return date_parse_iso(date_format_iso(now_unix()))
}

pattern decay_weight(age_days: Float) -> Float {
  if age_days <= decay_tau_days {
    return 1.0
  }
  return exp((decay_tau_days - age_days) / decay_tau_days)
}

pattern arm_posterior(arm_id: Float, prior_mean: Float, prior_std: Float) -> List {
  let mut s0 = prior_std
  if s0 <= 0.0 {
    s0 = 1.0
  }
  let rows = query("SELECT reward, trial_date FROM trial WHERE arm_id = ? AND status = 'completed' AND (moment_present = 1 OR next_day_present = 1 OR action_present = 1)", [arm_id])
  let today = today_unix()
  let mut wsum = 0.0
  let mut xsum = 0.0
  each r in rows {
    let mut age = date_diff_days(today, date_parse_iso(r.trial_date))
    if age < 0.0 {
      age = 0.0
    }
    let w = decay_weight(age)
    wsum = wsum + w
    xsum = xsum + w * r.reward
  }
  let inv0 = 1.0 / (s0 * s0)
  let invr = 1.0 / (reward_obs_std * reward_obs_std)
  let precision = inv0 + wsum * invr
  let mean = (prior_mean * inv0 + xsum * invr) / precision
  let sd = 1.0 / sqrt(precision)
  return [mean, sd, wsum]
}

// Н3-01: the candidate set of every decision. An ACTIVE hand with a
// protocol that requires consent is a candidate only while the consent
// row of its safety class exists (scope 'class:<X>', not revoked) —
// forced exploration draws from THIS list too, so a class-C practice is
// never assigned without the record (invariant 5 floor untouched: the 20%
// is spread over the eligible hands).
pattern eligible_arms() -> List {
  return query("SELECT a.id AS id, a.name AS name, a.prior_mean AS prior_mean, a.prior_std AS prior_std FROM arm a LEFT JOIN practice_protocol p ON p.arm_id = a.id WHERE a.active = 1 AND (p.arm_id IS NULL OR p.requires_consent = 0 OR EXISTS (SELECT 1 FROM consent c WHERE c.scope = 'class:' || p.safety_class AND c.revoked = 0)) ORDER BY a.id", [])
}

pattern bandit_pick(seed: Float) -> Struct {
  let arms = eligible_arms()
  let k = len(arms)
  if k == 0.0 {
    return {arm_id: 0.0, mode: "empty", theta: 0.0}
  }
  let rows = query("SELECT count(*) AS n FROM trial WHERE arm_id IS NOT NULL", [])
  let n = rows[0].n
  if to_int(n / explore_every) * explore_every == n {
    let step = to_int(n / explore_every)
    let kk = to_int(k)
    let idx = step - kk * to_int(step / kk)
    let arm = arms[idx]
    return {arm_id: arm.id, mode: "explore", theta: 0.0}
  }
  random_seed(seed)
  let mut i = 0.0
  let mut best_id = 0.0
  let mut best_theta = 0.0
  let mut first = true
  while i < k {
    let arm = arms[i]
    let post = arm_posterior(arm.id, arm.prior_mean, arm.prior_std)
    let theta = post[0] + post[1] * normal_sample(0.0, 1.0)
    if first == true {
      best_id = arm.id
      best_theta = theta
      first = false
    }
    if theta > best_theta {
      best_id = arm.id
      best_theta = theta
    }
    i = i + 1.0
  }
  return {arm_id: best_id, mode: "thompson", theta: best_theta}
}

pattern bandit_propose(trial_date: String, seed: Float) -> Float {
  // Н2-08 day guard: a proposal is one per calendar day — a repeated
  // tick re-shows the existing trial instead of a second decision.
  let existing = query("SELECT id FROM trial WHERE trial_date = ? AND arm_id IS NOT NULL ORDER BY id LIMIT 1", [trial_date])
  if len(existing) > 0.0 {
    return existing[0].id
  }
  let pick = bandit_pick(seed)
  if pick.arm_id == 0.0 {
    return 0.0
  }
  let arm = query("SELECT id, day_window FROM arm WHERE id = ?", [pick.arm_id])
  if len(arm) == 0.0 {
    return 0.0
  }
  // Н2-12: the proposal carries the ACTIVE note's id — the «Нота:»
  // line stops being permanently empty (the trial joins note by id in
  // morning_proposal_row). No note row — the key stays absent (SQL
  // NULL default), never a fabricated 0 (the FK-target row does not
  // exist); two branches instead of a nullable field in one struct
  // (the language has no nullable struct fields).
  let note = query("SELECT id FROM note WHERE active = 1 ORDER BY id DESC LIMIT 1", [])
  if len(note) > 0.0 {
    let row = {trial_date: trial_date, day_window: arm[0].day_window, arm_id: pick.arm_id, note_id: note[0].id}
    return db_insert("trial", row)
  }
  let row = {trial_date: trial_date, day_window: arm[0].day_window, arm_id: pick.arm_id}
  return db_insert("trial", row)
}





// ── Н3-06: slot rotation (ADR-0003, принят 2026-10-24: 25 / 0,10 / 0,90 / 14 / 90)
//
// Once a day, in the morning tick BEFORE the proposal. Per slot:
//   - the slot is evaluated only while it is FULLY staffed (active ==
//     max_active — the owner's chosen set is in place; an incomplete slot
//     means the owner has not chosen yet, nothing is changed silently) and,
//     for `methods`, the Н3-05 armed cap (the owner's confirm event);
//   - the 14-day window is open (no rotate-off of this slot in the last
//     14 days — at most ONE replacement per slot per 14 days);
//   - for every ACTIVE hand with >= 25 completed trials (at least one
//     present reward component, same filter as the posterior): the
//     probability that its mean is BELOW the best hand of the slot by
//     >= 0.10, over the Normal posterior estimates (the difference of two
//     independent posteriors is Normal with the combined variance);
//   - the WEAKEST such hand (the largest probability) is retired ONLY if
//     a replacement candidate exists — the slot is never emptied;
//   - the candidate: the next catalog hand of the slot by prior_mean DESC,
//     then id ASC, admitted by its safety class consent, and NOT in the
//     90-day rotation cooldown (a hand retired by the rotation returns as
//     a candidate not earlier than 90 days).
// Every decision (retire + admit) is journaled with the numbers of the
// criterion (actor 'rotation'); the owner can undo manually at any time
// (deactivate/activate — the manual path writes its own journal rows).
// Forced exploration is untouched: the rotation only moves the active
// flags; the exploration floor draws over the active set as before.
// The thresholds 14/90 live in the SQL literals below (datetime('now',
// '-N days')), consistent with the journal created_at format; the
// mutation checks flip those literals.
entity rotation_obs_min: Float = 25.0
entity rotation_gap: Float = 0.10
entity rotation_prob: Float = 0.90

// Normal CDF via the Abramowitz–Stegun 7.1.26 erf approximation
// (|error| < 1.5e-7 — far below the 0.90 decision threshold).
pattern normal_cdf(x: Float) -> Float {
  if x < 0.0 {
    return 1.0 - normal_cdf(0.0 - x)
  }
  let z = x / 1.4142135623730951
  let t = 1.0 / (1.0 + 0.3275911 * z)
  let poly = ((((1.061405429 * t + (0.0 - 1.453152027)) * t + 1.421413741) * t + (0.0 - 0.284496736)) * t + 0.254829592) * t
  let y = 1.0 - poly * exp(0.0 - z * z)
  return 0.5 * (1.0 + y)
}

// P(mu_best - mu_i >= rotation_gap) for two independent Gaussian
// posteriors: the difference is Normal(mean_best - mean_i, combined sd).
pattern rotation_gap_prob(mean_i: Float, sd_i: Float, mean_best: Float, sd_best: Float) -> Float {
  let delta = mean_best - mean_i
  let sd = sqrt(sd_i * sd_i + sd_best * sd_best)
  if sd <= 0.0 {
    if delta >= rotation_gap {
      return 1.0
    }
    return 0.0
  }
  return normal_cdf((delta - rotation_gap) / sd)
}

// Completed trials with at least one present reward component — the SAME
// observation filter as the posterior (ADR-0003 point 1).
pattern rotation_obs_count(arm_id: Float) -> Float {
  let rows = query("SELECT count(*) AS n FROM trial WHERE arm_id = ? AND status = 'completed' AND (moment_present = 1 OR next_day_present = 1 OR action_present = 1)", [arm_id])
  return rows[0].n
}

// The slot is ready for rotation: fully staffed (the owner's chosen set
// is in place) and — for `methods` — the Н3-05 armed cap (the owner's
// confirm event exists in the journal).
pattern rotation_slot_ready(slot_name: String) -> Bool {
  let cap_rows = query("SELECT max_active AS cap FROM slot WHERE name = ?", [slot_name])
  if len(cap_rows) == 0.0 {
    return false
  }
  let cap = to_float(cap_rows[0].cap)
  let act_rows = query("SELECT count(*) AS n FROM arm a JOIN practice_protocol p ON p.arm_id = a.id WHERE p.slot = ? AND a.active = 1", [slot_name])
  if act_rows[0].n < cap {
    return false
  }
  if slot_name == "methods" {
    let armed = query("SELECT count(*) AS n FROM arm_journal WHERE action = 'methods-cap-armed'", [])
    if armed[0].n == 0.0 {
      return false
    }
  }
  return true
}

// The 14-day window: no rotate-off of this slot in the last 14 days.
pattern rotation_window_open(slot_name: String) -> Bool {
  let rows = query("SELECT count(*) AS n FROM arm_journal j JOIN practice_protocol p ON p.arm_id = j.arm_id WHERE p.slot = ? AND j.action = 'rotate-off' AND j.created_at >= datetime('now', '-14 days')", [slot_name])
  return rows[0].n == 0.0
}

// The next catalog hand of the slot: prior_mean DESC, then id ASC; not
// active; admitted by its safety class (the same consent filter as the
// bandit candidates); not in the 90-day rotation cooldown. Returns the
// arm id, or 0 when no candidate is admissible.
pattern rotation_candidate(slot_name: String) -> Float {
  // Н4-07: the admission predicate rides the WHERE — a locked hand is
  // NOT a candidate (the rotation admits by system progress, the same
  // rule as activate_arm; the bandit canon is self-contained, so the
  // predicate is the declared twin of mm_admission_locked in
  // src/arms/arms.mlog — the same literals, both sides pinned by
  // tests). Level < 2 is always open; no rule for (system, level) is
  // open (the checkUnlock.ts semantics); admission = sessions AND
  // minutes of the system's completed trials (minutes = the practice
  // duration, arm.duration_min).
  let rows = query("SELECT a.id AS id FROM arm a JOIN practice_protocol p ON p.arm_id = a.id LEFT JOIN practice_profile pp ON pp.arm_id = a.id WHERE p.slot = ? AND a.active = 0 AND (p.requires_consent = 0 OR EXISTS (SELECT 1 FROM consent c WHERE c.scope = 'class:' || p.safety_class AND c.revoked = 0)) AND NOT EXISTS (SELECT 1 FROM arm_journal j WHERE j.action = 'rotate-off' AND j.arm_id = a.id AND j.created_at >= datetime('now', '-90 days')) AND (pp.arm_id IS NULL OR pp.level < 2 OR NOT EXISTS (SELECT 1 FROM practice_admission pa WHERE pa.system = pp.system AND pa.level = pp.level) OR ((SELECT count(*) FROM trial t JOIN arm a2 ON a2.id = t.arm_id JOIN practice_profile pp2 ON pp2.arm_id = a2.id WHERE pp2.system = pp.system AND t.status = 'completed') >= (SELECT pa1.min_sessions FROM practice_admission pa1 WHERE pa1.system = pp.system AND pa1.level = pp.level) AND (SELECT coalesce(sum(a3.duration_min), 0) FROM trial t3 JOIN arm a3 ON a3.id = t3.arm_id JOIN practice_profile pp3 ON pp3.arm_id = a3.id WHERE pp3.system = pp.system AND t3.status = 'completed') >= (SELECT pa2.min_minutes FROM practice_admission pa2 WHERE pa2.system = pp.system AND pa2.level = pp.level))) ORDER BY a.prior_mean DESC, a.id ASC LIMIT 1", [slot_name])
  if len(rows) == 0.0 {
    return 0.0
  }
  return rows[0].id
}

// The rotation itself: at most ONE replacement per slot per run (the
// weakest hand only), the windows and cooldowns enforced, every decision
// journaled with the numbers. Returns the number of replacements made.
pattern rotate_slots() -> Float {
  let slots = query("SELECT DISTINCT p.slot AS slot FROM practice_protocol p WHERE p.slot != '' ORDER BY p.slot", [])
  let mut replaced = 0.0
  each s in slots {
    let slot_name = s.slot
    let ready = rotation_slot_ready(slot_name)
    let window = rotation_window_open(slot_name)
    if ready == true and window == true {
      let act = query("SELECT a.id AS id, a.prior_mean AS pm, a.prior_std AS ps FROM arm a JOIN practice_protocol p ON p.arm_id = a.id WHERE p.slot = ? AND a.active = 1 ORDER BY a.id", [slot_name])
      let mut best_mean = 0.0 - 1.0
      let mut best_sd = 1.0
      each a in act {
        let post = arm_posterior(a.id, a.pm, a.ps)
        if post[0] > best_mean {
          best_mean = post[0]
          best_sd = post[1]
        }
      }
      let mut worst_id = 0.0
      let mut worst_prob = 0.0
      let mut worst_mean = 0.0
      let mut worst_sd = 0.0
      let mut worst_n = 0.0
      each a2 in act {
        let n = rotation_obs_count(a2.id)
        if n >= rotation_obs_min {
          let post2 = arm_posterior(a2.id, a2.pm, a2.ps)
          let prob = rotation_gap_prob(post2[0], post2[1], best_mean, best_sd)
          if prob >= rotation_prob and prob > worst_prob {
            worst_id = a2.id
            worst_prob = prob
            worst_mean = post2[0]
            worst_sd = post2[1]
            worst_n = n
          }
        }
      }
      if worst_id > 0.0 {
        // a replacement happens ONLY with an admissible candidate —
        // the slot is never emptied
        let cand = rotation_candidate(slot_name)
        if cand > 0.0 {
          let detail = "n=" + to_string(worst_n) + " mean=" + to_string(worst_mean) + " sd=" + to_string(worst_sd) + " best_mean=" + to_string(best_mean) + " best_sd=" + to_string(best_sd) + " gap=" + to_string(rotation_gap) + " prob=" + to_string(worst_prob)
          let _ = db_execute("UPDATE arm SET active = 0 WHERE id = ?", [worst_id])
          let _ = db_execute("INSERT INTO arm_journal (actor, arm_id, action) VALUES ('rotation', ?, 'arm-off')", [worst_id])
          let _ = db_execute("INSERT INTO arm_journal (actor, arm_id, action, detail) VALUES ('rotation', ?, 'rotate-off', ?)", [worst_id, detail])
          let cand_row = query("SELECT prior_mean AS pm FROM arm WHERE id = ?", [cand])
          let _ = db_execute("UPDATE arm SET active = 1 WHERE id = ?", [cand])
          let _ = db_execute("INSERT INTO arm_journal (actor, arm_id, action) VALUES ('rotation', ?, 'arm-on')", [cand])
          let _ = db_execute("INSERT INTO arm_journal (actor, arm_id, action, detail) VALUES ('rotation', ?, 'rotate-on', ?)", [cand, "prior_mean=" + to_string(cand_row[0].pm)])
          replaced = replaced + 1.0
        }
      }
    }
  }
  return replaced
}

// ── APP-MIRROR-END: bandit-core
// ── APP-MIRROR-START: arms-seed (byte-identical to
//    src/arms/arms.mlog §arms-seed) ─────────────────────────────────────

entity kamerton_arms: List = [
  {name: "breath-resonance-morning", group_name: "Резонансное дыхание", day_window: "morning", duration_min: 10.0, prior_mean: 0.6, prior_std: 0.15, source: "Lehrer & Gevirtz 2014 (Front Psychol 5:753): resonance-frequency HRV biofeedback, robust baroreflex effects"},
  {name: "breath-resonance-evening", group_name: "Резонансное дыхание", day_window: "evening", duration_min: 10.0, prior_mean: 0.6, prior_std: 0.15, source: "Lehrer & Gevirtz 2014 (Front Psychol 5:753): resonance-frequency HRV biofeedback, robust baroreflex effects"},
  {name: "woop-morning", group_name: "Имплементационные намерения", day_window: "morning", duration_min: 10.0, prior_mean: 0.6, prior_std: 0.15, source: "Gollwitzer & Sheeran 2006 (Adv Exp Soc Psychol 38): meta-analysis of 94 studies, d ~ 0.65"},
  {name: "woop-evening", group_name: "Имплементационные намерения", day_window: "evening", duration_min: 10.0, prior_mean: 0.6, prior_std: 0.15, source: "Gollwitzer & Sheeran 2006 (Adv Exp Soc Psychol 38): meta-analysis of 94 studies, d ~ 0.65"},
  {name: "mental-rehearsal-morning", group_name: "Ментальная репетиция", day_window: "morning", duration_min: 10.0, prior_mean: 0.5, prior_std: 0.15, source: "Driskell, Copper & Moran 1994 (J Appl Psychol 79(4)): mental practice meta-analysis, moderate effect, decays without physical practice"},
  {name: "mental-rehearsal-evening", group_name: "Ментальная репетиция", day_window: "evening", duration_min: 10.0, prior_mean: 0.5, prior_std: 0.15, source: "Driskell, Copper & Moran 1994 (J Appl Psychol 79(4)): mental practice meta-analysis, moderate effect, decays without physical practice"},
  {name: "focusing-morning", group_name: "Фокусинг", day_window: "morning", duration_min: 10.0, prior_mean: 0.45, prior_std: 0.2, source: "Hendricks 2002 (The Focusing-oriented client): experiential review, small-N studies, mixed quality — wide prior"},
  {name: "focusing-evening", group_name: "Фокусинг", day_window: "evening", duration_min: 10.0, prior_mean: 0.45, prior_std: 0.2, source: "Hendricks 2002 (The Focusing-oriented client): experiential review, small-N studies, mixed quality — wide prior"},
  {name: "yoga-nidra-morning", group_name: "Йога-нидра", day_window: "morning", duration_min: 10.0, prior_mean: 0.45, prior_std: 0.2, source: "Moszeik, von Oertzen & Günther 2022 (Current Psychology): Yoga Nidra effects on stress, sleep, well-being — moderate, wide prior"},
  {name: "yoga-nidra-evening", group_name: "Йога-нидра", day_window: "evening", duration_min: 10.0, prior_mean: 0.45, prior_std: 0.2, source: "Moszeik, von Oertzen & Günther 2022 (Current Psychology): Yoga Nidra effects on stress, sleep, well-being — moderate, wide prior"}
]

// Seed the arm library. Idempotent by construction: a UNIQUE index on
// name plus INSERT OR IGNORE — a repeated run changes nothing.
//
// WHY UNROLLED STATEMENTS (§2, declared loudly): the mlog D2 defect
// (declared in Kamerton issue #24; verified on v0.28.1 AND v0.28.2 by
// mutation probes) mis-executes loops whose body is a bare call — one
// iteration, and in a test body the tail after such a loop is silently
// cut (vacuously green). Assignment-body loops are full, but the
// trigger surface is not fully mapped (the probeprint case differs
// from the db_execute case), so the discipline here is: NO loops in
// test bodies at all until the language naryads land (Metalogos-
// №597/№598 → v0.28.3). A loop-driven seed would silently insert only
// the first arm, so the seed is unrolled into sequential statements
// and pinned to the kamerton_arms entity list by the per-arm VALUES
// LEFT JOIN verification test (loop-free); the JSON mirror is pinned
// to the same list. Divergence of any copy is a loud test failure.

pattern seed_arms() -> Float {
  db_execute("CREATE UNIQUE INDEX IF NOT EXISTS idx_arm_name_unique ON arm(name)")
  db_execute("INSERT OR IGNORE INTO arm (name, group_name, day_window, duration_min, prior_mean, prior_std) VALUES ('breath-resonance-morning', 'Резонансное дыхание', 'morning', 10, 0.6, 0.15)")
  db_execute("INSERT OR IGNORE INTO arm (name, group_name, day_window, duration_min, prior_mean, prior_std) VALUES ('breath-resonance-evening', 'Резонансное дыхание', 'evening', 10, 0.6, 0.15)")
  db_execute("INSERT OR IGNORE INTO arm (name, group_name, day_window, duration_min, prior_mean, prior_std) VALUES ('woop-morning', 'Имплементационные намерения', 'morning', 10, 0.6, 0.15)")
  db_execute("INSERT OR IGNORE INTO arm (name, group_name, day_window, duration_min, prior_mean, prior_std) VALUES ('woop-evening', 'Имплементационные намерения', 'evening', 10, 0.6, 0.15)")
  db_execute("INSERT OR IGNORE INTO arm (name, group_name, day_window, duration_min, prior_mean, prior_std) VALUES ('mental-rehearsal-morning', 'Ментальная репетиция', 'morning', 10, 0.5, 0.15)")
  db_execute("INSERT OR IGNORE INTO arm (name, group_name, day_window, duration_min, prior_mean, prior_std) VALUES ('mental-rehearsal-evening', 'Ментальная репетиция', 'evening', 10, 0.5, 0.15)")
  db_execute("INSERT OR IGNORE INTO arm (name, group_name, day_window, duration_min, prior_mean, prior_std) VALUES ('focusing-morning', 'Фокусинг', 'morning', 10, 0.45, 0.2)")
  db_execute("INSERT OR IGNORE INTO arm (name, group_name, day_window, duration_min, prior_mean, prior_std) VALUES ('focusing-evening', 'Фокусинг', 'evening', 10, 0.45, 0.2)")
  db_execute("INSERT OR IGNORE INTO arm (name, group_name, day_window, duration_min, prior_mean, prior_std) VALUES ('yoga-nidra-morning', 'Йога-нидра', 'morning', 10, 0.45, 0.2)")
  db_execute("INSERT OR IGNORE INTO arm (name, group_name, day_window, duration_min, prior_mean, prior_std) VALUES ('yoga-nidra-evening', 'Йога-нидра', 'evening', 10, 0.45, 0.2)")
  // Н2-09: the practice DELIVERY — the proposal must tell what to do,
  // not just name the hand (the M1-window gap: the trial asked for a
  // prediction with no practice content anywhere). One 10-minute
  // instruction per methodology group, grounded in the SAME literature
  // sources as the arms above; the proposal joins this table by
  // arm.group_name. Idempotent like the arm seed: UNIQUE(group_name)
  // plus INSERT OR IGNORE. Loop-free by the D2 discipline (unrolled,
  // like the arm seed above). The bodies carry no quote characters —
  // the SQL literals stay plain; a missing or empty row degrades LOUD
  // in the proposal (the NULLIF fallback, see morning_proposal_row).
  db_execute("CREATE TABLE IF NOT EXISTS practice_text (id INTEGER PRIMARY KEY AUTOINCREMENT, group_name TEXT, body TEXT, active INTEGER DEFAULT '1', created_at TEXT DEFAULT (datetime('now')))")
  db_execute("CREATE UNIQUE INDEX IF NOT EXISTS idx_practice_text_group_unique ON practice_text(group_name)")
  db_execute("INSERT OR IGNORE INTO practice_text (group_name, body) VALUES ('Резонансное дыхание', 'Сядь ровно, таймер на 10 минут. Дыши через нос, медленно и ровно: вдох около 5 секунд, выдох около 5 секунд — примерно 5–6 циклов в минуту, без усилия. Живот мягко уходит вперёд на вдохе. Держи ровный ритм: сбился — спокойно возвращайся к счёту. Это резонансная зона 4.5–6.5 вдохов в минуту, на ней дыхание и сердечный ритм входят в синхрон (Lehrer и Gevirtz, 2014).')")
  db_execute("INSERT OR IGNORE INTO practice_text (group_name, body) VALUES ('Имплементационные намерения', 'Бумага и ручка, 10 минут по четырём шагам. W — желание: запиши важное и реальное желание на ближайшие дни. O — исход: 2–3 минуты живо представляй лучший результат его достижения. O — препятствие: честно назови внутреннее, что чаще всего мешает. P — план: собери формулу «если у меня …, то я …», подставь своё препятствие и своё действие, повтори про себя 2–3 раза (Оэттинген; Голвитцер и Ширан, 2006).')")
  db_execute("INSERT OR IGNORE INTO practice_text (group_name, body) VALUES ('Ментальная репетиция', 'Выбери конкретный навык или предстоящее действие: выступление, разговор, движение. Первые 1–2 минуты — вживись в обстановку: где, что вокруг, кто рядом. Затем проиграй действие от начала до конца изнутри, своими глазами, в реальном темпе. Трудное место пройди отдельно 2–3 раза в исправленном варианте. Финал — одна уверенная полная прогонка без остановок. Репетиция дополняет физическую практику, а не заменяет её (Driskell, Copper и Moran, 1994).')")
  db_execute("INSERT OR IGNORE INTO practice_text (group_name, body) VALUES ('Фокусинг', 'Сядь удобно, 10 минут. Минута: пройди вниманием по телу — где сейчас самое заметное ощущение. 2–3 минуты: не меняй его, просто признай — здравствуй, я тебя вижу. Спроси внутри: о чём это? Не отвечай умом — жди телесного отклика, каким бы медленным он ни был. Всё, что придёт, признай без спора. Закончи вопросом: чего тебе нужно? — и спокойно выходи. Здесь ничего не надо добиваться: важно только присутствие внимания (Gendlin; Hendricks, 2002).')")
  db_execute("INSERT OR IGNORE INTO practice_text (group_name, body) VALUES ('Йога-нидра', 'Ляг на спину, руки чуть в стороны, глаза закрыты — держи лёгкую бодрость, не засыпай. Короткое намерение в настоящем времени, своими словами. Затем медленно пройди вниманием по телу: правая рука, левая рука, ноги, туловище, лицо. Дальше пары ощущений: тяжесть — лёгкость, тепло — прохлада. Потом просто наблюдай дыхание, не считая. В конце повтори намерение и сделай 2–3 глубоких вдоха, вставай медленно. Сжатая форма на 10 минут (Moszeik и соавт., 2022).')")
  // Н2-12: the note-goal — ONE row, the owner's formulation VERBATIM
  // from the concept (docs/concept-v2.md, «Нота и принцип»); the fixed
  // id keeps the seed idempotent (INSERT OR IGNORE) across re-runs and
  // the formulation is the OWNER's text, not the executor's invention
  // (the naryad Шаг 0 defers the wording to the owner — the concept's
  // own sentence IS the owner's wording). bandit_propose joins the
  // trial to the ACTIVE note (the latest active row), so a future
  // re-wording is a data edit, never a code change.
  db_execute("CREATE TABLE IF NOT EXISTS note (id INTEGER PRIMARY KEY AUTOINCREMENT, body TEXT, active INTEGER DEFAULT '1', created_at TEXT DEFAULT (datetime('now')))")
  db_execute("INSERT OR IGNORE INTO note (id, body, active) VALUES (1, 'Между тем, чего я хочу, и тем, что я делаю, нет зазора — и это видно по результату.', 1)")
  let rows = query("SELECT count(*) AS n FROM arm", [])
  return rows[0].n
}

// ── Н3-01: the practice CATALOG as data ─────────────────────────────────
// A practice is a ROW (arm + practice_protocol + practice_text), never
// code: a ninth practice is one more record — in this list for the seed,
// or one INSERT through a plain sqlite3 client (invariant 6). The engine
// reads the steps, it does not know the practices.
//
// Protocol format: steps = [{phase, sec, intensity 0..1, cue}] with the
// phases inhale | hold | exhale | pause (the hold after an exhale) |
// forced_exhale; series = {reps, rest_sec} — one SERIES is `reps` passes
// over the steps followed by `rest_sec` of ordinary breathing (reps 1,
// rest 0 = a plain endless cycle). The number of cycles is DERIVED from
// session_min (protocol_cycles) and never stored: the AERIS durations
// disagree with "steps x cycles" (4-7-8: 4 cycles x 19 s = 76 s against a
// declared 5 min), so a stored cycle count would lie.
//
// Safety classes (owner consent per class lives in the consent table):
//   A — no holds, no pauses, no forced breathing;
//   B — holds/pauses up to 8 s (max_hold_sec is the declared ceiling the
//       session engine may only SHORTEN);
//   C — long holds or pauses (> 8 s), forced breathing. requires_consent = 1:
//       never assigned — forced exploration included — until the consent
//       row of the class exists.
// The class follows the DATA, not the label: AERIS lists nadi shodhana and
// sitali as "no holds", yet both carry 4-5 s holds, so they are class B.
// Initial priors are WIDE (0.45 +- 0.20): only slow breathing in general
// has a verified review, no technique here has its own source.
entity kamerton_protocols: List = [
  {name: "breath-diaphragmatic", group_name: "Дыхание: диафрагмальное", slot: "breath", day_window: "morning", safety_class: "A", requires_consent: 0.0, max_hold_sec: 0.0, session_min: 5.0, prior_mean: 0.45, prior_std: 0.2,
   source: "Zaccaro et al. 2018 (Front Hum Neurosci 12:353, doi:10.3389/fnhum.2018.00353): систематический обзор медленного дыхания (<=10 вдохов/мин) в целом; конкретная техника в обзоре не оценивалась — широкий приор",
   contraindications: "",
   instruction: "Сядь или ляг удобно, одна рука на животе. Вдох носом 5 секунд — живот поднимается под рукой, грудь почти неподвижна. Выдох 5 секунд — живот мягко опускается. Без усилия, ровно. Сбился — просто вернись к счёту. Около 6 циклов в минуту.",
   series: {reps: 1.0, rest_sec: 0.0},
   steps: [
     {phase: "inhale", sec: 5.0, intensity: 0.3, cue: "вдох носом, живот расширяется"},
     {phase: "exhale", sec: 5.0, intensity: 0.3, cue: "выдох, живот втягивается"}
   ]},
  {name: "breath-four-seven-eight", group_name: "Дыхание: 4-7-8", slot: "breath", day_window: "morning", safety_class: "B", requires_consent: 0.0, max_hold_sec: 7.0, session_min: 5.0, prior_mean: 0.45, prior_std: 0.2,
   source: "нет источника: широкий приор",
   contraindications: "",
   instruction: "Кончик языка за верхними зубами. Вдох носом на 4, задержка на 7, выдох через рот со звуком на 8. Если задержка в 7 секунд трудна — укороти пропорционально, но сохрани соотношение 4:7:8. Остановись сразу при головокружении.",
   series: {reps: 1.0, rest_sec: 0.0},
   steps: [
     {phase: "inhale", sec: 4.0, intensity: 0.5, cue: "вдох носом"},
     {phase: "hold", sec: 7.0, intensity: 0.2, cue: "задержка"},
     {phase: "exhale", sec: 8.0, intensity: 0.7, cue: "выдох ртом со звуком"}
   ]},
  {name: "breath-box", group_name: "Дыхание: квадратное дыхание", slot: "breath", day_window: "morning", safety_class: "B", requires_consent: 0.0, max_hold_sec: 4.0, session_min: 5.0, prior_mean: 0.45, prior_std: 0.2,
   source: "нет источника: широкий приор",
   contraindications: "",
   instruction: "Четыре равные стороны квадрата: вдох 4, задержка 4, выдох 4, пауза 4. Дыши носом, плечи расслаблены. Если задержки трудны — укороти все стороны поровну.",
   series: {reps: 1.0, rest_sec: 0.0},
   steps: [
     {phase: "inhale", sec: 4.0, intensity: 0.4, cue: "вдох"},
     {phase: "hold", sec: 4.0, intensity: 0.2, cue: "задержка"},
     {phase: "exhale", sec: 4.0, intensity: 0.4, cue: "выдох"},
     {phase: "pause", sec: 4.0, intensity: 0.1, cue: "пауза после выдоха"}
   ]},
  {name: "breath-alternate-nostril", group_name: "Дыхание: поочерёдное дыхание ноздрями (нади шодхана)", slot: "breath", day_window: "morning", safety_class: "B", requires_consent: 0.0, max_hold_sec: 4.0, session_min: 5.0, prior_mean: 0.45, prior_std: 0.2,
   source: "нет источника: широкий приор",
   contraindications: "",
   instruction: "Большим пальцем правой руки закрой правую ноздрю, вдох левой на 4. Закрой обе, задержка 4. Открой правую, выдох на 4, пауза 4. Вдох правой на 4, закрой обе, задержка 4, открой левую, выдох 4, пауза 4. Это один полный цикл.",
   series: {reps: 1.0, rest_sec: 0.0},
   steps: [
     {phase: "inhale", sec: 4.0, intensity: 0.3, cue: "вдох левой ноздрёй"},
     {phase: "hold", sec: 4.0, intensity: 0.2, cue: "задержка"},
     {phase: "exhale", sec: 4.0, intensity: 0.3, cue: "выдох правой ноздрёй"},
     {phase: "pause", sec: 4.0, intensity: 0.1, cue: "пауза"},
     {phase: "inhale", sec: 4.0, intensity: 0.3, cue: "вдох правой ноздрёй"},
     {phase: "hold", sec: 4.0, intensity: 0.2, cue: "задержка"},
     {phase: "exhale", sec: 4.0, intensity: 0.3, cue: "выдох левой ноздрёй"},
     {phase: "pause", sec: 4.0, intensity: 0.1, cue: "пауза"}
   ]},
  {name: "breath-sitali", group_name: "Дыхание: ситали (через свёрнутый язык)", slot: "breath", day_window: "morning", safety_class: "B", requires_consent: 0.0, max_hold_sec: 5.0, session_min: 5.0, prior_mean: 0.45, prior_std: 0.2,
   source: "нет источника: широкий приор",
   contraindications: "",
   instruction: "Сверни язык трубочкой и выступи им чуть за губы (если не получается — зубы сомкнуты, губы приоткрыты). Вдох через эту трубочку на 5, задержка на 5, выдох через нос на 5.",
   series: {reps: 1.0, rest_sec: 0.0},
   steps: [
     {phase: "inhale", sec: 5.0, intensity: 0.4, cue: "вдох через свёрнутый язык"},
     {phase: "hold", sec: 5.0, intensity: 0.2, cue: "задержка"},
     {phase: "exhale", sec: 5.0, intensity: 0.4, cue: "выдох через нос"}
   ]},
  {name: "breath-buteyko-basic", group_name: "Дыхание: Бутейко (базовое)", slot: "breath", day_window: "morning", safety_class: "C", requires_consent: 1.0, max_hold_sec: 10.0, session_min: 7.0, prior_mean: 0.45, prior_std: 0.2,
   source: "нет источника: широкий приор",
   contraindications: "",
   instruction: "Дыхание максимально лёгкое и малое, только носом. Вдох 3, выдох 4, затем пауза после выдоха на 10 секунд, затем снова вдох 3 и выдох 4. Пауза не должна быть борьбой: при сильном желании вдохнуть — вдохни сразу и вернись к лёгкому ритму.",
   series: {reps: 1.0, rest_sec: 0.0},
   steps: [
     {phase: "inhale", sec: 3.0, intensity: 0.2, cue: "лёгкий вдох носом"},
     {phase: "exhale", sec: 4.0, intensity: 0.2, cue: "лёгкий выдох"},
     {phase: "pause", sec: 10.0, intensity: 0.0, cue: "пауза после выдоха, нос зажат при необходимости"},
     {phase: "inhale", sec: 3.0, intensity: 0.2, cue: "лёгкий вдох носом"},
     {phase: "exhale", sec: 4.0, intensity: 0.2, cue: "лёгкий выдох"}
   ]},
  {name: "breath-kumbhaka-advanced", group_name: "Дыхание: кумбхака (продвинутая)", slot: "breath", day_window: "morning", safety_class: "C", requires_consent: 1.0, max_hold_sec: 15.0, session_min: 10.0, prior_mean: 0.45, prior_std: 0.2,
   source: "нет источника: широкий приор",
   contraindications: "",
   instruction: "Вдох на 5, задержка на 15, выдох на 8, пауза на 5. Только сидя. Задержка без напряжения лица и горла. При любом дискомфорте, головокружении или дрожи — прекрати задержку сразу и дыши свободно.",
   series: {reps: 1.0, rest_sec: 0.0},
   steps: [
     {phase: "inhale", sec: 5.0, intensity: 0.5, cue: "вдох носом"},
     {phase: "hold", sec: 15.0, intensity: 0.2, cue: "задержка на вдохе"},
     {phase: "exhale", sec: 8.0, intensity: 0.5, cue: "выдох"},
     {phase: "pause", sec: 5.0, intensity: 0.1, cue: "пауза после выдоха"}
   ]},
  {name: "breath-kapalabhati", group_name: "Дыхание: капалабхати", slot: "breath", day_window: "morning", safety_class: "C", requires_consent: 1.0, max_hold_sec: 0.0, session_min: 5.0, prior_mean: 0.45, prior_std: 0.2,
   source: "нет источника: широкий приор",
   contraindications: "",
   instruction: "Сидя, спина прямая. Резкий выдох носом за счёт сокращения живота, вдох происходит сам. Серия — 30 циклов, затем пауза 30 секунд обычного дыхания; всего три серии. При головокружении остановись и дыши спокойно.",
   series: {reps: 30.0, rest_sec: 30.0},
   steps: [
     {phase: "forced_exhale", sec: 1.0, intensity: 1.0, cue: "резкий выдох животом"},
     {phase: "inhale", sec: 1.0, intensity: 0.3, cue: "пассивный вдох"}
   ]},
  {name: "movement-six-keys", group_name: "Движение: 6 ключей", slot: "methods", day_window: "morning", safety_class: "B", requires_consent: 0.0, max_hold_sec: 5.0, session_min: 12.0, prior_mean: 0.45, prior_std: 0.2,
   source: "Традиционная гимнастика (цигун/тайцзи-подобная), движения и счёт из видео владельца. Эффекта на теломеры/теломеразу НЕ доказано; источник доказательств для самих движений нет — широкий приор",
   contraindications: "",
   instruction: "Встань, ноги на ширине плеч, колени мягкие; рядом стена или опора. 1) Руки вверх: вдох 5 секунд, поднимая руки ладонями вверх, задержка 5, выдох 5 с опусканием рук; 5 раз. 2) Равновесие: колено к животу, 30 секунд на каждой ноге, 3 подхода; качаешься — это нормально. 3) Простукивание: 3 минуты подушечками пальцев от центра груди к плечам и по рукам, в такт дыханию. 4) Скрутка: бёдра на месте, поворот корпуса, один цикл дыхания 5-5-5 в крайней точке, по 5 раз в каждую сторону. 5) Полуприсед: ладони внизу живота, вдох и задержка 5 секунд, на выдохе чуть согни колени, на вдохе вернись; 5 раз. 6) Ладони перед грудью: 3 цикла дыхания, лёгкое нажатие на выдохе. В конце минута свободного дыхания. Закружилась голова — выдохни и сядь; задержку можно убрать (дыши свободно). Это спокойная гимнастика, а не лечение.",
   series: {reps: 1.0, rest_sec: 0.0},
   steps: [
     {phase: "prep", sec: 30.0, intensity: 0.1, cue: "встань, ноги на ширине плеч, колени мягкие; рядом стена или опора"},
     {phase: "inhale", sec: 5.0, intensity: 0.3, cue: "ключ 1: вдох 5 секунд — руки вверх ладонями вверх"},
