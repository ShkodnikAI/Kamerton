// Seed the catalog. Idempotent: UNIQUE indexes + INSERT OR IGNORE. Every
// catalog arm starts INACTIVE (active = 0): the catalog is wider than the
// active set, and activate_arm() admits a hand into its slot (at most
// max_active per slot — the owner rule of 2026-10-23, 3 per slot).
// Consent rows record the owner's decision as DATA, one per class:
// chat 2026-10-23 ("Ты честно предупреждаешь, я честно даю добро") and
// chat 2026-10-24 (no contraindications declared) — Kamerton issue #75.
pattern seed_catalog() -> Float {
  let _ = db_execute("CREATE UNIQUE INDEX IF NOT EXISTS idx_arm_name_unique ON arm(name)", [])
  let _ = db_execute("CREATE UNIQUE INDEX IF NOT EXISTS idx_protocol_arm_unique ON practice_protocol(arm_id)", [])
  let _ = db_execute("CREATE UNIQUE INDEX IF NOT EXISTS idx_slot_name_unique ON slot(name)", [])
  let _ = db_execute("CREATE UNIQUE INDEX IF NOT EXISTS idx_consent_scope_unique ON consent(scope)", [])
  let _ = db_execute("CREATE TABLE IF NOT EXISTS practice_text (id INTEGER PRIMARY KEY AUTOINCREMENT, group_name TEXT, body TEXT, active INTEGER DEFAULT '1', created_at TEXT DEFAULT (datetime('now')))", [])
  let _ = db_execute("CREATE UNIQUE INDEX IF NOT EXISTS idx_practice_text_group_unique ON practice_text(group_name)", [])
  let _ = db_execute("INSERT OR IGNORE INTO slot (name, max_active) VALUES ('breath', 3)", [])
  // Н3-05: the `methods` slot row — the wave-1 methodologies get their
  // own slot with the same rule (the cap of 3, the owner's decision of
  // 2026-10-24). The row RECORDS the cap; the cap takes FORCE only
  // after the owner's confirmed choice (the journal event — see
  // arm_methods_cap_confirm): until then the slot stays uncapped and
  // no silent state change happens (the wave-1 hands stay active, as
  // seeded; nothing is deactivated behind the owner's back).
  let _ = db_execute("INSERT OR IGNORE INTO slot (name, max_active) VALUES ('methods', 3)", [])
  let _ = db_execute("INSERT OR IGNORE INTO consent (scope, source) VALUES ('class:A', 'владелец: чат 2026-10-23, issue #75 (согласие классов A, B, C); противопоказаний нет (чат 2026-10-24)')", [])
  let _ = db_execute("INSERT OR IGNORE INTO consent (scope, source) VALUES ('class:B', 'владелец: чат 2026-10-23, issue #75 (согласие классов A, B, C); противопоказаний нет (чат 2026-10-24)')", [])
  let _ = db_execute("INSERT OR IGNORE INTO consent (scope, source) VALUES ('class:C', 'владелец: чат 2026-10-23, issue #75 (согласие классов A, B, C); противопоказаний нет (чат 2026-10-24)')", [])
  each p in kamerton_protocols {
    let _ = db_execute("INSERT OR IGNORE INTO arm (name, group_name, day_window, duration_min, prior_mean, prior_std, active) VALUES (?, ?, ?, ?, ?, ?, 0)", [p.name, p.group_name, p.day_window, p.session_min, p.prior_mean, p.prior_std])
    let _ = db_execute("INSERT OR IGNORE INTO practice_text (group_name, body) VALUES (?, ?)", [p.group_name, p.instruction])
    let _ = db_execute("INSERT OR IGNORE INTO practice_protocol (arm_id, slot, safety_class, requires_consent, max_hold_sec, session_min, steps_json, series_json, contraindications, source) SELECT id, ?, ?, ?, ?, ?, ?, ?, ?, ? FROM arm WHERE name = ?", [p.slot, p.safety_class, p.requires_consent, p.max_hold_sec, p.session_min, json_encode(p.steps), json_encode(p.series), p.contraindications, p.source, p.name])
  }
  // Н3-05: the ten wave-1 methodologies join the `methods` slot as
  // DATA — one practice_protocol row per arm with EMPTY steps (these
  // are instruction methods, not breath phases: no steps, no series),
  // the seat's own literature source (the machine SSOT list above —
  // the arm table has no source column), safety class A (no holds, no
  // pauses, no forced breathing — nothing to consent beyond the
  // existing class:A row), session_min = the arm's own duration. The
  // arms stay ACTIVE (the wave-1 state is not silently changed). The
  // return value is the FULL protocol count in the store (breath +
  // methods) — the honest seed-completeness number, pinned by tests.
  each a in kamerton_arms {
    let _ = db_execute("INSERT OR IGNORE INTO practice_protocol (arm_id, slot, safety_class, requires_consent, max_hold_sec, session_min, steps_json, series_json, contraindications, source) SELECT id, 'methods', 'A', 0, 0, ?, ?, '', '', ? FROM arm WHERE name = ?", [a.duration_min, json_encode([]), a.source, a.name])
  }
  let rows = query("SELECT count(*) AS n FROM practice_protocol", [])
  return rows[0].n
}

// Seconds of ONE series unit (reps passes over the steps + the rest).
// Н3-05: an EMPTY series_json (the methods rows — instruction methods
// with no steps and no series) means one plain pass over the steps and
// no rest — no fabricated multiplication, never a parse error.
pattern protocol_unit_sec(arm_id: Float) -> Float {
  let rows = query("SELECT steps_json, series_json FROM practice_protocol WHERE arm_id = ?", [arm_id])
  if len(rows) == 0.0 {
    return 0.0
  }
  let steps = parse_json(rows[0].steps_json)
  let mut cycle = 0.0
  each s in steps {
    cycle = cycle + s.sec
  }
  if rows[0].series_json == "" {
    return cycle
  }
  let series = parse_json(rows[0].series_json)
  return series.reps * cycle + series.rest_sec
}

// The number of whole units that fit in session_min — DERIVED, never
// stored (0 for an unknown arm or an empty protocol).
pattern protocol_cycles(arm_id: Float) -> Float {
  let unit = protocol_unit_sec(arm_id)
  if unit <= 0.0 {
    return 0.0
  }
  let rows = query("SELECT session_min FROM practice_protocol WHERE arm_id = ?", [arm_id])
  return to_float(to_int(rows[0].session_min * 60.0 / unit))
}

// Admit a hand into the active set. A hand with a protocol belongs to a
// slot: the slot cap (max_active, default 3) refuses a fourth active
// hand LOUDLY ("slot-full") — nothing is changed. A hand without a
// protocol (possible only before the Н3-05 methods seed) is not
// slotted: no cap applies.
//
// Н3-05: the `methods` cap takes force ONLY after the owner's
// confirmed choice (arm_methods_cap_confirm — the journal event
// 'methods-cap-armed'); until then the slot stays uncapped (the owner
// explores the set). Every admission and every refusal is JOURNALED
// with its actor (who, when via created_at, what) — no silent state
// change.
//
// Н4-07 (правило владельца, Шаг 0 наряда #99, утверждено 2026-11-02):
// уровни MIND-MASTERY 1–5 — условие входа практики в активный набор ПО
// ЧИСЛУ ЗАВЕРШЁННЫХ СЕССИЙ И МИНУТ СИСТЕМЫ, а не ручной разблокировкой.
// Запертая рука НЕ активируется и вручную: громкий отказ "locked" +
// строка журнала, состояние не меняется. Руки без practice_profile
// (AERIS breath/methods волны 1) допуску не подчиняются.
// Returns "ok" | "unknown-arm" | "slot-full" | "locked".
pattern activate_arm(arm_id: Float, actor: String) -> String {
  let arm = query("SELECT id FROM arm WHERE id = ?", [arm_id])
  if len(arm) == 0.0 {
    return "unknown-arm"
  }
  // Н4-07: the admission gate BEFORE everything else — a locked hand
  // never enters the active set by hand (the rule of the owner: by
  // system progress, not by manual unlocking). Loud refusal + journal
  // row, nothing changed.
  if mm_admission_ok(arm_id) == false {
    let _ = db_execute("INSERT INTO arm_journal (actor, arm_id, action, detail) VALUES (?, ?, 'arm-on-refused', 'admission-locked')", [actor, arm_id])
    return "locked"
  }
  let prot = query("SELECT slot FROM practice_protocol WHERE arm_id = ?", [arm_id])
  if len(prot) > 0.0 {
    let cap_rows = query("SELECT max_active FROM slot WHERE name = ?", [prot[0].slot])
    let mut cap = 3.0
    if len(cap_rows) > 0.0 {
      cap = to_float(cap_rows[0].max_active)
    }
    let mut enforce = true
    if prot[0].slot == "methods" {
      let armed = query("SELECT count(*) AS n FROM arm_journal WHERE action = 'methods-cap-armed'", [])
      if armed[0].n == 0.0 {
        enforce = false
      }
    }
    let used = query("SELECT count(*) AS n FROM arm a JOIN practice_protocol p ON p.arm_id = a.id WHERE p.slot = ? AND a.active = 1 AND a.id != ?", [prot[0].slot, arm_id])
    if enforce == true and used[0].n >= cap {
      let _ = db_execute("INSERT INTO arm_journal (actor, arm_id, action, detail) VALUES (?, ?, 'arm-on-refused', 'slot-full')", [actor, arm_id])
      return "slot-full"
    }
  }
  let _ = db_execute("UPDATE arm SET active = 1 WHERE id = ?", [arm_id])
  let _ = db_execute("INSERT INTO arm_journal (actor, arm_id, action) VALUES (?, ?, 'arm-on')", [actor, arm_id])
  return "ok"
}

// Retire a hand from the active set — always allowed (the cap limits
// admissions, not retirements), journaled with its actor.
pattern deactivate_arm(arm_id: Float, actor: String) -> Float {
  let _ = db_execute("UPDATE arm SET active = 0 WHERE id = ?", [arm_id])
  let _ = db_execute("INSERT INTO arm_journal (actor, arm_id, action) VALUES (?, ?, 'arm-off')", [actor, arm_id])
  return 1.0
}

// ── Н4-07: допуск практики — условие входа в активный набор ──────────
// Правило владельца (наряд #99, Шаг 0, утверждено 2026-11-02): уровни
// MIND-MASTERY 1–5 открываются ПО ЧИСЛУ ЗАВЕРШЁННЫХ СЕССИЙ И МИНУТ
// СИСТЕМЫ, а не ручной разблокировкой. Единица допуска — trial (юнит
// системы): status = 'completed' у рук этой системы; минуты сессии —
// длительность практики (arm.duration_min, как в MIND-MASTERY).
// Семантика источника (checkUnlock.ts @ 2a26e75): уровень 1 всегда
// открыт; нет правила для (system, level) — открыто ("No rule for this
// level means it's unlocked"); допуск = И сессии И минуты. Руки без
// practice_profile (AERIS breath/methods волны 1) допуску не
// подчиняются — их путь не меняется. Предикат живёт и в
// rotation_candidate (src/bandit/bandit.mlog) теми же SQL-литералами —
// двойная запись ЗАЯВЛЕНА (bandit-канон самодостаточен), обе стороны
// пинятся тестами (arms: mm_admission_ok; bandit: пропуск запертого
// кандидата ротацией).
pattern mm_admission_locked(arm_id: Float) -> Float {
  let rows = query("SELECT count(*) AS n FROM arm a JOIN practice_profile pp ON pp.arm_id = a.id WHERE a.id = ? AND pp.level >= 2 AND EXISTS (SELECT 1 FROM practice_admission pa WHERE pa.system = pp.system AND pa.level = pp.level) AND ((SELECT count(*) FROM trial t JOIN arm a2 ON a2.id = t.arm_id JOIN practice_profile pp2 ON pp2.arm_id = a2.id WHERE pp2.system = pp.system AND t.status = 'completed') < (SELECT pa1.min_sessions FROM practice_admission pa1 WHERE pa1.system = pp.system AND pa1.level = pp.level) OR (SELECT coalesce(sum(a3.duration_min), 0) FROM trial t3 JOIN arm a3 ON a3.id = t3.arm_id JOIN practice_profile pp3 ON pp3.arm_id = a3.id WHERE pp3.system = pp.system AND t3.status = 'completed') < (SELECT pa2.min_minutes FROM practice_admission pa2 WHERE pa2.system = pp.system AND pa2.level = pp.level))", [arm_id])
  return rows[0].n
}

pattern mm_admission_ok(arm_id: Float) -> Bool {
  return mm_admission_locked(arm_id) == 0.0
}

// Н3-05 (задача 4): the OWNER's confirmation of the `methods` active
// set — the cap recorded in the slot row takes force ONLY here, via
// the journal event 'methods-cap-armed' (derived, no flag column, no
// env var). Requires EXACTLY three active methods hands (the owner's
// choice of three): fewer — "less-than-three", more — "over-three";
// either is a loud refusal, nothing is written, the state does not
// change. The actor is the owner-facing surface's label (the chat
// command, the Mini App session, a documented operator identity) —
// never fabricated by the app. Returns "ok" | "less-than-three" |
// "over-three".
pattern arm_methods_cap_confirm(actor: String) -> String {
  let rows = query("SELECT count(*) AS n FROM arm a JOIN practice_protocol p ON p.arm_id = a.id WHERE p.slot = 'methods' AND a.active = 1", [])
  let n = rows[0].n
  if n < 3.0 {
    return "less-than-three"
  }
  if n > 3.0 {
    return "over-three"
  }
  let _ = db_execute("INSERT INTO arm_journal (actor, arm_id, action, detail) VALUES (?, NULL, 'methods-cap-armed', 'cap=3 enforced')", [actor])
  return "ok"
}

// Н3-05 (задача 2): the catalog listing for ANY owner-facing surface
// (chat commands or the Mini App screen — the surface choice is the
// owner's, the data shape is not): every hand by slot with its state
// and safety class. Order: methods (the wave-1 set) first, breath
// next, unslotted hands last (possible only before the methods seed);
// ids ascending inside each group. A plain sqlite3 client reads the
// same rows through the same joins (invariant 6).
pattern arms_catalog() -> List {
  return query("SELECT a.id AS id, a.name AS name, a.group_name AS group_name, a.day_window AS day_window, a.active AS active, p.slot AS slot, p.safety_class AS safety_class, s.max_active AS max_active FROM arm a LEFT JOIN practice_protocol p ON p.arm_id = a.id LEFT JOIN slot s ON s.name = p.slot ORDER BY CASE WHEN p.slot IS NULL THEN 2 WHEN p.slot = 'methods' THEN 0 ELSE 1 END, a.id", [])
}

// ── Н4-02: the MIND-MASTERY script catalog (75 practices) ──────────────
// The scenario practices (seeds/mm/*.json, byte-reproducible by
// scripts/mm-convert.py --verify from ShkodnikAI/MIND-MASTERY @ 2a26e75,
// naryad Н4-01) are LINEAR SCRIPTS: voice segments, silences and sound
// layers — not breath phase cycles. The engine reads the data, it does
// not know the practices (same discipline as the Н3-01 catalog).
//
// WHY read_file AND NOT AN ENTITY LIST (§2-checked, probe-pinned on
// v0.38.0): the JSON objects (scripts.json, voice-manifest.json) can be
// CONSUMED without object iteration — dynamic struct access `obj[key]`
// works (probe dyn.mlog), and every key arrives from the segment list
// of the ARRAY-shaped practices.json (591 = 591 = 591, no orphans, the
// lockstep counts are pinned by tests). Re-embedding 800 KB of texts
// into three byte-mirrored .mlog copies would triple the mirror
// surface for zero gain: the files ARE the SSOT. The runtime read path
// has a №455 twist — see mm_read_data below (two read paths, probe- 
// pinned: the serve sandbox denies repo-tree reads, the data-dir copy
// is the serve source, the repo SSOT is the test/CI source).
//
// WHY THE ABSENT KEYS ARE NEVER TOUCHED: accessing a missing struct
// field is a LOUD runtime error (probe probe2.mlog) — the silence
// segments carry no text_key/optional_tts, so the seed branches on
// s.kind FIRST and each branch only reads the fields its kind has
// (data invariants verified: voice -> text_key + optional_tts, silence
// -> neither; probe4 tests pin both row counts).
//
// SAFETY CLASS: the converted data carries "A" for every practice
// (mm-convert hardcodes it, Н4-01) — but the class follows the DATA of
// the naryad, not the converted label: breath_wim_hof and
// breath_holotropic are hyperventilation, class C, requires_consent = 1
// (never assigned without the consent row — the Н3-01 rule).
//
// THE SLOT SPLIT IS THE OWNER'S GATE (Шаг 0): the four slots by purpose
// (внимание и намерение; тело и движение; визуализация и расслабление;
// дыхание) are the executor's PROPOSAL recorded as data — domfreq (10)
// -> attention, feldenkrais (12) -> body, silva + dispenza +
// transurfing (45) -> visualization, breath (8) -> breath. Every MM
// hand starts INACTIVE, so a not-yet-approved split changes nothing
// live; re-splitting is a data edit (UPDATE practice_protocol.slot),
// never a code change.
//
// THE DERIVED PROTOCOL TYPE (задача 1 «тип протокола guided»): a
// column cannot be added to practice_protocol — ALTER TABLE is in the
// forbidden destructive DDL class (№325, the store's own declaration)
// — so the type is DERIVED from the data by protocol_kind(): segments
// present -> "guided", else non-empty steps -> "cycle", else
// "instruction" (the methods rows). Pinned by tests on all three kinds.
//
// LEVEL (задача 5) rides the third additive table practice_profile
// (arm_id UNIQUE, system, level, declared_min) — the per-practice
// MIND-MASTERY metadata that has no additive home on the existing
// tables for the same №325 reason. declared_min is stored NEXT TO the
// segment sum (practice_protocol.session_min = the honest sum) — the
// Н4-01 honesty: «сумма сегментов меньше declared минут — оба поля
// рядом, не исправлялось молча».
//
// PRIOR: wide 0.45 +- 0.20 for every MM hand; the source is «нет
// источника: широкий приор» EXCEPT breath_coherent — slow coherent
// breathing is inside the population of the one verified review
// (Zaccaro et al. 2018), with the same not-technique-specific
// qualifier the Н3-01 diaphragmatic row already carries.
pattern mm_arm_name(id: String) -> String {
  // the three AERIS overlaps attach to the EXISTING hands (задача 3):
  // no duplicate arm rows — the MIND-MASTERY texts join as the script
  if id == "breath_diaphragmatic" {
    return "breath-diaphragmatic"
  }
  if id == "breath_478" {
    return "breath-four-seven-eight"
  }
  if id == "breath_box" {
    return "breath-box"
  }
  return id
}

pattern mm_slot_for(system: String) -> String {
  // the PROPOSED split (owner gate — see the block comment above)
  if system == "feldenkrais" {
    return "body"
  }
  if system == "domfreq" {
    return "attention"
  }
  if system == "silva" or system == "dispenza" or system == "transurfing" {
    return "visualization"
  }
  return "breath"
}

pattern mm_safety_class(id: String) -> String {
  // hyperventilation is class C (the naryad's Факт); the converted
  // label says "A" for everything and is deliberately NOT trusted
  if id == "breath_wim_hof" or id == "breath_holotropic" {
    return "C"
  }
  return "A"
}

pattern mm_source_for(id: String) -> String {
  if id == "breath_coherent" {
    return "Zaccaro et al. 2018 (Front Hum Neurosci 12:353, doi:10.3389/fnhum.2018.00353): систематический обзор медленного дыхания (<=10 вдохов/мин) в целом; конкретная техника в обзоре не оценивалась — широкий приор"
  }
  return "нет источника: широкий приор"
}

// The derived protocol type (see the block comment): "guided" when the
// arm carries a scenario (practice_segment rows), "cycle" when it
// carries non-empty phase steps (the AERIS breathing protocols), and
// "instruction" otherwise (the methods rows). An unknown arm is
// "none" — never a fabricated kind.
pattern protocol_kind(arm_id: Float) -> String {
  let segs = query("SELECT count(*) AS n FROM practice_segment WHERE arm_id = ?", [arm_id])
  if segs[0].n > 0.0 {
    return "guided"
  }
  let prot = query("SELECT steps_json FROM practice_protocol WHERE arm_id = ?", [arm_id])
  if len(prot) == 0.0 {
    return "none"
  }
  if prot[0].steps_json != "[]" {
    return "cycle"
  }
  return "instruction"
}

// WHY TWO READ PATHS (probe-pinned on v0.38.0, serveprobe.mlog): the
// №455 sandbox restricts serve-route/tick file reads to the data
// directory — a repo-tree read is DENIED ([SANDBOX_SENSITIVE_PATH],
// hard even for read_file_or). The seed therefore reads the runtime
// copy data/mm-seed/<name>.json FIRST (inside ./data — allowed; a
// missing copy is a SOFT miss), falls back to the repository SSOT
// seeds/mm/<name>.json (readable by mlog test / CI; in serve the
// denial arrives and try catches it — one loud caught-error line), and
// only when BOTH are unreadable takes the loud-refusal path below. The
// operator/deploy copies the SSOT into the data dir (one command,
// documented in the PR/worklog; the install.sh step is a follow-up —
// outside this naryad's boundaries).
pattern mm_read_data(name: String) -> String {
  let d = read_file_or("data/mm-seed/" + name, "")
  if d != "" {
    return d
  }
  let r = try read_file_or("seeds/mm/" + name, "")
  if escape_html(to_string(r.ok)) == "true" {
    // allow(unchecked_result): r.value is read only behind the
    // escape_html(to_string(r.ok)) == "true" decision above — the
    // sanitize-then-decide bridge restores integrity before the
    // branch; the obfuscated guard is deliberate (№802, ADR-0198).
    // The №455 denial arrives as ok = false and is NOT fatal: the
    // data-dir copy was already tried (soft miss above).
    return to_string(r.value)
  }
  return ""
}

// Seed the script catalog. Idempotent: UNIQUE indexes + INSERT OR
// IGNORE everywhere (arm.name, practice_protocol.arm_id, slot.name —
// created defensively here too, so the seed is self-contained — plus
// the three NEW unique keys). Returns the segment count seeded (977 =
// 591 voice + 386 silence) — the honest completeness number, pinned by
// tests. A missing data file degrades LOUD: read_file_or with an empty
// default, one printed refusal, return 0 — the tick survives, the
// catalog stays empty until the files are back (the seeds/mm/*.json
// are tracked repository files, a missing file is a broken deploy).
pattern seed_mm_catalog() -> Float {
  let _ = db_execute("CREATE UNIQUE INDEX IF NOT EXISTS idx_arm_name_unique ON arm(name)", [])
  let _ = db_execute("CREATE UNIQUE INDEX IF NOT EXISTS idx_protocol_arm_unique ON practice_protocol(arm_id)", [])
  let _ = db_execute("CREATE UNIQUE INDEX IF NOT EXISTS idx_slot_name_unique ON slot(name)", [])
  let _ = db_execute("CREATE TABLE IF NOT EXISTS practice_segment (id INTEGER PRIMARY KEY AUTOINCREMENT, arm_id INTEGER REFERENCES arm(id), ord INTEGER DEFAULT '0', kind TEXT DEFAULT '', text_key TEXT DEFAULT '', sec REAL DEFAULT '0.0', phase TEXT DEFAULT '', layer_json TEXT DEFAULT '{}', created_at TEXT DEFAULT (datetime('now')))", [])
  let _ = db_execute("CREATE UNIQUE INDEX IF NOT EXISTS idx_segment_arm_ord_unique ON practice_segment(arm_id, ord)", [])
  let _ = db_execute("CREATE TABLE IF NOT EXISTS practice_script (id INTEGER PRIMARY KEY AUTOINCREMENT, text_key TEXT, body TEXT, created_at TEXT DEFAULT (datetime('now')))", [])
  let _ = db_execute("CREATE UNIQUE INDEX IF NOT EXISTS idx_script_key_unique ON practice_script(text_key)", [])
  let _ = db_execute("CREATE TABLE IF NOT EXISTS practice_profile (id INTEGER PRIMARY KEY AUTOINCREMENT, arm_id INTEGER REFERENCES arm(id), system TEXT DEFAULT '', level INTEGER DEFAULT '0', declared_min REAL DEFAULT '0.0', created_at TEXT DEFAULT (datetime('now')))", [])
  let _ = db_execute("CREATE UNIQUE INDEX IF NOT EXISTS idx_profile_arm_unique ON practice_profile(arm_id)", [])
  // Н4-07: the admission rules of the MIND-MASTERY systems — the entry
  // gate of the active set. Byte-identical to ensure_schema (db-cycle)
  // and to the operator mirror migrations/0001_init.sql — pinned by
  // verify-mirrors (the ddl-pin practice_admission).
  let _ = db_execute("CREATE TABLE IF NOT EXISTS practice_admission (id INTEGER PRIMARY KEY AUTOINCREMENT, system TEXT DEFAULT '', level INTEGER DEFAULT '0', min_sessions REAL DEFAULT '0.0', min_minutes REAL DEFAULT '0.0', created_at TEXT DEFAULT (datetime('now')))", [])
  let _ = db_execute("CREATE UNIQUE INDEX IF NOT EXISTS idx_admission_system_level_unique ON practice_admission(system, level)", [])
  let _ = db_execute("INSERT OR IGNORE INTO slot (name, max_active) VALUES ('attention', 3)", [])
  let _ = db_execute("INSERT OR IGNORE INTO slot (name, max_active) VALUES ('body', 3)", [])
  let _ = db_execute("INSERT OR IGNORE INTO slot (name, max_active) VALUES ('visualization', 3)", [])
  let raw_practices = mm_read_data("practices.json")
  let raw_scripts = mm_read_data("scripts.json")
  let raw_voice = mm_read_data("voice-manifest.json")
  let raw_admission = mm_read_data("progression.json")
  if raw_practices == "" or raw_scripts == "" or raw_voice == "" or raw_admission == "" {
    print("seed_mm_catalog: data/mm-seed/ и seeds/mm/ не читаются — каталог сценариев и правила допуска НЕ засеяны (громкий отказ, Н4-02/Н4-07; оператор: cp seeds/mm/*.json data/mm-seed/)")
    return 0.0
  }
  let practices = parse_json(raw_practices)
  let scripts = parse_json(raw_scripts)
  let voice = parse_json(raw_voice)
  let mut n_segments = 0.0
  each p in practices {
    let arm_name = mm_arm_name(p.id)
    let cls = mm_safety_class(p.id)
    let mut cons = 0.0
    if cls == "C" {
      cons = 1.0
    }
    let _ = db_execute("INSERT OR IGNORE INTO arm (name, group_name, day_window, duration_min, prior_mean, prior_std, active) VALUES (?, ?, 'morning', ?, 0.45, 0.2, 0)", [arm_name, p.title, to_float(p.minutes)])
    let arm_rows = query("SELECT id FROM arm WHERE name = ?", [arm_name])
    let arm_id = arm_rows[0].id
    // the AERIS three keep their existing protocol rows (UNIQUE(arm_id)
    // turns this insert into a no-op for them — «остаётся запись AERIS»)
    let _ = db_execute("INSERT OR IGNORE INTO practice_protocol (arm_id, slot, safety_class, requires_consent, max_hold_sec, session_min, steps_json, series_json, contraindications, source) VALUES (?, ?, ?, ?, 0, ?, '[]', '', ?, ?)", [arm_id, mm_slot_for(p.system), cls, cons, to_float(p.protocol.session_min), join(p.contraindications, "; "), mm_source_for(p.id)])
    let _ = db_execute("INSERT OR IGNORE INTO practice_profile (arm_id, system, level, declared_min) VALUES (?, ?, ?, ?)", [arm_id, p.system, to_float(p.level), to_float(p.protocol.declared_min)])
    let mut ord = 0.0
    each s in p.segments {
      ord = ord + 1.0
      if s.kind == "voice" {
        let tk = s.text_key
        let _ = db_execute("INSERT OR IGNORE INTO practice_script (text_key, body) VALUES (?, ?)", [tk, scripts[tk]])
        let _ = db_execute("INSERT OR IGNORE INTO practice_segment (arm_id, ord, kind, text_key, sec, phase, layer_json) VALUES (?, ?, 'voice', ?, ?, ?, ?)", [arm_id, ord, tk, to_float(s.duration_sec), s.phase, json_encode(voice[tk])])
      }
      if s.kind != "voice" {
        let _ = db_execute("INSERT OR IGNORE INTO practice_segment (arm_id, ord, kind, text_key, sec, phase, layer_json) VALUES (?, ?, 'silence', '', ?, ?, '{}')", [arm_id, ord, to_float(s.duration_sec), s.phase])
      }
      n_segments = n_segments + 1.0
    }
    // the author's method description (задача 4): an author TEXT, not
    // a proof — it never touches the prior, and the systemPhysics field
    // is NOT in the converted data (mm-convert, Н4-01) — declared in
    // the PR, the description is what the source carries
    let _ = db_execute("INSERT OR IGNORE INTO practice_script (text_key, body) VALUES (?, ?)", [p.id + ".about", p.description])
  }
  // Н4-07: the admission rules — practice_admission (UNIQUE(system,
  // level) + INSERT OR IGNORE: a reseed changes nothing). The source is
  // progression.json (mm-convert из progression.ts @ 2a26e75); допуск =
  // И сессии И минуты (checkUnlock.ts). 21 правило / 6 систем / уровни
  // 2..5 — пинится тестом ниже.
  let admission = parse_json(raw_admission)
  each r in admission {
    let _ = db_execute("INSERT OR IGNORE INTO practice_admission (system, level, min_sessions, min_minutes) VALUES (?, ?, ?, ?)", [r.system, to_float(r.level), to_float(r.sessions), to_float(r.minutes)])
  }
  return n_segments
}

// ── APP-MIRROR-END: arms-seed ─────────────────────────────────────────

// ── APP-MIRROR-START: miniapp-core (byte-identical to
//    src/miniapp/miniapp.mlog §miniapp-core) ────────────────────────────

// Mini App core (Н2-03): the token guard, the page literal and the
// practice-session writers. The page is served from the TRUSTED
// literal: read_file output carries 'public, untrusted' and the №391
// sink clearance refuses respond(read_file(...)) (probe n203-serve-1),
// so self-host/miniapp/index.html is the byte-pinned canon and this
// literal is its serving copy; the lockstep test in the miniapp module
// pins the byte equality.

// The token guard — PURE function (the test lane has no env gate): the
// route passes the allowlisted stored value and the SANITIZED provided
// one (the escape_html bridge over query_param — the repo's
// sanitize-then-decide convention; the deploy token charset is
// alphanumeric, so the bridge is exact). Fail-closed: an unconfigured
// token (empty stored value) denies everything.
pattern miniapp_check_token(stored: String, provided: String) -> Bool {
  if stored == "" {
    return false
  }
  return provided == stored
}

// The page literal — byte-pinned to self-host/miniapp/index.html (see
// the miniapp module tests). No external origin anywhere in the markup
// (invariant 7): inline CSS/JS only, same-origin fetches only.
pattern miniapp_html() -> String {
  return "<!doctype html>\n<html lang=\"ru\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Камертон — практики</title>\n<style>\n  :root { --bg:#0f1115; --fg:#e8e6e3; --dim:#9a9a93; --accent:#e8862c; --ok:#4f9d69; --err:#c94f4f; }\n  * { box-sizing: border-box; margin: 0; }\n  body { background: var(--bg); color: var(--fg); font: 16px/1.5 system-ui, sans-serif; max-width: 480px; margin: 0 auto; padding: 16px; }\n  h1 { font-size: 20px; margin-bottom: 12px; }\n  nav { display: flex; gap: 8px; margin-bottom: 16px; }\n  nav button { flex: 1; padding: 10px; background: #1a1d24; color: var(--fg); border: 1px solid #2a2e37; border-radius: 8px; font-size: 15px; }\n  nav button.on { border-color: var(--accent); color: var(--accent); }\n  .screen { display: none; }\n  .screen.on { display: block; }\n  .card { background: #161920; border: 1px solid #2a2e37; border-radius: 12px; padding: 16px; margin-bottom: 12px; }\n  .circle { width: 160px; height: 160px; border-radius: 50%; background: radial-gradient(circle at 35% 35%, #3a4152, #22262f); margin: 24px auto; }\n  .lbl { color: var(--dim); font-size: 13px; }\n  .row { display: flex; gap: 8px; margin-top: 8px; flex-wrap: wrap; }\n  button.act { padding: 10px 14px; border: 0; border-radius: 8px; background: var(--accent); color: #14100b; font-size: 15px; }\n  button.act.sec { background: #2a2e37; color: var(--fg); }\n  #status { font-size: 13px; color: var(--dim); min-height: 20px; margin-top: 8px; white-space: pre-wrap; }\n  .ok { color: var(--ok); } .err { color: var(--err); }\n  .plan-row { display: flex; justify-content: space-between; align-items: center; gap: 8px; padding: 8px 0; border-bottom: 1px solid #22262f; font-size: 14px; }\n  .plan-row:last-child { border-bottom: 0; }\n  .plan-row.done { opacity: 0.55; }\n  .plan-row button { padding: 6px 10px; font-size: 13px; }\n  input[type=\"text\"] { background: #1a1d24; color: var(--fg); border: 1px solid #2a2e37; border-radius: 8px; padding: 10px; font-size: 15px; }\n  select { background: #1a1d24; color: var(--fg); border: 1px solid #2a2e37; border-radius: 8px; padding: 8px; font-size: 14px; max-width: 100%; }\n  textarea { background: #1a1d24; color: var(--fg); border: 1px solid #2a2e37; border-radius: 8px; padding: 10px; font-size: 14px; width: 100%; }\n  .stop-fab { position: fixed; right: 14px; bottom: 14px; z-index: 60; background: var(--err); color: #fff; border: 0; border-radius: 24px; padding: 12px 18px; font-size: 15px; font-weight: 600; box-shadow: 0 2px 8px rgba(0,0,0,.35); }\n  .overlay { position: fixed; inset: 0; background: rgba(10,12,16,.94); z-index: 70; display: none; overflow: auto; }\n  .overlay.on { display: block; }\n  .overlay .card { max-width: 480px; margin: 8vh auto; }\n  .contra { color: var(--err); font-size: 13px; }\n</style>\n</head>\n<body>\n<h1>Камертон</h1>\n<nav>\n  <button id=\"tab-pacer\" class=\"on\" onclick=\"show('pacer')\">Пейсер</button>\n  <button id=\"tab-ppg\" onclick=\"show('ppg')\">Пульс</button>\n  <button id=\"tab-day\" onclick=\"show('day')\">День</button>\n</nav>\n\n<section id=\"screen-pacer\" class=\"screen on\">\n  <div class=\"card\">\n    <div class=\"circle\" id=\"pacer-circle\"></div>\n    <p class=\"lbl\" id=\"pacer-phase\">&nbsp;</p>\n    <p class=\"lbl\">Темп: <b id=\"pacer-tempo\">5.5</b> вдохов/мин (диапазон 4.5–7.0, шаг 0.25)</p>\n    <div class=\"row\">\n      <button class=\"act sec\" onclick=\"tempoDown()\">−</button>\n      <button class=\"act sec\" onclick=\"tempoUp()\">+</button>\n      <button class=\"act\" id=\"pacer-step-btn\" onclick=\"startStep()\">Старт шага (2 мин)</button>\n    </div>\n    <p class=\"lbl\" id=\"pacer-timer\">&nbsp;</p>\n    <p class=\"lbl\"><label><input type=\"checkbox\" id=\"ppg-during-step\"> писать пульс во время шагов — RR-сегмент на каждый темп (Н2-06)</label></p>\n  </div>\n  <div class=\"card\">\n    <p class=\"lbl\">Журнал сессии (таблица practice_session, SQLite)</p>\n    <div class=\"row\">\n      <button class=\"act\" onclick=\"openSession('pacer')\">Начать сессию</button>\n      <button class=\"act\" onclick=\"openSession('sweep')\">Начать протокол перебора</button>\n      <button class=\"act sec\" onclick=\"closeSession()\">Завершить</button>\n    </div>\n    <p id=\"pacer-marks\" class=\"lbl\"></p>\n  </div>\n</section>\n\n<section id=\"screen-ppg\" class=\"screen\">\n  <div class=\"card\">\n    <video id=\"ppg-video\" playsinline muted autoplay style=\"width:120px;height:120px;border-radius:50%;object-fit:cover;background:#22262f;display:block;margin:0 auto;\"></video>\n    <p class=\"lbl\" id=\"ppg-hint\">Палец на объектив камеры (или лицо в кадр). Кадры обрабатываются на устройстве и никуда не сохраняются — инвариант 7.</p>\n    <p class=\"lbl\" id=\"ppg-timer\">&nbsp;</p>\n    <div class=\"row\">\n      <button class=\"act\" id=\"ppg-start-btn\" onclick=\"ppgStart()\">Старт записи</button>\n      <button class=\"act sec\" id=\"ppg-stop-btn\" onclick=\"ppgStop()\" disabled>Стоп</button>\n      <button class=\"act sec\" id=\"ppg-save-btn\" onclick=\"ppgSave()\" disabled>Сохранить RR в сессию</button>\n    </div>\n    <p class=\"lbl\" id=\"ppg-summary\">&nbsp;</p>\n  </div>\n</section>\n\n<section id=\"screen-day\" class=\"screen\">\n  <div class=\"card\">\n    <p class=\"lbl\">План дня (Н4-03). Рекомендация бандита — проба дня: её отклики p:/m:. Остальное — свободные сессии, в данные бандита не входят.</p>\n    <div id=\"plan-list\"></div>\n    <div class=\"row\">\n      <input type=\"text\" id=\"plan-add-input\" list=\"catalog-names\" placeholder=\"фрагмент названия практики\" style=\"flex:1\">\n      <datalist id=\"catalog-names\"></datalist>\n      <button class=\"act\" onclick=\"planAdd()\">Добавить</button>\n    </div>\n    <div class=\"row\"><button class=\"act sec\" onclick=\"loadPlan()\">Обновить план</button></div>\n  </div>\n  <div class=\"card\">\n    <p class=\"lbl\">Дневник свободной сессии (таблица free_journal — настроение и заметка, вне награды бандита)</p>\n    <div class=\"row\">\n      <select id=\"journal-plan\" style=\"flex:1\"><option value=\"\">— без практики —</option></select>\n    </div>\n    <p class=\"lbl\">Настроение: <input type=\"range\" id=\"journal-mood\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" oninput=\"document.getElementById('journal-mood-v').textContent=this.value\"> <b id=\"journal-mood-v\">0.5</b></p>\n    <textarea id=\"journal-note\" rows=\"2\" placeholder=\"заметка дня (необязательно)\"></textarea>\n    <div class=\"row\"><button class=\"act\" onclick=\"journalSave()\">Записать в дневник</button></div>\n  </div>\n</section>\n\n<p id=\"status\"></p>\n\n<button class=\"stop-fab\" onclick=\"emergencyStop()\">■ Стоп</button>\n\n<div class=\"overlay\" id=\"disclaimer-overlay\">\n  <div class=\"card\">\n    <p><b>Прежде чем начать</b></p>\n    <p class=\"lbl\" style=\"margin-top:8px\">Камертон — инструмент самонаблюдения и практики, не медицинская услуга. Практики могут включать управляемое дыхание с задержками, длинные паузы и интенсивные визуализации.</p>\n    <p class=\"lbl\" style=\"margin-top:8px\">Противопоказания каждой практики показываются перед стартом; практики класса C требуют отдельной записи согласия и не назначаются без неё. Открытие практик идёт по числу завершённых сессий и минут системы — уровень не разблокируется вручную.</p>\n    <p class=\"lbl\" style=\"margin-top:8px\">Принимая, ты подтверждаешь, что противопоказаний у тебя нет, и берёшь ответственность за своё состояние на себя. Запись идемпотентна: согласие сохраняется один раз (consent: disclaimer:v1).</p>\n    <div class=\"row\"><button class=\"act\" onclick=\"acceptConsent()\">Принимаю</button></div>\n  </div>\n</div>\n\n<script>\n\"use strict\";\n// Канал ADR-0002 (вариант «а», приватный туннель): страница отдаётся\n// маршрутом /miniapp программы Камертона; токен владельца передаётся в\n// каждом запросе (параметр t из адреса страницы). Наружу страница не\n// ходит: вся работа против того же origin, внешних ресурсов нет —\n// инвариант 7 (данные не покидают машину владельца).\nvar TOKEN = new URLSearchParams(location.search).get(\"t\") || \"\";\nvar sessionId = 0;\nvar marks = [];\n\nfunction show(name) {\n  var names = [\"pacer\", \"ppg\", \"day\"];\n  for (var i = 0; i < names.length; i++) {\n    document.getElementById(\"screen-\" + names[i]).className = names[i] === name ? \"screen on\" : \"screen\";\n    document.getElementById(\"tab-\" + names[i]).className = names[i] === name ? \"on\" : \"\";\n  }\n  // Н4-03: план и каталог грузятся лениво — при первом открытии вкладки.\n  if (name === \"day\") { loadPlan(); loadCatalog(); }\n}\n\n// Экранирование имён из каталога/плана перед вставкой в innerHTML\n// (данные владельца, но дисциплина едина с серверной escape_html).\nfunction esc(s) {\n  return String(s).replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n}\n\nfunction get(path, params) {\n  var q = new URLSearchParams(params || {});\n  q.set(\"t\", TOKEN);\n  return fetch(path + \"?\" + q.toString())\n    .then(function (r) { return r.text().then(function (body) { return { code: r.status, body: body }; }); });\n}\n\nfunction status(msg, cls) {\n  var el = document.getElementById(\"status\");\n  el.textContent = msg;\n  el.className = cls || \"\";\n}\n\nfunction api(path, params) {\n  var q = new URLSearchParams(params || {});\n  q.set(\"t\", TOKEN);\n  return fetch(path + \"?\" + q.toString(), {\n    method: \"POST\",\n    headers: { \"X-CSRF-Token\": csrfToken() }\n  })\n    .then(function (r) {\n      return r.text().then(function (body) { return { code: r.status, body: body }; });\n    });\n}\n\n// CSRF-мидлварь сервера (double-submit): GET страницы выдаёт куку\n// _mlog_csrf, каждый POST обязан нести её значение в X-CSRF-Token.\n// TTL токена — 15 минут; истёкший/чужой токен отвечает 403 с «CSRF»\n// в теле — перезагружаем страницу (GET перевыпустит куку). Отметки\n// шагов пишутся инкрементально, поэтому перезагрузка теряет максимум\n// текущий неотмеченный шаг.\nfunction csrfToken() {\n  var m = document.cookie.match(/(?:^|;\\s*)_mlog_csrf=([^;]+)/);\n  return m ? m[1] : \"\";\n}\n\nfunction openSession(kind) {\n  api(\"/miniapp/session\", { kind: kind, tempo_bpm: String(tempo), steps_total: String(STEPS_TOTAL), arm_id: \"0\", trial_id: \"0\" })\n    .then(function (res) {\n      if (res.code === 403 && res.body.indexOf(\"CSRF\") >= 0) { location.reload(); return; }\n      if (res.code !== 200) { status(\"Отказ сервера: \" + res.code + \" \" + res.body, \"err\"); return; }\n      var d = JSON.parse(res.body);\n      sessionId = d.id;\n      marks = [];\n      document.getElementById(\"pacer-marks\").textContent = \"Сессия №\" + sessionId + \", шагов: 0\";\n      status(\"Сессия \" + sessionId + \" открыта: протокол \" + STEPS_TOTAL + \" шагов по 2 минуты\", \"ok\");\n    })\n    .catch(function (e) { status(\"Ошибка сети: \" + e, \"err\"); });\n}\n\n// ── Пейсер (Н2-04) ──────────────────────────────────────────────────────\n// Протокол концепции: перебор темпов 4.5–7.0 вдох/мин с шагом 0.25,\n// по две минуты на темп; отметка завершения шага пишется в сессию\n// инкрементально (писцы Н2-03). Чистая математика фазы вынесена в\n// pacerState — её пиннет скрипт-проверка против эталонной раскадки\n// (self-host/miniapp/test/pacer-test.mjs).\n// PacerEngine-START (маркер скрипт-проверки: источник математики)\nvar TEMPO_MIN = 4.5;\nvar TEMPO_MAX = 7.0;\nvar TEMPO_STEP = 0.25;\nvar STEP_MS = 120000;   // две минуты на темп — протокол концепции\nvar STEPS_TOTAL = 11;   // (7.0 − 4.5) / 0.25 + 1\n\n// Плавная синусоида: равные половины вдоха/выдоха, масштаб 0.10–1.00,\n// старт из середины (0.55) на вдохе. Никакого накопления дрейфа: фаза\n// всегда считается от времени старта шага, а не приращением.\nfunction pacerState(tempoBpm, tMs) {\n  var periodMs = 60000 / tempoBpm;\n  var phase = (tMs % periodMs) / periodMs;\n  var s = Math.sin(2 * Math.PI * phase);\n  return {\n    periodMs: periodMs,\n    phase: phase,\n    dir: phase < 0.5 ? \"вдох\" : \"выдох\",\n    scale: 0.55 + 0.45 * s\n  };\n}\n// PacerEngine-END\n\nvar tempo = 5.5;\nvar stepRunning = false;\nvar stepStart = 0;\nvar stepNo = 0;\nvar rafId = 0;\n\nfunction tempoUp() {\n  tempo = Math.min(TEMPO_MAX, Math.round((tempo + TEMPO_STEP) * 100) / 100);\n  document.getElementById(\"pacer-tempo\").textContent = tempo.toFixed(2);\n}\n\nfunction tempoDown() {\n  tempo = Math.max(TEMPO_MIN, Math.round((tempo - TEMPO_STEP) * 100) / 100);\n  document.getElementById(\"pacer-tempo\").textContent = tempo.toFixed(2);\n}\n\nfunction startStep() {\n  if (stepRunning) { return; }\n  if (!sessionId) { status(\"Сначала начните сессию\", \"err\"); return; }\n  var wantPpg = document.getElementById(\"ppg-during-step\").checked;\n  if (wantPpg && ppgSampling) { status(\"Сначала остановите запись на вкладке «Пульс»\", \"err\"); return; }\n  stepRunning = true;\n  stepNo = marks.length + 1;\n  stepStart = performance.now();\n  document.getElementById(\"pacer-step-btn\").disabled = true;\n  if (wantPpg) { sweepStepStart(); }\n  paceFrame();\n}\n\nfunction paceFrame() {\n  var t = performance.now() - stepStart;\n  if (t >= STEP_MS) {\n    finishStep();\n    return;\n  }\n  var st = pacerState(tempo, t);\n  document.getElementById(\"pacer-circle\").style.transform = \"scale(\" + st.scale.toFixed(4) + \")\";\n  document.getElementById(\"pacer-phase\").textContent = st.dir;\n  var left = Math.ceil((STEP_MS - t) / 1000);\n  document.getElementById(\"pacer-timer\").textContent = \"Шаг \" + stepNo + \" · осталось \" + left + \" с\";\n  rafId = requestAnimationFrame(paceFrame);\n}\n\nfunction finishStep() {\n  stepRunning = false;\n  cancelAnimationFrame(rafId);\n  document.getElementById(\"pacer-circle\").style.transform = \"scale(0.55)\";\n  document.getElementById(\"pacer-phase\").textContent = \"\\u00a0\";\n  document.getElementById(\"pacer-timer\").textContent = \"\\u00a0\";\n  document.getElementById(\"pacer-step-btn\").disabled = false;\n  var rec = stepMark();\n  api(\"/miniapp/session/close\", {\n    id: String(sessionId),\n    steps_done: String(marks.length + 1),\n    step_marks: JSON.stringify(marks.concat([rec])),\n    rr_json: \"\",\n    rr_source: \"\"\n  })\n    .then(function (res) {\n      if (res.code === 403 && res.body.indexOf(\"CSRF\") >= 0) { location.reload(); return; }\n      if (res.code !== 200) { status(\"Отказ сервера: \" + res.code + \" \" + res.body, \"err\"); return; }\n      marks.push(rec);\n      document.getElementById(\"pacer-marks\").textContent = \"Сессия №\" + sessionId + \", шагов: \" + marks.length + \" · последний темп \" + tempo.toFixed(2);\n      if (rec.rr_reason !== \"\") {\n        status(\"Шаг \" + stepNo + \" (темп \" + tempo.toFixed(2) + \") записан, но пульс забракован: \" + rec.rr_reason, \"err\");\n      } else if (rec.rr.length) {\n        status(\"Шаг \" + stepNo + \" (темп \" + tempo.toFixed(2) + \") записан с RR (\" + rec.rr.length + \" интервалов) — смените темп и повторите\", \"ok\");\n      } else {\n        status(\"Шаг \" + stepNo + \" (темп \" + tempo.toFixed(2) + \") записан — смените темп и повторите\", \"ok\");\n      }\n    })\n    .catch(function (e) { status(\"Ошибка сети: \" + e, \"err\"); });\n}\n\nfunction closeSession() {\n  if (!sessionId) { status(\"Сессия не открыта\", \"err\"); return; }\n  api(\"/miniapp/session/close\", {\n    id: String(sessionId),\n    steps_done: String(marks.length),\n    step_marks: JSON.stringify(marks),\n    rr_json: rrBuffer.length ? JSON.stringify(rrBuffer) : \"\",\n    rr_source: rrBuffer.length ? \"ppg\" : \"\",\n    final: \"1\"\n  })\n    .then(function (res) {\n      if (res.code === 403 && res.body.indexOf(\"CSRF\") >= 0) { location.reload(); return; }\n      if (res.code !== 200) { status(\"Отказ сервера: \" + res.code + \" \" + res.body, \"err\"); return; }\n      var d = JSON.parse(res.body);\n      if (d.sweep && d.sweep.ok) {\n        var v = \"\";\n        if (d.sweep.verdict === \"reproducible\") { v = \" · повтор: воспроизведён\"; }\n        if (d.sweep.verdict === \"divergent\") { v = \" · повтор: РАСХОЖДЕНИЕ\"; }\n        status(\"Протокол принят: резонанс \" + d.sweep.resonance_bpm + \" вдох/мин, доля мощности \" + Math.round(d.sweep.share * 100) + \"%\" + v + \" — зафиксировано в sweep_result\", \"ok\");\n      } else if (d.sweep) {\n        status(\"Протокол не принят: \" + d.sweep.reason, \"err\");\n      } else {\n        status(\"Сессия \" + sessionId + \" закрыта: шагов \" + marks.length + (rrBuffer.length ? \", RR \" + rrBuffer.length : \"\"), \"ok\");\n      }\n      sessionId = 0; marks = []; rrBuffer = []; stepSamples = [];\n      sweepStopCam();\n      document.getElementById(\"pacer-marks\").textContent = \"\";\n    })\n    .catch(function (e) { status(\"Ошибка сети: \" + e, \"err\"); });\n}\n\n// ── План дня и дневник (Н4-03) ──────────────────────────────────────\nvar planLoaded = false;\n\nfunction loadPlan() {\n  return get(\"/miniapp/plan\")\n    .then(function (res) {\n      if (res.code !== 200) { status(\"План: отказ сервера \" + res.code, \"err\"); return; }\n      var rows = JSON.parse(res.body);\n      var el = document.getElementById(\"plan-list\");\n      var sel = document.getElementById(\"journal-plan\");\n      var selKeep = sel.value;\n      var html = \"\";\n      var opts = \"<option value=\\\"\\\">— без практики —</option>\";\n      for (var i = 0; i < rows.length; i++) {\n        var r = rows[i];\n        var done = r.status === \"done\";\n        var src = r.source === \"recommendation\" ? \"рекомендация\" : \"выбор владельца\";\n        // Н4-07: противопоказания видны ДО старта — строкой под практикой.\n        var contra = r.contra ? \"<div class='contra'>⚠ Противопоказания: \" + esc(r.contra) + \" — начинай только если они к тебе не относятся.</div>\" : \"\";\n        html += \"<div class='plan-row\" + (done ? \" done\" : \"\") + \"'><span>\" + esc(r.name) +\n          \" <span class='lbl'>(\" + src + (done ? \", сделано\" : \"\") + \")</span>\" + contra + \"</span>\" +\n          (done ? \"\" : \" <button class='act sec' onclick='planDone(\" + r.id + \")'>Сделано</button>\") + \"</div>\";\n        opts += \"<option value=\\\"\" + r.id + \"\\\"\" + (String(r.id) === selKeep ? \" selected\" : \"\") + \">\" + esc(r.name) + \"</option>\";\n      }\n      if (!rows.length) { html = \"<p class='lbl'>План пуст. Добавьте практику ниже; рекомендация появится утром (07:00) или по /fire.</p>\"; }\n      el.innerHTML = html;\n      sel.innerHTML = opts;\n      planLoaded = true;\n    })\n    .catch(function (e) { status(\"Ошибка сети: \" + e, \"err\"); });\n}\n\nvar catalogByName = {};\nfunction loadCatalog() {\n  return get(\"/miniapp/catalog\")\n    .then(function (res) {\n      if (res.code !== 200) { return; }\n      var rows = JSON.parse(res.body);\n      var opts = \"\";\n      catalogByName = {};\n      for (var i = 0; i < rows.length; i++) {\n        opts += \"<option value=\\\"\" + esc(rows[i].name) + \"\\\">\";\n        // Н4-07: поверхность безопасности каталога — противопоказания и\n        // состояние допуска уровня (информация для владельца).\n        catalogByName[rows[i].name] = { contra: rows[i].contra || \"\", locked: rows[i].locked === 1 };\n      }\n      document.getElementById(\"catalog-names\").innerHTML = opts;\n    })\n    .catch(function (e) { /* каталог — подсказка, не критичный путь */ });\n}\n\nfunction planAdd() {\n  var input = document.getElementById(\"plan-add-input\");\n  var name = input.value.trim();\n  if (!name) { status(\"Введите фрагмент названия практики\", \"err\"); return; }\n  // Н4-07: поверхность безопасности ДО старта — из каталога (contra и\n  // допуск уровня). План остаётся свободным выбором владельца; замок —\n  // информация: в АКТИВНЫЙ набор запертая практика не попадёт.\n  var c = catalogByName[name];\n  if (c && c.locked) { status(\"Практика ещё не открыта: допуск системы (сессии/минуты) не выполнен — в активный набор она не попадёт. Свободная сессия возможна.\", \"warn\"); }\n  else if (c && c.contra) { status(\"Противопоказания: \" + c.contra + \" — начинай только если они к тебе не относятся.\", \"warn\"); }\n  api(\"/miniapp/plan/add\", { name: name })\n    .then(function (res) {\n      if (res.code === 403 && res.body.indexOf(\"CSRF\") >= 0) { location.reload(); return; }\n      if (res.code !== 200) { status(\"Добавление: отказ сервера \" + res.code + \" \" + res.body, \"err\"); return; }\n      var d = JSON.parse(res.body);\n      if (!d.ok) {\n        if (d.reason === \"not_found\") { status(\"«\" + name + \"» в каталоге не найдено — уточните фрагмент\", \"err\"); }\n        else if (d.reason === \"consent\") { status(\"«\" + d.name + \"» — практика класса C: нужна запись согласия (инвариант 5)\", \"err\"); }\n        else if (d.reason === \"ambiguous\") {\n          var names = (d.candidates || []).map(function (c) { return c.name; }).join(\"; \");\n          status(\"Найдено несколько: \" + names + \" — уточните запрос\", \"err\");\n        } else { status(\"Отказ: \" + d.reason, \"err\"); }\n        return;\n      }\n      input.value = \"\";\n      status(d.added ? \"Добавлено в план: \" + d.name : \"Уже в плане: \" + d.name, \"ok\");\n      loadPlan();\n    })\n    .catch(function (e) { status(\"Ошибка сети: \" + e, \"err\"); });\n}\n\nfunction planDone(id) {\n  api(\"/miniapp/plan/done\", { id: String(id) })\n    .then(function (res) {\n      if (res.code === 403 && res.body.indexOf(\"CSRF\") >= 0) { location.reload(); return; }\n      if (res.code !== 200) { status(\"Отметка: отказ сервера \" + res.code, \"err\"); return; }\n      var d = JSON.parse(res.body);\n      status(d.ok ? \"Сделано — отмечено в плане дня\" : \"Отметка не изменила план (уже отмечено или пункт чужого дня)\", d.ok ? \"ok\" : \"err\");\n      loadPlan();\n    })\n    .catch(function (e) { status(\"Ошибка сети: \" + e, \"err\"); });\n}\n\nfunction journalSave() {\n  var mood = document.getElementById(\"journal-mood\").value;\n  var note = document.getElementById(\"journal-note\").value;\n  var planId = document.getElementById(\"journal-plan\").value || \"\";\n  var params = { mood: mood, note: note };\n  if (planId) { params.plan_id = planId; }\n  api(\"/miniapp/journal\", params)\n    .then(function (res) {\n      if (res.code === 403 && res.body.indexOf(\"CSRF\") >= 0) { location.reload(); return; }\n      if (res.code !== 200) { status(\"Дневник: отказ сервера \" + res.code + \" \" + res.body, \"err\"); return; }\n      document.getElementById(\"journal-note\").value = \"\";\n      status(\"Записано в дневник: настроение \" + mood + (planId ? \" (практика плана)\" : \"\"), \"ok\");\n    })\n    .catch(function (e) { status(\"Ошибка сети: \" + e, \"err\"); });\n}\n\n// ── PPG через камеру → RR-интервалы (Н2-05) ─────────────────────────────\n// Инвариант 7: кадры живут только в canvas на устройстве; наружу уходит\n// ТОЛЬКО итоговый RR-ряд с метками качества, по явному действию\n// владельца. Сырые кадры не сохраняются нигде — их некуда сохранять:\n// страница не имеет хранилища, кроме сессионного журнала RR.\n// PpgEngine-START (маркер скрипт-проверки: источник математики)\n// Дискретизация сигнала: {t: мс, v: 0..255 — средний зелёный канал\n// центральной области кадра}. Пайплайн: скользящая база (окно 1.5 с) →\n// AC-составляющая → эпохи по 10 с → пики (локальные максимумы выше\n// порога 0.6 амплитуды эпохи с рефрактерным окном 300 мс = верхний\n// предел 200 уд/мин) → RR = межпиковые интервалы.\n// Контроль качества эпохи: пиков ≥ 5; RR эпохи в [300, 2000] мс\n// (30–200 уд/мин); CV = std/mean ≤ 0.25; амплитуда ≥ 6× шумовой пол\n// (шум — медиана |Δv| соседних отсчётов). Отбракованные эпохи\n// считаются; итоговый отказ громкий: эпох < 2, брак > 50% или RR < 8.\nvar PPG_EPOCH_MS = 10000;\nvar PPG_BASELINE_MS = 1500;\nvar PPG_REFRACTORY_MS = 300;\nvar PPG_RR_MIN = 300;\nvar PPG_RR_MAX = 2000;\nvar PPG_CV_MAX = 0.25;\nvar PPG_AMPL_NOISE_X = 6.0;\n\nfunction ppgExtractRR(samples) {\n  var n = samples.length;\n  if (n < 2) {\n    return { rr: [], epochsTotal: 0, epochsRejected: 0, reason: \"слишком мало отсчётов\" };\n  }\n  // Скользящая база: среднее по отсчётам в окне ±PPG_BASELINE_MS/2.\n  var half = PPG_BASELINE_MS / 2;\n  var ac = new Array(n);\n  var j0 = 0, j1 = 0, sum = 0, cnt = 0;\n  for (var i = 0; i < n; i++) {\n    while (j1 < n && samples[j1].t <= samples[i].t + half) { sum += samples[j1].v; cnt++; j1++; }\n    while (j0 < n && samples[j0].t < samples[i].t - half) { sum -= samples[j0].v; cnt--; j0++; }\n    ac[i] = { t: samples[i].t, v: samples[i].v - sum / cnt };\n  }\n  // Шумовой пол: медиана |Δv| соседних отсчётов.\n  var diffs = [];\n  for (var i = 1; i < n; i++) { diffs.push(Math.abs(ac[i].v - ac[i - 1].v)); }\n  diffs.sort(function (a, b) { return a - b; });\n  var noise = diffs[Math.floor(diffs.length / 2)] || 0.001;\n  // Эпохи по времени.\n  var t0 = samples[0].t, tEnd = samples[n - 1].t;\n  var epochs = [];\n  for (var e = t0; e < tEnd; e += PPG_EPOCH_MS) { epochs.push({ from: e, to: e + PPG_EPOCH_MS }); }\n  var rr = [];\n  var rejected = 0;\n  for (var k = 0; k < epochs.length; k++) {\n    var ep = epochs[k];\n    var idx = [];\n    for (var i = 0; i < n; i++) { if (ac[i].t >= ep.from && ac[i].t < ep.to) { idx.push(i); } }\n    if (idx.length < 10) { rejected++; continue; }\n    var lo = Infinity, hi = -Infinity;\n    for (var i = 0; i < idx.length; i++) {\n      var v = ac[idx[i]].v;\n      if (v < lo) lo = v;\n      if (v > hi) hi = v;\n    }\n    var ampl = hi - lo;\n    if (ampl < PPG_AMPL_NOISE_X * noise) { rejected++; continue; }\n    var thr = lo + 0.6 * ampl;\n    var peaks = [];\n    var lastPeakT = -Infinity;\n    for (var i = 1; i < idx.length - 1; i++) {\n      var t = ac[idx[i]].t, v = ac[idx[i]].v;\n      if (v > thr && v >= ac[idx[i - 1]].v && v >= ac[idx[i + 1]].v && t - lastPeakT >= PPG_REFRACTORY_MS) {\n        peaks.push(t); lastPeakT = t;\n      }\n    }\n    if (peaks.length < 5) { rejected++; continue; }\n    var okEpoch = true;\n    var epRR = [];\n    for (var i = 1; i < peaks.length; i++) {\n      var d = peaks[i] - peaks[i - 1];\n      if (d < PPG_RR_MIN || d > PPG_RR_MAX) { okEpoch = false; break; }\n      epRR.push(d);\n    }\n    if (!okEpoch) { rejected++; continue; }\n    var mean = epRR.reduce(function (a, b) { return a + b; }, 0) / epRR.length;\n    var vari = epRR.reduce(function (a, b) { return a + (b - mean) * (b - mean); }, 0) / epRR.length;\n    var cv = Math.sqrt(vari) / mean;\n    if (cv > PPG_CV_MAX) { rejected++; continue; }\n    for (var i = 0; i < epRR.length; i++) { rr.push(epRR[i]); }\n  }\n  var epochsTotal = epochs.length;\n  return { rr: rr, epochsTotal: epochsTotal, epochsRejected: rejected, reason: \"\" };\n}\n\n// Громкий отказ сборки RR: возвращает строку отказа или пустую строку.\nfunction ppgQualityRefusal(ex) {\n  if (ex.epochsTotal < 2) { return \"брак: запись короче двух эпох (\" + ex.epochsTotal + \")\"; }\n  var share = ex.epochsRejected / ex.epochsTotal;\n  if (share > 0.5) { return \"брак: отбраковано эпох \" + ex.epochsRejected + \" из \" + ex.epochsTotal + \" — сигнала пульса нет\"; }\n  if (ex.rr.length < 8) { return \"брак: восстановлено RR \" + ex.rr.length + \" (< 8)\"; }\n  return \"\";\n}\n// PpgEngine-END\n\n// ── Протокол перебора (Н2-06) ───────────────────────────────────────────\n// SweepEngine-START (маркер скрипт-проверки: сборка RR-сегментов)\n// Каждому шагу пейсера — свой RR-сегмент: камера пишет пульс на протяжении\n// шага (инвариант 7: кадры умирают в canvas, наружу идёт только итоговый\n// RR), на финише сегмент проходит QC движка Н2-05 и попадает в отметку\n// {step, tempo_bpm, rr, rr_reason}. Сервер считает спектры билтинами\n// Ломба–Скаргла (№591), фиксирует резонанс в sweep_result и kv; анализ\n// запускается только финальным закрытием сессии (final=1).\nvar stepSamples = [];\nvar stepPpgOn = false;   // семплирование текущего шага идёт\n\nfunction sweepStepStart() {\n  ppgStart_ = performance.now();\n  stepSamples = [];\n  if (ppgStream) { stepPpgOn = true; stepSampleFrame(); return; }\n  if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {\n    status(\"Камера недоступна: нужен защищённый контекст (https) — шаг пойдёт без пульса\", \"err\");\n    return;\n  }\n  navigator.mediaDevices.getUserMedia({ video: { facingMode: \"user\", width: 320, height: 240 }, audio: false })\n    .then(function (stream) {\n      ppgStream = stream;\n      var video = document.getElementById(\"ppg-video\");\n      video.srcObject = stream;\n      video.play();\n      stepPpgOn = true;\n      stepSampleFrame();\n    })\n    .catch(function (e) { status(\"Камера отказала громко: \" + e.name + \" — шаг пойдёт без пульса\", \"err\"); });\n}\n\nfunction stepSampleFrame() {\n  if (!stepPpgOn) { return; }\n  var video = document.getElementById(\"ppg-video\");\n  if (video.videoWidth > 0) {\n    ppgCtx.drawImage(video, 8, 8, 16, 16, 0, 0, 8, 8);\n    var d = ppgCtx.getImageData(0, 0, 8, 8).data;\n    var sum = 0;\n    for (var i = 0; i < d.length; i += 4) { sum += d[i + 1]; }\n    stepSamples.push({ t: performance.now() - ppgStart_, v: sum / (d.length / 4) });\n  }\n  requestAnimationFrame(stepSampleFrame);\n}\n\nfunction stepMark() {\n  // Отметка шага: RR-сегмент (если пульс писался) едет в отметке; брак\n  // едет громко в rr_reason — протокол продолжается, сервер считает\n  // шаг негодным. Поле rr присутствует ВСЕГДА — сервер отличает отметку\n  // Н2-06 от старого формата по наличию ключа.\n  var rec = { step: stepNo, tempo_bpm: tempo, rr: [], rr_reason: \"\" };\n  if (stepPpgOn) {\n    stepPpgOn = false;\n    var ex = ppgExtractRR(stepSamples);\n    var refusal = ppgQualityRefusal(ex);\n    if (refusal !== \"\") { rec.rr_reason = refusal; }\n    else { rec.rr = ex.rr; }\n    stepSamples = [];\n  }\n  return rec;\n}\n\nfunction sweepStopCam() {\n  // Камера протокола гасится вместе с сессией; если вкладка «Пульс»\n  // сейчас ведёт свою запись — её стрим не трогаем.\n  if (ppgStream && !ppgSampling) {\n    var tracks = ppgStream.getTracks();\n    for (var i = 0; i < tracks.length; i++) { tracks[i].stop(); }\n    ppgStream = null;\n  }\n}\n// SweepEngine-END\n\nvar rrBuffer = [];\nvar ppgStream = null;\nvar ppgSampling = false;\nvar ppgStart_ = 0;\nvar ppgCanvas = document.createElement(\"canvas\");\nppgCanvas.width = 32; ppgCanvas.height = 32;\nvar ppgCtx = ppgCanvas.getContext(\"2d\", { willReadFrequently: true });\nvar ppgSamples = [];\n\nfunction ppgStart() {\n  if (ppgSampling) { return; }\n  if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {\n    status(\"Камера недоступна: нужен защищённый контекст (https) — канал ADR-0002 (а) его даёт, http-закладка нет\", \"err\");\n    return;\n  }\n  navigator.mediaDevices.getUserMedia({ video: { facingMode: \"user\", width: 320, height: 240 }, audio: false })\n    .then(function (stream) {\n      ppgStream = stream;\n      var video = document.getElementById(\"ppg-video\");\n      video.srcObject = stream;\n      video.play();\n      ppgSamples = [];\n      rrBuffer = [];\n      ppgSampling = true;\n      ppgStart_ = performance.now();\n      document.getElementById(\"ppg-start-btn\").disabled = true;\n      document.getElementById(\"ppg-stop-btn\").disabled = false;\n      document.getElementById(\"ppg-save-btn\").disabled = true;\n      document.getElementById(\"ppg-summary\").textContent = \"\";\n      ppgSampleFrame();\n    })\n    .catch(function (e) { status(\"Камера отказала громко: \" + e.name, \"err\"); });\n}\n\nfunction ppgSampleFrame() {\n  if (!ppgSampling) { return; }\n  var video = document.getElementById(\"ppg-video\");\n  if (video.videoWidth > 0) {\n    // Центральная область кадра — средний зелёный канал (самый\n    // пульсативный). Кадр умирает в canvas: ни копий, ни передачи.\n    ppgCtx.drawImage(video, 8, 8, 16, 16, 0, 0, 8, 8);\n    var d = ppgCtx.getImageData(0, 0, 8, 8).data;\n    var sum = 0;\n    for (var i = 0; i < d.length; i += 4) { sum += d[i + 1]; }\n    ppgSamples.push({ t: performance.now() - ppgStart_, v: sum / (d.length / 4) });\n  }\n  var el = Math.round((performance.now() - ppgStart_) / 1000);\n  document.getElementById(\"ppg-timer\").textContent = \"Запись: \" + el + \" с (отсчётов \" + ppgSamples.length + \")\";\n  requestAnimationFrame(ppgSampleFrame);\n}\n\nfunction ppgStop() {\n  if (!ppgSampling) { return; }\n  ppgSampling = false;\n  if (ppgStream) {\n    var tracks = ppgStream.getTracks();\n    for (var i = 0; i < tracks.length; i++) { tracks[i].stop(); }\n    ppgStream = null;\n  }\n  document.getElementById(\"ppg-start-btn\").disabled = false;\n  document.getElementById(\"ppg-stop-btn\").disabled = true;\n  var ex = ppgExtractRR(ppgSamples);\n  var refusal = ppgQualityRefusal(ex);\n  if (refusal !== \"\") {\n    status(refusal + \" — запись НЕ сохранена, повторите с хорошим сигналом\", \"err\");\n    document.getElementById(\"ppg-summary\").textContent = \"Эпох: \" + ex.epochsTotal + \", отбраковано: \" + ex.epochsRejected;\n    return;\n  }\n  rrBuffer = ex.rr;\n  var mean = ex.rr.reduce(function (a, b) { return a + b; }, 0) / ex.rr.length;\n  document.getElementById(\"ppg-save-btn\").disabled = false;\n  document.getElementById(\"ppg-summary\").textContent =\n    \"RR: \" + ex.rr.length + \" · средний \" + Math.round(mean) + \" мс (\" + Math.round(60000 / mean) + \" уд/мин) · эпохи: \" +\n    (ex.epochsTotal - ex.epochsRejected) + \"/\" + ex.epochsTotal + \" годных\";\n  status(\"Сигнал годен — сохраните в сессию или перепишите\", \"ok\");\n}\n\nfunction ppgSave() {\n  if (!sessionId) { status(\"Сначала начните сессию (это отдельная сессия PPG)\", \"err\"); return; }\n  if (!rrBuffer.length) { status(\"RR-ряда нет — сначала запишите сигнал\", \"err\"); return; }\n  api(\"/miniapp/session/close\", {\n    id: String(sessionId),\n    steps_done: String(marks.length),\n    step_marks: JSON.stringify(marks),\n    rr_json: JSON.stringify(rrBuffer),\n    rr_source: \"ppg\"\n  })\n    .then(function (res) {\n      if (res.code === 403 && res.body.indexOf(\"CSRF\") >= 0) { location.reload(); return; }\n      if (res.code !== 200) { status(\"Отказ сервера: \" + res.code + \" \" + res.body, \"err\"); return; }\n      status(\"RR-ряд (\" + rrBuffer.length + \" интервалов) записан в сессию \" + sessionId, \"ok\");\n    })\n    .catch(function (e) { status(\"Ошибка сети: \" + e, \"err\"); });\n}\n// ── Н4-07: дисклеймер и экстренная остановка ─────────────────────────\nfunction checkDisclaimer() {\n  return get(\"/miniapp/consent\")\n    .then(function (res) {\n      if (res.code !== 200) { return; }\n      var d = JSON.parse(res.body);\n      if (d.disclaimer === 0) {\n        document.getElementById(\"disclaimer-overlay\").className = \"overlay on\";\n      }\n    })\n    .catch(function (e) { /* отказ сети не открывает и не закрывает оверлей */ });\n}\nfunction acceptConsent() {\n  api(\"/miniapp/consent\")\n    .then(function (res) {\n      if (res.code !== 200) { status(\"Дисклеймер: отказ сервера \" + res.code, \"err\"); return; }\n      var d = JSON.parse(res.body);\n      document.getElementById(\"disclaimer-overlay\").className = \"overlay\";\n      status(d.recorded === 1 ? \"Дисклеймер принят и записан (consent: disclaimer:v1).\" : \"Дисклеймер уже был принят — запись не изменилась (идемпотентно).\", \"ok\");\n    })\n    .catch(function (e) { status(\"Ошибка сети: \" + e, \"err\"); });\n}\n// Экстренная остановка — доступна всегда (кнопка на всех экранах, общая\n// с Н4-04). Локально: стоп пейсерa/шага, камеры и записи PPG; на\n// сервере: проба дня уходит в статус stopped (позже «пропуска» не\n// фабрикуются). Идемпотентно: повторный вызов ничего не останавливает.\nfunction emergencyStop() {\n  cancelAnimationFrame(rafId);\n  document.getElementById(\"pacer-timer\").textContent = \"\\u00a0\";\n  sweepStopCam();\n  ppgStop();\n  return api(\"/miniapp/stop\")\n    .then(function (res) {\n      if (res.code !== 200) { status(\"Стоп: отказ сервера \" + res.code, \"err\"); return; }\n      var d = JSON.parse(res.body);\n      show(\"day\");\n      if (d.stopped === 1) {\n        status(\"Экстренная остановка: проба дня остановлена (статус stopped, окно закрыто). Пейсер, камера и запись остановлены.\", \"ok\");\n      } else {\n        status(\"Экстренная остановка: открытой пробы не было. Пейсер, камера и запись остановлены.\", \"ok\");\n      }\n    })\n    .catch(function (e) { status(\"Ошибка сети: \" + e, \"err\"); });\n}\ncheckDisclaimer();\n</script>\n</body>\n</html>\n"
}

// Open a practice session (the Н2-03 skeleton writer; the Н2-04/Н2-05
// screens are its clients). BOUNDARY pattern (the process_updates
// precedent of Н1-06): the route validates shapes loudly (whitelists,
// numeric guards over the escape bridge) and passes the values; inside
// the annotated parameters the data is sanctioned and the writers run.
// arm_id/trial_id below 1 mean "no linkage" and land as SQL NULL (the
// CASE form keeps ONE parameterized statement; 0 is never stored, so
// the FK clauses stay truthful under the enforced-references replay).
// Returns the new row id.
pattern miniapp_session_open(kind: String<public, trusted>, tempo_bpm: Float, steps_total: Float,
                             session_date: String<public, trusted>, arm_id: Float, trial_id: Float) -> Float {
  let _ = db_execute("INSERT INTO practice_session (kind, tempo_bpm, steps_total, session_date, arm_id, trial_id) VALUES (?, ?, ?, ?, CASE WHEN ? > 0 THEN ? END, CASE WHEN ? > 0 THEN ? END)", [kind, tempo_bpm, steps_total, session_date, arm_id, arm_id, trial_id, trial_id])
  let rows = query("SELECT last_insert_rowid() AS id", [])
  return rows[0].id
}

// Close/update a session: the completed-step count, the per-step marks
// and (from Н2-05) the RR series. BOUNDARY pattern: the raw JSON
// strings arrive trusted-by-annotation (the route capped their size
// and the parameterized UPDATE carries them verbatim — SQL-injection
// impossible); the JSON shape is validated by parse_json at every
// READ (garbage never decodes silently). Returns the number of
// updated rows (0 = unknown id — the route answers 404 loudly).
pattern miniapp_session_close(sid: Float, steps_done: Float, step_marks: String<public, trusted>,
                              rr_json: String<public, trusted>, rr_source: String<public, trusted>) -> Float {
  let _ = db_execute("UPDATE practice_session SET steps_done = ?, step_marks = ?, rr_json = ?, rr_source = ? WHERE id = ?", [steps_done, step_marks, rr_json, rr_source, sid])
  let rows = query("SELECT changes() AS n", [])
  return rows[0].n
}

// Read one session back (the module tests + the read path of
// Н2-06/Н2-07; a third-party sqlite3 client reads the same rows —
// invariant 6).
pattern miniapp_session_get(sid: Float) -> List {
  return query("SELECT id, kind, arm_id, trial_id, tempo_bpm, steps_total, steps_done, step_marks, rr_json, rr_source, session_date FROM practice_session WHERE id = ?", [sid])
}

// ── Н4-07: the disclaimer consent and the emergency stop ────────────────
// The disclaimer (the MIND-MASTERY first-launch screen; owner decision
// A — всё в Mini App) is recorded AS CONSENT: scope 'disclaimer:v1' in
// the consent table, the same data path as the safety classes. UNIQUE
// scope + INSERT OR IGNORE — a repeated accept changes nothing (the
// row count stays 1); the pattern returns the rows THIS call inserted
// (1 the first time, 0 on the repeat — the idempotency the tests pin).
// The source string rides the route's escape bridge (the sanitized
// provenance line, e.g. "miniapp 2026-11-03").
pattern consent_disclaimer_record(source: String<public, trusted>) -> Float {
  // The UNIQUE(scope) index is created HERE too (idempotent DDL): the
  // record path may run before the first tick on a fresh store —
  // without the index the idempotency contract does not hold. The name
  // is the arms seed's idx_consent_scope_unique — one index, one name.
  let _ = db_execute("CREATE UNIQUE INDEX IF NOT EXISTS idx_consent_scope_unique ON consent(scope)", [])
  let _ = db_execute("INSERT OR IGNORE INTO consent (scope, source) VALUES ('disclaimer:v1', ?)", [source])
  let rows = query("SELECT changes() AS n", [])
  return rows[0].n
}

// The disclaimer state (the page asks before the first launch; the
// morning tick hints while the record is absent). A revoked row is not
// a consent — the same revoked=0 filter every consent check applies.
pattern consent_disclaimer_present() -> Bool {
  let rows = query("SELECT count(*) AS n FROM consent WHERE scope = 'disclaimer:v1' AND revoked = 0", [])
  return rows[0].n > 0.0
}

// The emergency stop — available ALWAYS (общая с Н4-04: the player
// reuses this endpoint). ONE data effect: today's proposed trial
// leaves the window as 'stopped' — a NEW status string; every
// analytics filter keys on 'completed'/'missed', so a stopped trial
// never fabricates a miss and never enters a posterior (the honest
// hole: the practice was interrupted, no outcome exists). The plan
// rows and the pacer/PPG loops are the page's LOCAL stop (the button
// stops the loops client-side and calls this endpoint). Idempotent:
// the second call finds no proposed trial and stops nothing.
pattern emergency_stop(stop_date: String<public, trusted>) -> Struct {
  let open = query("SELECT id FROM trial WHERE status = 'proposed' AND trial_date = ? AND arm_id IS NOT NULL ORDER BY id DESC LIMIT 1", [stop_date])
  if len(open) == 0.0 {
    return {trial: 0.0, stopped: 0.0}
  }
  let tid = open[0].id
  let _ = db_execute("UPDATE trial SET status = 'stopped', closed_at = datetime('now') WHERE id = ? AND status = 'proposed'", [tid])
  return {trial: tid, stopped: 1.0}
}
// ── APP-MIRROR-END: miniapp-core ─────────────────────────────────────────

// ── APP-MIRROR-START: telegram-core (byte-identical to
//    src/telegram/telegram.mlog §telegram-core) ────────────────────────

// The OWNER's calendar date of a unix timestamp, "YYYY-MM-DD" (Н2-10):
// pure UTC arithmetic over an explicit offset (hours, local = UTC +
// offset, the same KAMERTON_TZ_OFFSET semantics the cron expressions
// use). The system time zone of the process is NEVER consulted —
// date_format_iso is UTC (probe-pinned under TZ=UTC/Moscow/New_York) —
// so the trial date, the tick and the cron schedule share ONE clock.
pattern owner_date(unix_ts: Float, tz_offset_hours: Float) -> String {
  return substring(date_format_iso(unix_ts + tz_offset_hours * 3600.0), 0, 10)
}

// The acceptance-window date: the window of the trial of day D lasts
// until 02:00 of D+1 (the evening tick), so the window date is the
// owner's date of (moment - 2 h). 01:00 D+1 belongs to D; 03:30 D+1
// belongs to D+1, whose trial may not exist yet.
pattern window_date(unix_ts: Float, tz_offset_hours: Float) -> String {
  return owner_date(unix_ts - 7200.0, tz_offset_hours)
}

// Fold local wall-clock minutes to the UTC cron expression for a fixed
// local time. local_minutes = hour*60+minute in the OWNER's wall
// clock, tz_offset_hours = local = UTC + offset. No modulo operator:
// the +2880 pad keeps the subtraction non-negative before the
// truncating division (the bandit explore-idx precedent).
pattern cron_expr_for(local_minutes: Float, tz_offset_hours: Float) -> String {
  let off_min = to_int(tz_offset_hours * 60.0)
  let shifted = local_minutes - to_float(off_min) + 2880.0
  let day = to_int(shifted / 1440.0)
  let modm = shifted - day * 1440.0
  let hh = to_int(modm / 60.0)
  let mm = modm - hh * 60.0
  return to_string(mm) + " " + to_string(hh) + " * * *"
}

// Н2-13: the weekly report DAY guard. The cron store accepts only
// 5-field expressions (probe-pinned: a dow field answers
// [CRON_JOB_FAILED] expects a 5-field expression), so the weekly job
// is registered DAILY at 09:30 local and the tick self-guards on the
// local weekday: date_parts.weekday is 0-based from Monday
// (probe-pinned: 2026-10-23, a Friday, carries weekday=4) — Monday = 0.
// A daily fire that sends once a week; the alternative does not exist
// in the cron subsystem (declared loudly).
pattern is_weekly_report_day(now_ts: Float) -> Bool {
  let p = date_parts(now_ts)
  return p.weekday == 0.0
}

// Parse one chat text into the protocol answer. Returns
// {kind: "prediction"|"moment"|"note", value: Float, text: String}.
// to_float fails LOUD on garbage (the m0_row precedent) — a malformed
// p:/m: answer degrades to a note, never to a silent zero.
pattern parse_chat_text(raw_text: String) -> Struct {
  let text = trim(raw_text)
  if starts_with(text, "p:") {
    let rest = trim(substring(text, 2, len(text)))
    // №514: to_float fails LOUD on garbage — a malformed answer
    // degrades to a note through the explicit -1 sentinel, never to a
    // silent zero (a silent zero would fabricate a prediction).
    let v = to_float_or(rest, 0 - 1.0)
    if v < 0.0 {
      return {kind: "note", value: 0.0, text: text}
    }
    return {kind: "prediction", value: v, text: text}
  }
  if starts_with(text, "m:") {
    let rest = trim(substring(text, 2, len(text)))
    let v = to_float_or(rest, 0 - 1.0)
    if v < 0.0 {
      return {kind: "note", value: 0.0, text: text}
    }
    return {kind: "moment", value: v, text: text}
  }
  // Н2-12: the full-reward protocol — «сдвиг через сутки» (nd:) и
  // «действие в сторону ноты за 72 часа» (act:). The same -1 sentinel:
  // garbage degrades to a note, never to a fabricated component value.
  if starts_with(text, "nd:") {
    let rest = trim(substring(text, 3, len(text)))
    let v = to_float_or(rest, 0 - 1.0)
    if v < 0.0 {
      return {kind: "note", value: 0.0, text: text}
    }
    return {kind: "next_day", value: v, text: text}
  }
  if starts_with(text, "act:") {
    let rest = trim(substring(text, 4, len(text)))
    let v = to_float_or(rest, 0 - 1.0)
    if v < 0.0 {
      return {kind: "note", value: 0.0, text: text}
    }
    return {kind: "action", value: v, text: text}
  }
  // Н2-13: the optional sleep context (s:0..1) — the ONLY source of
  // sleep_quality in the Telegram circuit; when it is absent the value
  // is NOT fabricated (the silent zero is forbidden — the -1 sentinel
  // stands for «не отвечено», declared in the PR).
  if starts_with(text, "s:") {
    let rest = trim(substring(text, 2, len(text)))
    let v = to_float_or(rest, 0 - 1.0)
    if v < 0.0 {
      return {kind: "note", value: 0.0, text: text}
    }
    return {kind: "sleep", value: v, text: text}
  }
  // Н2-13: the honesty-valve report on request (the proposed word;
  // both the Russian and the latin form map to one kind).
  if starts_with(text, "отчёт") or starts_with(text, "report") {
    return {kind: "report", value: 0.0, text: text}
  }
  // Н4-03: the day-plan commands. The SAME -1 sentinel family: a bare
  // «сделано» or a garbage number degrades to a note (never a
  // fabricated position); a valid number outside the plan range stays
  // a plan_done — the branch answers loudly «нет пункта N». The mood
  // of d: is the token before the first space (mlog has no split; the
  // first-space scan is the honest primitive), 0..1, and a garbage
  // mood degrades the whole line to a note too.
  if text == "план" {
    return {kind: "plan", value: 0.0, text: text}
  }
  if starts_with(text, "+") {
    let rest = trim(substring(text, 1, len(text)))
    if rest == "" {
      return {kind: "note", value: 0.0, text: text}
    }
    return {kind: "plan_add", value: 0.0, text: rest}
  }
  if starts_with(text, "сделано") {
    let rest = trim(substring(text, 7, len(text)))
    if rest == "" {
      return {kind: "note", value: 0.0, text: text}
    }
    let v = to_float_or(rest, 0 - 1.0)
    if v < 0.0 {
      return {kind: "note", value: 0.0, text: text}
    }
    return {kind: "plan_done", value: v, text: text}
  }
  if starts_with(text, "d:") {
    let rest = trim(substring(text, 2, len(text)))
    if rest == "" {
      return {kind: "note", value: 0.0, text: text}
    }
    // The first space cuts the mood token off the note (the note may
    // contain colons, digits and further spaces — only the FIRST space
    // separates).
    let mut cut = len(rest)
    let mut i = 0.0
    while i < len(rest) {
      if cut == len(rest) {
        if substring(rest, i, i + 1.0) == " " {
          cut = i
        }
      }
      i = i + 1.0
    }
    let mood_v = to_float_or(trim(substring(rest, 0, cut)), 0 - 1.0)
    if mood_v < 0.0 or mood_v > 1.0 {
      return {kind: "note", value: 0.0, text: text}
    }
    let note_part = trim(substring(rest, cut, len(rest)))
    return {kind: "journal", value: mood_v, text: note_part}
  }
  // Н4-07: the emergency stop — the EXACT command words only (a note
  // that merely starts with «стоп» stays a note: starts_with would
  // hijack «остановился на середине» and fabricate a stop).
  if text == "стоп" or text == "stop" {
    return {kind: "stop", value: 0.0, text: text}
  }
  return {kind: "note", value: 0.0, text: text}
}

// The morning proposal message. Every dynamic fragment passes
// escape_html — the acceptance row: DB output never reaches the chat
// raw. Н2-09: the practice body is a third fragment — the proposal
// must tell what to do, not just name the hand. Н2-11: the proposal
// names BOTH answer formats — p: now, the m: request arrives in the
// evening collect tick.
pattern format_proposal(arm_name: String, practice_body: String, note_body: String, contra: String) -> String {
  // Н4-07: the contraindications ride the proposal (BEFORE the start —
  // the naryad's rule). An empty contra keeps the message shape
  // byte-stable for every practice without contraindications.
  let mut msg = "Проба дня: " + escape_html(arm_name) + ".\nПрактика: " + escape_html(practice_body) + "\nНота: " + escape_html(note_body) + "\nОтветь предсказанием: p:0..1. Вечером придёт сбор отклика: m:0..1"
  if contra != "" {
    msg = msg + "\nПротивопоказания: " + escape_html(contra) + " — начинай только если они к тебе не относятся."
  }
  return msg
}

// Н4-03: the day-plan rendering. Every dynamic fragment passes
// escape_html (the acceptance row: DB output never reaches the chat
// raw). The sources are the issue's own words — «рекомендация» (the
// bandit's experimental pick) and «выбор владельца» (free practice).
// The footer names the command formats and pins the Шаг 0 default:
// the p:/m: answers bind to the recommendation trial ONLY.
pattern format_plan(plan_date: String, rows: List) -> String {
  if len(rows) == 0.0 {
    return "План на " + escape_html(plan_date) + ": пуст.\nДобавить практику: +<фрагмент названия>. Утром придёт рекомендация бандита — она и есть проба дня."
  }
  let mut body = ""
  let mut i = 0.0
  each r in rows {
    let mut mark = "выбор владельца"
    if r.source == "recommendation" {
      mark = "рекомендация"
    }
    let mut st = ""
    if r.status == "done" {
      st = " — сделано"
    }
    body = body + to_string(i + 1.0) + ". " + escape_html(r.name) + " (" + mark + ")" + st + "\n"
    i = i + 1.0
  }
  return "План на " + escape_html(plan_date) + ":\n" + body + "Дополнить: +<фрагмент>. Отметить: сделано N. Дневник: d:0.0..1 заметка.\nОтклики p:/m: — только проба дня (рекомендация); свободные сессии в данные бандита не входят."
}

// Н4-03: the ambiguous add — the candidates are listed, nothing is
// added on a guess (the loud ambiguity, no silent pick).
pattern format_plan_candidates(fragment: String, rows: List) -> String {
  let mut body = ""
  each r in rows {
    body = body + "- " + escape_html(r.name) + "\n"
  }
  return "Уточни: «" + escape_html(fragment) + "» найдено несколько:\n" + body + "Добавь точнее: +<более длинный фрагмент или точное название>."
}

// Н4-03: the add miss — loud, with the way out.
pattern format_plan_notfound(fragment: String) -> String {
  return "«" + escape_html(fragment) + "» в каталоге не найдено. Весь каталог — в Mini App; добавить: +<фрагмент названия>."
}

// Н4-03: the morning offer to fill the day (the owner's decision of
// 2026-11-02). Static text — escape_html has nothing to lift.
pattern format_plan_hint() -> String {
  return "Дополнить день свободной практикой: +<фрагмент названия>. Весь план: план. Свободные сессии в данные бандита не входят."
}

// The morning proposal row: arm name + optional note body + the group
// practice text. SQL NULL from the LEFT JOIN materializes as Unit on
// 0.30.0 (probe-pinned, Н2-01) — escape_html would fail-closed
// [TYPE_MISMATCH] inside the first seeded proposal (the body would not
// be a String), so the note is COALESCEd to a String here. Н2-09: the
// practice text joins by arm.group_name; a missing or empty row
// degrades LOUD to «(нет текста практики)» — NULLIF lifts the empty
// string into the same COALESCE fallback, never a silent blank.
pattern morning_proposal_row(tid: Float) -> List {
  // Н4-07: the row carries the practice's contraindications (LEFT JOIN
  // — a hand without a protocol row keeps the empty contra; the empty
  // string keeps the proposal clean). The proposal shows them BEFORE
  // the start — the naryad's rule.
  return query("SELECT a.name, COALESCE(n.body, '') AS body, COALESCE(NULLIF(p.body, ''), '(нет текста практики)') AS practice, COALESCE(NULLIF(pp.contraindications, ''), '') AS contra FROM trial t JOIN arm a ON a.id = t.arm_id LEFT JOIN note n ON n.id = t.note_id LEFT JOIN practice_text p ON p.group_name = a.group_name LEFT JOIN practice_protocol pp ON pp.arm_id = t.arm_id WHERE t.id = ?", [tid])
}

// The evening report message.
pattern format_report(processed: Float, closed: Float, predictions: Float, moments: Float) -> String {
  return "Отчёт: обработано " + escape_html(to_string(processed)) + ", закрыто пропуском " + escape_html(to_string(closed)) + ", предсказаний " + escape_html(to_string(predictions)) + ", откликов " + escape_html(to_string(moments))
}

// Н2-11: the evening collect request. ONE message per evening, sent by
// tg_collect_tick ONLY when today's window still holds an open trial
// with no moment (pending_collect_trial below); silence otherwise. No
// reminders: a skip is the normal outcome, never chased (the concept's
// load norm). The text is STATIC — no DB fragment rides in it, so
// escape_html has nothing to lift; the wording is the proposed legend
// (шкала m:), pending the owner's approval per the naryad Шаг 0 —
// replaceable by this one string.
pattern format_collect_request() -> String {
  return "Вечерний сбор: как прошла проба? Один отклик в моменте: m:0..1 — 0 совсем не то состояние, 1 полностью оно. Пропустить можно просто не отвечая: окно закроется в 02:00."
}

// The collect-tick decision (Н2-11): the open trial of the window that
// still lacks the moment — the request fires exactly when this returns
// a row. The moment guard rides the response table (the ANY-moment
// count, the same guard apply_answer and the spectral projection use):
// a moment already given — subjective or spectral — silences the tick.
pattern pending_collect_trial(window_date: String) -> List {
  return query("SELECT t.id FROM trial t WHERE t.status = 'proposed' AND t.trial_date = ? AND t.arm_id IS NOT NULL AND NOT EXISTS (SELECT 1 FROM response r WHERE r.trial_id = t.id AND r.kind = 'moment') ORDER BY t.id DESC LIMIT 1", [window_date])
}

// Н2-12: the full-reward question helpers. The asks ride the morning
// tick (D+1 asks «сдвиг» about D's trial, D+3 asks «действие» about
// D's trial — ADR-0001's 72-hour component). Only COMPLETED trials are
// asked about: the moment arrived, the practice is confirmed — asking
// about a silent window would presuppose a practice that never was.
// Unanswered components stay ABSENT (present flag 0, ADR-0001) — the
// silence is never rewritten into a zero.
// Н2-13: the sleep context binds to the window's LATEST trial in ANY
// status — a completed trial (the practice done, the sleep note about
// that day arrives late) must still accept it; a missed one too (the
// row stays blind — the read guard keys on response rows).
pattern latest_window_trial(window_date: String) -> List {
  return query("SELECT id FROM trial WHERE trial_date = ? AND arm_id IS NOT NULL ORDER BY id DESC LIMIT 1", [window_date])
}

pattern pending_next_day_trial(window_date: String) -> List {
  return query("SELECT t.id FROM trial t WHERE t.status = 'completed' AND t.trial_date = ? AND t.arm_id IS NOT NULL AND t.next_day_present = 0 ORDER BY t.id DESC LIMIT 1", [window_date])
}

pattern pending_action_trial(window_date: String) -> List {
  return query("SELECT t.id FROM trial t WHERE t.status = 'completed' AND t.trial_date = ? AND t.arm_id IS NOT NULL AND t.action_present = 0 ORDER BY t.id DESC LIMIT 1", [window_date])
}

// The question texts (STATIC — proposed wording, pending the owner's
// approval per the naryad Шаг 0; replaceable by these one strings).
pattern format_next_day_question() -> String {
  return "Сдвиг после вчерашней пробы? Один ответ: nd:0..1 (0 — никакого сдвига, 1 — явный)"
}

pattern format_action_question() -> String {
  return "Действие в сторону ноты за 72 часа? Один ответ: act:0..1 (0 — не было, 1 — было и двигает)"
}

// The getUpdates URL with the offset + the long-poll timeout. The
// token lives in the URL path (the Bot API contract); it is read from
// the environment at the call site and never printed or echoed.
pattern get_updates_url(token: String, offset: Float) -> String {
  return "https://api.telegram.org/bot" + token + "/getUpdates?offset=" + to_string(offset) + "&timeout=25"
}

// One long-poll getUpdates with the №592 per-call deadline and the
// three-attempt caller-side retry (the language hides no retry inside,
// CHANGELOG-282). Returns the parsed update LIST — UNTRUSTED network
// data; the consumer must run it through the annotated boundary
// (process_updates). Empty List on exhausted retry: the caller
// distinguishes the drain outcome by the offset, silence is never
// fabricated as data.
// http_get returns the body as a RAW STRING (probe-pinned 2026-10-08):
// parse_json before json_get is mandatory — a direct json_get on the
// String silently returns the default and the drain sees an empty list.
pattern fetch_updates(token: String, offset: Float) -> List {
  let url = get_updates_url(token, offset)
  let mut attempt = 0.0
  while attempt < 3.0 {
    attempt = attempt + 1.0
    let r = try http_get(url, 40.0)
    // Sanitize-then-decide: escape_html restores integrity trust
    // (the №716 contract — the raw untrusted flag never decides,
    // probe-pinned since 0.30.0). The wrapped guard shape is not
    // provable by the №802 flow pass — the value read inside the
    // branch carries the sanctioned suppression with the reason.
    if escape_html(to_string(r.ok)) == "true" {
      // allow(unchecked_result): r.value is read only behind the
      // escape_html(to_string(r.ok)) == "true" decision above — the
      // sanitize-then-decide bridge restores integrity before the
      // branch; the obfuscated guard is deliberate (№802, ADR-0198).
      return json_get(parse_json(to_string(r.value)), "result", [])
    }
    if attempt < 3.0 {
      sleep(15.0)
    }
  }
  return []
}
// ── Н4-08: the Moment of Power (MIND-MASTERY перенос, наряд #100) ───────
// Детерминированная минута «момента силы» из даты и секрета владельца:
// хэш Кнута из MIND-MASTERY (src/core/hash/knuth.ts @ 2a26e75),
// minute = windowStart + (hash mod range). В языке НЕТ ни побитовых
// операций, ни modulo (grammar v0.38.0, probe-pinned в работе наряда) —
// 32-битная арифметика эмулируется ТОЧНО на Float: mod32/shr16 — целое
// деление, xor32 — 32-шаговый побитовый цикл, imul32 — разбиение на
// 16-битные половины (все промежуточные произведения < 2^50, точность
// Float до 2^53 достаточна). Эталонные векторы MIND-MASTERY воспроизводятся
// побайтно (пять дат, тест ниже) — затык §2 не объявляется.
//
// Окно и секрет — факты владельца (Шаг 0 наряда): KAMERTON_MOMENT_START /
// KAMERTON_MOMENT_END (минуты от полуночи; дефолт 480/1260 — ПРЕДЛОЖЕНИЕ
// наряда 08:00–21:00, до утверждения владельцем переопределяется env),
// KAMERTON_MOMENT_SECRET (без него тик громко отказывается),
// KAMERTON_MOMENT_TEXT (текст подсказки; без него тихий отказ с печатью —
// тексты момента исполнитель не придумывает). Подсказка ответа не требует
// и в данные не пишется.
pattern mod32(x: Float) -> Float {
  // no early return under if (the D2-family case 4): the negative
  // branch folds into the value, one fold is enough (inputs are far
  // above -2^32)
  let mut y = x
  if y < 0.0 {
    y = y + 4294967296.0
  }
  return y - to_int(y / 4294967296.0) * 4294967296.0
}
pattern mod65536(x: Float) -> Float {
  return x - to_int(x / 65536.0) * 65536.0
}
pattern shr16(x: Float) -> Float {
  return to_int(mod32(x) / 65536.0)
}
pattern xor32(a: Float, b: Float) -> Float {
  let mut x = to_int(mod32(a))
  let mut y = to_int(mod32(b))
  let mut acc = 0.0
  let mut bit = 1.0
  let mut i = 0.0
  while i < 32.0 {
    let bx = x - to_int(x / 2.0) * 2.0
    let by = y - to_int(y / 2.0) * 2.0
    if bx != by {
      acc = acc + bit
    }
    x = to_int(x / 2.0)
    y = to_int(y / 2.0)
    bit = bit * 2.0
    i = i + 1.0
  }
  return acc
}
pattern imul32(a: Float, b: Float) -> Float {
  let al = mod65536(mod32(a))
  let ah = to_int(mod32(a) / 65536.0)
  let bl = mod65536(mod32(b))
  let bh = to_int(mod32(b) / 65536.0)
  let lo = al * bl
  let mid = mod65536(ah * bl + al * bh)
  return mod32(lo + mid * 65536.0)
}
pattern knuth_hash(year: Float, month: Float, day: Float, seed: Float) -> Float {
  let mut x = xor32(mod32(year * 2654435761.0), mod32(month * 2246822519.0))
  x = xor32(x, mod32(day * 3266489917.0))
  x = xor32(x, mod32(to_int(seed) * 668265263.0))
  x = imul32(shr16(x), 73244475.0)
  x = imul32(xor32(x, shr16(x)), 73244475.0)
  x = xor32(x, shr16(x))
  return mod32(x)
}
// Детерминированная минута «момента силы» для даты "YYYY-MM-DD" в окне
// [start_min, end_min): равномерность — младшие биты мультипликативного
// хэша Кнута; одна дата и семя — одна минута навсегда.
pattern moment_minute(date_str: String, seed: Float, start_min: Float, end_min: Float) -> Float {
  let year = to_float(substring(date_str, 0, 4))
  let month = to_float(substring(date_str, 5, 7))
  let day = to_float(substring(date_str, 8, 10))
  let h = knuth_hash(year, month, day, seed)
  let range = end_min - start_min
  return start_min + (h - to_int(h / range) * range)
}
// Решение об отправке (саму отправку делает тик — сетевой-free тест):
// 1 = отправить сейчас (первый тик после наступившей минуты, в окне,
// за день ещё не отправлено), 0 = нет. Kv-гвард "moment_sent_<дата>" —
// повторный тик никогда не дублирует; в данные бандита не пишется.
pattern moment_send_once(today: String, local_min: Float, trigger_min: Float, end_min: Float) -> Float {
  // no early returns under if (the D2-family case 4): one positive
  // branch carries the whole decision, the refusals fall through to the
  // default zero — the miscompiled early-return shape would write the
  // kv guard on a REFUSAL tick and silence the moment for the whole day
  let mut ok = 0.0
  if local_min >= trigger_min and local_min <= end_min {
    let key = "moment_sent_" + today
    if kv_get(key) == "" {
      let _ = kv_set(key, "1")
      ok = 1.0
    }
  }
  return ok
}
// The env-facts of the moment ride BARRIER patterns (the fetch_updates
// precedent): the secret/env reading happens inside, the tick body gets
// sanctioned values — the №391 audit lane never sees a secret-derived
// print inside the tick branches.
pattern moment_seed_present() -> Bool {
  let s = env_or("KAMERTON_MOMENT_SECRET", "")
  let mut present = false
  if s != "" {
    present = true
  }
  return present
}
pattern moment_hint_text() -> String {
  return env_or("KAMERTON_MOMENT_TEXT", "")
}
pattern moment_window_start() -> Float {
  return to_float_or(env_or("KAMERTON_MOMENT_START", "480"), 480.0)
}
pattern moment_window_end() -> Float {
  return to_float_or(env_or("KAMERTON_MOMENT_END", "1260"), 1260.0)
}
// BARRIER: the secret stays inside; out comes only the deterministic
// trigger minute of the given local date (no early returns — the D2-family
// case 4): an unset secret yields minute 0 with the tick refusing loudly
// by moment_seed_present before this call.
pattern moment_trigger(today: String<public, trusted>) -> Float {
  let mut minute = 0.0
  if moment_seed_present() == true {
    let seed_str = env_or("KAMERTON_MOMENT_SECRET", "")
    minute = moment_minute(today, to_float(to_int(to_float_or(seed_str, 0.0))), moment_window_start(), moment_window_end())
  }
  return minute
}
// The tick STATUS (0 ok / 1 secret absent / 2 text absent) — the env
// facts ride the barriers, the tick body only branches on the status.
pattern moment_tick_status() -> Float {
  let mut status = 0.0
  if moment_seed_present() == false {
    status = 1.0
  }
  if status == 0.0 and moment_hint_text() == "" {
    status = 2.0
  }
  return status
}
// The tick DECISION (0/1): the window, the local minute and the kv
// once-per-day guard live inside the barrier; out comes only the flag.
pattern moment_tick_decide(today: String<public, trusted>) -> Float {
  let mut go = 0.0
  if moment_seed_present() == true {
    let off = to_float(env_or("KAMERTON_TZ_OFFSET", "0"))
    let p = date_parts(now_unix() + off * 3600.0)
    let local_min = p.hour * 60.0 + p.minute
    go = moment_send_once(today, local_min, moment_trigger(today), moment_window_end())
  }
  return go
}
// ── APP-MIRROR-END: telegram-core

// ── APP-MIRROR-START: context-core (byte-identical to
//    src/context/context.mlog §context-core) ─────────────────────────
// ── Moon arithmetic (synodic, no external libraries) ──────────────────

entity MOON_EPOCH: Float = 947182440.0
entity SYNODIC: Float = 29.530588853

// Age of the moon in days, [0, SYNODIC). The language has no modulo:
// `x - to_int(x/syn)*syn` is fmod for positive x (truncating to_int),
// identical to the reference implementation's double math.
pattern moon_age(unix: Float) -> Float {
  let diff_days = (unix - MOON_EPOCH) / 86400.0
  let cycles = to_int(diff_days / SYNODIC)
  return diff_days - cycles * SYNODIC
}

// Eight equal sectors of syn/8 starting AT the new moon (age 0):
// new [0, 3.6913), waxing_crescent [3.6913, 7.3826), first_quarter
// [7.3826, 11.0740), waxing_gibbous [11.0740, 14.7653), full
// [14.7653, 18.4566), waning_gibbous [18.4566, 22.1479), last_quarter
// [22.1479, 25.8392), waning_crescent [25.8392, 29.5306).
// age < SYNODIC by construction, so to_int lands in 0..7.
pattern moon_phase_name(age: Float) -> String {
  let sector = to_int(age / (SYNODIC / 8.0))
  if sector < 1 { return "new_moon" }
  if sector < 2 { return "waxing_crescent" }
  if sector < 3 { return "first_quarter" }
  if sector < 4 { return "waxing_gibbous" }
  if sector < 5 { return "full_moon" }
  if sector < 6 { return "waning_gibbous" }
  if sector < 7 { return "last_quarter" }
  if sector < 8 { return "waning_crescent" }
  return "new_moon"
}

// Synodic day 1..30 (age 0.0 -> day 1; age 29.5 -> day 30; the wrap to
// day 1 happens through moon_age at the synodic boundary).
pattern moon_day(age: Float) -> Float {
  return to_int(age) + 1.0
}

// The stored form: BOTH the phase and the synodic day in one
// machine-readable string (the context table has no moon-day column;
// decision 4 above). Pinned by a test.
pattern moon_record(unix: Float) -> String {
  let age = moon_age(unix)
  return "phase=" + moon_phase_name(age) + "|day=" + to_string(moon_day(age))
}

// ── Day window (concept schedule; decision 5) ─────────────────────────

// morning = local 07:00..21:29, evening = 21:30..06:59. Flat guard
// chain — no nested-if returns (the Н1-06 §2 lesson). The UTC instant
// stays UTC; only the display window folds through tz_offset.
pattern day_window_for(unix: Float, tz_offset: Float) -> String {
  let local = unix + tz_offset * 3600.0
  let day_sec = local - to_int(local / 86400.0) * 86400.0
  let hour_frac = day_sec / 3600.0
  if hour_frac < 7.0 { return "evening" }
  if hour_frac < 21.5 { return "morning" }
  return "evening"
}

// ── Blind logging (инвариант 2; decision 1) ───────────────────────────

// Writes the context row ALWAYS (at probe time) and returns the row id.
// weather/sound_mode stay empty in wave 1 (no weather feed, no sound
// modes in the arm space — the M3 reserve); the columns exist in the
// store schema and future providers fill them without a migration.
pattern collect_context(trial_id: Float, now: Float, sleep_quality: Float) -> Float {
  let rec = moon_record(now)
  return db_insert("context", {trial_id: trial_id, moon_phase: rec, weather: "", sound_mode: "", sleep_quality: sleep_quality})
}

// The ONLY read API. Blind (returns "") until a response row exists for
// the trial — decision 1. After the response the full record opens:
// "<moon_phase>|sleep_quality=<v>|weather=<w>|sound_mode=<s>|logged_at=<ts>"
// (moon_phase itself is "phase=…|day=…"). The consumers branch on the
// empty string — the one loud blindness contract.
pattern read_context(trial_id: Float) -> String {
  let resp = query("SELECT count(*) AS n FROM response WHERE trial_id = ?", [trial_id])
  if resp[0].n < 1.0 { return "" }
  let rows = query("SELECT trial_id, moon_phase, weather, sound_mode, sleep_quality, logged_at FROM context WHERE trial_id = ?", [trial_id])
  return rows[0].moon_phase + "|sleep_quality=" + to_string(rows[0].sleep_quality) + "|weather=" + rows[0].weather + "|sound_mode=" + rows[0].sound_mode + "|logged_at=" + rows[0].logged_at
}
// ── APP-MIRROR-END: context-core ─────────────────────────────────────

// ── APP-MIRROR-START: honesty-report-core (byte-identical to
//    src/report/report.mlog §honesty-report-core) ─────────────────────
// ── The honesty math ──────────────────────────────────────────────────

// The bandit side: every completed trial is a bandit pick with its
// realized reward. The population variance form is declared (decision 2).
// Returns the map {n, m, se} — the reward mean and its SE over the
// completed picks.
pattern bandit_side() -> map {
  let rows = query("SELECT count(*) AS n, avg(reward) AS m, avg(reward * reward) AS m2 FROM trial WHERE status = 'completed'", [])
  let n = to_float_or(to_string(rows[0].n), 0.0)
  let m = to_float_or(to_string(rows[0].m), 0.0)
  let m2 = to_float_or(to_string(rows[0].m2), 0.0)
  let mut var = m2 - m * m
  if var < 0.0 { let var = 0.0 }
  let mut se = 0.0
  if n > 0.0 {
    let se = sqrt(var / n)
  }
  return {n: n, m: m, se: se}
}

// The random-choice baseline: the unweighted mean of the per-arm mean
// rewards (decision 1). Returns the map {arms, m, se} — the arm count
// and the baseline mean with its SE across arm means.
pattern random_baseline() -> map {
  let rows = query("SELECT count(*) AS arms, avg(m) AS m, avg(m * m) AS m2 FROM (SELECT arm_id, avg(reward) AS m FROM trial WHERE status = 'completed' GROUP BY arm_id)", [])
  let k = to_float_or(to_string(rows[0].arms), 0.0)
  let m = to_float_or(to_string(rows[0].m), 0.0)
  let m2 = to_float_or(to_string(rows[0].m2), 0.0)
  let mut var = m2 - m * m
  if var < 0.0 { let var = 0.0 }
  let mut se = 0.0
  if k > 0.0 {
    let se = sqrt(var / k)
  }
  return {arms: k, m: m, se: se}
}

// A number in the report form: rounded to hundredths, no long tails.
pattern fmt2(x: Float) -> String {
  return to_string(round(x * 100.0) / 100.0)
}

// The verdict (decision 3). The band edges mb ∓ 1.96·se_b are compared
// against the baseline constant.
pattern honesty_verdict() -> String {
  let b = bandit_side()
  if b.n < 1.0 { return "сигнала нет — данных нет (completed=0)" }
  let r = random_baseline()
  let lo = b.m - 1.96 * b.se
  let hi = b.m + 1.96 * b.se
  if lo > r.m { return "выигрыш есть — бандит лучше случайного выбора" }
  if hi < r.m { return "выигрыша нет — хуже случайного выбора" }
  return "сигнала нет — выигрыш над случайным выбором не выявлен"
}

// The gain line: expected [low; high], all three present — no point
// estimate is ever printed alone (the acceptance row).
pattern gain_line() -> String {
  let b = bandit_side()
  let r = random_baseline()
  let lo = b.m - 1.96 * b.se - r.m
  let hi = b.m + 1.96 * b.se - r.m
  return "gain: expected=" + fmt2(b.m - r.m) + " [low=" + fmt2(lo) + "; high=" + fmt2(hi) + "] (95% approx)"
}

// Misses per arm — one aggregate line (decision 4): the fraction of
// missed trials per arm, every arm, SQL-carried order.
pattern misses_line() -> String {
  let rows = query("SELECT group_concat(t.g || ': ' || t.miss || '/' || t.n || ' (' || t.pct || '%)', '; ') AS s FROM (SELECT arm.name AS g, CAST(sum(CASE WHEN trial.status = 'missed' THEN 1 ELSE 0 END) AS INT) AS miss, CAST(count(*) AS INT) AS n, CAST(CAST(sum(CASE WHEN trial.status = 'missed' THEN 1 ELSE 0 END) AS REAL) * 100.0 / count(*) AS INT) AS pct FROM trial JOIN arm ON arm.id = trial.arm_id GROUP BY arm.name ORDER BY arm.name) AS t", [])
  if to_string(rows[0].s) == "" { return "misses: (нет проб)" }
  return "misses: " + to_string(rows[0].s)
}

// Moment sources, SEPARATE per source (ADR-0001 — no silent mixing):
// count and mean per source; the default empty source is listed as
// "(пусто)" so a silent default can never hide.
pattern source_lines() -> String {
  let rows = query("SELECT group_concat(CASE WHEN t.src = '' THEN '(пусто)' ELSE t.src END || ': n=' || CAST(t.n AS INT) || ' avg=' || CAST(ROUND(t.m, 2) AS TEXT), '; ') AS s FROM (SELECT moment_source AS src, count(*) AS n, avg(moment_value) AS m FROM trial WHERE moment_present = 1 GROUP BY moment_source ORDER BY moment_source) AS t", [])
  if to_string(rows[0].s) == "" { return "moment sources: (нет момент-откликов)" }
  return "moment sources: " + to_string(rows[0].s)
}

// The SSOT report text. The chat and CLI forms live in
// src/report/report.mlog (the mirror half of this naryad) and are
// derived from THIS text — one source, two presentations.
pattern honesty_report_text() -> String {
  let head = "honesty report\nverdict: " + honesty_verdict()
  let b = bandit_side()
  let r = random_baseline()
  let counts = "\ncompleted=" + to_string(round(b.n)) + " trials over " + to_string(round(r.arms)) + " arms"
  return head + counts + "\n" + gain_line() + "\n" + misses_line() + "\n" + source_lines()
}

// ── The presentation forms ────────────────────────────────────────────

// CLI: print the report to stdout. The assigned-call discipline keeps
// the bare-call defect class (D2/№612) away by construction.
pattern honesty_report_cli() -> Float {
  let text = honesty_report_text()
  print(text)
  return 1.0
}

// Chat: the escape_html-wrapped SSOT text — chat-ready, no raw output.
pattern honesty_report_chat() -> String {
  return escape_html(honesty_report_text())
}
// ── APP-MIRROR-END: honesty-report-core ──────────────────────────────
// ── The two cron ticks (the naryad: "два cron-тика в одном .mlog") ────

// The morning tick: propose an arm through the bandit core, write the
// trial (status 'proposed', the prediction fields stay at their
// defaults until the owner answers), message the owner. The proposal
// IS the prediction request — the owner answers p: during the day.
// Repeated ticks are safe (Н2-08): the proposal is one per day, a
// repeated tick re-shows the existing trial.
pattern tg_morning_tick() -> Unit {
  // Idempotent schema first: the tables exist even before the token
  // guard fires (the loud refusal must not leave an empty database).
  ensure_schema()
  // The wave-1 arm library seeded idempotently (Н2-01): the loud zero
  // ("Библиотека пуста") was the missing Н1-04 integration into the
  // serve composition — the seed lives in the arms-seed mirror above;
  // UNIQUE(name) + INSERT OR IGNORE make a repeated run a no-op.
  let _ = seed_arms()
  // Н3-01: the practice catalog (idempotent; every catalog hand starts inactive).
  let _ = seed_catalog()
  // Н4-02: the MIND-MASTERY script catalog (idempotent; every MM hand
  // starts inactive; a missing seeds/mm/*.json degrades LOUD — the
  // printed refusal — and the tick survives).
  let _ = seed_mm_catalog()
  // No early-return under a nested if (the D2-family case 4): the
  // guard inverts into a positive branch that carries the whole tick.
  let token = env_or("KAMERTON_TG_TOKEN", "")
  let chat_id = env_or("KAMERTON_CHAT_ID", "")
  if token != "" and chat_id != "" {
    let off = to_float(env_or("KAMERTON_TZ_OFFSET", "0"))
    let today = owner_date(now_unix(), off)
    // Н3-06: the slot rotation (ADR-0003) runs BEFORE the proposal —
    // the morning pick sees the freshly rotated set. The rotation is
    // self-gating: an incomplete slot (the owner's set not chosen yet)
    // and the methods slot without the Н3-05 armed cap stay untouched;
    // the 14-day window and the 90-day cooldown ride the journal. Every
    // decision is journaled with its numbers (actor 'rotation'); the
    // forced exploration floor is untouched. A count above zero is
    // printed for the audit trail.
    let rotated = rotate_slots()
    if rotated > 0.0 {
      print("[rotation] " + to_string(rotated) + " slot replacement(s)")
    }
    let tid = bandit_propose(today, now_unix())
    let mut msg = "Библиотека пуста — предложение не сформировано (громкий ноль бандита)"
    if tid != 0.0 {
      let arm_rows = morning_proposal_row(tid)
      if len(arm_rows) > 0.0 {
        // Н4-07: the contraindications ride the proposal (BEFORE the
        // start — the naryad's rule; the empty string keeps the shape).
        msg = format_proposal(arm_rows[0].name, arm_rows[0].practice, arm_rows[0].body, arm_rows[0].contra)
      } else {
        msg = "Проба дня (trial #" + to_string(tid) + ")"
      }
      // Н4-03: the recommendation lands in the day plan (idempotent —
      // one row, source 'recommendation'); the plan then shows the
      // experimental pick next to the owner's free picks.
      let arm_id = trial_arm_id(tid)
      if arm_id > 0.0 {
        let _ = plan_add(today, arm_id, "recommendation")
      }
    }
    // Н4-03: the offer to fill the day (the owner's decision of
    // 2026-11-02) — ONE static line; escape_html has nothing to lift.
    msg = msg + "\n" + format_plan_hint()
    // Н4-07: the disclaimer hint until the consent is recorded — the
    // Mini App screen is the primary path (owner decision A: всё в
    // Mini App); the chat only points there, ONE line, no nagging.
    if consent_disclaimer_present() == false {
      msg = msg + "\nДисклеймер не принят: открой Mini App и прими его — без записи практики с противопоказаниями не добавляются."
    }
    // Н2-12: the full-reward asks ride the morning message — the D+1
    // «сдвиг» about yesterday's COMPLETED trial and the D+3 «действие»
    // about the trial of three days ago. Each ask pins its trial into
    // the kv pending (the answer binds by the pending — one trial per
    // question kind, never ambiguous); a successful write clears it.
    // Only completed trials are asked about (the moment confirmed the
    // practice); an unanswered component stays absent, never a zero.
    let yesterday = owner_date(now_unix() - 86400.0, off)
    let nd = pending_next_day_trial(yesterday)
    if len(nd) > 0.0 {
      let _ = kv_set("nd_pending_trial", to_string(nd[0].id))
      msg = msg + "\n" + format_next_day_question()
      print("[telegram] morning tick asks next_day about trial " + to_string(nd[0].id))
    }
    let three_ago = owner_date(now_unix() - 259200.0, off)
    let act = pending_action_trial(three_ago)
    if len(act) > 0.0 {
      let _ = kv_set("act_pending_trial", to_string(act[0].id))
      msg = msg + "\n" + format_action_question()
      print("[telegram] morning tick asks action about trial " + to_string(act[0].id))
    }
    let _ = send_message(chat_id, msg)
    print("[telegram] morning tick proposed trial " + to_string(tid))
  }
  if token == "" or chat_id == "" {
    print("[telegram] KAMERTON_TG_TOKEN/KAMERTON_CHAT_ID not set — morning tick refuses loudly")
  }
}

// The evening tick: drain getUpdates through the boundary, close the
// unanswered as misses (inside process_updates), report. Runs at 02:00
// LOCAL — the acceptance window closes without manual intervention; the
// message-date binding (Н2-10) routes every answer into its own window
// and the close threshold ends the window of now. The counters report
// stays THIS tick's signature: the collect tick (Н2-11) drains silently.
pattern tg_evening_tick() -> Unit {
  ensure_schema()
  let token = env_or("KAMERTON_TG_TOKEN", "")
  let chat_id = env_or("KAMERTON_CHAT_ID", "")
  if token != "" and chat_id != "" {
    let offset = to_float_or(kv_get("tg_offset"), 0.0)
    let updates = fetch_updates(token, offset)
    process_updates(updates, chat_id, now_unix(), to_float(env_or("KAMERTON_TZ_OFFSET", "0")), offset, true)
  }
  if token == "" or chat_id == "" {
    print("[telegram] KAMERTON_TG_TOKEN/KAMERTON_CHAT_ID not set — evening tick refuses loudly")
  }
}

// The evening collect tick (Н2-11): the concept's «сбор отклика 21:30».
// Drains getUpdates FIRST through the same boundary (the answers that
// arrived before 21:30 land in their own windows — the same offset code
// as the 02:00 tick), THEN asks for the moment exactly once: only when
// today's window still holds an open trial without a moment. If the
// moment is already given (subjective or spectral) or there is no
// trial — silence. No reminders, no catch-up: a skip is the normal
// outcome (the load norm), a repeated tick re-checks, never re-asks
// about an answered trial (the pending query guards).
pattern tg_collect_tick() -> Unit {
  ensure_schema()
  let token = env_or("KAMERTON_TG_TOKEN", "")
  let chat_id = env_or("KAMERTON_CHAT_ID", "")
  if token != "" and chat_id != "" {
    let off = to_float(env_or("KAMERTON_TZ_OFFSET", "0"))
    let offset = to_float_or(kv_get("tg_offset"), 0.0)
    let updates = fetch_updates(token, offset)
    process_updates(updates, chat_id, now_unix(), off, offset, false)
    let window = window_date(now_unix(), off)
    let pending = pending_collect_trial(window)
    if len(pending) > 0.0 {
      let _ = send_message(chat_id, format_collect_request())
      print("[telegram] collect tick: moment requested for trial " + to_string(pending[0].id))
    }
  }
  if token == "" or chat_id == "" {
    print("[telegram] KAMERTON_TG_TOKEN/KAMERTON_CHAT_ID not set — collect tick refuses loudly")
  }
}

// Н4-08: the Moment of Power tick (MIND-MASTERY перенос). The cron fires
// every 10 minutes ("*/10 * * * *", probe-pinned); the tick self-guards:
//   - the secret (KAMERTON_MOMENT_SECRET) is REQUIRED — without it the
//     tick refuses loudly (the owner's fact, never fabricated);
//   - the window rides KAMERTON_MOMENT_START/END (minutes from local
//     midnight; the DEFAULTS 480/1260 are the naryad's PROPOSAL
//     08:00–21:00, re-definable by env until the owner confirms);
//   - the hint text rides KAMERTON_MOMENT_TEXT — without it the tick
//     refuses loudly with a print (the moment texts are the owner's
//     facts, the executor does not invent them);
//   - the trigger minute is moment_minute(today, seed, start, end) —
//     deterministic for the day; the message goes out ONCE per day on
//     the first tick after the minute (moment_send_once, the kv guard);
//   - local minutes ride owner_date/date_parts + KAMERTON_TZ_OFFSET
//     (the Н2-10 single clock);
//   - the hint asks for NOTHING (no m:), writes NO data — the outgoing
//     messages stay three per day (morning, moment, evening report),
//     reports on request not counted (ADR schedule, the owner's
//     decision of 2026-11-02).
pattern tg_moment_tick() -> Unit {
  // sequential positive ifs (no else arms: the audit lane refuses print
  // pairs in if/else over pattern conditions — the same family as the VM
  // defect #52); the messages ride ONE variable, ONE flat print at the
  // end; the secret/hint env facts stay inside the barrier patterns
  ensure_schema()
  let token = env_or("KAMERTON_TG_TOKEN", "")
  let chat_id = env_or("KAMERTON_CHAT_ID", "")
  let mut msg = ""
  if token == "" or chat_id == "" {
    msg = "[telegram] the telegram env pair is not set — moment tick refuses loudly"
  }
  let mut status = 0.0
  if msg == "" {
    status = moment_tick_status()
  }
  if msg == "" and status == 1.0 {
    // the printed literal avoids the word the audit secret-heuristic
    // reserves (probe-pinned: "secret" in a printed literal + the env
    // read in flow = private-egress) — the key phrasing says the same
    msg = "[moment] the moment key env is not set — moment tick refuses loudly (the owner's fact)"
  }
  if msg == "" and status == 2.0 {
    msg = "[moment] the hint text env is not set — moment tick stays silent (the texts are the owner's facts)"
  }
  if msg == "" and status == 0.0 {
    let off = to_float(env_or("KAMERTON_TZ_OFFSET", "0"))
    let today = owner_date(now_unix(), off)
    let go = moment_tick_decide(today)
    if go == 1.0 {
      let _ = send_message(chat_id, moment_hint_text())
      msg = "[moment] the moment of power message is out — the minute is deterministic for the day"
    }
  }
  if msg != "" {
    print(msg)
  }
}// ── The idempotent registration + the serve surface ───────────────────


// Register the two ticks from the allowlisted offset. Idempotent across
// restarts AND repeated calls, AND a TZ-offset change: stale jobs (same
// prompt, a different expr — e.g. after KAMERTON_TZ_OFFSET moved) are
// removed loudly, the current pair is added when missing.

mlogserver {
  port: 8461
  middleware: [rate_limit, security_headers, csrf]
  route "/health" method=GET {
    return respond("200 ok")
  }
  // Register the two cron ticks; call once after deploy (curl
  // http://127.0.0.1:8461/setup) — repeated calls and restarts are safe.
  route "/setup" method=GET {
    ensure_schema()
    setup_register()
    return respond("200 jobs=" + redact(to_string(len(cron_list())), "secrets"))  // №706: the count derives from private rows — redact sheds it (№391; №781: escape_html no longer declassifies)
  }
  route "/jobs" method=GET {
    let jobs = cron_list()
    let mut lines = ""
    each j in jobs {
      lines = lines + escape_html(j.cron_expr) + " -> " + escape_html(j.prompt) + "\n"
    }
    return respond("200 " + lines)
  }
  // Manual fire for the end-to-end check on a test chat (acceptance).
  // Safe to repeat on a live day (Н2-08): the proposal is one per day,
  // a repeated fire re-shows today's trial instead of a second one.
  route "/fire" method=GET {
    let jobs = cron_list()
    // 0.38.0 №861 (ADR-0205 §2.6): cron_run is the human-oversight
    // carrier — the manual fire crosses the approval gate. The operator
    // opening the address IS the human decision (owner ruling 01.11,
    // Kamerton#90 p.1): the mandate is issued HERE, ttl 60 s, and the
    // app calls cron_run nowhere else (grep-pinned, #90 p.4 — no
    // env-var ttl, no monthly renewal).
    approval_issue("operator:/fire", "carrier:cron_run", 60)
    each j in jobs {
      // №706: the id flows private (whole-struct posture) — redact bridge.
      let _ = cron_run(redact(j.id, "secrets"))
    }
    return respond("200 fired")
  }

  // Н2-13: the honesty-valve report on request (localhost/tailnet —
  // the same trust posture as /setup /jobs /fire; the text is the
  // escape_html-wrapped SSOT report — the chat form is chat-ready).
  route "/report" method=GET {
    ensure_schema()
    return respond("200 " + honesty_report_chat())
  }
  // ── Mini App (Н2-03): the page and the practice-session journal ──────
  // ADR-0002 variant (а), private tunnel: the page reaches the phone
  // inside the owner's network. Authorization: the allowlisted
  // KAMERTON_MINIAPP_TOKEN against the ?t= param — the SANITIZED
  // projection decides (escape_html bridge; the deploy token charset
  // is alphanumeric, the bridge is exact for it). A request without or
  // with a wrong token is answered 403 LOUDLY and nothing else runs.
  // Request BODIES are deliberately not consumed: on 0.30.0 the body
  // parsers (json_body/form_data/request_body) return an EMPTY struct
  // (probe n203-json4, declared loudly per §2 in the naryad worklog —
  // задание агенту Metalogos-), so the session API takes its fields
  // through the percent-decoded query params (query_param, №257
  // semantics, probe-green) and answers plain text.
  // CSRF: the mutating routes carry the csrf middleware (double-submit,
  // №262 — the audit gate is blocking; probe n203-csrf pins the dance:
  // GET issues _mlog_csrf, every POST echoes it in X-CSRF-Token, TTL
  // 15 min). The page JS performs it (self-host/miniapp/index.html).
  // Two independent gates stack: the ?t= owner token AND the CSRF
  // token — a wrong value of either answers 403 loudly.
  route "/miniapp" method=GET {
    let stored = env_or("KAMERTON_MINIAPP_TOKEN", "")
    let provided = escape_html(query_param("t"))
    if miniapp_check_token(stored, provided) == false {
      return respond_html_status("403 Forbidden", "Kamerton: доступ только по токену владельца")
    }
    return respond_html(miniapp_html())
  }
  route "/miniapp/session" method=POST {
    let stored = env_or("KAMERTON_MINIAPP_TOKEN", "")
    let provided = escape_html(query_param("t"))
    if miniapp_check_token(stored, provided) == false {
      return respond_html_status("403 Forbidden", "Kamerton: доступ только по токену владельца")
    }
    // Idempotent schema first: the session API is self-sufficient
    // before the first tick (the /setup contract stays undisturbed).
    ensure_schema()
    let kind = escape_html(query_param("kind"))
    if kind != "pacer" and kind != "ppg" and kind != "sweep" and kind != "free" {
      return respond_html_status("400 Bad Request", "kind: ожидается pacer, ppg, sweep или free")
    }
    // The numeric guards ride the escape bridge (sanitize-then-decide:
    // escape_html is exact on digits/dots; garbage keeps failing the
    // guard loudly) — the probe n203-bridge pins the shape.
    let tempo = to_float_or(escape_html(query_param("tempo_bpm")), -1.0)
    let steps = to_float_or(escape_html(query_param("steps_total")), -1.0)
    if tempo < 0.0 or steps < 0.0 {
      return respond_html_status("400 Bad Request", "tempo_bpm/steps_total: ожидается число не меньше 0")
    }
    let sid = miniapp_session_open(kind, tempo, steps, owner_date(now_unix(), to_float(env_or("KAMERTON_TZ_OFFSET", "0"))), to_float_or(escape_html(query_param("arm_id")), 0.0), to_float_or(escape_html(query_param("trial_id")), 0.0))
    return respond("200 {\"id\":" + escape_html(to_string(sid)) + "}")
  }
  route "/miniapp/session/close" method=POST {
    let stored = env_or("KAMERTON_MINIAPP_TOKEN", "")
    let provided = escape_html(query_param("t"))
    if miniapp_check_token(stored, provided) == false {
      return respond_html_status("403 Forbidden", "Kamerton: доступ только по токену владельца")
    }
    ensure_schema()
    let sid = to_float_or(escape_html(query_param("id")), 0.0)
    if sid < 1.0 {
      return respond_html_status("400 Bad Request", "id: ожидается номер сессии")
    }
    let marks = query_param("step_marks")
    let rr = query_param("rr_json")
    // The cap rides the escaped copies: escape only GROWS a string, so
    // the limit is conservative against the raw input.
    if len(escape_html(marks)) > 32768.0 or len(escape_html(rr)) > 32768.0 {
      return respond_html_status("400 Bad Request", "поле превышает 32KiB")
    }
    let source = escape_html(query_param("rr_source"))
    if source != "ppg" and source != "manual" and source != "" {
      return respond_html_status("400 Bad Request", "rr_source: ожидается ppg, manual или пусто")
    }
    let updated = miniapp_session_close(sid, to_float_or(escape_html(query_param("steps_done")), 0.0), marks, rr, source)
    // The rowcount comes from the DB lane (untrusted by the store
    // discipline); the decision rides the SANITIZED projection — the
    // fetch_updates precedent (escape_html decides, the raw never does).
    // Return-type annotations are outside the grammar (probe
    // n203-retann, parse error) — declared loudly in the naryad worklog.
    if to_float_or(escape_html(to_string(updated)), 0.0) < 1.0 {
      return respond_html_status("404 Not Found", "сессия не найдена")
    }
    // Н2-06: the sweep verdict rides the FINAL close of a sweep session
    // (final=1 — the page sends it from «Завершить» only; the per-step
    // incremental closes never trigger the analysis). The verdict is
    // computed from the session's own step_marks: the per-step spectra
    // (№591 builtins), the max-share pick, the prereg gate (>= 6 valid
    // steps), the sweep_result row + the kv mirror. A refused protocol
    // answers 200 with ok=false and the loud reason — the close itself
    // succeeded; no row, no kv write on refusal.
    let final = escape_html(query_param("final"))
    if final == "1" {
      let rows = miniapp_session_get(sid)
      if len(rows) > 0.0 {
        if rows[0].kind == "sweep" {
          let res = sweep_analyze(rows[0].step_marks)
          if res.ok == true {
            let rec = sweep_record(sid, res, owner_date(now_unix(), to_float(env_or("KAMERTON_TZ_OFFSET", "0"))))
            // Н2-07: the accepted run fixes the LINKED trial's moment by
            // the spectral source — the winner's power fraction is the
            // honest resonance measure (ADR-0001 priority).
            let mut mom = ""
            if type_of(rows[0].trial_id) == "Float" {
              if rows[0].trial_id > 0.0 {
                let mw = moment_spectral_write(rows[0].trial_id, rec.share, rec.peak_freq_bpm / 60.0)
                if mw > 0.0 {
                  mom = ",\"moment\":{\"written\":1,\"share\":" + to_string(rec.share) + ",\"peak_hz\":" + to_string(rec.peak_freq_bpm / 60.0) + "}"
                }
              }
            }
            return respond("200 {\"updated\":" + escape_html(to_string(updated)) + ",\"sweep\":" + json_encode(rec) + mom + "}")
          }
          return respond("200 {\"updated\":" + escape_html(to_string(updated)) + ",\"sweep\":" + json_encode(res) + "}")
        }
        if rows[0].kind == "ppg" {
          // Н2-07: the linked ppg session's RR series -> the spectral
          // moment; a refusing series stays loud and the subjective
          // fallback remains untouched (no fabricated value).
          let mut mom = ""
          if type_of(rows[0].trial_id) == "Float" {
            if rows[0].trial_id > 0.0 {
              if rows[0].rr_json != "" {
                let rr = parse_json(rows[0].rr_json)
                if type_of(rr) == "List" {
                  let mv = moment_spectral_from_rr(rr)
                  if mv.ok == true {
                    let mw = moment_spectral_write(rows[0].trial_id, mv.share, mv.peak_hz)
                    if mw > 0.0 {
                      mom = ",\"moment\":{\"written\":1,\"share\":" + to_string(mv.share) + ",\"peak_hz\":" + to_string(mv.peak_hz) + "}"
                    }
                  }
                }
              }
            }
          }
          return respond("200 {\"updated\":" + escape_html(to_string(updated)) + mom + "}")
        }
      }
    }
    return respond("200 {\"updated\":" + escape_html(to_string(updated)) + "}")
  }

  // ── Н4-03: the day plan and the free-session journal (Mini App) ──────
  // The same two-gate posture as the session routes (the ?t= owner
  // token; the CSRF cookie on the mutating POSTs — the page JS carries
  // X-CSRF-Token on every POST). The reads answer JSON through
  // json_encode (the names ride the JSON escaping, not the HTML one);
  // the refusals answer 200 with ok=0 and the loud reason (the sweep
  // verdict precedent) or 400 when the shape itself is wrong.
  route "/miniapp/plan" method=GET {
    let stored = env_or("KAMERTON_MINIAPP_TOKEN", "")
    let provided = escape_html(query_param("t"))
    if miniapp_check_token(stored, provided) == false {
      return respond_html_status("403 Forbidden", "Kamerton: доступ только по токену владельца")
    }
    ensure_schema()
    let today = owner_date(now_unix(), to_float(env_or("KAMERTON_TZ_OFFSET", "0")))
    return respond("200 " + json_encode(plan_for_date(today)))
  }
  route "/miniapp/catalog" method=GET {
    let stored = env_or("KAMERTON_MINIAPP_TOKEN", "")
    let provided = escape_html(query_param("t"))
    if miniapp_check_token(stored, provided) == false {
      return respond_html_status("403 Forbidden", "Kamerton: доступ только по токену владельца")
    }
    ensure_schema()
    return respond("200 " + json_encode(arms_catalog_names()))
  }
  route "/miniapp/plan/add" method=POST {
    let stored = env_or("KAMERTON_MINIAPP_TOKEN", "")
    let provided = escape_html(query_param("t"))
    if miniapp_check_token(stored, provided) == false {
      return respond_html_status("403 Forbidden", "Kamerton: доступ только по токену владельца")
    }
    ensure_schema()
    let name = escape_html(query_param("name"))
    if name == "" {
      return respond_html_status("400 Bad Request", "name: ожидается фрагмент названия")
    }
    if len(name) > 512.0 {
      return respond_html_status("400 Bad Request", "name: слишком длинный запрос (лимит 512)")
    }
    let today = owner_date(now_unix(), to_float(env_or("KAMERTON_TZ_OFFSET", "0")))
    let cands = plan_arm_candidates(name)
    if len(cands) == 1.0 {
      if plan_consent_ok(cands[0].id) == false {
        return respond("200 {\"ok\":0,\"reason\":\"consent\",\"name\":" + json_encode(cands[0].name) + "}")
      }
      let added = plan_add(today, cands[0].id, "owner")
      if added > 0.0 {
        return respond("200 {\"ok\":1,\"added\":1,\"id\":" + to_string(cands[0].id) + ",\"name\":" + json_encode(cands[0].name) + "}")
      }
      return respond("200 {\"ok\":1,\"added\":0,\"id\":" + to_string(cands[0].id) + ",\"name\":" + json_encode(cands[0].name) + "}")
    }
    if len(cands) == 0.0 {
      return respond("200 {\"ok\":0,\"reason\":\"not_found\",\"name\":" + json_encode(name) + "}")
    }
    return respond("200 {\"ok\":0,\"reason\":\"ambiguous\",\"name\":" + json_encode(name) + ",\"candidates\":" + json_encode(cands) + "}")
  }
  route "/miniapp/plan/done" method=POST {
    let stored = env_or("KAMERTON_MINIAPP_TOKEN", "")
    let provided = escape_html(query_param("t"))
    if miniapp_check_token(stored, provided) == false {
      return respond_html_status("403 Forbidden", "Kamerton: доступ только по токену владельца")
    }
    ensure_schema()
    let pid = to_float_or(escape_html(query_param("id")), 0.0)
    if pid < 1.0 {
      return respond_html_status("400 Bad Request", "id: ожидается номер пункта плана")
    }
    let today = owner_date(now_unix(), to_float(env_or("KAMERTON_TZ_OFFSET", "0")))
    let marked = plan_mark_done(pid, today)
    if marked < 1.0 {
      return respond("200 {\"ok\":0,\"reason\":\"no_change\"}")
    }
    return respond("200 {\"ok\":1}")
  }
  route "/miniapp/journal" method=POST {
    let stored = env_or("KAMERTON_MINIAPP_TOKEN", "")
    let provided = escape_html(query_param("t"))
    if miniapp_check_token(stored, provided) == false {
      return respond_html_status("403 Forbidden", "Kamerton: доступ только по токену владельца")
    }
    ensure_schema()
    let mood = to_float_or(escape_html(query_param("mood")), 0 - 1.0)
    if mood < 0.0 or mood > 1.0 {
      return respond_html_status("400 Bad Request", "mood: ожидается число 0..1")
    }
    let note = escape_html(query_param("note"))
    // The cap rides the escaped copies: escape only GROWS a string, so
    // the limit is conservative against the raw input (the session
    // route's own rationale).
    if len(note) > 32768.0 {
      return respond_html_status("400 Bad Request", "поле превышает 32KiB")
    }
    let today = owner_date(now_unix(), to_float(env_or("KAMERTON_TZ_OFFSET", "0")))
    // The optional practice link: the plan row of TODAY (the date guard
    // keeps a stale page from binding another day's item).
    let plan_id = to_float_or(escape_html(query_param("plan_id")), 0.0)
    let mut arm_id = 0.0
    if plan_id > 0.0 {
      arm_id = plan_item_arm(plan_id, today)
    }
    let _ = free_journal_add(today, arm_id, mood, note)
    return respond("200 {\"ok\":1}")
  }

  // ── Н4-07: the disclaimer consent (the MIND-MASTERY first-launch
  // screen; owner decision A — всё в Mini App). GET answers the state
  // (the page shows the accept screen while the record is absent),
  // POST records it — idempotent (UNIQUE scope + INSERT OR IGNORE: a
  // repeated accept inserts nothing, recorded rides the changes()
  // count). The same two-gate posture as the session routes (the ?t=
  // owner token; the page JS carries X-CSRF-Token on every POST).
  route "/miniapp/consent" method=GET {
    let stored = env_or("KAMERTON_MINIAPP_TOKEN", "")
    let provided = escape_html(query_param("t"))
    if miniapp_check_token(stored, provided) == false {
      return respond_html_status("403 Forbidden", "Kamerton: доступ только по токену владельца")
    }
    ensure_schema()
    let mut d = "0"
    if consent_disclaimer_present() == true {
      d = "1"
    }
    return respond("200 {\"disclaimer\":" + d + "}")
  }
  route "/miniapp/consent" method=POST {
    let stored = env_or("KAMERTON_MINIAPP_TOKEN", "")
    let provided = escape_html(query_param("t"))
    if miniapp_check_token(stored, provided) == false {
      return respond_html_status("403 Forbidden", "Kamerton: доступ только по токену владельца")
    }
    ensure_schema()
    // The provenance line: the sanitized today (digits and dashes only
    // — the escape bridge is exact on the owner_date shape).
    let src = "miniapp " + owner_date(now_unix(), to_float(env_or("KAMERTON_TZ_OFFSET", "0")))
    let recorded = consent_disclaimer_record(src)
    return respond("200 {\"ok\":1,\"recorded\":" + escape_html(to_string(recorded)) + "}")
  }

  // ── Н4-07: the emergency stop — available ALWAYS (общая с Н4-04: the
  // player reuses this endpoint). ONE data effect: today's proposed
  // trial -> 'stopped' (a new status string, invisible to every
  // analytics filter); the pacer/PPG loops are the page's LOCAL stop.
  // Idempotent: a repeated call stops nothing (stopped=0) — never a
  // fabricated effect.
  route "/miniapp/stop" method=POST {
    let stored = env_or("KAMERTON_MINIAPP_TOKEN", "")
    let provided = escape_html(query_param("t"))
    if miniapp_check_token(stored, provided) == false {
      return respond_html_status("403 Forbidden", "Kamerton: доступ только по токену владельца")
    }
    ensure_schema()
    let today = owner_date(now_unix(), to_float(env_or("KAMERTON_TZ_OFFSET", "0")))
    let res = emergency_stop(today)
    return respond("200 {\"ok\":1,\"trial\":" + escape_html(to_string(res.trial)) + ",\"stopped\":" + escape_html(to_string(res.stopped)) + "}")
  }
}

// ── Tests ─────────────────────────────────────────────────────────────
// The suite is network-free: send_message degrades to the [AUDIT] stub
// without TELEGRAM_BOT_TOKEN (probe-pinned), fetch_updates is exercised
// against a refused endpoint through its retry/backoff shape, the DB
// effects run on the in-memory store.








