test "M0 import gives the same rows as direct input" {
  write_file("m0_test.csv", "date,window,depth,sleep_quality,free_note\n2026-10-01,morning,0.6,4.0,calm baseline, quiet")
  let n = import_m0("m0_test.csv")
  assert_eq(n, 1.0)

  let aid = insert_arm("focusing-morning", "focusing", "morning", 10.0, 0.4, 0.3)
  let nid = insert_note("equivalence note")
  let did = insert_trial("2026-10-01", "morning", aid, nid, 0.0, 0.0)
  add_response(did, "moment", 0.6, "M0 import", "subjective")
  log_context(did, "", "", "", 4.0)
  db_execute("UPDATE trial SET free_note = ? WHERE id = ?", ["calm baseline, quiet", did])

  let imported = query("SELECT trial_date, day_window, moment_value, free_note, moment_source, status FROM trial WHERE status = 'imported' ORDER BY id LIMIT 1", [])
  let direct = query("SELECT trial_date, day_window, moment_value, free_note, moment_source, status FROM trial WHERE id = ?", [did])
  assert_eq(imported[0].trial_date, direct[0].trial_date)
  assert_eq(imported[0].day_window, direct[0].day_window)
  assert_eq(imported[0].moment_value, direct[0].moment_value)
  assert_eq(imported[0].moment_source, direct[0].moment_source)
  assert_eq(imported[0].free_note, direct[0].free_note)
  assert_eq(imported[0].free_note, "calm baseline, quiet")
  let ic = query("SELECT sleep_quality FROM context WHERE trial_id = (SELECT min(id) FROM trial WHERE status = 'imported')", [])
  let dc = query("SELECT sleep_quality FROM context WHERE trial_id = ?", [did])
  assert_eq(ic[0].sleep_quality, dc[0].sleep_quality)
}

// ── Sweep tests (Н2-06) ─────────────────────────────────────────────────
// No sin()/floor() in the 0.30.0 grammar (probe-pinned): the synthetic
// segments are literal cycles on a 1 Hz beat grid, which is exactly the
// shape the analyzer consumes. The pure 6-point cycle concentrates all
// periodic power in one band; the spread cycle smears it — that contrast
// drives the resonance pick deterministically.

// The test fixture builder: a literal cycle shape scaled by ampl on a
// flat base, repeated `cycles` times (period = 6 beats = 6 s).
pattern sweep_test_rr(base: Float, ampl: Float, shape: List, cycles: Float) -> List {
  let mut rr = []
  let mut c = 0.0
  while c < cycles {
    each s in shape {
      rr = push(rr, base + ampl * s)
    }
    c = c + 1.0
  }
  return rr
}

test "sweep_rr_times accumulates beat arrival seconds" {
  let ts = sweep_rr_times([1000.0, 1500.0, 500.0])
  assert_eq(ts[0], 1.0)
  assert_eq(ts[1], 2.5)
  assert_eq(ts[2], 3.0)
  assert_eq(len(sweep_rr_times([])), 0.0)
}

test "sweep_step_peak finds the paced frequency on a literal segment" {
  // The zero-mean pure cycle (sums to 0) on the 1000 ms base: the 6-beat
  // cycle lasts exactly 6.0 s, so the periodogram peak sits at the
  // breathing tempo 10.0 breaths/min (the Факт band of the naryad: near
  // 0.1 Hz). A nonzero-mean cycle shifts the temporal period with the
  // mean RR — the analyzer is honest about TIME, the fixture must be
  // zero-mean for the tempo semantics.
  let pure = [0.0, 1.0, 2.0, 0.0, -1.0, -2.0]
  let rr = sweep_test_rr(1000.0, 40.0, pure, 20.0)
  let pk = sweep_step_peak(rr)
  assert_eq(pk.ok, true)
  assert_eq(round(pk.freq_bpm * 10.0), 100.0)
  assert_eq(pk.share > 0.5, true)
}

test "sweep_step_peak refuses a short segment loudly" {
  let pk = sweep_step_peak([900.0, 910.0, 890.0])
  assert_eq(pk.ok, false)
  assert_contains(pk.reason, "12")
}

test "sweep_analyze picks the max-share step as the resonance tempo" {
  // Six steps at 6–60 amplitude; the third step carries the pure cycle
  // (all power in one band) — it must win over louder spread shapes and
  // fix the resonance at its paced tempo 5.5.
  let pure = [0.0, 1.0, 2.0, 0.0, -1.0, -2.0]
  let spread = [-0.6, 0.4, -0.3, 0.6, -0.4, 0.3]
  let m1 = {step: 1.0, tempo_bpm: 4.5, rr: sweep_test_rr(1000.0, 30.0, spread, 20.0), rr_reason: ""}
  let m2 = {step: 2.0, tempo_bpm: 5.0, rr: sweep_test_rr(1000.0, 30.0, spread, 20.0), rr_reason: ""}
  let m3 = {step: 3.0, tempo_bpm: 5.5, rr: sweep_test_rr(1000.0, 30.0, pure, 20.0), rr_reason: ""}
  let m4 = {step: 4.0, tempo_bpm: 5.75, rr: sweep_test_rr(1000.0, 30.0, spread, 20.0), rr_reason: ""}
  let m5 = {step: 5.0, tempo_bpm: 6.0, rr: sweep_test_rr(1000.0, 30.0, spread, 20.0), rr_reason: ""}
  let m6 = {step: 6.0, tempo_bpm: 6.25, rr: sweep_test_rr(1000.0, 30.0, spread, 20.0), rr_reason: ""}
  let marks = json_encode([m1, m2, m3, m4, m5, m6])
  let res = sweep_analyze(marks)
  assert_eq(res.ok, true)
  assert_eq(res.resonance_bpm, 5.5)
  assert_eq(res.steps_valid, 6.0)
  assert_eq(res.steps_total, 6.0)
  // The winner's spectral peak sits at its paced frequency (6 s cycle
  // = 10 breaths/min on the 1 Hz beat grid).
  assert_eq(round(res.peak_freq_bpm * 10.0), 100.0)
}

test "sweep_analyze refuses below the preregistered 6 valid steps" {
  let pure = [0.0, 1.0, 2.0, 0.0, -1.0, -2.0]
  let m1 = {step: 1.0, tempo_bpm: 4.5, rr: sweep_test_rr(1000.0, 40.0, pure, 20.0), rr_reason: ""}
  let m2 = {step: 2.0, tempo_bpm: 5.0, rr: sweep_test_rr(1000.0, 40.0, pure, 20.0), rr_reason: ""}
  let m3 = {step: 3.0, tempo_bpm: 5.5, rr: sweep_test_rr(1000.0, 40.0, pure, 20.0), rr_reason: ""}
  let m4 = {step: 4.0, tempo_bpm: 5.75, rr: sweep_test_rr(1000.0, 40.0, pure, 20.0), rr_reason: ""}
  let m5 = {step: 5.0, tempo_bpm: 6.0, rr: sweep_test_rr(1000.0, 40.0, pure, 20.0), rr_reason: ""}
  let marks = json_encode([m1, m2, m3, m4, m5])
  let res = sweep_analyze(marks)
  assert_eq(res.ok, false)
  assert_contains(res.reason, "не менее 6")
  assert_eq(res.steps_valid, 5.0)
}

test "sweep_analyze counts broken and pre-H2-06 marks as invalid steps" {
  // A session where the camera QC refused two steps (rr_reason set) and
  // one mark predates the rr field entirely: 3 valid of 6 — refused.
  let pure = [0.0, 1.0, 2.0, 0.0, -1.0, -2.0]
  let m1 = {step: 1.0, tempo_bpm: 4.5, rr: sweep_test_rr(1000.0, 40.0, pure, 20.0), rr_reason: ""}
  let m2 = {step: 2.0, tempo_bpm: 5.0, rr: [], rr_reason: "брак: отбраковано эпох 8 из 12"}
  let m3 = {step: 3.0, tempo_bpm: 5.5}
  let m4 = {step: 4.0, tempo_bpm: 5.75, rr: sweep_test_rr(1000.0, 40.0, pure, 20.0), rr_reason: ""}
  let m5 = {step: 5.0, tempo_bpm: 6.0, rr: sweep_test_rr(1000.0, 40.0, pure, 20.0), rr_reason: ""}
  let m6 = {step: 6.0, tempo_bpm: 6.25, rr: [], rr_reason: "брак: восстановлено RR 5 (< 8)"}
  let marks = json_encode([m1, m2, m3, m4, m5, m6])
  let res = sweep_analyze(marks)
  assert_eq(res.ok, false)
  assert_eq(res.steps_valid, 3.0)
  assert_eq(res.steps_total, 6.0)
}

test "sweep_analyze refuses a non-array marks body" {
  let res = sweep_analyze("{\"step\":1}")
  assert_eq(res.ok, false)
  assert_contains(res.reason, "массив")
}

test "sweep_record fixes the verdict, the row and the kv mirror" {
  // The FK parent first — the enforced-references replay refuses an
  // INSERT into a table whose parent is missing (the store discipline).
  let _ = db_execute("CREATE TABLE IF NOT EXISTS practice_session (id INTEGER PRIMARY KEY AUTOINCREMENT, kind TEXT DEFAULT 'pacer', arm_id INTEGER REFERENCES arm(id), trial_id INTEGER REFERENCES trial(id), tempo_bpm REAL DEFAULT '0.0', steps_total INTEGER DEFAULT '0', steps_done INTEGER DEFAULT '0', step_marks TEXT DEFAULT '', rr_json TEXT DEFAULT '', rr_source TEXT DEFAULT '', session_date TEXT DEFAULT '', created_at TEXT DEFAULT (datetime('now')))", [])
  let _ = db_execute("CREATE TABLE IF NOT EXISTS sweep_result (id INTEGER PRIMARY KEY AUTOINCREMENT, session_id INTEGER REFERENCES practice_session(id), result_date TEXT DEFAULT '', resonance_bpm REAL DEFAULT '0.0', peak_freq_bpm REAL DEFAULT '0.0', power_fraction REAL DEFAULT '0.0', p_value REAL DEFAULT '1.0', steps_valid INTEGER DEFAULT '0', steps_total INTEGER DEFAULT '0', prev_resonance_bpm REAL DEFAULT '0.0', freq_delta_bpm REAL DEFAULT '0.0', share_ratio REAL DEFAULT '0.0', verdict TEXT DEFAULT '', created_at TEXT DEFAULT (datetime('now')))", [])
  // The FK parent needs real rows — the enforced references refuse an
  // INSERT pointing at a missing parent; three sessions, one per run.
  let _ = db_execute("INSERT INTO practice_session (kind, session_date) VALUES ('sweep', '2026-10-09')", [])
  let _ = db_execute("INSERT INTO practice_session (kind, session_date) VALUES ('sweep', '2026-10-09')", [])
  let _ = db_execute("INSERT INTO practice_session (kind, session_date) VALUES ('sweep', '2026-10-09')", [])
  let sid_rows = query("SELECT min(id) AS id FROM practice_session", [])
  let sid = sid_rows[0].id
  let res1 = {ok: true, reason: "", resonance_bpm: 5.5, peak_freq_bpm: 5.9, share: 0.6, p_value: 0.0001, steps_valid: 11.0, steps_total: 11.0}
  let rec1 = sweep_record(sid, res1, "2026-10-09")
  // The first recorded run has no comparison partner: the empty verdict
  // is the honest "nothing to reproduce against yet".
  assert_eq(rec1.verdict, "")
  assert_eq(to_float(kv_get("resonance_bpm")), 5.5)
  assert_eq(kv_get("resonance_verdict"), "")
  let rows = query("SELECT session_id, resonance_bpm, verdict FROM sweep_result", [])
  assert_eq(len(rows), 1.0)
  assert_eq(rows[0].session_id, sid)
  // The repeat run: tempo +0.25 (<= 0.3), share 0.5 (ratio 0.833) —
  // reproduced per the preregistration.
  let res2 = {ok: true, reason: "", resonance_bpm: 5.75, peak_freq_bpm: 5.9, share: 0.5, p_value: 0.0002, steps_valid: 11.0, steps_total: 11.0}
  let rec2 = sweep_record(sid + 1.0, res2, "2026-10-09")
  assert_eq(rec2.verdict, "reproducible")
  assert_eq(round(rec2.share_ratio * 1000.0), 833.0)
  assert_eq(round(rec2.freq_delta_bpm * 100.0), 25.0)
  // A divergent repeat: the tempo jumps +1.25 (> 0.3) — loud.
  let res3 = {ok: true, reason: "", resonance_bpm: 7.0, peak_freq_bpm: 6.9, share: 0.55, p_value: 0.0003, steps_valid: 11.0, steps_total: 11.0}
  let rec3 = sweep_record(sid + 2.0, res3, "2026-10-09")
  assert_eq(rec3.verdict, "divergent")
  assert_eq(to_float(kv_get("resonance_bpm")), 7.0)
  assert_eq(kv_get("resonance_verdict"), "divergent")
}

test "the sweep_result DDL literal is idempotent (replay twice)" {
  let _ = db_execute("CREATE TABLE IF NOT EXISTS sweep_result (id INTEGER PRIMARY KEY AUTOINCREMENT, session_id INTEGER REFERENCES practice_session(id), result_date TEXT DEFAULT '', resonance_bpm REAL DEFAULT '0.0', peak_freq_bpm REAL DEFAULT '0.0', power_fraction REAL DEFAULT '0.0', p_value REAL DEFAULT '1.0', steps_valid INTEGER DEFAULT '0', steps_total INTEGER DEFAULT '0', prev_resonance_bpm REAL DEFAULT '0.0', freq_delta_bpm REAL DEFAULT '0.0', share_ratio REAL DEFAULT '0.0', verdict TEXT DEFAULT '', created_at TEXT DEFAULT (datetime('now')))", [])
  let _ = db_execute("CREATE TABLE IF NOT EXISTS sweep_result (id INTEGER PRIMARY KEY AUTOINCREMENT, session_id INTEGER REFERENCES practice_session(id), result_date TEXT DEFAULT '', resonance_bpm REAL DEFAULT '0.0', peak_freq_bpm REAL DEFAULT '0.0', power_fraction REAL DEFAULT '0.0', p_value REAL DEFAULT '1.0', steps_valid INTEGER DEFAULT '0', steps_total INTEGER DEFAULT '0', prev_resonance_bpm REAL DEFAULT '0.0', freq_delta_bpm REAL DEFAULT '0.0', share_ratio REAL DEFAULT '0.0', verdict TEXT DEFAULT '', created_at TEXT DEFAULT (datetime('now')))", [])
  let rows = query("SELECT count(*) AS n FROM sqlite_master WHERE type = 'table' AND name = 'sweep_result'", [])
  assert_eq(rows[0].n, 1.0)
}
