// Kamerton bandit (naryad Н1-05): Thompson sampling on Gaussian
// posteriors over the shared PRNG, a 20% forced-exploration floor and a
// 60-day exponential decay of old responses. Consumers: Н1-06 (the
// morning cron tick proposes an arm), Н1-08 (the honesty valve reads the
// pick history).
//
// Design decisions fixed here (in-boundary implementation choices, the
// naryad fixes the requirements, not the parametrisation):
//   1. Posterior: Normal-Normal conjugate update with known observation
//      noise. Every completed trial with at least one present reward
//      component contributes x_i = trial.reward (ADR-0001 normalized
//      weighted sum, computed by the store) with decay weight w_i:
//        precision λ = 1/s0² + Σw_i/σr²,  mean = (m0/s0² + Σw_i·x_i/σr²)/λ,
//        sd = 1/√λ.  σr = 0.25 is the observation-noise constant of the
//      [0,1] reward scale (pinned by the formula test below).
//   2. Decay: the naryad says "экспоненциальный распад откликов старше
//      60 дней" — read literally: full weight up to 60 days of age,
//      exponential exp(-(age-60)/60) after that (tau = 60 days, the
//      ADR-0001 transition-absorption horizon). A future-dated row is a
//      data error and is clamped to age zero, never to negative weight.
//   3. Forced exploration: every 5th DECISION (trial rows carrying an
//      arm_id, so restarts and imports do not reset the schedule) is
//      forced, the arm is taken round-robin over the active arms ordered
//      by id. Exactly 20% over any 1000-decision window — inside the
//      20-25% acceptance corridor deterministically, with equal forced
//      coverage of every arm. Thompson's own posterior uncertainty
//      exploration comes on top of this floor.
//   4. Seed contract: bandit_pick(seed) reseeds the shared xorshift64
//      stream (random_seed) before drawing, so a fixed seed gives a
//      byte-reproducible pick on the same database state (№590). The
//      production caller (Н1-06 tick) passes a varying seed; tests pass
//      constants.
//
// Language-discipline notes (§2, declared loudly where relevant):
//   - This file is standalone: CI runs check/audit/test per file, so the
//     arm/note/trial declarations below are byte-identical to the ones in
//     src/store/store.mlog (the arms.mlog precedent) and pinned by a
//     column test.
//   - v0.29.0 (Metalogos- №611) enforces declared references() in the
//     emitted DDL: the FK trial.note_id -> note is real now, so the
//     standalone schema carries the parent `note` table (byte-identical
//     to store.mlog). On v0.28.2 the same clause was silently dropped
//     (the D1 defect) and inserts passed without the parent; keeping the
//     parent table is harmless there too. The same release closes the D2
//     loop defect (№612); the assignment-call shape above is kept as
//     defense-in-depth.
//   - The D2 loop defect (Kamerton issue #24, Metalogos- №598, unfixed
//     in v0.28.2) triggers on BARE calls inside loop bodies. Mapped so
//     far: a body that is a single bare call runs one iteration; and a
//     NEW symptom isolated during this naryad (probe in the worklog): in
//     a mixed while body a bare db_insert silently corrupts the
//     pattern's return (the assigned shape `x = db_insert(...)` runs
//     full and correct). Every loop here therefore uses the
//     assignment-call shape only, and test bodies stay loop-free.
//   - The tick/route parity criterion (№594) is verified by the sample
//     program tests/bandit/parity-tick-route.mlog: the same seeded pure
//     chain runs in a cron-tick body (TW) and in a route body (VM) and
//     the outputs are compared byte-for-byte.
//   - No modulo operator exists in the language (grammar v0.28.2); the
//     every-5th test is to_int(n/5)*5 == n via the truncating to_int.

entity db_raw: String = env_or("KAMERTON_DB", ":memory:")
entity db_url: String = "sqlite:" + db_raw

db { url: db_url }

schema kamerton {

  table arm {
    id: Int primary_key auto_increment,
    name: String,
    group_name: String,
    day_window: String,
    duration_min: Int default("10"),
    prior_mean: Float default("0.0"),
    prior_std: Float default("1.0"),
    active: Int default("1"),
    created_at: String default(now())
  }

  table note {
    id: Int primary_key auto_increment,
    body: String,
    active: Int default("1"),
    created_at: String default(now())
  }

  table trial {
    id: Int primary_key auto_increment,
    trial_date: String,
    day_window: String,
    arm_id: Int references(arm.id),
    note_id: Int references(note.id),
    status: String default("proposed"),
    prediction_depth: Float default("0.0"),
    prediction_confidence: Float default("0.0"),
    moment_value: Float default("0.0"),
    moment_present: Int default("0"),
    moment_source: String default(""),
    next_day_value: Float default("0.0"),
    next_day_present: Int default("0"),
    action_value: Float default("0.0"),
    action_present: Int default("0"),
    reward: Float default("0.0"),
    free_note: String default(""),
    closed_at: String default(""),
    created_at: String default(now())
  }

  table slot {
    id: Int primary_key auto_increment,
    name: String,
    max_active: Int default("3"),
    created_at: String default(now())
  }

  table consent {
    id: Int primary_key auto_increment,
    scope: String,
    revoked: Int default("0"),
    source: String default(""),
    created_at: String default(now())
  }

  table practice_protocol {
    id: Int primary_key auto_increment,
    arm_id: Int references(arm.id),
    slot: String default(""),
    safety_class: String default("A"),
    requires_consent: Int default("0"),
    max_hold_sec: Float default("0.0"),
    session_min: Float default("10.0"),
    steps_json: String default("[]"),
    series_json: String default(""),
    contraindications: String default(""),
    source: String default(""),
    created_at: String default(now())
  }

  // Н3-06: the arm_journal table (byte-identical declaration to the
  // arms.mlog / app.mlog / migrations schema — the rotation writes its
  // decisions here too, so the standalone module can be tested).
  table arm_journal {
    id: Int primary_key auto_increment,
    actor: String default(""),
    arm_id: Int references(arm.id),
    action: String default(""),
    detail: String default(""),
    created_at: String default(now())
  }
}

// The reward scale is [0,1]; 0.25 is the assumed observation noise of a
// single normalized reward (see the formula test: one reward of 1.0 on a
// 0.5±0.5 prior must land the mean at exactly 0.9).
entity reward_obs_std: Float = 0.25

// Decay horizon: plateau of 60 days, then exponential with tau = 60 days.
entity decay_tau_days: Float = 60.0

// One forced-exploration decision out of every 5 → exactly 20%.
entity explore_every: Float = 5.0

// ── Time and decay ──────────────────────────────────────────────────────

// Midnight-UTC unix timestamp of today (all bandit arithmetic is UTC,
// the timezone is applied only at display time elsewhere).
pattern today_unix() -> Float {
  return date_parse_iso(date_format_iso(now_unix()))
}

// Exponential decay weight of a response by its age in days: full weight
// on the 60-day plateau, exp(-(age-60)/60) after it.
pattern decay_weight(age_days: Float) -> Float {
  if age_days <= decay_tau_days {
    return 1.0
  }
  return exp((decay_tau_days - age_days) / decay_tau_days)
}

// ── Posterior ───────────────────────────────────────────────────────────

// Gaussian posterior of one arm over its decayed rewards. Returns
// [mean, sd, weight_sum]. Only completed trials carrying at least one
// present reward component feed the posterior — a missed trial is a
// stored STRING, not a fabricated zero (ADR-0001).
pattern arm_posterior(arm_id: Float, prior_mean: Float, prior_std: Float) -> List {
  let mut s0 = prior_std
  if s0 <= 0.0 {
    // A zero prior std would claim infinite precision; the schema
    // default is 1.0 and the seed test pins the priors positive.
    s0 = 1.0
  }
  let rows = query("SELECT reward, trial_date FROM trial WHERE arm_id = ? AND status = 'completed' AND (moment_present = 1 OR next_day_present = 1 OR action_present = 1)", [arm_id])
  let today = today_unix()
  let mut wsum = 0.0
  let mut xsum = 0.0
  each r in rows {
    let mut age = date_diff_days(today, date_parse_iso(r.trial_date))
    if age < 0.0 {
      age = 0.0
    }
    let w = decay_weight(age)
    wsum = wsum + w
    xsum = xsum + w * r.reward
  }
  let inv0 = 1.0 / (s0 * s0)
  let invr = 1.0 / (reward_obs_std * reward_obs_std)
  let precision = inv0 + wsum * invr
  let mean = (prior_mean * inv0 + xsum * invr) / precision
  let sd = 1.0 / sqrt(precision)
  return [mean, sd, wsum]
}

// ── Pick ────────────────────────────────────────────────────────────────

// Н3-01: the candidate set of every decision. An ACTIVE hand with a
// protocol that requires consent is a candidate only while the consent
// row of its safety class exists (scope 'class:<X>', not revoked) —
// forced exploration draws from THIS list too, so a class-C practice is
// never assigned without the record (invariant 5 floor untouched: the 20%
// is spread over the eligible hands).
pattern eligible_arms() -> List {
  return query("SELECT a.id AS id, a.name AS name, a.prior_mean AS prior_mean, a.prior_std AS prior_std FROM arm a LEFT JOIN practice_protocol p ON p.arm_id = a.id WHERE a.active = 1 AND (p.arm_id IS NULL OR p.requires_consent = 0 OR EXISTS (SELECT 1 FROM consent c WHERE c.scope = 'class:' || p.safety_class AND c.revoked = 0)) ORDER BY a.id", [])
}

// One bandit decision. Pure with respect to the database: nothing is
// written here, the proposal is recorded by bandit_propose.
// Returns {arm_id, mode, theta}: mode is "explore" (forced round-robin
// pick, no draw consumed), "thompson" (posterior sample argmax) or
// "empty" (no active arms; arm_id 0.0 — the caller must surface this
// loudly, it is a deployment error, not a valid choice).
pattern bandit_pick(seed: Float) -> Struct {
  let arms = eligible_arms()
  let k = len(arms)
  if k == 0.0 {
    return {arm_id: 0.0, mode: "empty", theta: 0.0}
  }
  let rows = query("SELECT count(*) AS n FROM trial WHERE arm_id IS NOT NULL", [])
  let n = rows[0].n
  if to_int(n / explore_every) * explore_every == n {
    // Forced exploration: decision number n (0-based) with n % 5 == 0;
    // round-robin index = (n/5) mod K, no modulo operator in the
    // language — to_int truncation arithmetic.
    let step = to_int(n / explore_every)
    let kk = to_int(k)
    let idx = step - kk * to_int(step / kk)
    let arm = arms[idx]
    return {arm_id: arm.id, mode: "explore", theta: 0.0}
  }
  random_seed(seed)
  let mut i = 0.0
  let mut best_id = 0.0
  let mut best_theta = 0.0
  let mut first = true
  while i < k {
    let arm = arms[i]
    let post = arm_posterior(arm.id, arm.prior_mean, arm.prior_std)
    let theta = post[0] + post[1] * normal_sample(0.0, 1.0)
    if first == true {
      best_id = arm.id
      best_theta = theta
      first = false
    }
    if theta > best_theta {
      best_id = arm.id
      best_theta = theta
    }
    i = i + 1.0
  }
  return {arm_id: best_id, mode: "thompson", theta: best_theta}
}

// Proposal: one decision recorded as a trial row in status 'proposed'
// (the prediction fields stay at their defaults until the owner answers
// through Н1-06). Returns the trial id, or 0.0 when the library is
// empty (nothing proposed — silence, not a fabricated choice).
// Н2-08 day guard: a proposal is one per calendar day — a repeated tick
// (/fire, a re-registered cron) re-shows the existing trial (the caller
// formats the same proposal again); the decision counter does not move.
pattern bandit_propose(trial_date: String, seed: Float) -> Float {
  // Н2-08 day guard: a proposal is one per calendar day — a repeated
  // tick re-shows the existing trial instead of a second decision.
  let existing = query("SELECT id FROM trial WHERE trial_date = ? AND arm_id IS NOT NULL ORDER BY id LIMIT 1", [trial_date])
  if len(existing) > 0.0 {
    return existing[0].id
  }
  let pick = bandit_pick(seed)
  if pick.arm_id == 0.0 {
    return 0.0
  }
  let arm = query("SELECT id, day_window FROM arm WHERE id = ?", [pick.arm_id])
  if len(arm) == 0.0 {
    return 0.0
  }
  // Н2-12: the proposal carries the ACTIVE note's id — the «Нота:»
  // line stops being permanently empty (the trial joins note by id in
  // morning_proposal_row). No note row — the key stays absent (SQL
  // NULL default), never a fabricated 0 (the FK-target row does not
  // exist); two branches instead of a nullable field in one struct
  // (the language has no nullable struct fields).
  let note = query("SELECT id FROM note WHERE active = 1 ORDER BY id DESC LIMIT 1", [])
  if len(note) > 0.0 {
    let row = {trial_date: trial_date, day_window: arm[0].day_window, arm_id: pick.arm_id, note_id: note[0].id}
    return db_insert("trial", row)
  }
  let row = {trial_date: trial_date, day_window: arm[0].day_window, arm_id: pick.arm_id}
  return db_insert("trial", row)
}

// ── Н3-06: slot rotation (ADR-0003, принят 2026-10-24: 25 / 0,10 / 0,90 / 14 / 90)
//
// Once a day, in the morning tick BEFORE the proposal. Per slot:
//   - the slot is evaluated only while it is FULLY staffed (active ==
//     max_active — the owner's chosen set is in place; an incomplete slot
//     means the owner has not chosen yet, nothing is changed silently) and,
//     for `methods`, the Н3-05 armed cap (the owner's confirm event);
//   - the 14-day window is open (no rotate-off of this slot in the last
//     14 days — at most ONE replacement per slot per 14 days);
//   - for every ACTIVE hand with >= 25 completed trials (at least one
//     present reward component, same filter as the posterior): the
//     probability that its mean is BELOW the best hand of the slot by
//     >= 0.10, over the Normal posterior estimates (the difference of two
//     independent posteriors is Normal with the combined variance);
//   - the WEAKEST such hand (the largest probability) is retired ONLY if
//     a replacement candidate exists — the slot is never emptied;
//   - the candidate: the next catalog hand of the slot by prior_mean DESC,
//     then id ASC, admitted by its safety class consent, and NOT in the
//     90-day rotation cooldown (a hand retired by the rotation returns as
//     a candidate not earlier than 90 days).
// Every decision (retire + admit) is journaled with the numbers of the
// criterion (actor 'rotation'); the owner can undo manually at any time
// (deactivate/activate — the manual path writes its own journal rows).
// Forced exploration is untouched: the rotation only moves the active
// flags; the exploration floor draws over the active set as before.
// The thresholds 14/90 live in the SQL literals below (datetime('now',
// '-N days')), consistent with the journal created_at format; the
// mutation checks flip those literals.
entity rotation_obs_min: Float = 25.0
entity rotation_gap: Float = 0.10
entity rotation_prob: Float = 0.90

// Normal CDF via the Abramowitz–Stegun 7.1.26 erf approximation
// (|error| < 1.5e-7 — far below the 0.90 decision threshold).
pattern normal_cdf(x: Float) -> Float {
  if x < 0.0 {
    return 1.0 - normal_cdf(0.0 - x)
  }
  let z = x / 1.4142135623730951
  let t = 1.0 / (1.0 + 0.3275911 * z)
  let poly = ((((1.061405429 * t + (0.0 - 1.453152027)) * t + 1.421413741) * t + (0.0 - 0.284496736)) * t + 0.254829592) * t
  let y = 1.0 - poly * exp(0.0 - z * z)
  return 0.5 * (1.0 + y)
}

// P(mu_best - mu_i >= rotation_gap) for two independent Gaussian
// posteriors: the difference is Normal(mean_best - mean_i, combined sd).
pattern rotation_gap_prob(mean_i: Float, sd_i: Float, mean_best: Float, sd_best: Float) -> Float {
  let delta = mean_best - mean_i
  let sd = sqrt(sd_i * sd_i + sd_best * sd_best)
  if sd <= 0.0 {
    if delta >= rotation_gap {
      return 1.0
    }
    return 0.0
  }
  return normal_cdf((delta - rotation_gap) / sd)
}

// Completed trials with at least one present reward component — the SAME
// observation filter as the posterior (ADR-0003 point 1).
pattern rotation_obs_count(arm_id: Float) -> Float {
  let rows = query("SELECT count(*) AS n FROM trial WHERE arm_id = ? AND status = 'completed' AND (moment_present = 1 OR next_day_present = 1 OR action_present = 1)", [arm_id])
  return rows[0].n
}

// The slot is ready for rotation: fully staffed (the owner's chosen set
// is in place) and — for `methods` — the Н3-05 armed cap (the owner's
// confirm event exists in the journal).
pattern rotation_slot_ready(slot_name: String) -> Bool {
  let cap_rows = query("SELECT max_active AS cap FROM slot WHERE name = ?", [slot_name])
  if len(cap_rows) == 0.0 {
    return false
  }
  let cap = to_float(cap_rows[0].cap)
  let act_rows = query("SELECT count(*) AS n FROM arm a JOIN practice_protocol p ON p.arm_id = a.id WHERE p.slot = ? AND a.active = 1", [slot_name])
  if act_rows[0].n < cap {
    return false
  }
  if slot_name == "methods" {
    let armed = query("SELECT count(*) AS n FROM arm_journal WHERE action = 'methods-cap-armed'", [])
    if armed[0].n == 0.0 {
      return false
    }
  }
  return true
}

// The 14-day window: no rotate-off of this slot in the last 14 days.
pattern rotation_window_open(slot_name: String) -> Bool {
  let rows = query("SELECT count(*) AS n FROM arm_journal j JOIN practice_protocol p ON p.arm_id = j.arm_id WHERE p.slot = ? AND j.action = 'rotate-off' AND j.created_at >= datetime('now', '-14 days')", [slot_name])
  return rows[0].n == 0.0
}

// The next catalog hand of the slot: prior_mean DESC, then id ASC; not
// active; admitted by its safety class (the same consent filter as the
// bandit candidates); not in the 90-day rotation cooldown. Returns the
// arm id, or 0 when no candidate is admissible.
pattern rotation_candidate(slot_name: String) -> Float {
  let rows = query("SELECT a.id AS id FROM arm a JOIN practice_protocol p ON p.arm_id = a.id WHERE p.slot = ? AND a.active = 0 AND (p.requires_consent = 0 OR EXISTS (SELECT 1 FROM consent c WHERE c.scope = 'class:' || p.safety_class AND c.revoked = 0)) AND NOT EXISTS (SELECT 1 FROM arm_journal j WHERE j.action = 'rotate-off' AND j.arm_id = a.id AND j.created_at >= datetime('now', '-90 days')) ORDER BY a.prior_mean DESC, a.id ASC LIMIT 1", [slot_name])
  if len(rows) == 0.0 {
    return 0.0
  }
  return rows[0].id
}

// The rotation itself: at most ONE replacement per slot per run (the
// weakest hand only), the windows and cooldowns enforced, every decision
// journaled with the numbers. Returns the number of replacements made.
pattern rotate_slots() -> Float {
  let slots = query("SELECT DISTINCT p.slot AS slot FROM practice_protocol p WHERE p.slot != '' ORDER BY p.slot", [])
  let mut replaced = 0.0
  each s in slots {
    let slot_name = s.slot
    let ready = rotation_slot_ready(slot_name)
    let window = rotation_window_open(slot_name)
    if ready == true and window == true {
      let act = query("SELECT a.id AS id, a.prior_mean AS pm, a.prior_std AS ps FROM arm a JOIN practice_protocol p ON p.arm_id = a.id WHERE p.slot = ? AND a.active = 1 ORDER BY a.id", [slot_name])
      let mut best_mean = 0.0 - 1.0
      let mut best_sd = 1.0
      each a in act {
        let post = arm_posterior(a.id, a.pm, a.ps)
        if post[0] > best_mean {
          best_mean = post[0]
          best_sd = post[1]
        }
      }
      let mut worst_id = 0.0
      let mut worst_prob = 0.0
      let mut worst_mean = 0.0
      let mut worst_sd = 0.0
      let mut worst_n = 0.0
      each a2 in act {
        let n = rotation_obs_count(a2.id)
        if n >= rotation_obs_min {
          let post2 = arm_posterior(a2.id, a2.pm, a2.ps)
          let prob = rotation_gap_prob(post2[0], post2[1], best_mean, best_sd)
          if prob >= rotation_prob and prob > worst_prob {
            worst_id = a2.id
            worst_prob = prob
            worst_mean = post2[0]
            worst_sd = post2[1]
            worst_n = n
          }
        }
      }
      if worst_id > 0.0 {
        // a replacement happens ONLY with an admissible candidate —
        // the slot is never emptied
        let cand = rotation_candidate(slot_name)
        if cand > 0.0 {
          let detail = "n=" + to_string(worst_n) + " mean=" + to_string(worst_mean) + " sd=" + to_string(worst_sd) + " best_mean=" + to_string(best_mean) + " best_sd=" + to_string(best_sd) + " gap=" + to_string(rotation_gap) + " prob=" + to_string(worst_prob)
          let _ = db_execute("UPDATE arm SET active = 0 WHERE id = ?", [worst_id])
          let _ = db_execute("INSERT INTO arm_journal (actor, arm_id, action) VALUES ('rotation', ?, 'arm-off')", [worst_id])
          let _ = db_execute("INSERT INTO arm_journal (actor, arm_id, action, detail) VALUES ('rotation', ?, 'rotate-off', ?)", [worst_id, detail])
          let cand_row = query("SELECT prior_mean AS pm FROM arm WHERE id = ?", [cand])
          let _ = db_execute("UPDATE arm SET active = 1 WHERE id = ?", [cand])
          let _ = db_execute("INSERT INTO arm_journal (actor, arm_id, action) VALUES ('rotation', ?, 'arm-on')", [cand])
          let _ = db_execute("INSERT INTO arm_journal (actor, arm_id, action, detail) VALUES ('rotation', ?, 'rotate-on', ?)", [cand, "prior_mean=" + to_string(cand_row[0].pm)])
          replaced = replaced + 1.0
        }
      }
    }
  }
  return replaced
}

// ── Test fixtures (INSERT OR IGNORE + a file-local unique index keep
//    the synthetic arms idempotent) ────────────────────────────────────

pattern seed_pair() -> Float {
  db_execute("CREATE UNIQUE INDEX IF NOT EXISTS idx_bandit_syn_name ON arm(name)")
  db_execute("INSERT OR IGNORE INTO arm (name, group_name, day_window, duration_min, prior_mean, prior_std) VALUES ('syn-good', 'synthetic', 'morning', 10, 0.5, 0.5)")
  db_execute("INSERT OR IGNORE INTO arm (name, group_name, day_window, duration_min, prior_mean, prior_std) VALUES ('syn-bad', 'synthetic', 'morning', 10, 0.5, 0.5)")
  let rows = query("SELECT count(*) AS n FROM arm WHERE name LIKE 'syn-%'", [])
  return rows[0].n
}

// k bandit decisions recorded as proposed trials; returns the number of
// forced-exploration picks among them. The decision counter inside the
// bandit counts exactly the rows this loop inserts, so i-th decision is
// decision number i.
pattern synth_explore(k: Float) -> Float {
  let today = date_format_iso(now_unix())
  let mut i = 0.0
  let mut forced = 0.0
  let mut last = 0.0
  while i < k {
    let pick = bandit_pick(42.0 + i)
    if pick.mode == "explore" {
      forced = forced + 1.0
    }
    last = db_insert("trial", {trial_date: today, day_window: "morning", arm_id: pick.arm_id, status: "proposed"})
    i = i + 1.0
  }
  return forced
}

// k decisions recorded as COMPLETED trials with a fixed reward: r_good
// on good_id, r_bad elsewhere. Returns [good_count, other_count].
pattern synth_feed(k: Float, good_id: Float, r_good: Float, r_bad: Float) -> List {
  let today = date_format_iso(now_unix())
  let mut i = 0.0
  let mut gc = 0.0
  let mut bc = 0.0
  let mut last = 0.0
  while i < k {
    let pick = bandit_pick(101.0 + i)
    if pick.arm_id == good_id {
      gc = gc + 1.0
      last = db_insert("trial", {trial_date: today, day_window: "morning", arm_id: pick.arm_id, status: "completed", reward: r_good, moment_present: 1})
    }
    if pick.arm_id != good_id {
      bc = bc + 1.0
      last = db_insert("trial", {trial_date: today, day_window: "morning", arm_id: pick.arm_id, status: "completed", reward: r_bad, moment_present: 1})
    }
    i = i + 1.0
  }
  return [gc, bc]
}

// ── Tests ───────────────────────────────────────────────────────────────
// The tests share one in-memory database and run in declaration order:
// the empty-library test MUST stay first, the convergence test reshapes
// and then restores the active flags.

test "an empty arm library refuses to propose" {
  let pick = bandit_pick(42.0)
  assert_eq(pick.arm_id, 0.0)
  assert_eq(pick.mode, "empty")
  let tid = bandit_propose("2026-10-06", 42.0)
  assert_eq(tid, 0.0)
  let rows = query("SELECT count(*) AS n FROM trial", [])
  assert_eq(rows[0].n, 0.0)
}

test "fixed seed reproduces the normal sequence" {
  random_seed(42.0)
  let a1 = normal_sample(0.0, 1.0)
  let a2 = normal_sample(0.0, 1.0)
  random_seed(42.0)
  let b1 = normal_sample(0.0, 1.0)
  let b2 = normal_sample(0.0, 1.0)
  assert_eq(a1, b1)
  assert_eq(a2, b2)
  random_seed(43.0)
  let c1 = normal_sample(0.0, 1.0)
  assert_eq(a1 == c1, false)
}

test "same seed and same state give an identical pick" {
  db_execute("INSERT OR IGNORE INTO arm (name, group_name, day_window, duration_min, prior_mean, prior_std) VALUES ('repro-a', 'repro', 'morning', 10, 0.5, 0.5)")
  db_execute("INSERT OR IGNORE INTO arm (name, group_name, day_window, duration_min, prior_mean, prior_std) VALUES ('repro-b', 'repro', 'evening', 10, 0.5, 0.5)")
  // Land on a THOMPSON decision: with the decision counter on a multiple
  // of five the pick goes through the explore branch, the PRNG is never
  // consumed and the determinism asserts pass vacuously (the vacuous
  // pass the mutation battery caught; arm_id 1 is repro-a, the FK is
  // carried by the operator mirror, not enforced on this path — D1).
  db_execute("INSERT INTO trial (trial_date, day_window, arm_id, status) VALUES ('2026-10-06', 'morning', 1.0, 'proposed')")
  let p1 = bandit_pick(42.0)
  let p2 = bandit_pick(42.0)
  assert_eq(p1.mode, "thompson")
  assert_eq(p1.arm_id, p2.arm_id)
  assert_eq(p1.theta, p2.theta)
  assert_eq(p1.mode, p2.mode)
  // A different seed moves the draw stream: the winning theta changes.
  let p3 = bandit_pick(43.0)
  assert_eq(p3.mode, "thompson")
  assert_eq(p3.theta == p1.theta, false)
}

test "decay weight: 60-day plateau then exponential" {
  assert_eq(decay_weight(0.0), 1.0)
  assert_eq(decay_weight(60.0), 1.0)
  assert_eq(round(decay_weight(120.0) * 10000.0), 3679.0)
  assert_eq(round(decay_weight(300.0) * 10000.0), 183.0)
}

test "posterior: closed form on one reward" {
  // One reward of 1.0 today on a 0.1±0.5 prior: λ = 4 + 16 = 20,
  // mean = (0.1·4 + 1.0·16)/20 = 0.82, sd = 1/√20 = 0.223606… —
  // the observation-noise constant 0.25 is pinned by these numbers.
  db_execute("INSERT OR IGNORE INTO arm (name, group_name, day_window, duration_min, prior_mean, prior_std) VALUES ('post-single', 'post', 'morning', 10, 0.1, 0.5)")
  let aid_rows = query("SELECT id AS v FROM arm WHERE name = 'post-single'", [])
  let aid = aid_rows[0].v
  db_execute("INSERT INTO trial (trial_date, day_window, arm_id, status, reward, moment_present) VALUES (?, 'morning', ?, 'completed', 1.0, 1)", [date_format_iso(now_unix()), aid])
  let post = arm_posterior(aid, 0.1, 0.5)
  assert_eq(round(post[0] * 100.0), 82.0)
  assert_eq(round(post[1] * 10000.0), 2236.0)
  assert_eq(round(post[2]), 1.0)
}

test "a decayed old failure stops dragging the mean down" {
  // Three rewards of 0.9 today and one 0.0 dated 120 days back on a
  // 0.6±0.15 prior. With the decay: mean 0.7106 (71 percent scale) and
  // weight_sum 3.3679. Without the decay the same numbers would be
  // 0.6443 (64) and 4.0 — the mutation is caught by both asserts.
  db_execute("INSERT OR IGNORE INTO arm (name, group_name, day_window, duration_min, prior_mean, prior_std) VALUES ('post-decay', 'post', 'morning', 10, 0.6, 0.15)")
  let aid_rows = query("SELECT id AS v FROM arm WHERE name = 'post-decay'", [])
  let aid = aid_rows[0].v
  let today = date_format_iso(now_unix())
  let old = date_format_iso(now_unix() - 120.0 * 86400.0)
  db_execute("INSERT INTO trial (trial_date, day_window, arm_id, status, reward, moment_present) VALUES (?, 'morning', ?, 'completed', 0.9, 1)", [today, aid])
  db_execute("INSERT INTO trial (trial_date, day_window, arm_id, status, reward, moment_present) VALUES (?, 'morning', ?, 'completed', 0.9, 1)", [today, aid])
  db_execute("INSERT INTO trial (trial_date, day_window, arm_id, status, reward, moment_present) VALUES (?, 'morning', ?, 'completed', 0.9, 1)", [today, aid])
  db_execute("INSERT INTO trial (trial_date, day_window, arm_id, status, reward, moment_present) VALUES (?, 'morning', ?, 'completed', 0.0, 1)", [old, aid])
  let post = arm_posterior(aid, 0.6, 0.15)
  assert_eq(round(post[0] * 100.0), 71.0)
  assert_eq(round(post[2] * 10000.0), 33679.0)
}

test "a future-dated row is clamped to age zero" {
  // Reward 0.9 dated tomorrow on a 0.5±0.5 prior: clamped → w=1 →
  // mean (2 + 14.4)/20 = 0.82. Unclamped, the negative age would
  // overweight the row to w = e^(61/60) and move the mean to 0.87.
  db_execute("INSERT OR IGNORE INTO arm (name, group_name, day_window, duration_min, prior_mean, prior_std) VALUES ('post-future', 'post', 'morning', 10, 0.5, 0.5)")
  let aid_rows = query("SELECT id AS v FROM arm WHERE name = 'post-future'", [])
  let aid = aid_rows[0].v
  let tomorrow = date_format_iso(now_unix() + 86400.0)
  db_execute("INSERT INTO trial (trial_date, day_window, arm_id, status, reward, moment_present) VALUES (?, 'morning', ?, 'completed', 0.9, 1)", [tomorrow, aid])
  let post = arm_posterior(aid, 0.5, 0.5)
  assert_eq(round(post[0] * 100.0), 82.0)
}

test "silence produces no fabricated signal" {
  // A missed and a bare proposed trial feed nothing: the posterior is
  // exactly the prior (0.45±0.20 → sd = 1/√25 = 0.2).
  db_execute("INSERT OR IGNORE INTO arm (name, group_name, day_window, duration_min, prior_mean, prior_std) VALUES ('post-silent', 'post', 'morning', 10, 0.45, 0.2)")
  let aid_rows = query("SELECT id AS v FROM arm WHERE name = 'post-silent'", [])
  let aid = aid_rows[0].v
  db_execute("INSERT INTO trial (trial_date, day_window, arm_id, status) VALUES ('2026-10-01', 'morning', ?, 'missed')", [aid])
  db_execute("INSERT INTO trial (trial_date, day_window, arm_id, status) VALUES ('2026-10-02', 'morning', ?, 'proposed')", [aid])
  let post = arm_posterior(aid, 0.45, 0.2)
  assert_eq(round(post[0] * 100.0), 45.0)
  assert_eq(round(post[1] * 10000.0), 2000.0)
  assert_eq(round(post[2]), 0.0)
}

test "forced exploration is exactly 20 percent over 1000 decisions" {
  seed_pair()
  let before_rows = query("SELECT count(*) AS n FROM trial WHERE arm_id IS NOT NULL", [])
  let before = before_rows[0].n
  let forced = synth_explore(1000.0)
  // Any window of 1000 consecutive decision numbers contains exactly
  // 200 multiples of five, whatever phase the counter starts from.
  assert_eq(forced, 200.0)
  let after_rows = query("SELECT count(*) AS n FROM trial WHERE arm_id IS NOT NULL", [])
  assert_eq(after_rows[0].n - before, 1000.0)
}

test "converges to the best arm on synthetic data" {
  seed_pair()
  // A controlled universe: only the synthetic pair competes; the flags
  // are restored at the end so later tests keep a live library.
  db_execute("UPDATE arm SET active = 0 WHERE name NOT IN ('syn-good', 'syn-bad')")
  let good_rows = query("SELECT id AS v FROM arm WHERE name = 'syn-good'", [])
  let good = good_rows[0].v
  let counts = synth_feed(200.0, good, 0.9, 0.1)
  // 200 decisions = 160 Thompson + 40 forced (20 per arm round-robin).
  // Once the posteriors separate, the exploit picks go to syn-good:
  // 140 is well below the expected ~175 and far above the 40-ish a
  // broken argmax would produce.
  assert_eq(counts[0] > counts[1], true)
  assert_eq(counts[0] >= 140.0, true)
  let pg = arm_posterior(good, 0.5, 0.5)
  let bad_rows = query("SELECT id AS v FROM arm WHERE name = 'syn-bad'", [])
  let pb = arm_posterior(bad_rows[0].v, 0.5, 0.5)
  assert_eq(pg[0] > pb[0], true)
  db_execute("UPDATE arm SET active = 1")
}

test "a proposal writes a trial row in the chosen arm's window" {
  // Н2-08: a unique date — the synthetic fixtures above already occupy
  // today's, and the day guard re-shows their rows.
  let tid = bandit_propose("2031-01-01", 7.0)
  assert_eq(tid > 0.0, true)
  let rows = query("SELECT t.arm_id AS aid, t.day_window AS w, t.status AS st FROM trial t WHERE t.id = ?", [tid])
  assert_eq(rows[0].st, "proposed")
  let arm = query("SELECT day_window AS w FROM arm WHERE id = ?", [rows[0].aid])
  assert_eq(rows[0].w, arm[0].w)
}

test "Н2-08 guard: a repeated proposal for the same day re-shows the trial" {
  let d = "2031-02-01"
  let t1 = bandit_propose(d, 7.0)
  assert_eq(t1 > 0.0, true)
  let t2 = bandit_propose(d, 99.0)
  assert_eq(t2, t1)
  let rows = query("SELECT count(*) AS n FROM trial WHERE trial_date = ?", [d])
  assert_eq(rows[0].n, 1.0)
}

test "Н2-08 guard: a fresh date proposes anew" {
  let t = bandit_propose("2031-02-02", 7.0)
  assert_eq(t > 0.0, true)
  let rows = query("SELECT count(*) AS n FROM trial WHERE trial_date = '2031-02-02'", [])
  assert_eq(rows[0].n, 1.0)
}

test "bandit table declarations match the store's (column pin)" {
  let trial = query("SELECT sql AS s FROM sqlite_master WHERE name = 'trial'", [])
  assert_contains(trial[0].s, "arm_id INTEGER")
  assert_contains(trial[0].s, "status TEXT DEFAULT 'proposed'")
  assert_contains(trial[0].s, "moment_present INTEGER DEFAULT '0'")
  assert_contains(trial[0].s, "reward REAL DEFAULT '0.0'")
  let arm = query("SELECT sql AS s FROM sqlite_master WHERE name = 'arm'", [])
  assert_contains(arm[0].s, "prior_mean REAL DEFAULT '0.0'")
  assert_contains(arm[0].s, "prior_std REAL DEFAULT '1.0'")
  // №611 (v0.29.0): references() is enforced in the emitted DDL, so the
  // FK clauses are pinnable — and the FK parent (note) must exist in this
  // standalone schema, or inserts into trial fail with no such table.
  let note = query("SELECT sql AS s FROM sqlite_master WHERE name = 'note'", [])
  assert_contains(note[0].s, "body TEXT")
  assert_contains(trial[0].s, "REFERENCES note(id)")
  assert_contains(trial[0].s, "REFERENCES arm(id)")
}

test "Н3-01: a class-C hand is never picked without consent, forced exploration included" {
  // prior 0.9 +- 0.01: Thompson would favour it overwhelmingly, so any
  // leak through the candidate filter shows up at once.
  let cid = db_insert("arm", {name: "h301-class-c", group_name: "g", day_window: "morning", duration_min: 5.0, prior_mean: 0.9, prior_std: 0.01, active: 1})
  let _ = db_insert("practice_protocol", {arm_id: cid, slot: "breath", safety_class: "C", requires_consent: 1, steps_json: "[]", series_json: ""})
  let mut i = 0.0
  let mut hits = 0.0
  let mut explores = 0.0
  while i < 20.0 {
    let pick = bandit_pick(300.0 + i)
    if pick.arm_id == cid {
      hits = hits + 1.0
    }
    if pick.mode == "explore" {
      explores = explores + 1.0
    }
    let _ = db_insert("trial", {trial_date: "2032-03-01", day_window: "morning", arm_id: pick.arm_id})
    i = i + 1.0
  }
  assert_eq(hits, 0.0)
  assert_eq(explores >= 3.0, true)
  // the consent record opens the hand to the candidate set; a revoked one closes it again
  let _ = db_insert("consent", {scope: "class:C", source: "test"})
  let mut seen = 0.0
  let el = eligible_arms()
  each e in el {
    if e.id == cid {
      seen = seen + 1.0
    }
  }
  assert_eq(seen, 1.0)
  let _ = db_execute("UPDATE consent SET revoked = 1 WHERE scope = 'class:C'", [])
  let mut seen2 = 0.0
  let el2 = eligible_arms()
  each e2 in el2 {
    if e2.id == cid {
      seen2 = seen2 + 1.0
    }
  }
  assert_eq(seen2, 0.0)
}

// ── Н3-06: the slot rotation tests (ADR-0003 synthetic) ─────────────────
// ORDER MATTERS on the shared test database: the rotation tests run AFTER
// every bandit test above (the bandit tests pin exact counts over their
// own synthetic arms, which carry NO protocol and NO slot — the rotation
// cannot see them). The rotation fixtures create their own slots.

pattern seed_rot_basic() -> Float {
  let _ = db_execute("INSERT OR IGNORE INTO slot (name, max_active) VALUES ('rotbreath', 3)", [])
  let _ = db_execute("CREATE UNIQUE INDEX IF NOT EXISTS idx_bandit_rot_name ON arm(name)")
  let _ = db_execute("INSERT OR IGNORE INTO arm (name, group_name, day_window, duration_min, prior_mean, prior_std, active) VALUES ('rot-a', 'rot', 'morning', 10, 0.5, 0.2, 1)", [])
  let _ = db_execute("INSERT OR IGNORE INTO arm (name, group_name, day_window, duration_min, prior_mean, prior_std, active) VALUES ('rot-b', 'rot', 'morning', 10, 0.5, 0.2, 1)", [])
  let _ = db_execute("INSERT OR IGNORE INTO arm (name, group_name, day_window, duration_min, prior_mean, prior_std, active) VALUES ('rot-c', 'rot', 'morning', 10, 0.5, 0.2, 1)", [])
  let _ = db_execute("INSERT OR IGNORE INTO arm (name, group_name, day_window, duration_min, prior_mean, prior_std, active) VALUES ('rot-d', 'rot', 'morning', 10, 0.45, 0.2, 0)", [])
  let _ = db_execute("INSERT OR IGNORE INTO arm (name, group_name, day_window, duration_min, prior_mean, prior_std, active) VALUES ('rot-e', 'rot', 'morning', 10, 0.5, 0.2, 0)", [])
  let _ = db_execute("INSERT OR IGNORE INTO practice_protocol (arm_id, slot, safety_class, requires_consent, session_min, source) SELECT id, 'rotbreath', 'A', 0, 10, 'rot fixture' FROM arm WHERE name IN ('rot-a', 'rot-b', 'rot-c', 'rot-d')", [])
  let _ = db_execute("INSERT OR IGNORE INTO practice_protocol (arm_id, slot, safety_class, requires_consent, session_min, source) SELECT id, 'rotbreath', 'C', 1, 10, 'rot fixture' FROM arm WHERE name = 'rot-e'", [])
  let _ = db_execute("INSERT OR IGNORE INTO consent (scope, source) VALUES ('class:A', 'rot fixture: живо')", [])
  let _ = db_execute("INSERT OR IGNORE INTO consent (scope, source) VALUES ('class:C', 'rot fixture: живо (не отозвано)')", [])
  return 0.0
}

pattern rot_feed(arm_name: String, reward: Float, k: Float) -> Float {
  let rows = query("SELECT id FROM arm WHERE name = ?", [arm_name])
  let aid = rows[0].id
  let d = date_format_iso(now_unix())
  let mut i = 0.0
  let mut fed = 0.0
  while i < k {
    let _ = db_execute("INSERT INTO trial (trial_date, day_window, arm_id, status, reward, moment_present) VALUES (?, 'morning', ?, 'completed', ?, 1)", [d, aid, reward])
    fed = fed + 1.0
    i = i + 1.0
  }
  return fed
}

pattern arm_active(name: String) -> Float {
  let rows = query("SELECT a.active AS a FROM arm a WHERE a.name = ?", [name])
  return rows[0].a
}

test "Н3-06 rot: the clearly worse hand is retired exactly at 25 observations and replaced by the next catalog hand" {
  seed_rot_basic()
  // rot-a: 30 low rewards; rot-b, rot-c: 30 high rewards each
  let _ = rot_feed("rot-a", 0.1, 30.0)
  let _ = rot_feed("rot-b", 0.9, 30.0)
  let _ = rot_feed("rot-c", 0.9, 30.0)
  let replaced = rotate_slots()
  assert_eq(replaced, 1.0)
  // the weakest hand is off, the best prior candidate (rot-e, prior 0.5,
  // class C WITH a live consent) is in — the slot is staffed again
  assert_eq(arm_active("rot-a"), 0.0)
  assert_eq(arm_active("rot-e"), 1.0)
  let active = query("SELECT count(*) AS n FROM arm a JOIN practice_protocol p ON p.arm_id = a.id WHERE p.slot = 'rotbreath' AND a.active = 1", [])
  assert_eq(active[0].n, 3.0)
  // the journal carries WHO (actor), WHAT (rotate-off/rotate-on) and the
  // numbers of the criterion
  let off = query("SELECT detail FROM arm_journal WHERE action = 'rotate-off' ORDER BY id DESC LIMIT 1", [])
  assert_contains(off[0].detail, "n=30")
  assert_contains(off[0].detail, "mean=")
  assert_contains(off[0].detail, "prob=")
  let on = query("SELECT actor, detail FROM arm_journal WHERE action = 'rotate-on' ORDER BY id DESC LIMIT 1", [])
  assert_eq(on[0].actor, "rotation")
  assert_contains(on[0].detail, "prior_mean=")
}

test "Н3-06 rot: 24 observations are not enough (the observation floor)" {
  // a separate slot: three active hands, the weakest fed 24 trials only
  let _ = db_execute("INSERT OR IGNORE INTO slot (name, max_active) VALUES ('rot24', 3)", [])
  let _ = db_execute("INSERT OR IGNORE INTO arm (name, group_name, day_window, duration_min, prior_mean, prior_std, active) VALUES ('rot24-a', 'r24', 'morning', 10, 0.5, 0.2, 1)", [])
  let _ = db_execute("INSERT OR IGNORE INTO arm (name, group_name, day_window, duration_min, prior_mean, prior_std, active) VALUES ('rot24-b', 'r24', 'morning', 10, 0.5, 0.2, 1)", [])
  let _ = db_execute("INSERT OR IGNORE INTO arm (name, group_name, day_window, duration_min, prior_mean, prior_std, active) VALUES ('rot24-c', 'r24', 'morning', 10, 0.5, 0.2, 1)", [])
  let _ = db_execute("INSERT OR IGNORE INTO arm (name, group_name, day_window, duration_min, prior_mean, prior_std, active) VALUES ('rot24-d', 'r24', 'morning', 10, 0.5, 0.2, 0)", [])
  // rot24-e: an admissible CANDIDATE so the 14-day-window test (below)
  // fails loudly when the window is mutated away — without it the zero
  // replacements would also come from "no candidate", which is not the
  // property this test pins
  let _ = db_execute("INSERT OR IGNORE INTO arm (name, group_name, day_window, duration_min, prior_mean, prior_std, active) VALUES ('rot24-e', 'r24', 'morning', 10, 0.5, 0.2, 0)", [])
  let _ = db_execute("INSERT OR IGNORE INTO practice_protocol (arm_id, slot, safety_class, requires_consent, session_min, source) SELECT id, 'rot24', 'A', 0, 10, 'rot fixture' FROM arm WHERE name LIKE 'rot24-%'", [])
  let _ = rot_feed("rot24-a", 0.1, 24.0)
  let _ = rot_feed("rot24-b", 0.9, 24.0)
  let _ = rot_feed("rot24-c", 0.9, 24.0)
  let _ = rot_feed("rot24-d", 0.9, 24.0)
  let replaced = rotate_slots()
  assert_eq(replaced, 0.0)
  assert_eq(arm_active("rot24-a"), 1.0)
  // the very next observation crosses the floor: 25 trials — retired
  // (the SAME slot, the window still open: no replacement happened yet)
  let _ = rot_feed("rot24-a", 0.1, 1.0)
  let replaced2 = rotate_slots()
  assert_eq(replaced2, 1.0)
  assert_eq(arm_active("rot24-a"), 0.0)
}

test "Н3-06 rot: at most one replacement per slot per 14 days — and the window OPENS after it" {
  // the rot24 slot has just had a replacement (the test above); its
  // window is closed — a second weak hand in the same slot waits, even
  // with an admissible candidate (rot24-e) in place
  let _ = rot_feed("rot24-b", 0.1, 30.0)
  let replaced = rotate_slots()
  assert_eq(replaced, 0.0)
  assert_eq(arm_active("rot24-b"), 1.0)
  // 15 days later the window is open again: the SAME weak hand is now
  // replaced — the window is the ONLY thing that held it back
  let _ = db_execute("UPDATE arm_journal SET created_at = datetime('now', '-15 days') WHERE action = 'rotate-off' AND arm_id = (SELECT id FROM arm WHERE name = 'rot24-a')", [])
  let replaced2 = rotate_slots()
  assert_eq(replaced2, 1.0)
  assert_eq(arm_active("rot24-b"), 0.0)
  assert_eq(arm_active("rot24-e"), 1.0)
}

test "Н3-06 rot: class C without a live consent is not a candidate; the 90-day cooldown holds and expires" {
  // the candidate filter of the rotation, unit-tested directly (a real
  // replacement here would be blocked by the 14-day window that the
  // cooldown seed itself opens — the replacement path is covered by the
  // first test). The consent filter rides scope = 'class:' || the
  // safety class (the bandit-eligible filter): a class-C hand is a
  // candidate ONLY while a live class:C row exists.
  // Candidates of the rotc slot, ids ascending: rotc-1 (class A, in the
  // 90-day cooldown), rotc-2 (class C), rotc-3 (class A).
  let _ = db_execute("INSERT OR IGNORE INTO slot (name, max_active) VALUES ('rotc', 3)", [])
  let _ = db_execute("INSERT OR IGNORE INTO arm (name, group_name, day_window, duration_min, prior_mean, prior_std, active) VALUES ('rotc-a', 'rc', 'morning', 10, 0.5, 0.2, 1)", [])
  let _ = db_execute("INSERT OR IGNORE INTO arm (name, group_name, day_window, duration_min, prior_mean, prior_std, active) VALUES ('rotc-1', 'rc', 'morning', 10, 0.5, 0.2, 0)", [])
  let _ = db_execute("INSERT OR IGNORE INTO arm (name, group_name, day_window, duration_min, prior_mean, prior_std, active) VALUES ('rotc-2', 'rc', 'morning', 10, 0.5, 0.2, 0)", [])
  let _ = db_execute("INSERT OR IGNORE INTO arm (name, group_name, day_window, duration_min, prior_mean, prior_std, active) VALUES ('rotc-3', 'rc', 'morning', 10, 0.5, 0.2, 0)", [])
  let _ = db_execute("INSERT OR IGNORE INTO practice_protocol (arm_id, slot, safety_class, requires_consent, session_min, source) SELECT id, 'rotc', 'A', 0, 10, 'rot fixture' FROM arm WHERE name IN ('rotc-a', 'rotc-1', 'rotc-3')", [])
  let _ = db_execute("INSERT OR IGNORE INTO practice_protocol (arm_id, slot, safety_class, requires_consent, session_min, source) SELECT id, 'rotc', 'C', 1, 10, 'rot fixture' FROM arm WHERE name = 'rotc-2'", [])
  let id_rows = query("SELECT id FROM arm WHERE name = 'rotc-1'", [])
  let _ = db_execute("INSERT INTO arm_journal (actor, arm_id, action, detail, created_at) VALUES ('rotation', ?, 'rotate-off', 'cooldown seed', datetime('now', '-10 days'))", [id_rows[0].id])
  // the live class:C consent exists (the fixture above and the earlier
  // Н3-01 test both carry rows): with rotc-1 in cooldown the candidate
  // is the class-C hand rotc-2 — a class-C hand WITH consent enters
  let c2 = rotation_candidate("rotc")
  let c2_name = query("SELECT name FROM arm WHERE id = ?", [c2])
  assert_eq(c2_name[0].name, "rotc-2")
  // revoke class:C — the class-C hand is out, the next candidate is the
  // class-A rotc-3 (a class-C hand WITHOUT consent is never admitted)
  let _ = db_execute("UPDATE consent SET revoked = 1 WHERE scope = 'class:C'", [])
  let c3 = rotation_candidate("rotc")
  let c3_name = query("SELECT name FROM arm WHERE id = ?", [c3])
  assert_eq(c3_name[0].name, "rotc-3")
  // the 90-day cooldown: rotc-1 was retired 10 days ago and stays out
  // (rotc-3 above is still ahead of it); 91 days later it returns
  let _ = db_execute("UPDATE arm_journal SET created_at = datetime('now', '-91 days') WHERE arm_id = (SELECT id FROM arm WHERE name = 'rotc-1') AND action = 'rotate-off'", [])
  let c1 = rotation_candidate("rotc")
  let c1_name = query("SELECT name FROM arm WHERE id = ?", [c1])
  assert_eq(c1_name[0].name, "rotc-1")
}

test "Н3-06 rot: an incomplete slot is never rotated; methods waits for the owner's confirm" {
  // incomplete: retire rot-b (rot-a was retired by the first rotation
  // test and rot-e is active — the slot is left with two active hands)
  seed_rot_basic()
  let _ = db_execute("UPDATE arm SET active = 0 WHERE name = 'rot-b'", [])
  let _ = db_execute("INSERT INTO arm_journal (actor, arm_id, action) SELECT 'rotation', id, 'arm-off' FROM arm WHERE name = 'rot-b'", [])
  let _ = rot_feed("rot-c", 0.1, 30.0)
  let replaced = rotate_slots()
  assert_eq(replaced, 0.0)
  // the incomplete slot is untouched (rot-e keeps its place)
  assert_eq(arm_active("rot-e"), 1.0)
  // methods: fully staffed but without the Н3-05 armed cap — untouched
  let _ = db_execute("INSERT OR IGNORE INTO slot (name, max_active) VALUES ('methods', 3)", [])
  let _ = db_execute("INSERT OR IGNORE INTO arm (name, group_name, day_window, duration_min, prior_mean, prior_std, active) VALUES ('rotm-a', 'rm', 'morning', 10, 0.5, 0.2, 1)", [])
  let _ = db_execute("INSERT OR IGNORE INTO arm (name, group_name, day_window, duration_min, prior_mean, prior_std, active) VALUES ('rotm-b', 'rm', 'morning', 10, 0.5, 0.2, 1)", [])
  let _ = db_execute("INSERT OR IGNORE INTO arm (name, group_name, day_window, duration_min, prior_mean, prior_std, active) VALUES ('rotm-c', 'rm', 'morning', 10, 0.5, 0.2, 1)", [])
  let _ = db_execute("INSERT OR IGNORE INTO arm (name, group_name, day_window, duration_min, prior_mean, prior_std, active) VALUES ('rotm-d', 'rm', 'morning', 10, 0.5, 0.2, 0)", [])
  let _ = db_execute("INSERT OR IGNORE INTO practice_protocol (arm_id, slot, safety_class, requires_consent, session_min, source) SELECT id, 'methods', 'A', 0, 10, 'rot fixture' FROM arm WHERE name LIKE 'rotm-%'", [])
  let _ = rot_feed("rotm-a", 0.1, 30.0)
  let _ = rot_feed("rotm-b", 0.9, 30.0)
  let _ = rot_feed("rotm-c", 0.9, 30.0)
  let replaced2 = rotate_slots()
  assert_eq(replaced2, 0.0)
  assert_eq(arm_active("rotm-a"), 1.0)
  // the owner's confirm event (as in the real confirm path: NULL arm_id)
  // arms the methods slot — the rotation now acts on it
  let _ = db_execute("INSERT INTO arm_journal (actor, arm_id, action, detail) VALUES ('owner', NULL, 'methods-cap-armed', 'test confirm')", [])
  let replaced3 = rotate_slots()
  assert_eq(replaced3, 1.0)
  assert_eq(arm_active("rotm-a"), 0.0)
  assert_eq(arm_active("rotm-d"), 1.0)
}
