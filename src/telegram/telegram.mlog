entity kamerton_arms: List = [
  {name: "breath-resonance-morning", group_name: "Резонансное дыхание", day_window: "morning", duration_min: 10.0, prior_mean: 0.6, prior_std: 0.15, source: "Lehrer & Gevirtz 2014 (Front Psychol 5:753): resonance-frequency HRV biofeedback, robust baroreflex effects"},
  {name: "breath-resonance-evening", group_name: "Резонансное дыхание", day_window: "evening", duration_min: 10.0, prior_mean: 0.6, prior_std: 0.15, source: "Lehrer & Gevirtz 2014 (Front Psychol 5:753): resonance-frequency HRV biofeedback, robust baroreflex effects"},
  {name: "woop-morning", group_name: "Имплементационные намерения", day_window: "morning", duration_min: 10.0, prior_mean: 0.6, prior_std: 0.15, source: "Gollwitzer & Sheeran 2006 (Adv Exp Soc Psychol 38): meta-analysis of 94 studies, d ~ 0.65"},
  {name: "woop-evening", group_name: "Имплементационные намерения", day_window: "evening", duration_min: 10.0, prior_mean: 0.6, prior_std: 0.15, source: "Gollwitzer & Sheeran 2006 (Adv Exp Soc Psychol 38): meta-analysis of 94 studies, d ~ 0.65"},
  {name: "mental-rehearsal-morning", group_name: "Ментальная репетиция", day_window: "morning", duration_min: 10.0, prior_mean: 0.5, prior_std: 0.15, source: "Driskell, Copper & Moran 1994 (J Appl Psychol 79(4)): mental practice meta-analysis, moderate effect, decays without physical practice"},
  {name: "mental-rehearsal-evening", group_name: "Ментальная репетиция", day_window: "evening", duration_min: 10.0, prior_mean: 0.5, prior_std: 0.15, source: "Driskell, Copper & Moran 1994 (J Appl Psychol 79(4)): mental practice meta-analysis, moderate effect, decays without physical practice"},
  {name: "focusing-morning", group_name: "Фокусинг", day_window: "morning", duration_min: 10.0, prior_mean: 0.45, prior_std: 0.2, source: "Hendricks 2002 (The Focusing-oriented client): experiential review, small-N studies, mixed quality — wide prior"},
  {name: "focusing-evening", group_name: "Фокусинг", day_window: "evening", duration_min: 10.0, prior_mean: 0.45, prior_std: 0.2, source: "Hendricks 2002 (The Focusing-oriented client): experiential review, small-N studies, mixed quality — wide prior"},
  {name: "yoga-nidra-morning", group_name: "Йога-нидра", day_window: "morning", duration_min: 10.0, prior_mean: 0.45, prior_std: 0.2, source: "Moszeik, von Oertzen & Günther 2022 (Current Psychology): Yoga Nidra effects on stress, sleep, well-being — moderate, wide prior"},
  {name: "yoga-nidra-evening", group_name: "Йога-нидра", day_window: "evening", duration_min: 10.0, prior_mean: 0.45, prior_std: 0.2, source: "Moszeik, von Oertzen & Günther 2022 (Current Psychology): Yoga Nidra effects on stress, sleep, well-being — moderate, wide prior"}
]

// Seed the arm library. Idempotent by construction: a UNIQUE index on
// name plus INSERT OR IGNORE — a repeated run changes nothing.
//
// WHY UNROLLED STATEMENTS (§2, declared loudly): the mlog D2 defect
// (declared in Kamerton issue #24; verified on v0.28.1 AND v0.28.2 by
// mutation probes) mis-executes loops whose body is a bare call — one
// iteration, and in a test body the tail after such a loop is silently
// cut (vacuously green). Assignment-body loops are full, but the
// trigger surface is not fully mapped (the probeprint case differs
// from the db_execute case), so the discipline here is: NO loops in
// test bodies at all until the language naryads land (Metalogos-
// №597/№598 → v0.28.3). A loop-driven seed would silently insert only
// the first arm, so the seed is unrolled into sequential statements
// and pinned to the kamerton_arms entity list by the per-arm VALUES
// LEFT JOIN verification test (loop-free); the JSON mirror is pinned
// to the same list. Divergence of any copy is a loud test failure.

pattern seed_arms() -> Float {
  db_execute("CREATE UNIQUE INDEX IF NOT EXISTS idx_arm_name_unique ON arm(name)")
  db_execute("INSERT OR IGNORE INTO arm (name, group_name, day_window, duration_min, prior_mean, prior_std) VALUES ('breath-resonance-morning', 'Резонансное дыхание', 'morning', 10, 0.6, 0.15)")
  db_execute("INSERT OR IGNORE INTO arm (name, group_name, day_window, duration_min, prior_mean, prior_std) VALUES ('breath-resonance-evening', 'Резонансное дыхание', 'evening', 10, 0.6, 0.15)")
  db_execute("INSERT OR IGNORE INTO arm (name, group_name, day_window, duration_min, prior_mean, prior_std) VALUES ('woop-morning', 'Имплементационные намерения', 'morning', 10, 0.6, 0.15)")
  db_execute("INSERT OR IGNORE INTO arm (name, group_name, day_window, duration_min, prior_mean, prior_std) VALUES ('woop-evening', 'Имплементационные намерения', 'evening', 10, 0.6, 0.15)")
  db_execute("INSERT OR IGNORE INTO arm (name, group_name, day_window, duration_min, prior_mean, prior_std) VALUES ('mental-rehearsal-morning', 'Ментальная репетиция', 'morning', 10, 0.5, 0.15)")
  db_execute("INSERT OR IGNORE INTO arm (name, group_name, day_window, duration_min, prior_mean, prior_std) VALUES ('mental-rehearsal-evening', 'Ментальная репетиция', 'evening', 10, 0.5, 0.15)")
  db_execute("INSERT OR IGNORE INTO arm (name, group_name, day_window, duration_min, prior_mean, prior_std) VALUES ('focusing-morning', 'Фокусинг', 'morning', 10, 0.45, 0.2)")
  db_execute("INSERT OR IGNORE INTO arm (name, group_name, day_window, duration_min, prior_mean, prior_std) VALUES ('focusing-evening', 'Фокусинг', 'evening', 10, 0.45, 0.2)")
  db_execute("INSERT OR IGNORE INTO arm (name, group_name, day_window, duration_min, prior_mean, prior_std) VALUES ('yoga-nidra-morning', 'Йога-нидра', 'morning', 10, 0.45, 0.2)")
  db_execute("INSERT OR IGNORE INTO arm (name, group_name, day_window, duration_min, prior_mean, prior_std) VALUES ('yoga-nidra-evening', 'Йога-нидра', 'evening', 10, 0.45, 0.2)")
  let rows = query("SELECT count(*) AS n FROM arm", [])
  return rows[0].n
}

// ── APP-MIRROR-END: arms-seed ─────────────────────────────────────────

// ── APP-MIRROR-START: miniapp-core (byte-identical to
//    src/miniapp/miniapp.mlog §miniapp-core) ────────────────────────────

// Mini App core (Н2-03): the token guard, the page literal and the
// practice-session writers. The page is served from the TRUSTED
// literal: read_file output carries 'public, untrusted' and the №391
// sink clearance refuses respond(read_file(...)) (probe n203-serve-1),
// so self-host/miniapp/index.html is the byte-pinned canon and this
// literal is its serving copy; the lockstep test in the miniapp module
// pins the byte equality.

// The token guard — PURE function (the test lane has no env gate): the
// route passes the allowlisted stored value and the SANITIZED provided
// one (the escape_html bridge over query_param — the repo's
// sanitize-then-decide convention; the deploy token charset is
// alphanumeric, so the bridge is exact). Fail-closed: an unconfigured
// token (empty stored value) denies everything.
pattern miniapp_check_token(stored: String, provided: String) -> Bool {
  if stored == "" {
    return false
  }
  return provided == stored
}

// The page literal — byte-pinned to self-host/miniapp/index.html (see
// the miniapp module tests). No external origin anywhere in the markup
// (invariant 7): inline CSS/JS only, same-origin fetches only.
pattern miniapp_html() -> String {
  return "<!doctype html>\n<html lang=\"ru\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Камертон — практики</title>\n<style>\n  :root { --bg:#0f1115; --fg:#e8e6e3; --dim:#9a9a93; --accent:#e8862c; --ok:#4f9d69; --err:#c94f4f; }\n  * { box-sizing: border-box; margin: 0; }\n  body { background: var(--bg); color: var(--fg); font: 16px/1.5 system-ui, sans-serif; max-width: 480px; margin: 0 auto; padding: 16px; }\n  h1 { font-size: 20px; margin-bottom: 12px; }\n  nav { display: flex; gap: 8px; margin-bottom: 16px; }\n  nav button { flex: 1; padding: 10px; background: #1a1d24; color: var(--fg); border: 1px solid #2a2e37; border-radius: 8px; font-size: 15px; }\n  nav button.on { border-color: var(--accent); color: var(--accent); }\n  .screen { display: none; }\n  .screen.on { display: block; }\n  .card { background: #161920; border: 1px solid #2a2e37; border-radius: 12px; padding: 16px; margin-bottom: 12px; }\n  .circle { width: 160px; height: 160px; border-radius: 50%; background: radial-gradient(circle at 35% 35%, #3a4152, #22262f); margin: 24px auto; }\n  .lbl { color: var(--dim); font-size: 13px; }\n  .row { display: flex; gap: 8px; margin-top: 8px; flex-wrap: wrap; }\n  button.act { padding: 10px 14px; border: 0; border-radius: 8px; background: var(--accent); color: #14100b; font-size: 15px; }\n  button.act.sec { background: #2a2e37; color: var(--fg); }\n  #status { font-size: 13px; color: var(--dim); min-height: 20px; margin-top: 8px; white-space: pre-wrap; }\n  .ok { color: var(--ok); } .err { color: var(--err); }\n</style>\n</head>\n<body>\n<h1>Камертон</h1>\n<nav>\n  <button id=\"tab-pacer\" class=\"on\" onclick=\"show('pacer')\">Пейсер</button>\n  <button id=\"tab-ppg\" onclick=\"show('ppg')\">Пульс</button>\n</nav>\n\n<section id=\"screen-pacer\" class=\"screen on\">\n  <div class=\"card\">\n    <div class=\"circle\" id=\"pacer-circle\"></div>\n    <p class=\"lbl\">Экран пейсера — каркас. Ритм дыхания и протокол темпов входят нарядом Н2-04.</p>\n  </div>\n  <div class=\"card\">\n    <p class=\"lbl\">Журнал сессии (таблица practice_session, SQLite)</p>\n    <div class=\"row\">\n      <button class=\"act\" onclick=\"openSession('pacer')\">Начать сессию</button>\n      <button class=\"act sec\" onclick=\"markStep()\">Отметить шаг</button>\n      <button class=\"act sec\" onclick=\"closeSession()\">Завершить</button>\n    </div>\n    <p id=\"pacer-marks\" class=\"lbl\"></p>\n  </div>\n</section>\n\n<section id=\"screen-ppg\" class=\"screen\">\n  <div class=\"card\">\n    <div class=\"circle\"></div>\n    <p class=\"lbl\">Экран PPG — каркас. Съёмка пульса через камеру и RR-ряд входят нарядом Н2-05.</p>\n  </div>\n</section>\n\n<p id=\"status\"></p>\n\n<script>\n\"use strict\";\n// Канал ADR-0002 (вариант «а», приватный туннель): страница отдаётся\n// маршрутом /miniapp программы Камертона; токен владельца передаётся в\n// каждом запросе (параметр t из адреса страницы). Наружу страница не\n// ходит: вся работа против того же origin, внешних ресурсов нет —\n// инвариант 7 (данные не покидают машину владельца).\nvar TOKEN = new URLSearchParams(location.search).get(\"t\") || \"\";\nvar sessionId = 0;\nvar marks = [];\n\nfunction show(name) {\n  var names = [\"pacer\", \"ppg\"];\n  for (var i = 0; i < names.length; i++) {\n    document.getElementById(\"screen-\" + names[i]).className = names[i] === name ? \"screen on\" : \"screen\";\n    document.getElementById(\"tab-\" + names[i]).className = names[i] === name ? \"on\" : \"\";\n  }\n}\n\nfunction status(msg, cls) {\n  var el = document.getElementById(\"status\");\n  el.textContent = msg;\n  el.className = cls || \"\";\n}\n\nfunction api(path, params) {\n  var q = new URLSearchParams(params || {});\n  q.set(\"t\", TOKEN);\n  return fetch(path + \"?\" + q.toString(), {\n    method: \"POST\",\n    headers: { \"X-CSRF-Token\": csrfToken() }\n  })\n    .then(function (r) {\n      return r.text().then(function (body) { return { code: r.status, body: body }; });\n    });\n}\n\n// CSRF-мидлварь сервера (double-submit): GET страницы выдаёт куку\n// _mlog_csrf, каждый POST обязан нести её значение в X-CSRF-Token.\n// TTL токена — 15 минут; истёкший/чужой токен отвечает 403 с «CSRF»\n// в теле — перезагружаем страницу (GET перевыпустит куку). Отметки\n// шагов пишутся инкрементально, поэтому перезагрузка теряет максимум\n// текущий неотмеченный шаг.\nfunction csrfToken() {\n  var m = document.cookie.match(/(?:^|;\\s*)_mlog_csrf=([^;]+)/);\n  return m ? m[1] : \"\";\n}\n\nfunction openSession(kind) {\n  api(\"/miniapp/session\", { kind: kind, tempo_bpm: \"0\", steps_total: \"0\", arm_id: \"0\", trial_id: \"0\" })\n    .then(function (res) {\n      if (res.code === 403 && res.body.indexOf(\"CSRF\") >= 0) { location.reload(); return; }\n      if (res.code !== 200) { status(\"Отказ сервера: \" + res.code + \" \" + res.body, \"err\"); return; }\n      var d = JSON.parse(res.body);\n      sessionId = d.id;\n      marks = [];\n      document.getElementById(\"pacer-marks\").textContent = \"Сессия №\" + sessionId + \", шагов: 0\";\n      status(\"Сессия \" + sessionId + \" открыта\", \"ok\");\n    })\n    .catch(function (e) { status(\"Ошибка сети: \" + e, \"err\"); });\n}\n\nfunction markStep() {\n  if (!sessionId) { status(\"Сначала начните сессию\", \"err\"); return; }\n  var stepNo = marks.length + 1;\n  api(\"/miniapp/session/close\", {\n    id: String(sessionId),\n    steps_done: String(stepNo),\n    step_marks: JSON.stringify(marks.concat([{ step: stepNo }])),\n    rr_json: \"\",\n    rr_source: \"\"\n  })\n    .then(function (res) {\n      if (res.code === 403 && res.body.indexOf(\"CSRF\") >= 0) { location.reload(); return; }\n      if (res.code !== 200) { status(\"Отказ сервера: \" + res.code + \" \" + res.body, \"err\"); return; }\n      marks.push({ step: stepNo });\n      document.getElementById(\"pacer-marks\").textContent = \"Сессия №\" + sessionId + \", шагов: \" + marks.length;\n      status(\"Шаг \" + stepNo + \" записан в журнал\", \"ok\");\n    })\n    .catch(function (e) { status(\"Ошибка сети: \" + e, \"err\"); });\n}\n\nfunction closeSession() {\n  if (!sessionId) { status(\"Сессия не открыта\", \"err\"); return; }\n  api(\"/miniapp/session/close\", {\n    id: String(sessionId),\n    steps_done: String(marks.length),\n    step_marks: JSON.stringify(marks),\n    rr_json: \"\",\n    rr_source: \"\"\n  })\n    .then(function (res) {\n      if (res.code === 403 && res.body.indexOf(\"CSRF\") >= 0) { location.reload(); return; }\n      if (res.code !== 200) { status(\"Отказ сервера: \" + res.code + \" \" + res.body, \"err\"); return; }\n      status(\"Сессия \" + sessionId + \" закрыта: шагов \" + marks.length, \"ok\");\n      sessionId = 0; marks = [];\n      document.getElementById(\"pacer-marks\").textContent = \"\";\n    })\n    .catch(function (e) { status(\"Ошибка сети: \" + e, \"err\"); });\n}\n</script>\n</body>\n</html>\n"
}

// Open a practice session (the Н2-03 skeleton writer; the Н2-04/Н2-05
// screens are its clients). BOUNDARY pattern (the process_updates
// precedent of Н1-06): the route validates shapes loudly (whitelists,
// numeric guards over the escape bridge) and passes the values; inside
// the annotated parameters the data is sanctioned and the writers run.
// arm_id/trial_id below 1 mean "no linkage" and land as SQL NULL (the
// CASE form keeps ONE parameterized statement; 0 is never stored, so
// the FK clauses stay truthful under the enforced-references replay).
// Returns the new row id.
pattern miniapp_session_open(kind: String<public, trusted>, tempo_bpm: Float, steps_total: Float,
                             session_date: String<public, trusted>, arm_id: Float, trial_id: Float) -> Float {
  let _ = db_execute("INSERT INTO practice_session (kind, tempo_bpm, steps_total, session_date, arm_id, trial_id) VALUES (?, ?, ?, ?, CASE WHEN ? > 0 THEN ? END, CASE WHEN ? > 0 THEN ? END)", [kind, tempo_bpm, steps_total, session_date, arm_id, arm_id, trial_id, trial_id])
  let rows = query("SELECT last_insert_rowid() AS id", [])
  return rows[0].id
}

// Close/update a session: the completed-step count, the per-step marks
// and (from Н2-05) the RR series. BOUNDARY pattern: the raw JSON
// strings arrive trusted-by-annotation (the route capped their size
// and the parameterized UPDATE carries them verbatim — SQL-injection
// impossible); the JSON shape is validated by parse_json at every
// READ (garbage never decodes silently). Returns the number of
// updated rows (0 = unknown id — the route answers 404 loudly).
pattern miniapp_session_close(sid: Float, steps_done: Float, step_marks: String<public, trusted>,
                              rr_json: String<public, trusted>, rr_source: String<public, trusted>) -> Float {
  let _ = db_execute("UPDATE practice_session SET steps_done = ?, step_marks = ?, rr_json = ?, rr_source = ? WHERE id = ?", [steps_done, step_marks, rr_json, rr_source, sid])
  let rows = query("SELECT changes() AS n", [])
  return rows[0].n
}

// Read one session back (the module tests + the read path of
// Н2-06/Н2-07; a third-party sqlite3 client reads the same rows —
// invariant 6).
pattern miniapp_session_get(sid: Float) -> List {
  return query("SELECT id, kind, arm_id, trial_id, tempo_bpm, steps_total, steps_done, step_marks, rr_json, rr_source, session_date FROM practice_session WHERE id = ?", [sid])
}
// ── APP-MIRROR-END: miniapp-core ─────────────────────────────────────────

// ── APP-MIRROR-START: telegram-core (byte-identical to
//    src/telegram/telegram.mlog §telegram-core) ────────────────────────

// Local wall-clock date of a unix timestamp, "YYYY-MM-DD" — the trial
// date is the OWNER's date, not UTC's (the 02:00 close already lives
// in the next local day). date_parts is chrono::Local-based
// (probe-pinned); the assembly is manual zero-padded.
pattern local_iso_date(unix_ts: Float) -> String {
  let p = date_parts(unix_ts)
  let mut mo = to_string(p.month)
  if p.month < 10.0 {
    mo = "0" + mo
  }
  let mut dd = to_string(p.day)
  if p.day < 10.0 {
    dd = "0" + dd
  }
  return to_string(p.year) + "-" + mo + "-" + dd
}

// Fold local wall-clock minutes to the UTC cron expression for a fixed
// local time. local_minutes = hour*60+minute in the OWNER's wall
// clock, tz_offset_hours = local = UTC + offset. No modulo operator:
// the +2880 pad keeps the subtraction non-negative before the
// truncating division (the bandit explore-idx precedent).
pattern cron_expr_for(local_minutes: Float, tz_offset_hours: Float) -> String {
  let off_min = to_int(tz_offset_hours * 60.0)
  let shifted = local_minutes - to_float(off_min) + 2880.0
  let day = to_int(shifted / 1440.0)
  let modm = shifted - day * 1440.0
  let hh = to_int(modm / 60.0)
  let mm = modm - hh * 60.0
  return to_string(mm) + " " + to_string(hh) + " * * *"
}

// Parse one chat text into the protocol answer. Returns
// {kind: "prediction"|"moment"|"note", value: Float, text: String}.
// to_float fails LOUD on garbage (the m0_row precedent) — a malformed
// p:/m: answer degrades to a note, never to a silent zero.
pattern parse_chat_text(raw_text: String) -> Struct {
  let text = trim(raw_text)
  if starts_with(text, "p:") {
    let rest = trim(substring(text, 2, len(text)))
    // №514: to_float fails LOUD on garbage — a malformed answer
    // degrades to a note through the explicit -1 sentinel, never to a
    // silent zero (a silent zero would fabricate a prediction).
    let v = to_float_or(rest, 0 - 1.0)
    if v < 0.0 {
      return {kind: "note", value: 0.0, text: text}
    }
    return {kind: "prediction", value: v, text: text}
  }
  if starts_with(text, "m:") {
    let rest = trim(substring(text, 2, len(text)))
    let v = to_float_or(rest, 0 - 1.0)
    if v < 0.0 {
      return {kind: "note", value: 0.0, text: text}
    }
    return {kind: "moment", value: v, text: text}
  }
  return {kind: "note", value: 0.0, text: text}
}

// The morning proposal message. Every dynamic fragment passes
// escape_html — the acceptance row: DB output never reaches the chat
// raw.
pattern format_proposal(arm_name: String, note_body: String) -> String {
  return "Проба дня: " + escape_html(arm_name) + ". Нота: " + escape_html(note_body) + ". Ответь предсказанием: p:0..1"
}

// The morning proposal row: arm name + optional note body. SQL NULL
// from the LEFT JOIN materializes as Unit on 0.30.0 (probe-pinned,
// Н2-01) — escape_html would fail-closed [TYPE_MISMATCH] inside the
// first seeded proposal (the body would not be a String), so the
// body is COALESCEd to a String here.
pattern morning_proposal_row(tid: Float) -> List {
  return query("SELECT a.name, COALESCE(n.body, '') AS body FROM trial t JOIN arm a ON a.id = t.arm_id LEFT JOIN note n ON n.id = t.note_id WHERE t.id = ?", [tid])
}

// The evening report message.
pattern format_report(processed: Float, closed: Float, predictions: Float, moments: Float) -> String {
  return "Отчёт: обработано " + escape_html(to_string(processed)) + ", закрыто пропуском " + escape_html(to_string(closed)) + ", предсказаний " + escape_html(to_string(predictions)) + ", откликов " + escape_html(to_string(moments))
}

// The getUpdates URL with the offset + the long-poll timeout. The
// token lives in the URL path (the Bot API contract); it is read from
// the environment at the call site and never printed or echoed.
pattern get_updates_url(token: String, offset: Float) -> String {
  return "https://api.telegram.org/bot" + token + "/getUpdates?offset=" + to_string(offset) + "&timeout=25"
}

// One long-poll getUpdates with the №592 per-call deadline and the
// three-attempt caller-side retry (the language hides no retry inside,
// CHANGELOG-282). Returns the parsed update LIST — UNTRUSTED network
// data; the consumer must run it through the annotated boundary
// (process_updates). Empty List on exhausted retry: the caller
// distinguishes the drain outcome by the offset, silence is never
// fabricated as data.
// http_get returns the body as a RAW STRING (probe-pinned 2026-10-08):
// parse_json before json_get is mandatory — a direct json_get on the
// String silently returns the default and the drain sees an empty list.
pattern fetch_updates(token: String, offset: Float) -> List {
  let url = get_updates_url(token, offset)
  let mut attempt = 0.0
  while attempt < 3.0 {
    attempt = attempt + 1.0
    let r = try http_get(url, 40.0)
    // Sanitize-then-decide: escape_html restores integrity trust
    // (Sanitized = public/trusted); the raw label never branches.
    if escape_html(to_string(r.ok)) == "true" {
      return json_get(parse_json(to_string(r.value)), "result", [])
    }
    if attempt < 3.0 {
      sleep(15.0)
    }
  }
  return []
}
// ── APP-MIRROR-END: telegram-core

// ── Tests (the pure core, network-free) ───────────────────────────────

test "local_iso_date is zero-padded and date-keyed" {
  let d = local_iso_date(1791331200.0)
  assert_eq(len(d), 10.0)
  assert_eq(char_at(d, 4), "-")
  assert_eq(char_at(d, 7), "-")
  let yesterday = date_format_iso(date_parse_iso(d) - 86400.0)
  assert_eq(len(substring(yesterday, 0, 10)), 10.0)
}

test "cron_expr_for folds local minutes to UTC (MSK and fractional)" {
  assert_eq(cron_expr_for(420.0, 3.0), "0 4 * * *")
  assert_eq(cron_expr_for(120.0, 3.0), "0 23 * * *")
  assert_eq(cron_expr_for(420.0, 0.0), "0 7 * * *")
  assert_eq(cron_expr_for(420.0, 3.5), "30 3 * * *")
  assert_eq(cron_expr_for(420.0, -5.0), "0 12 * * *")
}

test "parse_chat_text: the p:/m:/note protocol" {
  let a = parse_chat_text("p:0.6")
  assert_eq(a.kind, "prediction")
  assert_eq(a.value, 0.6)
  let b = parse_chat_text(" m: 0.7 ")
  assert_eq(b.kind, "moment")
  assert_eq(b.value, 0.7)
  let c = parse_chat_text("проба прошла спокойно")
  assert_eq(c.kind, "note")
  assert_eq(c.value, 0.0)
  let d = parse_chat_text("p:abc")
  assert_eq(d.kind, "note")
}

test "format_proposal and format_report escape every dynamic fragment" {
  let msg = format_proposal("<b>arm</b>", "note & \"quote\"")
  assert_contains(msg, "&lt;b&gt;arm&lt;/b&gt;")
  assert_contains(msg, "note &amp; &quot;quote&quot;")
  let rep = format_report(1.0, 2.0, 3.0, 4.0)
  assert_contains(rep, "предсказаний 3")
  assert_contains(rep, "закрыто пропуском 2")
}

test "morning proposal row: a missing note stays a String (Н2-01 regression)" {
  // SQL NULL from the LEFT JOIN materializes as Unit on 0.30.0 — the
  // first seeded proposal died in escape_html AFTER the trial insert
  // (the silent burned-trial loop). COALESCE keeps the body a String.
  ensure_schema()
  db_execute("INSERT INTO arm (name, group_name, day_window, duration_min, prior_mean, prior_std) VALUES ('n2-01-arm', 'Резонансное дыхание', 'morning', 10, 0.6, 0.15)", [])
  db_execute("INSERT INTO trial (trial_date, day_window, arm_id) VALUES ('2026-10-08', 'morning', 1)", [])
  let ids = query("SELECT id FROM trial", [])
  let pr = morning_proposal_row(ids[0].id)
  assert_eq(len(pr), 1.0)
  assert_eq(pr[0].body, "")
  // must not fail-closed [TYPE_MISMATCH] on a missing note
  let msg = format_proposal(pr[0].name, pr[0].body)
  assert_contains(msg, "Проба дня: n2-01-arm")
}


test "seed_arms seeds exactly the ten canonical arms (Н2-01 restoration)" {
  // The Н2-01 order-proof restored: the byte-mirrored seed block must
  // produce exactly the ten canonical names (the IN-list predicate
  // covers every row in one assert — loop-free by the D2 discipline).
  // The double call exercises the INSERT OR IGNORE idempotency; the
  // group-by pins the UNIQUE index — a duplicate name cannot hide.
  ensure_schema()
  let _ = seed_arms()
  let _ = seed_arms()
  let rows = query("SELECT count(*) AS n FROM arm WHERE name IN ('breath-resonance-morning','breath-resonance-evening','woop-morning','woop-evening','mental-rehearsal-morning','mental-rehearsal-evening','focusing-morning','focusing-evening','yoga-nidra-morning','yoga-nidra-evening')", [])
  assert_eq(rows[0].n, 10.0)
  let dup = query("SELECT count(*) AS n FROM (SELECT name FROM arm GROUP BY name HAVING count(*) > 1)", [])
  assert_eq(dup[0].n, 0.0)
}

test "get_updates_url carries the offset and the long-poll timeout" {
  let url = get_updates_url("TEST-TOKEN", 102.0)
  assert_contains(url, "/botTEST-TOKEN/getUpdates?offset=102")
  assert_contains(url, "timeout=25")
}

test "fetch_updates success path: the body is a raw String, parse_json before json_get (regression 2026-10-08)" {
  // http_get returns r.value as the raw body STRING. The pre-fix code
  // ran json_get on the String and silently got the default — the drain
  // reported processed=0 while Telegram held unconfirmed updates.
  let raw = "{\"ok\": true, \"result\": [{\"update_id\": 80194091, \"message\": {\"text\": \"Тест\", \"chat\": {\"id\": 2044005421}}}]}"
  let updates = json_get(parse_json(raw), "result", [])
  assert_eq(len(updates), 1.0)
  assert_eq(json_get(updates[0], "update_id", 0.0), 80194091.0)
  assert_eq(json_get(updates[0], "message.text", ""), "Тест")
}

test "fetch_updates: three attempts with backoff, empty list on refusal" {
  let t0 = now_unix()
  let updates = fetch_updates("TEST-TOKEN", 0.0)
  let dt = now_unix() - t0
  assert_eq(len(updates), 0.0)
  assert_eq(dt > 30.0, true)
  assert_eq(dt < 200.0, true)
}

test "json_get over the getUpdates shape: chat filter fields" {
  let doc = parse_json("{\"ok\":true,\"result\":[{\"update_id\":100,\"message\":{\"message_id\":1,\"chat\":{\"id\":777},\"text\":\"p:0.5\"}}]}")
  let updates = json_get(doc, "result", [])
  let u = updates[0]
  assert_eq(json_get(u, "update_id", 0.0), 100.0)
  assert_eq(to_string(json_get(u, "message.chat.id", 0.0)), "777")
  assert_eq(json_get(u, "message.text", ""), "p:0.5")
  let doc2 = parse_json("{\"ok\":true,\"result\":[{\"update_id\":101}]}")
  let u2 = json_get(doc2, "result", [])[0]
  assert_eq(json_get(u2, "message.text", ""), "")
  assert_eq(to_string(json_get(u2, "message.chat.id", 0.0)), "0")
}

// ── Tests: the db-cycle (in-memory store, network-free) ───────────────

test "ensure_schema creates the six tables additively" {
  ensure_schema()
  ensure_schema()
  let rows = query("SELECT count(*) AS n FROM sqlite_master WHERE type = 'table' AND name IN ('note','trial','arm','response','context','candidate')", [])
  assert_eq(rows[0].n, 6.0)
  let cols = query("PRAGMA table_info(trial)", [])
  let mut has_prediction = false
  let mut has_moment_source = false
  each c in cols {
    if c.name == "prediction_depth" {
      has_prediction = true
    }
    if c.name == "moment_source" {
      has_moment_source = true
    }
  }
  assert_eq(has_prediction, true)
  assert_eq(has_moment_source, true)
}

test "apply_answer: prediction fills an untouched default exactly once" {
  ensure_schema()
  let aid = db_insert("arm", {name: "answer-arm", group_name: "g", day_window: "morning", duration_min: 10.0, prior_mean: 0.6, prior_std: 0.25, active: 1})
  let tid = db_insert("trial", {trial_date: "2026-10-06", day_window: "morning", arm_id: aid})
  let first = apply_answer(tid, parse_chat_text("p:0.6"))
  assert_eq(first, "prediction")
  let rows = trial_by_id(tid)
  assert_eq(rows[0].prediction_depth, 0.6)
  let second = apply_answer(tid, parse_chat_text("p:0.9"))
  assert_eq(second, "prediction-kept")
  let rows2 = trial_by_id(tid)
  assert_eq(rows2[0].prediction_depth, 0.6)
}

test "apply_answer: moment completes the trial and computes the reward once" {
  ensure_schema()
  let aid = db_insert("arm", {name: "moment-arm", group_name: "g", day_window: "morning", duration_min: 10.0, prior_mean: 0.6, prior_std: 0.25, active: 1})
  let tid = db_insert("trial", {trial_date: "2026-10-06", day_window: "morning", arm_id: aid})
  let first = apply_answer(tid, parse_chat_text("m:0.8"))
  assert_eq(first, "moment")
  let rows = trial_by_id(tid)
  assert_eq(rows[0].status, "completed")
  assert_eq(rows[0].moment_present, 1.0)
  assert_eq(rows[0].moment_source, "subjective")
  assert_eq(round(rows[0].reward * 100.0), 80.0)
  let second = apply_answer(tid, parse_chat_text("m:0.2"))
  assert_eq(second, "moment-kept")
  let rows2 = trial_by_id(tid)
  assert_eq(rows2[0].moment_value, 0.8)
  let resp = query("SELECT count(*) AS n FROM response WHERE trial_id = ? AND kind = 'moment'", [tid])
  assert_eq(resp[0].n, 1.0)
}

test "apply_answer: free notes append (the declared dup window)" {
  ensure_schema()
  let aid = db_insert("arm", {name: "note-arm", group_name: "g", day_window: "morning", duration_min: 10.0, prior_mean: 0.6, prior_std: 0.25, active: 1})
  let tid = db_insert("trial", {trial_date: "2026-10-06", day_window: "morning", arm_id: aid})
  let _ = apply_answer(tid, parse_chat_text("<script>x</script>"))
  let note_rows = query("SELECT free_note FROM trial WHERE id = ?", [tid])
  assert_contains(note_rows[0].free_note, "&lt;script&gt;")
}

test "close_stale_misses flips only the stale proposed rows" {
  ensure_schema()
  let aid = db_insert("arm", {name: "stale-arm", group_name: "g", day_window: "morning", duration_min: 10.0, prior_mean: 0.6, prior_std: 0.25, active: 1})
  let old = db_insert("trial", {trial_date: "2026-10-01", day_window: "morning", arm_id: aid})
  let fresh = db_insert("trial", {trial_date: "2026-10-06", day_window: "morning", arm_id: aid})
  let done = db_insert("trial", {trial_date: "2026-10-01", day_window: "morning", arm_id: aid, status: "completed"})
  let closed = close_stale_misses("2026-10-06")
  assert_eq(closed, 1.0)
  let rows_old = trial_by_id(old)
  assert_eq(rows_old[0].status, "missed")
  let rows_fresh = trial_by_id(fresh)
  assert_eq(rows_fresh[0].status, "proposed")
  let rows_done = trial_by_id(done)
  assert_eq(rows_done[0].status, "completed")
  assert_eq(close_stale_misses("2026-10-06"), 0.0)
}

test "process_updates with an empty batch: silent drain, offset untouched" {
  ensure_schema()
  kv_set("tg_offset", "7")
  let _ = process_updates([], "777", "2026-10-06", 7.0)
  assert_eq(to_float(kv_get("tg_offset")), 7.0)
}

test "process_updates drains a fake batch end-to-end (no network)" {
  ensure_schema()
  let d = "2026-11-09"
  let aid = db_insert("arm", {name: "drain-arm", group_name: "g", day_window: "morning", duration_min: 10.0, prior_mean: 0.6, prior_std: 0.25, active: 1})
  let nid = db_insert("note", {body: "drain note"})
  let tid = db_insert("trial", {trial_date: d, day_window: "morning", arm_id: aid, note_id: nid})
  let doc = parse_json("{\"result\":[{\"update_id\":900,\"message\":{\"chat\":{\"id\":777},\"text\":\"p:0.4\"}},{\"update_id\":901,\"message\":{\"chat\":{\"id\":777},\"text\":\"m:0.9\"}},{\"update_id\":902,\"message\":{\"chat\":{\"id\":999},\"text\":\"foreign\"}}]}")
  let updates = json_get(doc, "result", [])
  let _ = process_updates(updates, "777", d, 0.0)
  assert_eq(to_float(kv_get("tg_offset")), 903.0)
  let open_rows = trial_by_id(tid)
  assert_eq(open_rows[0].prediction_depth, 0.4)
  assert_eq(open_rows[0].status, "completed")
  assert_eq(open_rows[0].moment_value, 0.9)
  assert_eq(open_rows[0].moment_present, 1.0)
  assert_eq(round(open_rows[0].reward * 100.0), 90.0)
  let resp_rows = query("SELECT count(*) AS n FROM response WHERE trial_id = ? AND kind = 'moment'", [tid])
  assert_eq(resp_rows[0].n, 1.0)
  assert_eq(open_rows[0].status, "completed")
}

test "has_job and setup_register: idempotent registration" {
  ensure_schema()
  let pre = cron_list()
  each pj in pre {
    if pj.prompt == "tg_morning_tick" or pj.prompt == "tg_evening_tick" {
      let _ = cron_remove(pj.id)
    }
  }
  let off = 3.0
  let morning = cron_expr_for(420.0, off)
  let evening = cron_expr_for(120.0, off)
  assert_eq(has_job(morning, "tg_morning_tick"), false)
  let j1 = cron_add(morning, "tg_morning_tick")
  let _ = j1
  assert_eq(has_job(morning, "tg_morning_tick"), true)
  let j2 = cron_add(evening, "tg_evening_tick")
  let _ = j2
  setup_register()
  setup_register()
  let jobs = cron_list()
  let mut morning_count = 0.0
  let mut evening_count = 0.0
  each j in jobs {
    if j.prompt == "tg_morning_tick" {
      morning_count = morning_count + 1.0
    }
    if j.prompt == "tg_evening_tick" {
      evening_count = evening_count + 1.0
    }
  }
  assert_eq(morning_count, 1.0)
  assert_eq(evening_count, 1.0)
}
