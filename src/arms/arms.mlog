// ── Н4-07 tests: the admission gate (условие входа в активный набор) ───

test "Н4-07: the admission rules seed — 21 rules in 6 systems, levels 2..5, reseed is a no-op" {
  seed_mm_catalog()
  let _ = seed_mm_catalog()
  let total = query("SELECT count(*) AS n FROM practice_admission", [])
  assert_eq(total[0].n, 21.0)
  let l1 = query("SELECT count(*) AS n FROM practice_admission WHERE level < 2", [])
  assert_eq(l1[0].n, 0.0)
  let breath = query("SELECT count(*) AS n FROM practice_admission WHERE system = 'breath'", [])
  assert_eq(breath[0].n, 3.0)
  let dispenza = query("SELECT count(*) AS n FROM practice_admission WHERE system = 'dispenza'", [])
  assert_eq(dispenza[0].n, 4.0)
  let domfreq = query("SELECT count(*) AS n FROM practice_admission WHERE system = 'domfreq'", [])
  assert_eq(domfreq[0].n, 3.0)
  let feldenkrais = query("SELECT count(*) AS n FROM practice_admission WHERE system = 'feldenkrais'", [])
  assert_eq(feldenkrais[0].n, 3.0)
  let silva = query("SELECT count(*) AS n FROM practice_admission WHERE system = 'silva'", [])
  assert_eq(silva[0].n, 4.0)
  let trans = query("SELECT count(*) AS n FROM practice_admission WHERE system = 'transurfing'", [])
  assert_eq(trans[0].n, 4.0)
  // The source pins (progression.ts @ 2a26e75): transurfing level 5 is
  // 40 sessions / 600 minutes; breath level 2 is 3 / 30.
  let t5 = query("SELECT min_sessions AS s, min_minutes AS m FROM practice_admission WHERE system = 'transurfing' AND level = 5", [])
  assert_eq(t5[0].s, 40.0)
  assert_eq(t5[0].m, 600.0)
  let b2 = query("SELECT min_sessions AS s, min_minutes AS m FROM practice_admission WHERE system = 'breath' AND level = 2", [])
  assert_eq(b2[0].s, 3.0)
  assert_eq(b2[0].m, 30.0)
}

test "Н4-07: a level-3 practice stays out of the active set until the system admission is met" {
  // The naryad test. The fixture: one transurfing hand normalized to a
  // 10-minute duration, so 12 completed trials = 12 sessions / 120
  // minutes — exactly the transurfing level-3 rule (10 / 120).
  seed_mm_catalog()
  let rows = query("SELECT pp.arm_id AS id FROM practice_profile pp WHERE pp.system = 'transurfing' AND pp.level = 3 ORDER BY pp.arm_id LIMIT 1", [])
  let aid = rows[0].id
  let _ = db_execute("UPDATE arm SET duration_min = 10, active = 0 WHERE id = ?", [aid])
  // Locked: nothing met. The refusal is LOUD (the 'locked' string) and
  // journaled; the hand stays inactive.
  assert_eq(activate_arm(aid, "test-н4-07"), "locked")
  let act1 = query("SELECT active FROM arm WHERE id = ?", [aid])
  assert_eq(act1[0].active, 0.0)
  let jrnl = query("SELECT count(*) AS n FROM arm_journal WHERE arm_id = ? AND action = 'arm-on-refused' AND detail = 'admission-locked'", [aid])
  assert_eq(jrnl[0].n, 1.0)
  // 9 completed sessions: 90 minutes pass the minutes rule, the session
  // count does not — the gate stays closed (И сессии И минуты).
  let _ = db_execute("INSERT INTO trial (trial_date, day_window, arm_id, status) VALUES ('2042-05-01', 'morning', ?, 'completed')", [aid])
  let _ = db_execute("INSERT INTO trial (trial_date, day_window, arm_id, status) VALUES ('2042-05-02', 'morning', ?, 'completed')", [aid])
  let _ = db_execute("INSERT INTO trial (trial_date, day_window, arm_id, status) VALUES ('2042-05-03', 'morning', ?, 'completed')", [aid])
  let _ = db_execute("INSERT INTO trial (trial_date, day_window, arm_id, status) VALUES ('2042-05-04', 'morning', ?, 'completed')", [aid])
  let _ = db_execute("INSERT INTO trial (trial_date, day_window, arm_id, status) VALUES ('2042-05-05', 'morning', ?, 'completed')", [aid])
  let _ = db_execute("INSERT INTO trial (trial_date, day_window, arm_id, status) VALUES ('2042-05-06', 'morning', ?, 'completed')", [aid])
  let _ = db_execute("INSERT INTO trial (trial_date, day_window, arm_id, status) VALUES ('2042-05-07', 'morning', ?, 'completed')", [aid])
  let _ = db_execute("INSERT INTO trial (trial_date, day_window, arm_id, status) VALUES ('2042-05-08', 'morning', ?, 'completed')", [aid])
  let _ = db_execute("INSERT INTO trial (trial_date, day_window, arm_id, status) VALUES ('2042-05-09', 'morning', ?, 'completed')", [aid])
  assert_eq(mm_admission_ok(aid), false)
  assert_eq(activate_arm(aid, "test-н4-07"), "locked")
  // Missed trials are NOT sessions: three misses on top change nothing.
  let _ = db_execute("INSERT INTO trial (trial_date, day_window, arm_id, status) VALUES ('2042-05-10', 'morning', ?, 'missed')", [aid])
  let _ = db_execute("INSERT INTO trial (trial_date, day_window, arm_id, status) VALUES ('2042-05-11', 'morning', ?, 'missed')", [aid])
  let _ = db_execute("INSERT INTO trial (trial_date, day_window, arm_id, status) VALUES ('2042-05-12', 'morning', ?, 'missed')", [aid])
  assert_eq(mm_admission_ok(aid), false)
  // 12 completed sessions / 120 minutes — the rule is met, the hand
  // enters the active set by hand (the unlocked path).
  let _ = db_execute("INSERT INTO trial (trial_date, day_window, arm_id, status) VALUES ('2042-05-13', 'morning', ?, 'completed')", [aid])
  let _ = db_execute("INSERT INTO trial (trial_date, day_window, arm_id, status) VALUES ('2042-05-14', 'morning', ?, 'completed')", [aid])
  let _ = db_execute("INSERT INTO trial (trial_date, day_window, arm_id, status) VALUES ('2042-05-15', 'morning', ?, 'completed')", [aid])
  assert_eq(mm_admission_ok(aid), true)
  assert_eq(activate_arm(aid, "test-н4-07"), "ok")
  let act2 = query("SELECT active FROM arm WHERE id = ?", [aid])
  assert_eq(act2[0].active, 1.0)
}

test "Н4-07: level 1 is always open; a hand without a profile is not gated" {
  seed_mm_catalog()
  // A level-1 MM practice: the gate is open with ZERO sessions.
  let rows = query("SELECT pp.arm_id AS id FROM practice_profile pp WHERE pp.level = 1 ORDER BY pp.arm_id LIMIT 1", [])
  let l1 = rows[0].id
  assert_eq(mm_admission_ok(l1), true)
  // A wave-1 hand (AERIS breath, no practice_profile row): the gate
  // does not apply — the Н3-01 path is unchanged.
  let aer = query("SELECT id FROM arm WHERE name = 'breath-diaphragmatic'", [])
  assert_eq(len(aer), 1.0)
  assert_eq(mm_admission_ok(aer[0].id), true)
  // An unknown id: the count-form returns 0 locked rows — the gate is
  // open; the caller's own unknown-arm refusal handles the miss.
  assert_eq(mm_admission_ok(999999.0), true)
}
