// Kamerton arm library seed (naryad Н1-04): wave-1 hands = 5 methodologies
// x 2 day windows at a fixed 10-minute duration — 10 arms total, each with
// a literature prior and its source.
//
// Prior mapping (continuity with the previous iteration's seed):
//   strong      -> mean 0.6, sd 0.15
//   medium      -> mean 0.5, sd 0.15
//   medium-weak -> mean 0.45, sd 0.20
// Both windows of a methodology share the literature prior: the window is
// a variable of the experiment, not a separately documented effect.
//
// NOT in the seed, deliberately: self-hypnosis (reserve), binaural and
// isochronic tones, 432/528 Hz carrier tones (sound arrives in M3) —
// the wave-1 canon keeps the hand space at 5 methodologies x 2 windows.
//
// The machine SSOT is the kamerton_arms list below; seeds/arms.json is
// the human/ops mirror and is pinned to it by the lockstep test
// (json_encode of the list must equal the file byte-for-byte).
// The arm table declaration here is byte-identical to the one in
// src/store/store.mlog (naryad Н1-03) — both programs replay the same
// additive DDL; the columns are pinned by a test.

entity db_raw: String = env_or("KAMERTON_DB", ":memory:")
entity db_url: String = "sqlite:" + db_raw

db { url: db_url }

schema kamerton {
  table arm {
    id: Int primary_key auto_increment,
    name: String,
    group_name: String,
    day_window: String,
    duration_min: Int default("10"),
    prior_mean: Float default("0.0"),
    prior_std: Float default("1.0"),
    active: Int default("1"),
    created_at: String default(now())
  }

  table slot {
    id: Int primary_key auto_increment,
    name: String,
    max_active: Int default("3"),
    created_at: String default(now())
  }

  table consent {
    id: Int primary_key auto_increment,
    scope: String,
    revoked: Int default("0"),
    source: String default(""),
    created_at: String default(now())
  }

  table practice_protocol {
    id: Int primary_key auto_increment,
    arm_id: Int references(arm.id),
    slot: String default(""),
    safety_class: String default("A"),
    requires_consent: Int default("0"),
    max_hold_sec: Float default("0.0"),
    session_min: Float default("10.0"),
    steps_json: String default("[]"),
    series_json: String default(""),
    contraindications: String default(""),
    source: String default(""),
    created_at: String default(now())
  }

  // Н3-05: the journal of EVERY active-set change (who, when, what) —
  // a plain sqlite3 client reads it (invariant 6). The `methods` cap
  // "in force" is DERIVED from this journal (the owner's
  // 'methods-cap-armed' event), never from a mutable flag column: the
  // owner's choice is a recorded event, not a silent bit. arm_id is
  // NULL for the cap event (no hand involved) — the CASE form keeps
  // NULL truthful under the enforced-references replay (№611).
  table arm_journal {
    id: Int primary_key auto_increment,
    actor: String default(""),
    arm_id: Int references(arm.id),
    action: String default(""),
    detail: String default(""),
    created_at: String default(now())
  }

  // Н4-07: the admission gate reads trial (the unit of the admission —
  // completed sessions of the system) and practice_profile (the MM
  // system/level of the hand). note rides along: trial references it.
  // Declarations byte-identical to the store module and ensure_schema.
  table note {
    id: Int primary_key auto_increment,
    body: String,
    active: Int default("1"),
    created_at: String default(now())
  }
  table trial {
    id: Int primary_key auto_increment,
    trial_date: String,
    day_window: String,
    arm_id: Int references(arm.id),
    note_id: Int references(note.id),
    status: String default("proposed"),
    prediction_depth: Float default("0.0"),
    prediction_confidence: Float default("0.0"),
    moment_value: Float default("0.0"),
    moment_present: Int default("0"),
    moment_source: String default(""),
    next_day_value: Float default("0.0"),
    next_day_present: Int default("0"),
    action_value: Float default("0.0"),
    action_present: Int default("0"),
    reward: Float default("0.0"),
    free_note: String default(""),
    closed_at: String default(""),
    created_at: String default(now())
  }
  table practice_profile {
    id: Int primary_key auto_increment,
    arm_id: Int references(arm.id),
    system: String default(""),
    level: Int default("0"),
    declared_min: Float default("0.0"),
    created_at: String default(now())
  }
  // practice_admission: the per-system level rules (Н4-07, the source
  // progression.ts @ 2a26e75 via seeds/mm/progression.json). UNIQUE
  // (system, level) — the seed and ensure_schema create the index.
  table practice_admission {
    id: Int primary_key auto_increment,
    system: String default(""),
    level: Int default("0"),
    min_sessions: Float default("0.0"),
    min_minutes: Float default("0.0"),
    created_at: String default(now())
  }
}

// ── APP-MIRROR-START: arms-seed (byte-identical to
//    src/arms/arms.mlog §arms-seed) ─────────────────────────────────────

entity kamerton_arms: List = [
  {name: "breath-resonance-morning", group_name: "Резонансное дыхание", day_window: "morning", duration_min: 10.0, prior_mean: 0.6, prior_std: 0.15, source: "Lehrer & Gevirtz 2014 (Front Psychol 5:753): resonance-frequency HRV biofeedback, robust baroreflex effects"},
  {name: "breath-resonance-evening", group_name: "Резонансное дыхание", day_window: "evening", duration_min: 10.0, prior_mean: 0.6, prior_std: 0.15, source: "Lehrer & Gevirtz 2014 (Front Psychol 5:753): resonance-frequency HRV biofeedback, robust baroreflex effects"},
  {name: "woop-morning", group_name: "Имплементационные намерения", day_window: "morning", duration_min: 10.0, prior_mean: 0.6, prior_std: 0.15, source: "Gollwitzer & Sheeran 2006 (Adv Exp Soc Psychol 38): meta-analysis of 94 studies, d ~ 0.65"},
  {name: "woop-evening", group_name: "Имплементационные намерения", day_window: "evening", duration_min: 10.0, prior_mean: 0.6, prior_std: 0.15, source: "Gollwitzer & Sheeran 2006 (Adv Exp Soc Psychol 38): meta-analysis of 94 studies, d ~ 0.65"},
  {name: "mental-rehearsal-morning", group_name: "Ментальная репетиция", day_window: "morning", duration_min: 10.0, prior_mean: 0.5, prior_std: 0.15, source: "Driskell, Copper & Moran 1994 (J Appl Psychol 79(4)): mental practice meta-analysis, moderate effect, decays without physical practice"},
  {name: "mental-rehearsal-evening", group_name: "Ментальная репетиция", day_window: "evening", duration_min: 10.0, prior_mean: 0.5, prior_std: 0.15, source: "Driskell, Copper & Moran 1994 (J Appl Psychol 79(4)): mental practice meta-analysis, moderate effect, decays without physical practice"},
  {name: "focusing-morning", group_name: "Фокусинг", day_window: "morning", duration_min: 10.0, prior_mean: 0.45, prior_std: 0.2, source: "Hendricks 2002 (The Focusing-oriented client): experiential review, small-N studies, mixed quality — wide prior"},
  {name: "focusing-evening", group_name: "Фокусинг", day_window: "evening", duration_min: 10.0, prior_mean: 0.45, prior_std: 0.2, source: "Hendricks 2002 (The Focusing-oriented client): experiential review, small-N studies, mixed quality — wide prior"},
  {name: "yoga-nidra-morning", group_name: "Йога-нидра", day_window: "morning", duration_min: 10.0, prior_mean: 0.45, prior_std: 0.2, source: "Moszeik, von Oertzen & Günther 2022 (Current Psychology): Yoga Nidra effects on stress, sleep, well-being — moderate, wide prior"},
  {name: "yoga-nidra-evening", group_name: "Йога-нидра", day_window: "evening", duration_min: 10.0, prior_mean: 0.45, prior_std: 0.2, source: "Moszeik, von Oertzen & Günther 2022 (Current Psychology): Yoga Nidra effects on stress, sleep, well-being — moderate, wide prior"}
]

// Seed the arm library. Idempotent by construction: a UNIQUE index on
// name plus INSERT OR IGNORE — a repeated run changes nothing.
//
// WHY UNROLLED STATEMENTS (§2, declared loudly): the mlog D2 defect
// (declared in Kamerton issue #24; verified on v0.28.1 AND v0.28.2 by
// mutation probes) mis-executes loops whose body is a bare call — one
// iteration, and in a test body the tail after such a loop is silently
// cut (vacuously green). Assignment-body loops are full, but the
// trigger surface is not fully mapped (the probeprint case differs
// from the db_execute case), so the discipline here is: NO loops in
// test bodies at all until the language naryads land (Metalogos-
// №597/№598 → v0.28.3). A loop-driven seed would silently insert only
// the first arm, so the seed is unrolled into sequential statements
// and pinned to the kamerton_arms entity list by the per-arm VALUES
// LEFT JOIN verification test (loop-free); the JSON mirror is pinned
// to the same list. Divergence of any copy is a loud test failure.

pattern seed_arms() -> Float {
  db_execute("CREATE UNIQUE INDEX IF NOT EXISTS idx_arm_name_unique ON arm(name)")
  db_execute("INSERT OR IGNORE INTO arm (name, group_name, day_window, duration_min, prior_mean, prior_std) VALUES ('breath-resonance-morning', 'Резонансное дыхание', 'morning', 10, 0.6, 0.15)")
  db_execute("INSERT OR IGNORE INTO arm (name, group_name, day_window, duration_min, prior_mean, prior_std) VALUES ('breath-resonance-evening', 'Резонансное дыхание', 'evening', 10, 0.6, 0.15)")
  db_execute("INSERT OR IGNORE INTO arm (name, group_name, day_window, duration_min, prior_mean, prior_std) VALUES ('woop-morning', 'Имплементационные намерения', 'morning', 10, 0.6, 0.15)")
  db_execute("INSERT OR IGNORE INTO arm (name, group_name, day_window, duration_min, prior_mean, prior_std) VALUES ('woop-evening', 'Имплементационные намерения', 'evening', 10, 0.6, 0.15)")
  db_execute("INSERT OR IGNORE INTO arm (name, group_name, day_window, duration_min, prior_mean, prior_std) VALUES ('mental-rehearsal-morning', 'Ментальная репетиция', 'morning', 10, 0.5, 0.15)")
  db_execute("INSERT OR IGNORE INTO arm (name, group_name, day_window, duration_min, prior_mean, prior_std) VALUES ('mental-rehearsal-evening', 'Ментальная репетиция', 'evening', 10, 0.5, 0.15)")
  db_execute("INSERT OR IGNORE INTO arm (name, group_name, day_window, duration_min, prior_mean, prior_std) VALUES ('focusing-morning', 'Фокусинг', 'morning', 10, 0.45, 0.2)")
  db_execute("INSERT OR IGNORE INTO arm (name, group_name, day_window, duration_min, prior_mean, prior_std) VALUES ('focusing-evening', 'Фокусинг', 'evening', 10, 0.45, 0.2)")
  db_execute("INSERT OR IGNORE INTO arm (name, group_name, day_window, duration_min, prior_mean, prior_std) VALUES ('yoga-nidra-morning', 'Йога-нидра', 'morning', 10, 0.45, 0.2)")
  db_execute("INSERT OR IGNORE INTO arm (name, group_name, day_window, duration_min, prior_mean, prior_std) VALUES ('yoga-nidra-evening', 'Йога-нидра', 'evening', 10, 0.45, 0.2)")
  // Н2-09: the practice DELIVERY — the proposal must tell what to do,
  // not just name the hand (the M1-window gap: the trial asked for a
  // prediction with no practice content anywhere). One 10-minute
  // instruction per methodology group, grounded in the SAME literature
  // sources as the arms above; the proposal joins this table by
  // arm.group_name. Idempotent like the arm seed: UNIQUE(group_name)
  // plus INSERT OR IGNORE. Loop-free by the D2 discipline (unrolled,
  // like the arm seed above). The bodies carry no quote characters —
  // the SQL literals stay plain; a missing or empty row degrades LOUD
  // in the proposal (the NULLIF fallback, see morning_proposal_row).
  db_execute("CREATE TABLE IF NOT EXISTS practice_text (id INTEGER PRIMARY KEY AUTOINCREMENT, group_name TEXT, body TEXT, active INTEGER DEFAULT '1', created_at TEXT DEFAULT (datetime('now')))")
  db_execute("CREATE UNIQUE INDEX IF NOT EXISTS idx_practice_text_group_unique ON practice_text(group_name)")
  db_execute("INSERT OR IGNORE INTO practice_text (group_name, body) VALUES ('Резонансное дыхание', 'Сядь ровно, таймер на 10 минут. Дыши через нос, медленно и ровно: вдох около 5 секунд, выдох около 5 секунд — примерно 5–6 циклов в минуту, без усилия. Живот мягко уходит вперёд на вдохе. Держи ровный ритм: сбился — спокойно возвращайся к счёту. Это резонансная зона 4.5–6.5 вдохов в минуту, на ней дыхание и сердечный ритм входят в синхрон (Lehrer и Gevirtz, 2014).')")
  db_execute("INSERT OR IGNORE INTO practice_text (group_name, body) VALUES ('Имплементационные намерения', 'Бумага и ручка, 10 минут по четырём шагам. W — желание: запиши важное и реальное желание на ближайшие дни. O — исход: 2–3 минуты живо представляй лучший результат его достижения. O — препятствие: честно назови внутреннее, что чаще всего мешает. P — план: собери формулу «если у меня …, то я …», подставь своё препятствие и своё действие, повтори про себя 2–3 раза (Оэттинген; Голвитцер и Ширан, 2006).')")
  db_execute("INSERT OR IGNORE INTO practice_text (group_name, body) VALUES ('Ментальная репетиция', 'Выбери конкретный навык или предстоящее действие: выступление, разговор, движение. Первые 1–2 минуты — вживись в обстановку: где, что вокруг, кто рядом. Затем проиграй действие от начала до конца изнутри, своими глазами, в реальном темпе. Трудное место пройди отдельно 2–3 раза в исправленном варианте. Финал — одна уверенная полная прогонка без остановок. Репетиция дополняет физическую практику, а не заменяет её (Driskell, Copper и Moran, 1994).')")
  db_execute("INSERT OR IGNORE INTO practice_text (group_name, body) VALUES ('Фокусинг', 'Сядь удобно, 10 минут. Минута: пройди вниманием по телу — где сейчас самое заметное ощущение. 2–3 минуты: не меняй его, просто признай — здравствуй, я тебя вижу. Спроси внутри: о чём это? Не отвечай умом — жди телесного отклика, каким бы медленным он ни был. Всё, что придёт, признай без спора. Закончи вопросом: чего тебе нужно? — и спокойно выходи. Здесь ничего не надо добиваться: важно только присутствие внимания (Gendlin; Hendricks, 2002).')")
  db_execute("INSERT OR IGNORE INTO practice_text (group_name, body) VALUES ('Йога-нидра', 'Ляг на спину, руки чуть в стороны, глаза закрыты — держи лёгкую бодрость, не засыпай. Короткое намерение в настоящем времени, своими словами. Затем медленно пройди вниманием по телу: правая рука, левая рука, ноги, туловище, лицо. Дальше пары ощущений: тяжесть — лёгкость, тепло — прохлада. Потом просто наблюдай дыхание, не считая. В конце повтори намерение и сделай 2–3 глубоких вдоха, вставай медленно. Сжатая форма на 10 минут (Moszeik и соавт., 2022).')")
  // Н2-12: the note-goal — ONE row, the owner's formulation VERBATIM
  // from the concept (docs/concept-v2.md, «Нота и принцип»); the fixed
  // id keeps the seed idempotent (INSERT OR IGNORE) across re-runs and
  // the formulation is the OWNER's text, not the executor's invention
  // (the naryad Шаг 0 defers the wording to the owner — the concept's
  // own sentence IS the owner's wording). bandit_propose joins the
  // trial to the ACTIVE note (the latest active row), so a future
  // re-wording is a data edit, never a code change.
  db_execute("CREATE TABLE IF NOT EXISTS note (id INTEGER PRIMARY KEY AUTOINCREMENT, body TEXT, active INTEGER DEFAULT '1', created_at TEXT DEFAULT (datetime('now')))")
  db_execute("INSERT OR IGNORE INTO note (id, body, active) VALUES (1, 'Между тем, чего я хочу, и тем, что я делаю, нет зазора — и это видно по результату.', 1)")
  let rows = query("SELECT count(*) AS n FROM arm", [])
  return rows[0].n
}

// ── Н3-01: the practice CATALOG as data ─────────────────────────────────
// A practice is a ROW (arm + practice_protocol + practice_text), never
// code: a ninth practice is one more record — in this list for the seed,
// or one INSERT through a plain sqlite3 client (invariant 6). The engine
// reads the steps, it does not know the practices.
//
// Protocol format: steps = [{phase, sec, intensity 0..1, cue}] with the
// phases inhale | hold | exhale | pause (the hold after an exhale) |
// forced_exhale; series = {reps, rest_sec} — one SERIES is `reps` passes
// over the steps followed by `rest_sec` of ordinary breathing (reps 1,
// rest 0 = a plain endless cycle). The number of cycles is DERIVED from
// session_min (protocol_cycles) and never stored: the AERIS durations
// disagree with "steps x cycles" (4-7-8: 4 cycles x 19 s = 76 s against a
// declared 5 min), so a stored cycle count would lie.
//
// Safety classes (owner consent per class lives in the consent table):
//   A — no holds, no pauses, no forced breathing;
//   B — holds/pauses up to 8 s (max_hold_sec is the declared ceiling the
//       session engine may only SHORTEN);
//   C — long holds or pauses (> 8 s), forced breathing. requires_consent = 1:
//       never assigned — forced exploration included — until the consent
//       row of the class exists.
// The class follows the DATA, not the label: AERIS lists nadi shodhana and
// sitali as "no holds", yet both carry 4-5 s holds, so they are class B.
// Initial priors are WIDE (0.45 +- 0.20): only slow breathing in general
// has a verified review, no technique here has its own source.
entity kamerton_protocols: List = [
  {name: "breath-diaphragmatic", group_name: "Дыхание: диафрагмальное", slot: "breath", day_window: "morning", safety_class: "A", requires_consent: 0.0, max_hold_sec: 0.0, session_min: 5.0, prior_mean: 0.45, prior_std: 0.2,
   source: "Zaccaro et al. 2018 (Front Hum Neurosci 12:353, doi:10.3389/fnhum.2018.00353): систематический обзор медленного дыхания (<=10 вдохов/мин) в целом; конкретная техника в обзоре не оценивалась — широкий приор",
   contraindications: "",
   instruction: "Сядь или ляг удобно, одна рука на животе. Вдох носом 5 секунд — живот поднимается под рукой, грудь почти неподвижна. Выдох 5 секунд — живот мягко опускается. Без усилия, ровно. Сбился — просто вернись к счёту. Около 6 циклов в минуту.",
   series: {reps: 1.0, rest_sec: 0.0},
   steps: [
     {phase: "inhale", sec: 5.0, intensity: 0.3, cue: "вдох носом, живот расширяется"},
     {phase: "exhale", sec: 5.0, intensity: 0.3, cue: "выдох, живот втягивается"}
   ]},
  {name: "breath-four-seven-eight", group_name: "Дыхание: 4-7-8", slot: "breath", day_window: "morning", safety_class: "B", requires_consent: 0.0, max_hold_sec: 7.0, session_min: 5.0, prior_mean: 0.45, prior_std: 0.2,
   source: "нет источника: широкий приор",
   contraindications: "",
   instruction: "Кончик языка за верхними зубами. Вдох носом на 4, задержка на 7, выдох через рот со звуком на 8. Если задержка в 7 секунд трудна — укороти пропорционально, но сохрани соотношение 4:7:8. Остановись сразу при головокружении.",
   series: {reps: 1.0, rest_sec: 0.0},
   steps: [
     {phase: "inhale", sec: 4.0, intensity: 0.5, cue: "вдох носом"},
     {phase: "hold", sec: 7.0, intensity: 0.2, cue: "задержка"},
     {phase: "exhale", sec: 8.0, intensity: 0.7, cue: "выдох ртом со звуком"}
   ]},
  {name: "breath-box", group_name: "Дыхание: квадратное дыхание", slot: "breath", day_window: "morning", safety_class: "B", requires_consent: 0.0, max_hold_sec: 4.0, session_min: 5.0, prior_mean: 0.45, prior_std: 0.2,
   source: "нет источника: широкий приор",
   contraindications: "",
   instruction: "Четыре равные стороны квадрата: вдох 4, задержка 4, выдох 4, пауза 4. Дыши носом, плечи расслаблены. Если задержки трудны — укороти все стороны поровну.",
   series: {reps: 1.0, rest_sec: 0.0},
   steps: [
     {phase: "inhale", sec: 4.0, intensity: 0.4, cue: "вдох"},
     {phase: "hold", sec: 4.0, intensity: 0.2, cue: "задержка"},
     {phase: "exhale", sec: 4.0, intensity: 0.4, cue: "выдох"},
     {phase: "pause", sec: 4.0, intensity: 0.1, cue: "пауза после выдоха"}
   ]},
  {name: "breath-alternate-nostril", group_name: "Дыхание: поочерёдное дыхание ноздрями (нади шодхана)", slot: "breath", day_window: "morning", safety_class: "B", requires_consent: 0.0, max_hold_sec: 4.0, session_min: 5.0, prior_mean: 0.45, prior_std: 0.2,
   source: "нет источника: широкий приор",
   contraindications: "",
   instruction: "Большим пальцем правой руки закрой правую ноздрю, вдох левой на 4. Закрой обе, задержка 4. Открой правую, выдох на 4, пауза 4. Вдох правой на 4, закрой обе, задержка 4, открой левую, выдох 4, пауза 4. Это один полный цикл.",
   series: {reps: 1.0, rest_sec: 0.0},
   steps: [
     {phase: "inhale", sec: 4.0, intensity: 0.3, cue: "вдох левой ноздрёй"},
     {phase: "hold", sec: 4.0, intensity: 0.2, cue: "задержка"},
     {phase: "exhale", sec: 4.0, intensity: 0.3, cue: "выдох правой ноздрёй"},
     {phase: "pause", sec: 4.0, intensity: 0.1, cue: "пауза"},
     {phase: "inhale", sec: 4.0, intensity: 0.3, cue: "вдох правой ноздрёй"},
     {phase: "hold", sec: 4.0, intensity: 0.2, cue: "задержка"},
     {phase: "exhale", sec: 4.0, intensity: 0.3, cue: "выдох левой ноздрёй"},
     {phase: "pause", sec: 4.0, intensity: 0.1, cue: "пауза"}
   ]},
  {name: "breath-sitali", group_name: "Дыхание: ситали (через свёрнутый язык)", slot: "breath", day_window: "morning", safety_class: "B", requires_consent: 0.0, max_hold_sec: 5.0, session_min: 5.0, prior_mean: 0.45, prior_std: 0.2,
   source: "нет источника: широкий приор",
   contraindications: "",
   instruction: "Сверни язык трубочкой и выступи им чуть за губы (если не получается — зубы сомкнуты, губы приоткрыты). Вдох через эту трубочку на 5, задержка на 5, выдох через нос на 5.",
   series: {reps: 1.0, rest_sec: 0.0},
   steps: [
     {phase: "inhale", sec: 5.0, intensity: 0.4, cue: "вдох через свёрнутый язык"},
     {phase: "hold", sec: 5.0, intensity: 0.2, cue: "задержка"},
     {phase: "exhale", sec: 5.0, intensity: 0.4, cue: "выдох через нос"}
   ]},
  {name: "breath-buteyko-basic", group_name: "Дыхание: Бутейко (базовое)", slot: "breath", day_window: "morning", safety_class: "C", requires_consent: 1.0, max_hold_sec: 10.0, session_min: 7.0, prior_mean: 0.45, prior_std: 0.2,
   source: "нет источника: широкий приор",
   contraindications: "",
   instruction: "Дыхание максимально лёгкое и малое, только носом. Вдох 3, выдох 4, затем пауза после выдоха на 10 секунд, затем снова вдох 3 и выдох 4. Пауза не должна быть борьбой: при сильном желании вдохнуть — вдохни сразу и вернись к лёгкому ритму.",
   series: {reps: 1.0, rest_sec: 0.0},
   steps: [
     {phase: "inhale", sec: 3.0, intensity: 0.2, cue: "лёгкий вдох носом"},
     {phase: "exhale", sec: 4.0, intensity: 0.2, cue: "лёгкий выдох"},
     {phase: "pause", sec: 10.0, intensity: 0.0, cue: "пауза после выдоха, нос зажат при необходимости"},
     {phase: "inhale", sec: 3.0, intensity: 0.2, cue: "лёгкий вдох носом"},
     {phase: "exhale", sec: 4.0, intensity: 0.2, cue: "лёгкий выдох"}
   ]},
  {name: "breath-kumbhaka-advanced", group_name: "Дыхание: кумбхака (продвинутая)", slot: "breath", day_window: "morning", safety_class: "C", requires_consent: 1.0, max_hold_sec: 15.0, session_min: 10.0, prior_mean: 0.45, prior_std: 0.2,
   source: "нет источника: широкий приор",
   contraindications: "",
   instruction: "Вдох на 5, задержка на 15, выдох на 8, пауза на 5. Только сидя. Задержка без напряжения лица и горла. При любом дискомфорте, головокружении или дрожи — прекрати задержку сразу и дыши свободно.",
   series: {reps: 1.0, rest_sec: 0.0},
   steps: [
     {phase: "inhale", sec: 5.0, intensity: 0.5, cue: "вдох носом"},
     {phase: "hold", sec: 15.0, intensity: 0.2, cue: "задержка на вдохе"},
     {phase: "exhale", sec: 8.0, intensity: 0.5, cue: "выдох"},
     {phase: "pause", sec: 5.0, intensity: 0.1, cue: "пауза после выдоха"}
   ]},
  {name: "breath-kapalabhati", group_name: "Дыхание: капалабхати", slot: "breath", day_window: "morning", safety_class: "C", requires_consent: 1.0, max_hold_sec: 0.0, session_min: 5.0, prior_mean: 0.45, prior_std: 0.2,
   source: "нет источника: широкий приор",
   contraindications: "",
   instruction: "Сидя, спина прямая. Резкий выдох носом за счёт сокращения живота, вдох происходит сам. Серия — 30 циклов, затем пауза 30 секунд обычного дыхания; всего три серии. При головокружении остановись и дыши спокойно.",
   series: {reps: 30.0, rest_sec: 30.0},
   steps: [
     {phase: "forced_exhale", sec: 1.0, intensity: 1.0, cue: "резкий выдох животом"},
     {phase: "inhale", sec: 1.0, intensity: 0.3, cue: "пассивный вдох"}
   ]}
]

// Seed the catalog. Idempotent: UNIQUE indexes + INSERT OR IGNORE. Every
// catalog arm starts INACTIVE (active = 0): the catalog is wider than the
// active set, and activate_arm() admits a hand into its slot (at most
// max_active per slot — the owner rule of 2026-10-23, 3 per slot).
// Consent rows record the owner's decision as DATA, one per class:
// chat 2026-10-23 ("Ты честно предупреждаешь, я честно даю добро") and
// chat 2026-10-24 (no contraindications declared) — Kamerton issue #75.
pattern seed_catalog() -> Float {
  let _ = db_execute("CREATE UNIQUE INDEX IF NOT EXISTS idx_arm_name_unique ON arm(name)", [])
  let _ = db_execute("CREATE UNIQUE INDEX IF NOT EXISTS idx_protocol_arm_unique ON practice_protocol(arm_id)", [])
  let _ = db_execute("CREATE UNIQUE INDEX IF NOT EXISTS idx_slot_name_unique ON slot(name)", [])
  let _ = db_execute("CREATE UNIQUE INDEX IF NOT EXISTS idx_consent_scope_unique ON consent(scope)", [])
  let _ = db_execute("CREATE TABLE IF NOT EXISTS practice_text (id INTEGER PRIMARY KEY AUTOINCREMENT, group_name TEXT, body TEXT, active INTEGER DEFAULT '1', created_at TEXT DEFAULT (datetime('now')))", [])
  let _ = db_execute("CREATE UNIQUE INDEX IF NOT EXISTS idx_practice_text_group_unique ON practice_text(group_name)", [])
  let _ = db_execute("INSERT OR IGNORE INTO slot (name, max_active) VALUES ('breath', 3)", [])
  // Н3-05: the `methods` slot row — the wave-1 methodologies get their
  // own slot with the same rule (the cap of 3, the owner's decision of
  // 2026-10-24). The row RECORDS the cap; the cap takes FORCE only
  // after the owner's confirmed choice (the journal event — see
  // arm_methods_cap_confirm): until then the slot stays uncapped and
  // no silent state change happens (the wave-1 hands stay active, as
  // seeded; nothing is deactivated behind the owner's back).
  let _ = db_execute("INSERT OR IGNORE INTO slot (name, max_active) VALUES ('methods', 3)", [])
  let _ = db_execute("INSERT OR IGNORE INTO consent (scope, source) VALUES ('class:A', 'владелец: чат 2026-10-23, issue #75 (согласие классов A, B, C); противопоказаний нет (чат 2026-10-24)')", [])
  let _ = db_execute("INSERT OR IGNORE INTO consent (scope, source) VALUES ('class:B', 'владелец: чат 2026-10-23, issue #75 (согласие классов A, B, C); противопоказаний нет (чат 2026-10-24)')", [])
  let _ = db_execute("INSERT OR IGNORE INTO consent (scope, source) VALUES ('class:C', 'владелец: чат 2026-10-23, issue #75 (согласие классов A, B, C); противопоказаний нет (чат 2026-10-24)')", [])
  each p in kamerton_protocols {
    let _ = db_execute("INSERT OR IGNORE INTO arm (name, group_name, day_window, duration_min, prior_mean, prior_std, active) VALUES (?, ?, ?, ?, ?, ?, 0)", [p.name, p.group_name, p.day_window, p.session_min, p.prior_mean, p.prior_std])
    let _ = db_execute("INSERT OR IGNORE INTO practice_text (group_name, body) VALUES (?, ?)", [p.group_name, p.instruction])
    let _ = db_execute("INSERT OR IGNORE INTO practice_protocol (arm_id, slot, safety_class, requires_consent, max_hold_sec, session_min, steps_json, series_json, contraindications, source) SELECT id, ?, ?, ?, ?, ?, ?, ?, ?, ? FROM arm WHERE name = ?", [p.slot, p.safety_class, p.requires_consent, p.max_hold_sec, p.session_min, json_encode(p.steps), json_encode(p.series), p.contraindications, p.source, p.name])
  }
  // Н3-05: the ten wave-1 methodologies join the `methods` slot as
  // DATA — one practice_protocol row per arm with EMPTY steps (these
  // are instruction methods, not breath phases: no steps, no series),
  // the seat's own literature source (the machine SSOT list above —
  // the arm table has no source column), safety class A (no holds, no
  // pauses, no forced breathing — nothing to consent beyond the
  // existing class:A row), session_min = the arm's own duration. The
  // arms stay ACTIVE (the wave-1 state is not silently changed). The
  // return value is the FULL protocol count in the store (breath +
  // methods) — the honest seed-completeness number, pinned by tests.
  each a in kamerton_arms {
    let _ = db_execute("INSERT OR IGNORE INTO practice_protocol (arm_id, slot, safety_class, requires_consent, max_hold_sec, session_min, steps_json, series_json, contraindications, source) SELECT id, 'methods', 'A', 0, 0, ?, ?, '', '', ? FROM arm WHERE name = ?", [a.duration_min, json_encode([]), a.source, a.name])
  }
  let rows = query("SELECT count(*) AS n FROM practice_protocol", [])
  return rows[0].n
}

// Seconds of ONE series unit (reps passes over the steps + the rest).
// Н3-05: an EMPTY series_json (the methods rows — instruction methods
// with no steps and no series) means one plain pass over the steps and
// no rest — no fabricated multiplication, never a parse error.
pattern protocol_unit_sec(arm_id: Float) -> Float {
  let rows = query("SELECT steps_json, series_json FROM practice_protocol WHERE arm_id = ?", [arm_id])
  if len(rows) == 0.0 {
    return 0.0
  }
  let steps = parse_json(rows[0].steps_json)
  let mut cycle = 0.0
  each s in steps {
    cycle = cycle + s.sec
  }
  if rows[0].series_json == "" {
    return cycle
  }
  let series = parse_json(rows[0].series_json)
  return series.reps * cycle + series.rest_sec
}

// The number of whole units that fit in session_min — DERIVED, never
// stored (0 for an unknown arm or an empty protocol).
pattern protocol_cycles(arm_id: Float) -> Float {
  let unit = protocol_unit_sec(arm_id)
  if unit <= 0.0 {
    return 0.0
  }
  let rows = query("SELECT session_min FROM practice_protocol WHERE arm_id = ?", [arm_id])
  return to_float(to_int(rows[0].session_min * 60.0 / unit))
}

// Admit a hand into the active set. A hand with a protocol belongs to a
// slot: the slot cap (max_active, default 3) refuses a fourth active
// hand LOUDLY ("slot-full") — nothing is changed. A hand without a
// protocol (possible only before the Н3-05 methods seed) is not
// slotted: no cap applies.
//
// Н3-05: the `methods` cap takes force ONLY after the owner's
// confirmed choice (arm_methods_cap_confirm — the journal event
// 'methods-cap-armed'); until then the slot stays uncapped (the owner
// explores the set). Every admission and every refusal is JOURNALED
// with its actor (who, when via created_at, what) — no silent state
// change.
//
// Н4-07 (правило владельца, Шаг 0 наряда #99, утверждено 2026-11-02):
// уровни MIND-MASTERY 1–5 — условие входа практики в активный набор ПО
// ЧИСЛУ ЗАВЕРШЁННЫХ СЕССИЙ И МИНУТ СИСТЕМЫ, а не ручной разблокировкой.
// Запертая рука НЕ активируется и вручную: громкий отказ "locked" +
// строка журнала, состояние не меняется. Руки без practice_profile
// (AERIS breath/methods волны 1) допуску не подчиняются.
// Returns "ok" | "unknown-arm" | "slot-full" | "locked".
pattern activate_arm(arm_id: Float, actor: String) -> String {
  let arm = query("SELECT id FROM arm WHERE id = ?", [arm_id])
  if len(arm) == 0.0 {
    return "unknown-arm"
  }
  // Н4-07: the admission gate BEFORE everything else — a locked hand
  // never enters the active set by hand (the rule of the owner: by
  // system progress, not by manual unlocking). Loud refusal + journal
  // row, nothing changed.
  if mm_admission_ok(arm_id) == false {
    let _ = db_execute("INSERT INTO arm_journal (actor, arm_id, action, detail) VALUES (?, ?, 'arm-on-refused', 'admission-locked')", [actor, arm_id])
    return "locked"
  }
  let prot = query("SELECT slot FROM practice_protocol WHERE arm_id = ?", [arm_id])
  if len(prot) > 0.0 {
    let cap_rows = query("SELECT max_active FROM slot WHERE name = ?", [prot[0].slot])
    let mut cap = 3.0
    if len(cap_rows) > 0.0 {
      cap = to_float(cap_rows[0].max_active)
    }
    let mut enforce = true
    if prot[0].slot == "methods" {
      let armed = query("SELECT count(*) AS n FROM arm_journal WHERE action = 'methods-cap-armed'", [])
      if armed[0].n == 0.0 {
        enforce = false
      }
    }
    let used = query("SELECT count(*) AS n FROM arm a JOIN practice_protocol p ON p.arm_id = a.id WHERE p.slot = ? AND a.active = 1 AND a.id != ?", [prot[0].slot, arm_id])
    if enforce == true and used[0].n >= cap {
      let _ = db_execute("INSERT INTO arm_journal (actor, arm_id, action, detail) VALUES (?, ?, 'arm-on-refused', 'slot-full')", [actor, arm_id])
      return "slot-full"
    }
  }
  let _ = db_execute("UPDATE arm SET active = 1 WHERE id = ?", [arm_id])
  let _ = db_execute("INSERT INTO arm_journal (actor, arm_id, action) VALUES (?, ?, 'arm-on')", [actor, arm_id])
  return "ok"
}

// Retire a hand from the active set — always allowed (the cap limits
// admissions, not retirements), journaled with its actor.
pattern deactivate_arm(arm_id: Float, actor: String) -> Float {
  let _ = db_execute("UPDATE arm SET active = 0 WHERE id = ?", [arm_id])
  let _ = db_execute("INSERT INTO arm_journal (actor, arm_id, action) VALUES (?, ?, 'arm-off')", [actor, arm_id])
  return 1.0
}

// ── Н4-07: допуск практики — условие входа в активный набор ──────────
// Правило владельца (наряд #99, Шаг 0, утверждено 2026-11-02): уровни
// MIND-MASTERY 1–5 открываются ПО ЧИСЛУ ЗАВЕРШЁННЫХ СЕССИЙ И МИНУТ
// СИСТЕМЫ, а не ручной разблокировкой. Единица допуска — trial (юнит
// системы): status = 'completed' у рук этой системы; минуты сессии —
// длительность практики (arm.duration_min, как в MIND-MASTERY).
// Семантика источника (checkUnlock.ts @ 2a26e75): уровень 1 всегда
// открыт; нет правила для (system, level) — открыто ("No rule for this
// level means it's unlocked"); допуск = И сессии И минуты. Руки без
// practice_profile (AERIS breath/methods волны 1) допуску не
// подчиняются — их путь не меняется. Предикат живёт и в
// rotation_candidate (src/bandit/bandit.mlog) теми же SQL-литералами —
// двойная запись ЗАЯВЛЕНА (bandit-канон самодостаточен), обе стороны
// пинятся тестами (arms: mm_admission_ok; bandit: пропуск запертого
// кандидата ротацией).
pattern mm_admission_locked(arm_id: Float) -> Float {
  let rows = query("SELECT count(*) AS n FROM arm a JOIN practice_profile pp ON pp.arm_id = a.id WHERE a.id = ? AND pp.level >= 2 AND EXISTS (SELECT 1 FROM practice_admission pa WHERE pa.system = pp.system AND pa.level = pp.level) AND ((SELECT count(*) FROM trial t JOIN arm a2 ON a2.id = t.arm_id JOIN practice_profile pp2 ON pp2.arm_id = a2.id WHERE pp2.system = pp.system AND t.status = 'completed') < (SELECT pa1.min_sessions FROM practice_admission pa1 WHERE pa1.system = pp.system AND pa1.level = pp.level) OR (SELECT coalesce(sum(a3.duration_min), 0) FROM trial t3 JOIN arm a3 ON a3.id = t3.arm_id JOIN practice_profile pp3 ON pp3.arm_id = a3.id WHERE pp3.system = pp.system AND t3.status = 'completed') < (SELECT pa2.min_minutes FROM practice_admission pa2 WHERE pa2.system = pp.system AND pa2.level = pp.level))", [arm_id])
  return rows[0].n
}

pattern mm_admission_ok(arm_id: Float) -> Bool {
  return mm_admission_locked(arm_id) == 0.0
}

// Н3-05 (задача 4): the OWNER's confirmation of the `methods` active
// set — the cap recorded in the slot row takes force ONLY here, via
// the journal event 'methods-cap-armed' (derived, no flag column, no
// env var). Requires EXACTLY three active methods hands (the owner's
// choice of three): fewer — "less-than-three", more — "over-three";
// either is a loud refusal, nothing is written, the state does not
// change. The actor is the owner-facing surface's label (the chat
// command, the Mini App session, a documented operator identity) —
// never fabricated by the app. Returns "ok" | "less-than-three" |
// "over-three".
pattern arm_methods_cap_confirm(actor: String) -> String {
  let rows = query("SELECT count(*) AS n FROM arm a JOIN practice_protocol p ON p.arm_id = a.id WHERE p.slot = 'methods' AND a.active = 1", [])
  let n = rows[0].n
  if n < 3.0 {
    return "less-than-three"
  }
  if n > 3.0 {
    return "over-three"
  }
  let _ = db_execute("INSERT INTO arm_journal (actor, arm_id, action, detail) VALUES (?, NULL, 'methods-cap-armed', 'cap=3 enforced')", [actor])
  return "ok"
}

// Н3-05 (задача 2): the catalog listing for ANY owner-facing surface
// (chat commands or the Mini App screen — the surface choice is the
// owner's, the data shape is not): every hand by slot with its state
// and safety class. Order: methods (the wave-1 set) first, breath
// next, unslotted hands last (possible only before the methods seed);
// ids ascending inside each group. A plain sqlite3 client reads the
// same rows through the same joins (invariant 6).
pattern arms_catalog() -> List {
  return query("SELECT a.id AS id, a.name AS name, a.group_name AS group_name, a.day_window AS day_window, a.active AS active, p.slot AS slot, p.safety_class AS safety_class, s.max_active AS max_active FROM arm a LEFT JOIN practice_protocol p ON p.arm_id = a.id LEFT JOIN slot s ON s.name = p.slot ORDER BY CASE WHEN p.slot IS NULL THEN 2 WHEN p.slot = 'methods' THEN 0 ELSE 1 END, a.id", [])
}

// ── Н4-02: the MIND-MASTERY script catalog (75 practices) ──────────────
// The scenario practices (seeds/mm/*.json, byte-reproducible by
// scripts/mm-convert.py --verify from ShkodnikAI/MIND-MASTERY @ 2a26e75,
// naryad Н4-01) are LINEAR SCRIPTS: voice segments, silences and sound
// layers — not breath phase cycles. The engine reads the data, it does
// not know the practices (same discipline as the Н3-01 catalog).
//
// WHY read_file AND NOT AN ENTITY LIST (§2-checked, probe-pinned on
// v0.38.0): the JSON objects (scripts.json, voice-manifest.json) can be
// CONSUMED without object iteration — dynamic struct access `obj[key]`
// works (probe dyn.mlog), and every key arrives from the segment list
// of the ARRAY-shaped practices.json (591 = 591 = 591, no orphans, the
// lockstep counts are pinned by tests). Re-embedding 800 KB of texts
// into three byte-mirrored .mlog copies would triple the mirror
// surface for zero gain: the files ARE the SSOT. The runtime read path
// has a №455 twist — see mm_read_data below (two read paths, probe- 
// pinned: the serve sandbox denies repo-tree reads, the data-dir copy
// is the serve source, the repo SSOT is the test/CI source).
//
// WHY THE ABSENT KEYS ARE NEVER TOUCHED: accessing a missing struct
// field is a LOUD runtime error (probe probe2.mlog) — the silence
// segments carry no text_key/optional_tts, so the seed branches on
// s.kind FIRST and each branch only reads the fields its kind has
// (data invariants verified: voice -> text_key + optional_tts, silence
// -> neither; probe4 tests pin both row counts).
//
// SAFETY CLASS: the converted data carries "A" for every practice
// (mm-convert hardcodes it, Н4-01) — but the class follows the DATA of
// the naryad, not the converted label: breath_wim_hof and
// breath_holotropic are hyperventilation, class C, requires_consent = 1
// (never assigned without the consent row — the Н3-01 rule).
//
// THE SLOT SPLIT IS THE OWNER'S GATE (Шаг 0): the four slots by purpose
// (внимание и намерение; тело и движение; визуализация и расслабление;
// дыхание) are the executor's PROPOSAL recorded as data — domfreq (10)
// -> attention, feldenkrais (12) -> body, silva + dispenza +
// transurfing (45) -> visualization, breath (8) -> breath. Every MM
// hand starts INACTIVE, so a not-yet-approved split changes nothing
// live; re-splitting is a data edit (UPDATE practice_protocol.slot),
// never a code change.
//
// THE DERIVED PROTOCOL TYPE (задача 1 «тип протокола guided»): a
// column cannot be added to practice_protocol — ALTER TABLE is in the
// forbidden destructive DDL class (№325, the store's own declaration)
// — so the type is DERIVED from the data by protocol_kind(): segments
// present -> "guided", else non-empty steps -> "cycle", else
// "instruction" (the methods rows). Pinned by tests on all three kinds.
//
// LEVEL (задача 5) rides the third additive table practice_profile
// (arm_id UNIQUE, system, level, declared_min) — the per-practice
// MIND-MASTERY metadata that has no additive home on the existing
// tables for the same №325 reason. declared_min is stored NEXT TO the
// segment sum (practice_protocol.session_min = the honest sum) — the
// Н4-01 honesty: «сумма сегментов меньше declared минут — оба поля
// рядом, не исправлялось молча».
//
// PRIOR: wide 0.45 +- 0.20 for every MM hand; the source is «нет
// источника: широкий приор» EXCEPT breath_coherent — slow coherent
// breathing is inside the population of the one verified review
// (Zaccaro et al. 2018), with the same not-technique-specific
// qualifier the Н3-01 diaphragmatic row already carries.
pattern mm_arm_name(id: String) -> String {
  // the three AERIS overlaps attach to the EXISTING hands (задача 3):
  // no duplicate arm rows — the MIND-MASTERY texts join as the script
  if id == "breath_diaphragmatic" {
    return "breath-diaphragmatic"
  }
  if id == "breath_478" {
    return "breath-four-seven-eight"
  }
  if id == "breath_box" {
    return "breath-box"
  }
  return id
}

pattern mm_slot_for(system: String) -> String {
  // the PROPOSED split (owner gate — see the block comment above)
  if system == "feldenkrais" {
    return "body"
  }
  if system == "domfreq" {
    return "attention"
  }
  if system == "silva" or system == "dispenza" or system == "transurfing" {
    return "visualization"
  }
  return "breath"
}

pattern mm_safety_class(id: String) -> String {
  // hyperventilation is class C (the naryad's Факт); the converted
  // label says "A" for everything and is deliberately NOT trusted
  if id == "breath_wim_hof" or id == "breath_holotropic" {
    return "C"
  }
  return "A"
}

pattern mm_source_for(id: String) -> String {
  if id == "breath_coherent" {
    return "Zaccaro et al. 2018 (Front Hum Neurosci 12:353, doi:10.3389/fnhum.2018.00353): систематический обзор медленного дыхания (<=10 вдохов/мин) в целом; конкретная техника в обзоре не оценивалась — широкий приор"
  }
  return "нет источника: широкий приор"
}

// The derived protocol type (see the block comment): "guided" when the
// arm carries a scenario (practice_segment rows), "cycle" when it
// carries non-empty phase steps (the AERIS breathing protocols), and
// "instruction" otherwise (the methods rows). An unknown arm is
// "none" — never a fabricated kind.
pattern protocol_kind(arm_id: Float) -> String {
  let segs = query("SELECT count(*) AS n FROM practice_segment WHERE arm_id = ?", [arm_id])
  if segs[0].n > 0.0 {
    return "guided"
  }
  let prot = query("SELECT steps_json FROM practice_protocol WHERE arm_id = ?", [arm_id])
  if len(prot) == 0.0 {
    return "none"
  }
  if prot[0].steps_json != "[]" {
    return "cycle"
  }
  return "instruction"
}

// WHY TWO READ PATHS (probe-pinned on v0.38.0, serveprobe.mlog): the
// №455 sandbox restricts serve-route/tick file reads to the data
// directory — a repo-tree read is DENIED ([SANDBOX_SENSITIVE_PATH],
// hard even for read_file_or). The seed therefore reads the runtime
// copy data/mm-seed/<name>.json FIRST (inside ./data — allowed; a
// missing copy is a SOFT miss), falls back to the repository SSOT
// seeds/mm/<name>.json (readable by mlog test / CI; in serve the
// denial arrives and try catches it — one loud caught-error line), and
// only when BOTH are unreadable takes the loud-refusal path below. The
// operator/deploy copies the SSOT into the data dir (one command,
// documented in the PR/worklog; the install.sh step is a follow-up —
// outside this naryad's boundaries).
pattern mm_read_data(name: String) -> String {
  let d = read_file_or("data/mm-seed/" + name, "")
  if d != "" {
    return d
  }
  let r = try read_file_or("seeds/mm/" + name, "")
  if escape_html(to_string(r.ok)) == "true" {
    // allow(unchecked_result): r.value is read only behind the
    // escape_html(to_string(r.ok)) == "true" decision above — the
    // sanitize-then-decide bridge restores integrity before the
    // branch; the obfuscated guard is deliberate (№802, ADR-0198).
    // The №455 denial arrives as ok = false and is NOT fatal: the
    // data-dir copy was already tried (soft miss above).
    return to_string(r.value)
  }
  return ""
}

// Seed the script catalog. Idempotent: UNIQUE indexes + INSERT OR
// IGNORE everywhere (arm.name, practice_protocol.arm_id, slot.name —
// created defensively here too, so the seed is self-contained — plus
// the three NEW unique keys). Returns the segment count seeded (977 =
// 591 voice + 386 silence) — the honest completeness number, pinned by
// tests. A missing data file degrades LOUD: read_file_or with an empty
// default, one printed refusal, return 0 — the tick survives, the
// catalog stays empty until the files are back (the seeds/mm/*.json
// are tracked repository files, a missing file is a broken deploy).
pattern seed_mm_catalog() -> Float {
  let _ = db_execute("CREATE UNIQUE INDEX IF NOT EXISTS idx_arm_name_unique ON arm(name)", [])
  let _ = db_execute("CREATE UNIQUE INDEX IF NOT EXISTS idx_protocol_arm_unique ON practice_protocol(arm_id)", [])
  let _ = db_execute("CREATE UNIQUE INDEX IF NOT EXISTS idx_slot_name_unique ON slot(name)", [])
  let _ = db_execute("CREATE TABLE IF NOT EXISTS practice_segment (id INTEGER PRIMARY KEY AUTOINCREMENT, arm_id INTEGER REFERENCES arm(id), ord INTEGER DEFAULT '0', kind TEXT DEFAULT '', text_key TEXT DEFAULT '', sec REAL DEFAULT '0.0', phase TEXT DEFAULT '', layer_json TEXT DEFAULT '{}', created_at TEXT DEFAULT (datetime('now')))", [])
  let _ = db_execute("CREATE UNIQUE INDEX IF NOT EXISTS idx_segment_arm_ord_unique ON practice_segment(arm_id, ord)", [])
  let _ = db_execute("CREATE TABLE IF NOT EXISTS practice_script (id INTEGER PRIMARY KEY AUTOINCREMENT, text_key TEXT, body TEXT, created_at TEXT DEFAULT (datetime('now')))", [])
  let _ = db_execute("CREATE UNIQUE INDEX IF NOT EXISTS idx_script_key_unique ON practice_script(text_key)", [])
  let _ = db_execute("CREATE TABLE IF NOT EXISTS practice_profile (id INTEGER PRIMARY KEY AUTOINCREMENT, arm_id INTEGER REFERENCES arm(id), system TEXT DEFAULT '', level INTEGER DEFAULT '0', declared_min REAL DEFAULT '0.0', created_at TEXT DEFAULT (datetime('now')))", [])
  let _ = db_execute("CREATE UNIQUE INDEX IF NOT EXISTS idx_profile_arm_unique ON practice_profile(arm_id)", [])
  // Н4-07: the admission rules of the MIND-MASTERY systems — the entry
  // gate of the active set. Byte-identical to ensure_schema (db-cycle)
  // and to the operator mirror migrations/0001_init.sql — pinned by
  // verify-mirrors (the ddl-pin practice_admission).
  let _ = db_execute("CREATE TABLE IF NOT EXISTS practice_admission (id INTEGER PRIMARY KEY AUTOINCREMENT, system TEXT DEFAULT '', level INTEGER DEFAULT '0', min_sessions REAL DEFAULT '0.0', min_minutes REAL DEFAULT '0.0', created_at TEXT DEFAULT (datetime('now')))", [])
  let _ = db_execute("CREATE UNIQUE INDEX IF NOT EXISTS idx_admission_system_level_unique ON practice_admission(system, level)", [])
  let _ = db_execute("INSERT OR IGNORE INTO slot (name, max_active) VALUES ('attention', 3)", [])
  let _ = db_execute("INSERT OR IGNORE INTO slot (name, max_active) VALUES ('body', 3)", [])
  let _ = db_execute("INSERT OR IGNORE INTO slot (name, max_active) VALUES ('visualization', 3)", [])
  let raw_practices = mm_read_data("practices.json")
  let raw_scripts = mm_read_data("scripts.json")
  let raw_voice = mm_read_data("voice-manifest.json")
  let raw_admission = mm_read_data("progression.json")
  if raw_practices == "" or raw_scripts == "" or raw_voice == "" or raw_admission == "" {
    print("seed_mm_catalog: data/mm-seed/ и seeds/mm/ не читаются — каталог сценариев и правила допуска НЕ засеяны (громкий отказ, Н4-02/Н4-07; оператор: cp seeds/mm/*.json data/mm-seed/)")
    return 0.0
  }
  let practices = parse_json(raw_practices)
  let scripts = parse_json(raw_scripts)
  let voice = parse_json(raw_voice)
  let mut n_segments = 0.0
  each p in practices {
    let arm_name = mm_arm_name(p.id)
    let cls = mm_safety_class(p.id)
    let mut cons = 0.0
    if cls == "C" {
      cons = 1.0
    }
    let _ = db_execute("INSERT OR IGNORE INTO arm (name, group_name, day_window, duration_min, prior_mean, prior_std, active) VALUES (?, ?, 'morning', ?, 0.45, 0.2, 0)", [arm_name, p.title, to_float(p.minutes)])
    let arm_rows = query("SELECT id FROM arm WHERE name = ?", [arm_name])
    let arm_id = arm_rows[0].id
    // the AERIS three keep their existing protocol rows (UNIQUE(arm_id)
    // turns this insert into a no-op for them — «остаётся запись AERIS»)
    let _ = db_execute("INSERT OR IGNORE INTO practice_protocol (arm_id, slot, safety_class, requires_consent, max_hold_sec, session_min, steps_json, series_json, contraindications, source) VALUES (?, ?, ?, ?, 0, ?, '[]', '', ?, ?)", [arm_id, mm_slot_for(p.system), cls, cons, to_float(p.protocol.session_min), join(p.contraindications, "; "), mm_source_for(p.id)])
    let _ = db_execute("INSERT OR IGNORE INTO practice_profile (arm_id, system, level, declared_min) VALUES (?, ?, ?, ?)", [arm_id, p.system, to_float(p.level), to_float(p.protocol.declared_min)])
    let mut ord = 0.0
    each s in p.segments {
      ord = ord + 1.0
      if s.kind == "voice" {
        let tk = s.text_key
        let _ = db_execute("INSERT OR IGNORE INTO practice_script (text_key, body) VALUES (?, ?)", [tk, scripts[tk]])
        let _ = db_execute("INSERT OR IGNORE INTO practice_segment (arm_id, ord, kind, text_key, sec, phase, layer_json) VALUES (?, ?, 'voice', ?, ?, ?, ?)", [arm_id, ord, tk, to_float(s.duration_sec), s.phase, json_encode(voice[tk])])
      }
      if s.kind != "voice" {
        let _ = db_execute("INSERT OR IGNORE INTO practice_segment (arm_id, ord, kind, text_key, sec, phase, layer_json) VALUES (?, ?, 'silence', '', ?, ?, '{}')", [arm_id, ord, to_float(s.duration_sec), s.phase])
      }
      n_segments = n_segments + 1.0
    }
    // the author's method description (задача 4): an author TEXT, not
    // a proof — it never touches the prior, and the systemPhysics field
    // is NOT in the converted data (mm-convert, Н4-01) — declared in
    // the PR, the description is what the source carries
    let _ = db_execute("INSERT OR IGNORE INTO practice_script (text_key, body) VALUES (?, ?)", [p.id + ".about", p.description])
  }
  // Н4-07: the admission rules — practice_admission (UNIQUE(system,
  // level) + INSERT OR IGNORE: a reseed changes nothing). The source is
  // progression.json (mm-convert из progression.ts @ 2a26e75); допуск =
  // И сессии И минуты (checkUnlock.ts). 21 правило / 6 систем / уровни
  // 2..5 — пинится тестом ниже.
  let admission = parse_json(raw_admission)
  each r in admission {
    let _ = db_execute("INSERT OR IGNORE INTO practice_admission (system, level, min_sessions, min_minutes) VALUES (?, ?, ?, ?)", [r.system, to_float(r.level), to_float(r.sessions), to_float(r.minutes)])
  }
  return n_segments
}

// ── APP-MIRROR-END: arms-seed ─────────────────────────────────────────

test "seed inserts ten arms and a repeat breeds no duplicates" {
  let first = seed_arms()
  assert_eq(first, 10.0)
  let second = seed_arms()
  assert_eq(second, 10.0)
  assert_eq(second, first)
}

test "five methodologies across two windows" {
  seed_arms()
  let groups = query("SELECT count(*) AS n FROM (SELECT group_name FROM arm GROUP BY group_name HAVING count(DISTINCT day_window) = 2)", [])
  assert_eq(groups[0].n, 5.0)
  let windows = query("SELECT count(DISTINCT day_window) AS n FROM arm", [])
  assert_eq(windows[0].n, 2.0)
  let durations = query("SELECT count(*) AS n FROM arm WHERE duration_min != 10", [])
  assert_eq(durations[0].n, 0.0)
}

test "no self-hypnosis and no sound groups in the wave-1 seed" {
  // Loop-free by D2 discipline: the SQL predicate covers every seeded
  // row; the SSOT side is transitively pinned by the per-arm VALUES
  // test and the JSON lockstep test.
  seed_arms()
  let rows = query("SELECT count(*) AS n FROM arm WHERE group_name LIKE '%тона%' OR group_name = 'Самогипноз'", [])
  assert_eq(rows[0].n, 0.0)
}

test "every arm carries a non-empty literature source" {
  // Loop-free by D2 discipline. `source` lives only in the SSOT list
  // (not a DB column), so the check rides the JSON encoding whose
  // exact shape is byte-pinned by the lockstep test: an empty source
  // would render as "source":"". One assert covers all ten arms.
  assert_eq(contains(json_encode(kamerton_arms), "\"source\":\"\""), false)
}

test "priors are literature-seeded, not zeros" {
  seed_arms()
  let rows = query("SELECT count(*) AS n FROM arm WHERE prior_mean > 0 AND prior_std > 0", [])
  assert_eq(rows[0].n, 10.0)
}

test "arm table declaration matches the store's (column pin)" {
  seed_arms()
  let rows = query("SELECT sql AS s FROM sqlite_master WHERE name = 'arm'", [])
  assert_contains(rows[0].s, "prior_mean REAL DEFAULT '0.0'")
  assert_contains(rows[0].s, "prior_std REAL DEFAULT '1.0'")
  assert_contains(rows[0].s, "duration_min INTEGER DEFAULT '10'")
}

test "seeds/arms.json is in lockstep with the machine seed" {
  assert_eq(json_encode(kamerton_arms), read_file("seeds/arms.json"))
}

test "practice texts: one non-empty text per group, replay is a no-op (Н2-09)" {
  seed_arms()
  let rows = query("SELECT count(*) AS n FROM practice_text", [])
  assert_eq(rows[0].n, 5.0)
  let empty = query("SELECT count(*) AS n FROM practice_text WHERE body = '' OR body IS NULL", [])
  assert_eq(empty[0].n, 0.0)
  let _ = seed_arms()
  let again = query("SELECT count(*) AS n FROM practice_text", [])
  assert_eq(again[0].n, 5.0)
}

test "every arm joins its group practice text (Н2-09)" {
  seed_arms()
  // All 10 arms join a non-empty text of their own group; the group
  // count stays 5 — UNIQUE(group_name) makes a duplicate row loud.
  let joined = query("SELECT count(*) AS n FROM arm a JOIN practice_text p ON p.group_name = a.group_name WHERE p.body != ''", [])
  assert_eq(joined[0].n, 10.0)
  let orphan = query("SELECT count(*) AS n FROM (SELECT a.group_name FROM arm a LEFT JOIN practice_text p ON p.group_name = a.group_name WHERE p.body IS NULL OR p.body = '' GROUP BY a.group_name)", [])
  assert_eq(orphan[0].n, 0.0)
}

test "unrolled seed matches the kamerton_arms list per arm" {
  // Loop-free by D2 discipline. The VALUES rows below mirror the
  // unrolled seed literals exactly; LEFT JOIN catches a missing row,
  // the WHERE catches any field divergence. Expect 0 mismatches over
  // all 10 arms × 5 fields.
  seed_arms()
  let rows = query("SELECT count(*) AS n FROM (VALUES ('breath-resonance-morning','Резонансное дыхание','morning',10,0.6,0.15), ('breath-resonance-evening','Резонансное дыхание','evening',10,0.6,0.15), ('woop-morning','Имплементационные намерения','morning',10,0.6,0.15), ('woop-evening','Имплементационные намерения','evening',10,0.6,0.15), ('mental-rehearsal-morning','Ментальная репетиция','morning',10,0.5,0.15), ('mental-rehearsal-evening','Ментальная репетиция','evening',10,0.5,0.15), ('focusing-morning','Фокусинг','morning',10,0.45,0.2), ('focusing-evening','Фокусинг','evening',10,0.45,0.2), ('yoga-nidra-morning','Йога-нидра','morning',10,0.45,0.2), ('yoga-nidra-evening','Йога-нидра','evening',10,0.45,0.2)) AS v LEFT JOIN arm a ON a.name = v.column1 WHERE a.name IS NULL OR a.group_name != v.column2 OR a.day_window != v.column3 OR a.duration_min != v.column4 OR a.prior_mean != v.column5 OR a.prior_std != v.column6", [])
  assert_eq(rows[0].n, 0.0)
}

// ── Н3-01: the practice catalog (tests run after the wave-1 tests above:
//    the shared test database must still count exactly ten wave-1 arms
//    while those run) ───────────────────────────────────────────────────

test "Н3-01 catalog: eight practices, a replay is a no-op, every source is non-empty" {
  seed_arms()
  let first = seed_catalog()
  // Н3-05: the full protocol count is 18 — 8 breath + 10 methods rows
  assert_eq(first, 18.0)
  let _ = seed_catalog()
  let n = query("SELECT count(*) AS n FROM practice_protocol", [])
  assert_eq(n[0].n, 18.0)
  let arms = query("SELECT count(*) AS n FROM arm WHERE name LIKE 'breath-%' AND name NOT LIKE 'breath-resonance-%'", [])
  assert_eq(arms[0].n, 8.0)
  let methods = query("SELECT count(*) AS n FROM practice_protocol WHERE slot = 'methods'", [])
  assert_eq(methods[0].n, 10.0)
  let empty = query("SELECT count(*) AS n FROM practice_protocol WHERE source = '' OR source IS NULL", [])
  assert_eq(empty[0].n, 0.0)
  // every BREATH catalog hand starts INACTIVE; the wave-1 methods hands
  // keep their seeded ACTIVE state (no silent state change — Н3-05)
  let active = query("SELECT count(*) AS n FROM arm a JOIN practice_protocol p ON p.arm_id = a.id WHERE p.slot = 'breath' AND a.active = 1", [])
  assert_eq(active[0].n, 0.0)
  let active_methods = query("SELECT count(*) AS n FROM arm a JOIN practice_protocol p ON p.arm_id = a.id WHERE p.slot = 'methods' AND a.active = 1", [])
  assert_eq(active_methods[0].n, 10.0)
  let texts = query("SELECT count(*) AS n FROM arm a JOIN practice_protocol p ON p.arm_id = a.id JOIN practice_text t ON t.group_name = a.group_name WHERE t.body != ''", [])
  assert_eq(texts[0].n, 18.0)
}

test "Н3-01 catalog: cycles are DERIVED from session_min and fit it, for every breath practice" {
  seed_catalog()
  // the `methods` rows carry EMPTY steps by design (instruction methods,
  // not breath phases) — the cycle arithmetic applies to breath only
  let rows = query("SELECT arm_id, session_min FROM practice_protocol WHERE steps_json != '[]' ORDER BY arm_id", [])
  assert_eq(len(rows), 8.0)
  let mut bad = 0.0
  each r in rows {
    let unit = protocol_unit_sec(r.arm_id)
    let cyc = protocol_cycles(r.arm_id)
    let budget = r.session_min * 60.0
    if unit <= 0.0 or cyc < 1.0 or cyc * unit > budget or (cyc + 1.0) * unit <= budget {
      bad = bad + 1.0
    }
  }
  assert_eq(bad, 0.0)
  // the declared AERIS 4-7-8: 19 s per cycle, 5 min -> 15 cycles (not the 4 of the source text)
  let a = query("SELECT arm_id FROM practice_protocol WHERE slot = 'breath' AND steps_json LIKE '%\"hold\"%' AND session_min = 5 AND max_hold_sec = 7", [])
  assert_eq(protocol_unit_sec(a[0].arm_id), 19.0)
  assert_eq(protocol_cycles(a[0].arm_id), 15.0)
  // kapalabhati: 30 x (1+1) s + 30 s rest = 90 s per series, 5 min -> 3 series
  let k = query("SELECT arm_id FROM practice_protocol WHERE steps_json LIKE '%forced_exhale%'", [])
  assert_eq(protocol_unit_sec(k[0].arm_id), 90.0)
  assert_eq(protocol_cycles(k[0].arm_id), 3.0)
  // Н3-05: an empty-steps `methods` protocol yields ZERO — never a
  // fabricated cycle count
  let m = query("SELECT arm_id FROM practice_protocol WHERE slot = 'methods' ORDER BY arm_id LIMIT 1", [])
  assert_eq(protocol_unit_sec(m[0].arm_id), 0.0)
  assert_eq(protocol_cycles(m[0].arm_id), 0.0)
}

test "Н3-01 catalog: the safety class follows the DATA (holds, pauses, forced breathing)" {
  seed_catalog()
  // the breath slot only — the `methods` rows are class A with EMPTY
  // steps by design (they carry no breathing phases at all; pinned
  // separately by the Н3-05 slot test below)
  let rows = query("SELECT arm_id, safety_class, requires_consent, max_hold_sec, steps_json FROM practice_protocol WHERE slot = 'breath' ORDER BY arm_id", [])
  let mut bad = 0.0
  let mut count_a = 0.0
  let mut count_c = 0.0
  each r in rows {
    let steps = parse_json(r.steps_json)
    let mut longest = 0.0
    let mut has_hold = false
    let mut forced = false
    let mut intens_bad = false
    each s in steps {
      if s.phase == "hold" or s.phase == "pause" {
        has_hold = true
        if s.sec > longest {
          longest = s.sec
        }
      }
      if s.phase == "forced_exhale" {
        forced = true
      }
      if s.intensity < 0.0 or s.intensity > 1.0 {
        intens_bad = true
      }
    }
    if intens_bad == true {
      bad = bad + 1.0
    }
    if r.max_hold_sec < longest {
      bad = bad + 1.0
    }
    if r.safety_class == "A" {
      count_a = count_a + 1.0
      if has_hold == true or forced == true or r.requires_consent != 0.0 {
        bad = bad + 1.0
      }
    }
    if r.safety_class == "B" {
      if has_hold == false or forced == true or longest > 8.0 or r.requires_consent != 0.0 {
        bad = bad + 1.0
      }
    }
    if r.safety_class == "C" {
      count_c = count_c + 1.0
      if r.requires_consent != 1.0 or (forced == false and longest <= 8.0) {
        bad = bad + 1.0
      }
    }
  }
  assert_eq(bad, 0.0)
  assert_eq(count_a, 1.0)
  assert_eq(count_c, 3.0)
}

test "Н3-01 slots: a fourth active hand is refused, a freed place admits it, unslotted hands are uncapped" {
  seed_catalog()
  let ids = query("SELECT arm_id FROM practice_protocol WHERE slot = 'breath' ORDER BY arm_id", [])
  assert_eq(activate_arm(ids[0].arm_id, "test-н3-01"), "ok")
  assert_eq(activate_arm(ids[1].arm_id, "test-н3-01"), "ok")
  assert_eq(activate_arm(ids[2].arm_id, "test-н3-01"), "ok")
  assert_eq(activate_arm(ids[3].arm_id, "test-н3-01"), "slot-full")
  let off = query("SELECT active FROM arm WHERE id = ?", [ids[3].arm_id])
  assert_eq(off[0].active, 0.0)
  // a re-activation of an already active hand does not count itself twice
  assert_eq(activate_arm(ids[0].arm_id, "test-н3-01"), "ok")
  let _ = deactivate_arm(ids[0].arm_id, "test-н3-01")
  assert_eq(activate_arm(ids[3].arm_id, "test-н3-01"), "ok")
  assert_eq(activate_arm(ids[0].arm_id, "test-н3-01"), "slot-full")
  // a hand without a protocol is not slotted: the cap does not apply
  let legacy = query("SELECT id FROM arm WHERE name = 'woop-morning'", [])
  assert_eq(activate_arm(legacy[0].id, "test-н3-01"), "ok")
  assert_eq(activate_arm(999999.0, "test-н3-01"), "unknown-arm")
  let _ = deactivate_arm(ids[1].arm_id, "test-н3-01")
  let _ = deactivate_arm(ids[2].arm_id, "test-н3-01")
  let _ = deactivate_arm(ids[3].arm_id, "test-н3-01")
}

test "Н3-01 catalog: a ninth practice is ONE data record, no code change" {
  seed_catalog()
  let aid = db_insert("arm", {name: "breath-test-ninth", group_name: "Дыхание: тест", day_window: "morning", duration_min: 6.0, prior_mean: 0.45, prior_std: 0.2, active: 0})
  let _ = db_insert("practice_protocol", {arm_id: aid, slot: "breath", safety_class: "A", session_min: 6.0, steps_json: "[{\"phase\":\"inhale\",\"sec\":3.0,\"intensity\":0.4,\"cue\":\"x\"},{\"phase\":\"exhale\",\"sec\":3.0,\"intensity\":0.4,\"cue\":\"y\"}]", series_json: "{\"reps\":1.0,\"rest_sec\":0.0}", source: "нет источника: широкий приор"})
  assert_eq(protocol_unit_sec(aid), 6.0)
  assert_eq(protocol_cycles(aid), 60.0)
  // an unknown arm / an empty protocol yields zero, never a fabricated cycle count
  assert_eq(protocol_cycles(999999.0), 0.0)
}

test "Н3-01 catalog: seeds/practices.json is in lockstep with the machine seed" {
  assert_eq(json_encode(kamerton_protocols), read_file("seeds/practices.json"))
}

test "Н3-01 consent: one data row per class, recorded with its source" {
  seed_catalog()
  let rows = query("SELECT count(*) AS n FROM consent WHERE scope IN ('class:A', 'class:B', 'class:C') AND revoked = 0 AND source != ''", [])
  assert_eq(rows[0].n, 3.0)
  let _ = seed_catalog()
  let again = query("SELECT count(*) AS n FROM consent", [])
  assert_eq(again[0].n, 3.0)
}

// ── Н3-05: the methods slot, the active-set control, the journal ────────
// ORDER MATTERS on the shared test database: the "BEFORE the confirm"
// test must run BEFORE the confirm-arming test (the cap, once armed by
// the owner's confirm event, stays armed — that is the design, there is
// no silent disarm). The catalog-listing test runs first on purpose: it
// pins the freshly-seeded, deterministic state.

test "Н3-05 methods slot: ten wave-1 hands join the slot with empty steps and their own sources" {
  seed_arms()
  seed_catalog()
  let slot_rows = query("SELECT count(*) AS n FROM slot WHERE name = 'methods' AND max_active = 3", [])
  assert_eq(slot_rows[0].n, 1.0)
  // every methods protocol: empty steps, no series, class A, no consent
  // needed, its own literature source, one-to-one with its arm row
  let empty_steps = query("SELECT count(*) AS n FROM practice_protocol WHERE slot = 'methods' AND (steps_json != '[]' OR series_json != '')", [])
  assert_eq(empty_steps[0].n, 0.0)
  let class_a = query("SELECT count(*) AS n FROM practice_protocol WHERE slot = 'methods' AND safety_class = 'A' AND requires_consent = 0 AND max_hold_sec = 0", [])
  assert_eq(class_a[0].n, 10.0)
  let src = query("SELECT count(*) AS n FROM practice_protocol p JOIN arm a ON a.id = p.arm_id WHERE p.slot = 'methods' AND p.source != ''", [])
  assert_eq(src[0].n, 10.0)
  let joined = query("SELECT count(*) AS n FROM arm a JOIN practice_protocol p ON p.arm_id = a.id WHERE p.slot = 'methods'", [])
  assert_eq(joined[0].n, 10.0)
}

test "Н3-05: the catalog listing carries slot, state and class for every hand" {
  // runs right after the seed tests, BEFORE any activation test; the
  // store may already carry the Н3-01 "ninth practice" data row, so the
  // ABSOLUTE count is pinned by the seed tests (18) and this test pins
  // the SHAPE: the slot order, the state and the class fields
  seed_catalog()
  let cat = arms_catalog()
  assert_eq(len(cat) >= 18.0, true)
  // methods first, breath next (the ORDER BY contract of arms_catalog)
  assert_eq(cat[0].slot, "methods")
  assert_eq(cat[0].active, 1.0)
  assert_eq(cat[0].safety_class, "A")
  assert_eq(cat[0].max_active, 3.0)
  assert_eq(cat[len(cat) - 1.0].slot, "breath")
  assert_eq(cat[len(cat) - 1.0].active, 0.0)
  let mut breath_active = 0.0
  let mut methods_active = 0.0
  let mut methods_count = 0.0
  each c in cat {
    if c.slot == "breath" {
      breath_active = breath_active + c.active
    }
    if c.slot == "methods" {
      methods_active = methods_active + c.active
      methods_count = methods_count + 1.0
    }
  }
  assert_eq(breath_active, 0.0)
  assert_eq(methods_active, 10.0)
  assert_eq(methods_count, 10.0)
}

test "Н3-05: BEFORE the owner's confirm the methods cap is recorded but not enforced" {
  seed_catalog()
  let ids = query("SELECT p.arm_id AS arm_id FROM practice_protocol p JOIN arm a ON a.id = p.arm_id WHERE p.slot = 'methods' ORDER BY p.arm_id", [])
  // a clean slate: the wave-1 hands are ACTIVE by seed — retire all ten
  // (assignment-body loop, the D2-safe shape) so the admissions below
  // are real admissions, not no-ops on already-active hands
  each id in ids {
    let _ = deactivate_arm(id.arm_id, "test-н3-05-cleanup")
  }
  // four admissions in a row — no refusal while the cap is not armed
  assert_eq(activate_arm(ids[0].arm_id, "test-н3-05"), "ok")
  assert_eq(activate_arm(ids[1].arm_id, "test-н3-05"), "ok")
  assert_eq(activate_arm(ids[2].arm_id, "test-н3-05"), "ok")
  assert_eq(activate_arm(ids[3].arm_id, "test-н3-05"), "ok")
  let on = query("SELECT count(*) AS n FROM arm_journal WHERE action = 'arm-on' AND arm_id = ?", [ids[3].arm_id])
  assert_eq(on[0].n, 1.0)
  each id2 in ids {
    let _ = deactivate_arm(id2.arm_id, "test-н3-05")
  }
  let armed = query("SELECT count(*) AS n FROM arm_journal WHERE action = 'methods-cap-armed'", [])
  assert_eq(armed[0].n, 0.0)
}

test "Н3-05: the owner's confirm arms the cap; the fourth methods hand is refused slot-full" {
  seed_catalog()
  let ids = query("SELECT p.arm_id AS arm_id FROM practice_protocol p JOIN arm a ON a.id = p.arm_id WHERE p.slot = 'methods' ORDER BY p.arm_id", [])
  // a clean slate again (the previous test retired its hands, the seed
  // active state of ids 4..9 may persist — retire everything once)
  each id0 in ids {
    let _ = deactivate_arm(id0.arm_id, "test-н3-05-cleanup")
  }
  // exactly three active methods hands required — loud refusals otherwise
  assert_eq(arm_methods_cap_confirm("test-н3-05"), "less-than-three")
  let _ = activate_arm(ids[0].arm_id, "test-н3-05")
  let _ = activate_arm(ids[1].arm_id, "test-н3-05")
  assert_eq(arm_methods_cap_confirm("test-н3-05"), "less-than-three")
  // over-three: a fourth hand rides in while the cap is unarmed (the
  // owner is exploring), the confirm refuses to arm an untrimmed set
  let _ = activate_arm(ids[2].arm_id, "test-н3-05")
  let _ = activate_arm(ids[3].arm_id, "test-н3-05")
  assert_eq(arm_methods_cap_confirm("test-н3-05"), "over-three")
  let armed0 = query("SELECT count(*) AS n FROM arm_journal WHERE action = 'methods-cap-armed'", [])
  assert_eq(armed0[0].n, 0.0)
  // the owner trims to three — the confirm arms the cap, ONE journal event
  let _ = deactivate_arm(ids[3].arm_id, "test-н3-05")
  assert_eq(arm_methods_cap_confirm("test-н3-05"), "ok")
  let armed = query("SELECT count(*) AS n FROM arm_journal WHERE action = 'methods-cap-armed'", [])
  assert_eq(armed[0].n, 1.0)
  // the fourth hand is refused LOUDLY, its state unchanged
  assert_eq(activate_arm(ids[3].arm_id, "test-н3-05"), "slot-full")
  let refused = query("SELECT count(*) AS n FROM arm_journal WHERE action = 'arm-on-refused' AND arm_id = ?", [ids[3].arm_id])
  assert_eq(refused[0].n, 1.0)
  // a freed place admits the fourth hand again
  let _ = deactivate_arm(ids[0].arm_id, "test-н3-05")
  assert_eq(activate_arm(ids[3].arm_id, "test-н3-05"), "ok")
}

test "Н3-05: the journal records who, when and what — readable by a plain sqlite3 client" {
  // the BREATH slot: its cap is always in force, so the refusal case
  // is reproducible here without depending on the methods-cap arming
  // order of the tests above
  seed_catalog()
  let ids = query("SELECT arm_id FROM practice_protocol WHERE slot = 'breath' ORDER BY arm_id", [])
  assert_eq(activate_arm(ids[0].arm_id, "journal-probe"), "ok")
  assert_eq(activate_arm(ids[1].arm_id, "journal-probe"), "ok")
  assert_eq(activate_arm(ids[2].arm_id, "journal-probe"), "ok")
  assert_eq(activate_arm(ids[3].arm_id, "journal-probe"), "slot-full")
  let _ = deactivate_arm(ids[0].arm_id, "journal-probe")
  // WHO: the actor rides every row; WHEN: created_at is never empty;
  // WHAT: the action (+ the detail on refusals)
  let when = query("SELECT count(*) AS n FROM arm_journal WHERE actor = 'journal-probe' AND created_at = ''", [])
  assert_eq(when[0].n, 0.0)
  let plain = query("SELECT action, created_at FROM arm_journal WHERE actor = 'journal-probe' AND detail = '' ORDER BY id", [])
  assert_eq(len(plain), 4.0)
  assert_eq(plain[0].action, "arm-on")
  assert_eq(plain[3].action, "arm-off")
  let refused = query("SELECT action, detail FROM arm_journal WHERE actor = 'journal-probe' AND detail != '' ORDER BY id", [])
  assert_eq(len(refused), 1.0)
  assert_eq(refused[0].action, "arm-on-refused")
  assert_eq(refused[0].detail, "slot-full")
}

