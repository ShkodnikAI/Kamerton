  assert_eq(scripts[0].n, 666.0)
  let profiles = query("SELECT count(*) AS n FROM practice_profile", [])
  assert_eq(profiles[0].n, 75.0)
  let mm_protocols = query("SELECT count(*) AS n FROM practice_protocol p JOIN practice_profile prof ON prof.arm_id = p.arm_id", [])
  assert_eq(mm_protocols[0].n, 75.0)
  // 72 NEW arm rows: every MM protocol carries EMPTY steps (the scenario
  // lives in practice_segment); the three AERIS cycles keep their steps
  let new_arms = query("SELECT count(*) AS n FROM practice_protocol p JOIN practice_profile prof ON prof.arm_id = p.arm_id WHERE p.steps_json = '[]'", [])
  assert_eq(new_arms[0].n, 72.0)
  let voice = query("SELECT count(*) AS n FROM practice_segment WHERE kind = 'voice'", [])
  assert_eq(voice[0].n, 591.0)
  let silence = query("SELECT count(*) AS n FROM practice_segment WHERE kind = 'silence'", [])
  assert_eq(silence[0].n, 386.0)
}

test "Н4-02: the three AERIS hands keep their protocol rows and gain the script" {
  seed_arms()
  seed_catalog()
  seed_mm_catalog()
  // diaphragmatic: the AERIS cycle protocol survives (source, steps,
  // class) AND the MIND-MASTERY scenario rides the same arm
  let d = query("SELECT p.source AS src, p.steps_json AS steps, p.safety_class AS cls FROM arm a JOIN practice_protocol p ON p.arm_id = a.id WHERE a.name = 'breath-diaphragmatic'", [])
  assert_eq(contains(d[0].src, "Zaccaro"), true)
  assert_eq(d[0].steps != "[]", true)
  assert_eq(d[0].cls, "A")
  let d_segs = query("SELECT count(*) AS n FROM practice_segment s JOIN arm a ON a.id = s.arm_id WHERE a.name = 'breath-diaphragmatic'", [])
  assert_eq(d_segs[0].n, 12.0)
  let d_scripts = query("SELECT count(*) AS n FROM practice_segment s JOIN arm a ON a.id = s.arm_id WHERE a.name = 'breath-diaphragmatic' AND s.kind = 'voice'", [])
  assert_eq(d_scripts[0].n, 7.0)
  // no duplicate arm rows: the three overlapping names stay unique
  let dup = query("SELECT count(*) AS n FROM (SELECT name FROM arm WHERE name IN ('breath-diaphragmatic', 'breath-four-seven-eight', 'breath-box') GROUP BY name HAVING count(*) > 1)", [])
  assert_eq(dup[0].n, 0.0)
  // 4-7-8: the AERIS cycle stays, the MM texts attach
  let f = query("SELECT p.max_hold_sec AS hold FROM arm a JOIN practice_protocol p ON p.arm_id = a.id WHERE a.name = 'breath-four-seven-eight'", [])
  assert_eq(f[0].hold, 7.0)
}

