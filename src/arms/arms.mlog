test "Н4-02: the script fits the declared session (the tolerance DECLARED: ratio 0.25..1.2 — the voiced core, Н4-01 honesty)" {
  seed_mm_catalog()
  let rows = query("SELECT prof.declared_min AS declared, prof.arm_id AS arm_id FROM practice_profile prof", [])
  let mut bad = 0.0
  each r in rows {
    let segs = query("SELECT sum(sec) AS total FROM practice_segment WHERE arm_id = ?", [r.arm_id])
    let total = segs[0].total
    if total <= 0.0 or total < r.declared * 60.0 * 0.25 or total > r.declared * 60.0 * 1.2 {
      bad = bad + 1.0
    }
  }
  assert_eq(bad, 0.0)
  // the data pins: the largest breath scripts, exact seconds
  let d = query("SELECT sum(sec) AS total FROM practice_segment WHERE arm_id = (SELECT id FROM arm WHERE name = 'breath-diaphragmatic')", [])
  assert_eq(d[0].total, 535.0)
  let w = query("SELECT sum(sec) AS total FROM practice_segment WHERE arm_id = (SELECT id FROM arm WHERE name = 'breath_wim_hof')", [])
  assert_eq(w[0].total, 660.0)
}

