// Kamerton (naryad Н1-08): the honesty valve — src/honesty/
// per the issue #27 form: накопленный выигрыш бандита против случайного
// выбора; прямая формулировка «сигнала нет» при отсутствии выигрыша;
// доля пропусков по рукам отдельной строкой; источники «отклика в
// моменте» показываются раздельно, без молчаливого смешения; все
// оценки — диапазоном low / expected / high.
//
// ── Design decisions fixed here (in-boundary choices; the naryad fixes
//    the requirements, not the parametrisation) ─────────────────────────
//   1. Observational baseline (честная граница): counterfactual rewards
//     do not exist — every completed trial was proposed by the bandit
//     (Н1-05/Н1-06), so no unchosen arm ever reveals its reward. The
//     random-choice expectation is estimated as the UNWEIGHTED mean of
//     the per-arm mean rewards over the same completed trials (a
//     uniform random pick lands on each arm equally often in
//     expectation). The bandit's edge shows up through UNEQUAL n: with
//     a signal the bandit concentrates picks on the better arms, so
//     its mean detaches from the arm-means average. Both sides come
//     from the same rows — no fabricated data.
//   2. Ranges, never points (the naryad acceptance row): the gain is
//     reported as expected ± the 1.96·SE band of the BANDIT side,
//     SE = sqrt(var/n), var = avg(x²) − avg(x)² (the population form —
//     slightly narrow at tiny n; declared, not hidden). The baseline is
//     treated as the reference constant of the observed period; with
//     very few arms this understates the baseline uncertainty — the
//     honest envelope is declared here and the verdict thresholds are
//     the band edges, not a point test.
//   3. Verdicts (громкая деградация — принцип языка, применённый к
//     выводу): «выигрыш есть» when the band edge clears the baseline;
//     «хуже случайного выбора» when the band sits fully below it;
//     «сигнала нет» in every other case, INCLUDING the empty-data case
//     (completed=0) — the phrase is always present when there is no
//     demonstrated edge. No silent mixing (ADR-0001): the moment
//     sources are listed per source, never merged.
//   4. One query per line (no language loops): every report line is a
//     single SQL aggregate — GROUP BY + group_concat carry the
//     per-arm/per-source walk inside SQLite, so the D2-sensitive
//     loop-free discipline costs nothing here. The concat order follows
//     the ORDER BY of the subquery and is pinned by a test.
//   5. Standalone file (no cross-file imports): the db header and the
//     arm/note/trial/response/context declarations are byte-identical
//     to src/store/store.mlog (the bandit/context precedent); the same
//     block is byte-identical across src/context/context.mlog (Н1-07)
//     and src/report/report.mlog (the mirror half of this naryad).
//     №611 (v0.29.0) enforces references() — the FK parents are
//     carried; the file is green on both v0.28.2 and v0.29.0 binaries.
//   6. Test bodies stay loop-free and every call is assigned or
//     returned (the D2 discipline); synthetic trials are UNROLLED
//     inserts. The reward scale is [0,1] (ADR-0001).

entity db_raw: String = env_or("KAMERTON_DB", ":memory:")

entity db_url: String = "sqlite:" + db_raw

db { url: db_url }

schema kamerton {

  table arm {
    id: Int primary_key auto_increment,
    name: String,
    group_name: String,
    day_window: String,
    duration_min: Int default("10"),
    prior_mean: Float default("0.0"),
    prior_std: Float default("1.0"),
    active: Int default("1"),
    created_at: String default(now())
  }

  table note {
    id: Int primary_key auto_increment,
    body: String,
    active: Int default("1"),
    created_at: String default(now())
  }

  table trial {
    id: Int primary_key auto_increment,
    trial_date: String,
    day_window: String,
    arm_id: Int references(arm.id),
    note_id: Int references(note.id),
    status: String default("proposed"),
    prediction_depth: Float default("0.0"),
    prediction_confidence: Float default("0.0"),
    moment_value: Float default("0.0"),
    moment_present: Int default("0"),
    moment_source: String default(""),
    next_day_value: Float default("0.0"),
    next_day_present: Int default("0"),
    action_value: Float default("0.0"),
    action_present: Int default("0"),
    reward: Float default("0.0"),
    free_note: String default(""),
    closed_at: String default(""),
    created_at: String default(now())
  }

  table response {
    id: Int primary_key auto_increment,
    trial_id: Int references(trial.id),
    kind: String,
    depth: Float default("0.0"),
    details: String default(""),
    created_at: String default(now())
  }

  table context {
    id: Int primary_key auto_increment,
    trial_id: Int references(trial.id),
    moon_phase: String default(""),
    weather: String default(""),
    sound_mode: String default(""),
    sleep_quality: Float default("0.0"),
    logged_at: String default(now())
  }
}

// ── The honesty math ──────────────────────────────────────────────────

// The bandit side: every completed trial is a bandit pick with its
// realized reward. The population variance form is declared (decision 2).
// Returns the map {n, m, se} — the reward mean and its SE over the
// completed picks.
pattern bandit_side() -> map {
  let rows = query("SELECT count(*) AS n, avg(reward) AS m, avg(reward * reward) AS m2 FROM trial WHERE status = 'completed'", [])
  let n = to_float_or(to_string(rows[0].n), 0.0)
  let m = to_float_or(to_string(rows[0].m), 0.0)
  let m2 = to_float_or(to_string(rows[0].m2), 0.0)
  let mut var = m2 - m * m
  if var < 0.0 { let var = 0.0 }
  let mut se = 0.0
  if n > 0.0 {
    let se = sqrt(var / n)
  }
  return {n: n, m: m, se: se}
}

// The random-choice baseline: the unweighted mean of the per-arm mean
// rewards (decision 1). Returns the map {arms, m, se} — the arm count
// and the baseline mean with its SE across arm means.
pattern random_baseline() -> map {
  let rows = query("SELECT count(*) AS arms, avg(m) AS m, avg(m * m) AS m2 FROM (SELECT arm_id, avg(reward) AS m FROM trial WHERE status = 'completed' GROUP BY arm_id)", [])
  let k = to_float_or(to_string(rows[0].arms), 0.0)
  let m = to_float_or(to_string(rows[0].m), 0.0)
  let m2 = to_float_or(to_string(rows[0].m2), 0.0)
  let mut var = m2 - m * m
  if var < 0.0 { let var = 0.0 }
  let mut se = 0.0
  if k > 0.0 {
    let se = sqrt(var / k)
  }
  return {arms: k, m: m, se: se}
}

// A number in the report form: rounded to hundredths, no long tails.
pattern fmt2(x: Float) -> String {
  return to_string(round(x * 100.0) / 100.0)
}

// The verdict (decision 3). The band edges mb ∓ 1.96·se_b are compared
// against the baseline constant.
pattern honesty_verdict() -> String {
  let b = bandit_side()
  if b.n < 1.0 { return "сигнала нет — данных нет (completed=0)" }
  let r = random_baseline()
  let lo = b.m - 1.96 * b.se
  let hi = b.m + 1.96 * b.se
  if lo > r.m { return "выигрыш есть — бандит лучше случайного выбора" }
  if hi < r.m { return "выигрыша нет — хуже случайного выбора" }
  return "сигнала нет — выигрыш над случайным выбором не выявлен"
}

// The gain line: expected [low; high], all three present — no point
// estimate is ever printed alone (the acceptance row).
pattern gain_line() -> String {
  let b = bandit_side()
  let r = random_baseline()
  let lo = b.m - 1.96 * b.se - r.m
  let hi = b.m + 1.96 * b.se - r.m
  return "gain: expected=" + fmt2(b.m - r.m) + " [low=" + fmt2(lo) + "; high=" + fmt2(hi) + "] (95% approx)"
}

// Misses per arm — one aggregate line (decision 4): the fraction of
// missed trials per arm, every arm, SQL-carried order.
pattern misses_line() -> String {
  let rows = query("SELECT group_concat(t.g || ': ' || t.miss || '/' || t.n || ' (' || t.pct || '%)', '; ') AS s FROM (SELECT arm.name AS g, CAST(sum(CASE WHEN trial.status = 'missed' THEN 1 ELSE 0 END) AS INT) AS miss, CAST(count(*) AS INT) AS n, CAST(CAST(sum(CASE WHEN trial.status = 'missed' THEN 1 ELSE 0 END) AS REAL) * 100.0 / count(*) AS INT) AS pct FROM trial JOIN arm ON arm.id = trial.arm_id GROUP BY arm.name ORDER BY arm.name) AS t", [])
  if to_string(rows[0].s) == "" { return "misses: (нет проб)" }
  return "misses: " + to_string(rows[0].s)
}

// Moment sources, SEPARATE per source (ADR-0001 — no silent mixing):
// count and mean per source; the default empty source is listed as
// "(пусто)" so a silent default can never hide.
pattern source_lines() -> String {
  let rows = query("SELECT group_concat(CASE WHEN t.src = '' THEN '(пусто)' ELSE t.src END || ': n=' || CAST(t.n AS INT) || ' avg=' || CAST(ROUND(t.m, 2) AS TEXT), '; ') AS s FROM (SELECT moment_source AS src, count(*) AS n, avg(moment_value) AS m FROM trial WHERE moment_present = 1 GROUP BY moment_source ORDER BY moment_source) AS t", [])
  if to_string(rows[0].s) == "" { return "moment sources: (нет момент-откликов)" }
  return "moment sources: " + to_string(rows[0].s)
}

// The SSOT report text. The chat and CLI forms live in
// src/report/report.mlog (the mirror half of this naryad) and are
// derived from THIS text — one source, two presentations.
pattern honesty_report_text() -> String {
  let head = "honesty report\nverdict: " + honesty_verdict()
  let b = bandit_side()
  let r = random_baseline()
  let counts = "\ncompleted=" + to_string(round(b.n)) + " trials over " + to_string(round(r.arms)) + " arms"
  return head + counts + "\n" + gain_line() + "\n" + misses_line() + "\n" + source_lines()
}

// ── Tests (no loops; synthetic trials are unrolled inserts) ───────────

test "empty data says no signal loudly" {
  let text = honesty_report_text()
  assert_contains(text, "сигнала нет")
  assert_contains(text, "данных нет")
  assert_contains(text, "completed=0")
}

test "no signal on signal-free synthetic data" {
  let a1 = db_insert("arm", {name: "h-flat-1", group_name: "honesty", day_window: "morning", duration_min: 10.0, prior_mean: 0.5, prior_std: 0.15})
  let a2 = db_insert("arm", {name: "h-flat-2", group_name: "honesty", day_window: "morning", duration_min: 10.0, prior_mean: 0.5, prior_std: 0.15})
  let t1 = db_insert("trial", {trial_date: "2026-10-06", day_window: "morning", arm_id: a1, status: "completed", reward: 0.4})
  let t2 = db_insert("trial", {trial_date: "2026-10-06", day_window: "morning", arm_id: a1, status: "completed", reward: 0.6})
  let t3 = db_insert("trial", {trial_date: "2026-10-06", day_window: "morning", arm_id: a1, status: "completed", reward: 0.4})
  let t4 = db_insert("trial", {trial_date: "2026-10-06", day_window: "morning", arm_id: a1, status: "completed", reward: 0.6})
  let t5 = db_insert("trial", {trial_date: "2026-10-06", day_window: "morning", arm_id: a2, status: "completed", reward: 0.5})
  let t6 = db_insert("trial", {trial_date: "2026-10-06", day_window: "morning", arm_id: a2, status: "completed", reward: 0.5})
  let t7 = db_insert("trial", {trial_date: "2026-10-06", day_window: "morning", arm_id: a2, status: "completed", reward: 0.5})
  let t8 = db_insert("trial", {trial_date: "2026-10-06", day_window: "morning", arm_id: a2, status: "completed", reward: 0.4})
  let t9 = db_insert("trial", {trial_date: "2026-10-06", day_window: "morning", arm_id: a2, status: "completed", reward: 0.6})
  let text = honesty_report_text()
  assert_contains(text, "сигнала нет")
  assert_eq(contains(text, "выигрыш есть"), false)
  assert_contains(text, "expected=")
  assert_contains(text, "[low=")
  assert_contains(text, "high=")
  // The band-width pin: the flat synthetic data gives SE = 0.0272, so
  // the 1.96·SE band is [-0.05; +0.05] around expected=0 — a collapsed
  // (point) range fails this pin.
  assert_contains(text, "[low=-0.05; high=0.05]")
}

test "gain on signal-carrying synthetic data" {
  let a1 = db_insert("arm", {name: "h-sig-good", group_name: "honesty", day_window: "morning", duration_min: 10.0, prior_mean: 0.6, prior_std: 0.15})
  let a2 = db_insert("arm", {name: "h-sig-poor", group_name: "honesty", day_window: "morning", duration_min: 10.0, prior_mean: 0.4, prior_std: 0.15})
  let t1 = db_insert("trial", {trial_date: "2026-10-06", day_window: "morning", arm_id: a1, status: "completed", reward: 0.8})
  let t2 = db_insert("trial", {trial_date: "2026-10-06", day_window: "morning", arm_id: a1, status: "completed", reward: 0.8})
  let t3 = db_insert("trial", {trial_date: "2026-10-06", day_window: "morning", arm_id: a1, status: "completed", reward: 0.8})
  let t4 = db_insert("trial", {trial_date: "2026-10-06", day_window: "morning", arm_id: a1, status: "completed", reward: 0.8})
  let t5 = db_insert("trial", {trial_date: "2026-10-06", day_window: "morning", arm_id: a1, status: "completed", reward: 0.8})
  let t6 = db_insert("trial", {trial_date: "2026-10-06", day_window: "morning", arm_id: a1, status: "completed", reward: 0.8})
  let t7 = db_insert("trial", {trial_date: "2026-10-06", day_window: "morning", arm_id: a1, status: "completed", reward: 0.8})
  let t8 = db_insert("trial", {trial_date: "2026-10-06", day_window: "morning", arm_id: a1, status: "completed", reward: 0.8})
  let t9 = db_insert("trial", {trial_date: "2026-10-06", day_window: "morning", arm_id: a1, status: "completed", reward: 0.8})
  let t10 = db_insert("trial", {trial_date: "2026-10-06", day_window: "morning", arm_id: a2, status: "completed", reward: 0.2})
  let t11 = db_insert("trial", {trial_date: "2026-10-06", day_window: "morning", arm_id: a2, status: "completed", reward: 0.2})
  let text = honesty_report_text()
  assert_contains(text, "выигрыш есть")
  assert_eq(contains(text, "сигнала нет"), false)
}

test "misses line is present with per-arm fractions" {
  let a1 = db_insert("arm", {name: "h-miss-a", group_name: "honesty", day_window: "morning", duration_min: 10.0, prior_mean: 0.5, prior_std: 0.15})
  let a2 = db_insert("arm", {name: "h-miss-b", group_name: "honesty", day_window: "evening", duration_min: 10.0, prior_mean: 0.5, prior_std: 0.15})
  let t1 = db_insert("trial", {trial_date: "2026-10-06", day_window: "morning", arm_id: a1, status: "missed"})
  let t2 = db_insert("trial", {trial_date: "2026-10-06", day_window: "morning", arm_id: a1, status: "completed", reward: 0.7})
  let t3 = db_insert("trial", {trial_date: "2026-10-06", day_window: "evening", arm_id: a2, status: "proposed"})
  let text = honesty_report_text()
  assert_contains(text, "misses: ")
  assert_contains(text, "h-miss-a: 1/2 (50%)")
  assert_contains(text, "h-miss-b: 0/1 (0%)")
}

test "moment sources are shown separately, no silent mixing" {
  let a1 = db_insert("arm", {name: "h-src", group_name: "honesty", day_window: "morning", duration_min: 10.0, prior_mean: 0.5, prior_std: 0.15})
  let t1 = db_insert("trial", {trial_date: "2026-10-06", day_window: "morning", arm_id: a1, status: "completed", reward: 0.5, moment_present: 1, moment_value: 0.6, moment_source: "projection"})
  let t2 = db_insert("trial", {trial_date: "2026-10-06", day_window: "morning", arm_id: a1, status: "completed", reward: 0.5, moment_present: 1, moment_value: 0.7, moment_source: "projection"})
  let t3 = db_insert("trial", {trial_date: "2026-10-06", day_window: "morning", arm_id: a1, status: "completed", reward: 0.5, moment_present: 1, moment_value: 0.3, moment_source: "self_scale"})
  let text = honesty_report_text()
  assert_contains(text, "moment sources: ")
  assert_contains(text, "projection: n=2 avg=0.65")
  assert_contains(text, "self_scale: n=1 avg=0.3")
}

test "the report carries the range form, never a lone point" {
  let text = honesty_report_text()
  assert_contains(text, "expected=")
  assert_contains(text, "[low=")
  assert_contains(text, "; high=")
}

test "Н2-07: subjective and spectral sources show separately in the valve" {
  // The canonical ADR-0001 source names on synthetic data with BOTH
  // sources present — the valve lists them per source, never merged.
  let a1 = db_insert("arm", {name: "h2-07-valve", group_name: "honesty", day_window: "morning", duration_min: 10.0, prior_mean: 0.5, prior_std: 0.15})
  let t1 = db_insert("trial", {trial_date: "2026-10-09", day_window: "morning", arm_id: a1, status: "completed", reward: 0.5, moment_present: 1, moment_value: 0.6, moment_source: "subjective"})
  let t2 = db_insert("trial", {trial_date: "2026-10-09", day_window: "morning", arm_id: a1, status: "completed", reward: 0.5, moment_present: 1, moment_value: 0.8, moment_source: "subjective"})
  let t3 = db_insert("trial", {trial_date: "2026-10-09", day_window: "morning", arm_id: a1, status: "completed", reward: 0.5, moment_present: 1, moment_value: 0.71, moment_source: "spectral"})
  let text = honesty_report_text()
  assert_contains(text, "subjective: n=2 avg=0.7")
  assert_contains(text, "spectral: n=1 avg=0.71")
}
