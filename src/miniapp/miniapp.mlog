// Kamerton mini-app core (naryad Н2-03): src/miniapp/
//
// The Mini App is the M2 practice surface (docs/concept-v2.md, фаза
// M2): the pacer and the PPG screens run in the owner's phone browser;
// HTML/JS is the single §1 AGENTS.md exception. Delivery channel per
// ADR-0002 (variant (а), private tunnel): the page is served by the
// app.mlog /miniapp route from the TRUSTED literal — read_file output
// carries 'public, untrusted' and the №391 sink clearance refuses
// respond(read_file(...)) (probe n203-serve-1), so this module carries
// the serving literal and self-host/miniapp/index.html is the
// byte-pinned canon (the lockstep test below).
//
// The practice sessions live in SQLite (invariant 6): the
// practice_session table is declared additively in the schema block
// below, in the app ensure_schema() DDL path (byte-identical in both
// db-cycle copies) and in the operator mirror migrations/0001_init.sql
// (the Н1-03 rules: CREATE TABLE IF NOT EXISTS only, no down-migration;
// the rollback path is backup restore, deploy/backup.sh).
//
// The §miniapp-core block (token guard + page literal + session
// writers) is byte-mirrored into app.mlog and
// src/telegram/telegram.mlog (the app↔tg prefix discipline); the
// equality is verified by the verifier script recorded in the naryad
// worklog.
//
// The route bodies (app.mlog) consume QUERY PARAMS only: on 0.30.0 the
// request-body parsers (json_body/form_data/request_body) return an
// EMPTY struct (probe n203-json4, declared loudly per §2 — задание
// агенту Metalogos-), so the session API takes its fields through the
// percent-decoded query params (query_param, №257 semantics,
// probe-green) and answers plain text.

entity db_raw: String = env_or("KAMERTON_DB", ":memory:")

entity db_url: String = "sqlite:" + db_raw

db { url: db_url }

schema kamerton {

  table arm {
    id: Int primary_key auto_increment,
    name: String,
    group_name: String,
    day_window: String,
    duration_min: Int default("10"),
    prior_mean: Float default("0.0"),
    prior_std: Float default("1.0"),
    active: Int default("1"),
    created_at: String default(now())
  }

  table note {
    id: Int primary_key auto_increment,
    body: String,
    active: Int default("1"),
    created_at: String default(now())
  }

  table trial {
    id: Int primary_key auto_increment,
    trial_date: String,
    day_window: String,
    arm_id: Int references(arm.id),
    note_id: Int references(note.id),
    status: String default("proposed"),
    prediction_depth: Float default("0.0"),
    prediction_confidence: Float default("0.0"),
    moment_value: Float default("0.0"),
    moment_present: Int default("0"),
    moment_source: String default(""),
    next_day_value: Float default("0.0"),
    next_day_present: Int default("0"),
    action_value: Float default("0.0"),
    action_present: Int default("0"),
    reward: Float default("0.0"),
    free_note: String default(""),
    closed_at: String default(""),
    created_at: String default(now())
  }

  table response {
    id: Int primary_key auto_increment,
    trial_id: Int references(trial.id),
    kind: String,
    depth: Float default("0.0"),
    details: String default(""),
    created_at: String default(now())
  }

  table context {
    id: Int primary_key auto_increment,
    trial_id: Int references(trial.id),
    moon_phase: String default(""),
    weather: String default(""),
    sound_mode: String default(""),
    sleep_quality: Float default("0.0"),
    logged_at: String default(now())
  }

  table candidate {
    id: Int primary_key auto_increment,
    name: String,
    kind: String default("non_periodic"),
    status: String default("candidate"),
    stat_value: Float default("0.0"),
    threshold: Float default("0.0"),
    tested_at: String default(""),
    note: String default("")
  }

  table practice_session {
    id: Int primary_key auto_increment,
    kind: String default("pacer"),
    arm_id: Int references(arm.id),
    trial_id: Int references(trial.id),
    tempo_bpm: Float default("0.0"),
    steps_total: Int default("0"),
    steps_done: Int default("0"),
    step_marks: String default(""),
    rr_json: String default(""),
    rr_source: String default(""),
    session_date: String default(""),
    created_at: String default(now())
  }
}

// ── APP-MIRROR-START: miniapp-core (byte-identical to
//    src/miniapp/miniapp.mlog §miniapp-core) ────────────────────────────

// Mini App core (Н2-03): the token guard, the page literal and the
// practice-session writers. The page is served from the TRUSTED
// literal: read_file output carries 'public, untrusted' and the №391
// sink clearance refuses respond(read_file(...)) (probe n203-serve-1),
// so self-host/miniapp/index.html is the byte-pinned canon and this
// literal is its serving copy; the lockstep test in the miniapp module
// pins the byte equality.

// The token guard — PURE function (the test lane has no env gate): the
// route passes the allowlisted stored value and the SANITIZED provided
// one (the escape_html bridge over query_param — the repo's
// sanitize-then-decide convention; the deploy token charset is
// alphanumeric, so the bridge is exact). Fail-closed: an unconfigured
// token (empty stored value) denies everything.
pattern miniapp_check_token(stored: String, provided: String) -> Bool {
  if stored == "" {
    return false
  }
  return provided == stored
}

// The page literal — byte-pinned to self-host/miniapp/index.html (see
// the miniapp module tests). No external origin anywhere in the markup
// (invariant 7): inline CSS/JS only, same-origin fetches only.
pattern miniapp_html() -> String {
  return "<!doctype html>\n<html lang=\"ru\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Камертон — практики</title>\n<style>\n  :root { --bg:#0f1115; --fg:#e8e6e3; --dim:#9a9a93; --accent:#e8862c; --ok:#4f9d69; --err:#c94f4f; }\n  * { box-sizing: border-box; margin: 0; }\n  body { background: var(--bg); color: var(--fg); font: 16px/1.5 system-ui, sans-serif; max-width: 480px; margin: 0 auto; padding: 16px; }\n  h1 { font-size: 20px; margin-bottom: 12px; }\n  nav { display: flex; gap: 8px; margin-bottom: 16px; }\n  nav button { flex: 1; padding: 10px; background: #1a1d24; color: var(--fg); border: 1px solid #2a2e37; border-radius: 8px; font-size: 15px; }\n  nav button.on { border-color: var(--accent); color: var(--accent); }\n  .screen { display: none; }\n  .screen.on { display: block; }\n  .card { background: #161920; border: 1px solid #2a2e37; border-radius: 12px; padding: 16px; margin-bottom: 12px; }\n  .circle { width: 160px; height: 160px; border-radius: 50%; background: radial-gradient(circle at 35% 35%, #3a4152, #22262f); margin: 24px auto; }\n  .lbl { color: var(--dim); font-size: 13px; }\n  .row { display: flex; gap: 8px; margin-top: 8px; flex-wrap: wrap; }\n  button.act { padding: 10px 14px; border: 0; border-radius: 8px; background: var(--accent); color: #14100b; font-size: 15px; }\n  button.act.sec { background: #2a2e37; color: var(--fg); }\n  #status { font-size: 13px; color: var(--dim); min-height: 20px; margin-top: 8px; white-space: pre-wrap; }\n  .ok { color: var(--ok); } .err { color: var(--err); }\n</style>\n</head>\n<body>\n<h1>Камертон</h1>\n<nav>\n  <button id=\"tab-pacer\" class=\"on\" onclick=\"show('pacer')\">Пейсер</button>\n  <button id=\"tab-ppg\" onclick=\"show('ppg')\">Пульс</button>\n</nav>\n\n<section id=\"screen-pacer\" class=\"screen on\">\n  <div class=\"card\">\n    <div class=\"circle\" id=\"pacer-circle\"></div>\n    <p class=\"lbl\" id=\"pacer-phase\">&nbsp;</p>\n    <p class=\"lbl\">Темп: <b id=\"pacer-tempo\">5.5</b> вдохов/мин (диапазон 4.5–7.0, шаг 0.25)</p>\n    <div class=\"row\">\n      <button class=\"act sec\" onclick=\"tempoDown()\">−</button>\n      <button class=\"act sec\" onclick=\"tempoUp()\">+</button>\n      <button class=\"act\" id=\"pacer-step-btn\" onclick=\"startStep()\">Старт шага (2 мин)</button>\n    </div>\n    <p class=\"lbl\" id=\"pacer-timer\">&nbsp;</p>\n    <p class=\"lbl\"><label><input type=\"checkbox\" id=\"ppg-during-step\"> писать пульс во время шагов — RR-сегмент на каждый темп (Н2-06)</label></p>\n  </div>\n  <div class=\"card\">\n    <p class=\"lbl\">Журнал сессии (таблица practice_session, SQLite)</p>\n    <div class=\"row\">\n      <button class=\"act\" onclick=\"openSession('pacer')\">Начать сессию</button>\n      <button class=\"act\" onclick=\"openSession('sweep')\">Начать протокол перебора</button>\n      <button class=\"act sec\" onclick=\"closeSession()\">Завершить</button>\n    </div>\n    <p id=\"pacer-marks\" class=\"lbl\"></p>\n  </div>\n</section>\n\n<section id=\"screen-ppg\" class=\"screen\">\n  <div class=\"card\">\n    <video id=\"ppg-video\" playsinline muted autoplay style=\"width:120px;height:120px;border-radius:50%;object-fit:cover;background:#22262f;display:block;margin:0 auto;\"></video>\n    <p class=\"lbl\" id=\"ppg-hint\">Палец на объектив камеры (или лицо в кадр). Кадры обрабатываются на устройстве и никуда не сохраняются — инвариант 7.</p>\n    <p class=\"lbl\" id=\"ppg-timer\">&nbsp;</p>\n    <div class=\"row\">\n      <button class=\"act\" id=\"ppg-start-btn\" onclick=\"ppgStart()\">Старт записи</button>\n      <button class=\"act sec\" id=\"ppg-stop-btn\" onclick=\"ppgStop()\" disabled>Стоп</button>\n      <button class=\"act sec\" id=\"ppg-save-btn\" onclick=\"ppgSave()\" disabled>Сохранить RR в сессию</button>\n    </div>\n    <p class=\"lbl\" id=\"ppg-summary\">&nbsp;</p>\n  </div>\n</section>\n\n<p id=\"status\"></p>\n\n<script>\n\"use strict\";\n// Канал ADR-0002 (вариант «а», приватный туннель): страница отдаётся\n// маршрутом /miniapp программы Камертона; токен владельца передаётся в\n// каждом запросе (параметр t из адреса страницы). Наружу страница не\n// ходит: вся работа против того же origin, внешних ресурсов нет —\n// инвариант 7 (данные не покидают машину владельца).\nvar TOKEN = new URLSearchParams(location.search).get(\"t\") || \"\";\nvar sessionId = 0;\nvar marks = [];\n\nfunction show(name) {\n  var names = [\"pacer\", \"ppg\"];\n  for (var i = 0; i < names.length; i++) {\n    document.getElementById(\"screen-\" + names[i]).className = names[i] === name ? \"screen on\" : \"screen\";\n    document.getElementById(\"tab-\" + names[i]).className = names[i] === name ? \"on\" : \"\";\n  }\n}\n\nfunction status(msg, cls) {\n  var el = document.getElementById(\"status\");\n  el.textContent = msg;\n  el.className = cls || \"\";\n}\n\nfunction api(path, params) {\n  var q = new URLSearchParams(params || {});\n  q.set(\"t\", TOKEN);\n  return fetch(path + \"?\" + q.toString(), {\n    method: \"POST\",\n    headers: { \"X-CSRF-Token\": csrfToken() }\n  })\n    .then(function (r) {\n      return r.text().then(function (body) { return { code: r.status, body: body }; });\n    });\n}\n\n// CSRF-мидлварь сервера (double-submit): GET страницы выдаёт куку\n// _mlog_csrf, каждый POST обязан нести её значение в X-CSRF-Token.\n// TTL токена — 15 минут; истёкший/чужой токен отвечает 403 с «CSRF»\n// в теле — перезагружаем страницу (GET перевыпустит куку). Отметки\n// шагов пишутся инкрементально, поэтому перезагрузка теряет максимум\n// текущий неотмеченный шаг.\nfunction csrfToken() {\n  var m = document.cookie.match(/(?:^|;\\s*)_mlog_csrf=([^;]+)/);\n  return m ? m[1] : \"\";\n}\n\nfunction openSession(kind) {\n  api(\"/miniapp/session\", { kind: kind, tempo_bpm: String(tempo), steps_total: String(STEPS_TOTAL), arm_id: \"0\", trial_id: \"0\" })\n    .then(function (res) {\n      if (res.code === 403 && res.body.indexOf(\"CSRF\") >= 0) { location.reload(); return; }\n      if (res.code !== 200) { status(\"Отказ сервера: \" + res.code + \" \" + res.body, \"err\"); return; }\n      var d = JSON.parse(res.body);\n      sessionId = d.id;\n      marks = [];\n      document.getElementById(\"pacer-marks\").textContent = \"Сессия №\" + sessionId + \", шагов: 0\";\n      status(\"Сессия \" + sessionId + \" открыта: протокол \" + STEPS_TOTAL + \" шагов по 2 минуты\", \"ok\");\n    })\n    .catch(function (e) { status(\"Ошибка сети: \" + e, \"err\"); });\n}\n\n// ── Пейсер (Н2-04) ──────────────────────────────────────────────────────\n// Протокол концепции: перебор темпов 4.5–7.0 вдох/мин с шагом 0.25,\n// по две минуты на темп; отметка завершения шага пишется в сессию\n// инкрементально (писцы Н2-03). Чистая математика фазы вынесена в\n// pacerState — её пиннет скрипт-проверка против эталонной раскадки\n// (self-host/miniapp/test/pacer-test.mjs).\n// PacerEngine-START (маркер скрипт-проверки: источник математики)\nvar TEMPO_MIN = 4.5;\nvar TEMPO_MAX = 7.0;\nvar TEMPO_STEP = 0.25;\nvar STEP_MS = 120000;   // две минуты на темп — протокол концепции\nvar STEPS_TOTAL = 11;   // (7.0 − 4.5) / 0.25 + 1\n\n// Плавная синусоида: равные половины вдоха/выдоха, масштаб 0.10–1.00,\n// старт из середины (0.55) на вдохе. Никакого накопления дрейфа: фаза\n// всегда считается от времени старта шага, а не приращением.\nfunction pacerState(tempoBpm, tMs) {\n  var periodMs = 60000 / tempoBpm;\n  var phase = (tMs % periodMs) / periodMs;\n  var s = Math.sin(2 * Math.PI * phase);\n  return {\n    periodMs: periodMs,\n    phase: phase,\n    dir: phase < 0.5 ? \"вдох\" : \"выдох\",\n    scale: 0.55 + 0.45 * s\n  };\n}\n// PacerEngine-END\n\nvar tempo = 5.5;\nvar stepRunning = false;\nvar stepStart = 0;\nvar stepNo = 0;\nvar rafId = 0;\n\nfunction tempoUp() {\n  tempo = Math.min(TEMPO_MAX, Math.round((tempo + TEMPO_STEP) * 100) / 100);\n  document.getElementById(\"pacer-tempo\").textContent = tempo.toFixed(2);\n}\n\nfunction tempoDown() {\n  tempo = Math.max(TEMPO_MIN, Math.round((tempo - TEMPO_STEP) * 100) / 100);\n  document.getElementById(\"pacer-tempo\").textContent = tempo.toFixed(2);\n}\n\nfunction startStep() {\n  if (stepRunning) { return; }\n  if (!sessionId) { status(\"Сначала начните сессию\", \"err\"); return; }\n  var wantPpg = document.getElementById(\"ppg-during-step\").checked;\n  if (wantPpg && ppgSampling) { status(\"Сначала остановите запись на вкладке «Пульс»\", \"err\"); return; }\n  stepRunning = true;\n  stepNo = marks.length + 1;\n  stepStart = performance.now();\n  document.getElementById(\"pacer-step-btn\").disabled = true;\n  if (wantPpg) { sweepStepStart(); }\n  paceFrame();\n}\n\nfunction paceFrame() {\n  var t = performance.now() - stepStart;\n  if (t >= STEP_MS) {\n    finishStep();\n    return;\n  }\n  var st = pacerState(tempo, t);\n  document.getElementById(\"pacer-circle\").style.transform = \"scale(\" + st.scale.toFixed(4) + \")\";\n  document.getElementById(\"pacer-phase\").textContent = st.dir;\n  var left = Math.ceil((STEP_MS - t) / 1000);\n  document.getElementById(\"pacer-timer\").textContent = \"Шаг \" + stepNo + \" · осталось \" + left + \" с\";\n  rafId = requestAnimationFrame(paceFrame);\n}\n\nfunction finishStep() {\n  stepRunning = false;\n  cancelAnimationFrame(rafId);\n  document.getElementById(\"pacer-circle\").style.transform = \"scale(0.55)\";\n  document.getElementById(\"pacer-phase\").textContent = \"\\u00a0\";\n  document.getElementById(\"pacer-timer\").textContent = \"\\u00a0\";\n  document.getElementById(\"pacer-step-btn\").disabled = false;\n  var rec = stepMark();\n  api(\"/miniapp/session/close\", {\n    id: String(sessionId),\n    steps_done: String(marks.length + 1),\n    step_marks: JSON.stringify(marks.concat([rec])),\n    rr_json: \"\",\n    rr_source: \"\"\n  })\n    .then(function (res) {\n      if (res.code === 403 && res.body.indexOf(\"CSRF\") >= 0) { location.reload(); return; }\n      if (res.code !== 200) { status(\"Отказ сервера: \" + res.code + \" \" + res.body, \"err\"); return; }\n      marks.push(rec);\n      document.getElementById(\"pacer-marks\").textContent = \"Сессия №\" + sessionId + \", шагов: \" + marks.length + \" · последний темп \" + tempo.toFixed(2);\n      if (rec.rr_reason !== \"\") {\n        status(\"Шаг \" + stepNo + \" (темп \" + tempo.toFixed(2) + \") записан, но пульс забракован: \" + rec.rr_reason, \"err\");\n      } else if (rec.rr.length) {\n        status(\"Шаг \" + stepNo + \" (темп \" + tempo.toFixed(2) + \") записан с RR (\" + rec.rr.length + \" интервалов) — смените темп и повторите\", \"ok\");\n      } else {\n        status(\"Шаг \" + stepNo + \" (темп \" + tempo.toFixed(2) + \") записан — смените темп и повторите\", \"ok\");\n      }\n    })\n    .catch(function (e) { status(\"Ошибка сети: \" + e, \"err\"); });\n}\n\nfunction closeSession() {\n  if (!sessionId) { status(\"Сессия не открыта\", \"err\"); return; }\n  api(\"/miniapp/session/close\", {\n    id: String(sessionId),\n    steps_done: String(marks.length),\n    step_marks: JSON.stringify(marks),\n    rr_json: rrBuffer.length ? JSON.stringify(rrBuffer) : \"\",\n    rr_source: rrBuffer.length ? \"ppg\" : \"\",\n    final: \"1\"\n  })\n    .then(function (res) {\n      if (res.code === 403 && res.body.indexOf(\"CSRF\") >= 0) { location.reload(); return; }\n      if (res.code !== 200) { status(\"Отказ сервера: \" + res.code + \" \" + res.body, \"err\"); return; }\n      var d = JSON.parse(res.body);\n      if (d.sweep && d.sweep.ok) {\n        var v = \"\";\n        if (d.sweep.verdict === \"reproducible\") { v = \" · повтор: воспроизведён\"; }\n        if (d.sweep.verdict === \"divergent\") { v = \" · повтор: РАСХОЖДЕНИЕ\"; }\n        status(\"Протокол принят: резонанс \" + d.sweep.resonance_bpm + \" вдох/мин, доля мощности \" + Math.round(d.sweep.share * 100) + \"%\" + v + \" — зафиксировано в sweep_result\", \"ok\");\n      } else if (d.sweep) {\n        status(\"Протокол не принят: \" + d.sweep.reason, \"err\");\n      } else {\n        status(\"Сессия \" + sessionId + \" закрыта: шагов \" + marks.length + (rrBuffer.length ? \", RR \" + rrBuffer.length : \"\"), \"ok\");\n      }\n      sessionId = 0; marks = []; rrBuffer = []; stepSamples = [];\n      sweepStopCam();\n      document.getElementById(\"pacer-marks\").textContent = \"\";\n    })\n    .catch(function (e) { status(\"Ошибка сети: \" + e, \"err\"); });\n}\n\n// ── PPG через камеру → RR-интервалы (Н2-05) ─────────────────────────────\n// Инвариант 7: кадры живут только в canvas на устройстве; наружу уходит\n// ТОЛЬКО итоговый RR-ряд с метками качества, по явному действию\n// владельца. Сырые кадры не сохраняются нигде — их некуда сохранять:\n// страница не имеет хранилища, кроме сессионного журнала RR.\n// PpgEngine-START (маркер скрипт-проверки: источник математики)\n// Дискретизация сигнала: {t: мс, v: 0..255 — средний зелёный канал\n// центральной области кадра}. Пайплайн: скользящая база (окно 1.5 с) →\n// AC-составляющая → эпохи по 10 с → пики (локальные максимумы выше\n// порога 0.6 амплитуды эпохи с рефрактерным окном 300 мс = верхний\n// предел 200 уд/мин) → RR = межпиковые интервалы.\n// Контроль качества эпохи: пиков ≥ 5; RR эпохи в [300, 2000] мс\n// (30–200 уд/мин); CV = std/mean ≤ 0.25; амплитуда ≥ 6× шумовой пол\n// (шум — медиана |Δv| соседних отсчётов). Отбракованные эпохи\n// считаются; итоговый отказ громкий: эпох < 2, брак > 50% или RR < 8.\nvar PPG_EPOCH_MS = 10000;\nvar PPG_BASELINE_MS = 1500;\nvar PPG_REFRACTORY_MS = 300;\nvar PPG_RR_MIN = 300;\nvar PPG_RR_MAX = 2000;\nvar PPG_CV_MAX = 0.25;\nvar PPG_AMPL_NOISE_X = 6.0;\n\nfunction ppgExtractRR(samples) {\n  var n = samples.length;\n  if (n < 2) {\n    return { rr: [], epochsTotal: 0, epochsRejected: 0, reason: \"слишком мало отсчётов\" };\n  }\n  // Скользящая база: среднее по отсчётам в окне ±PPG_BASELINE_MS/2.\n  var half = PPG_BASELINE_MS / 2;\n  var ac = new Array(n);\n  var j0 = 0, j1 = 0, sum = 0, cnt = 0;\n  for (var i = 0; i < n; i++) {\n    while (j1 < n && samples[j1].t <= samples[i].t + half) { sum += samples[j1].v; cnt++; j1++; }\n    while (j0 < n && samples[j0].t < samples[i].t - half) { sum -= samples[j0].v; cnt--; j0++; }\n    ac[i] = { t: samples[i].t, v: samples[i].v - sum / cnt };\n  }\n  // Шумовой пол: медиана |Δv| соседних отсчётов.\n  var diffs = [];\n  for (var i = 1; i < n; i++) { diffs.push(Math.abs(ac[i].v - ac[i - 1].v)); }\n  diffs.sort(function (a, b) { return a - b; });\n  var noise = diffs[Math.floor(diffs.length / 2)] || 0.001;\n  // Эпохи по времени.\n  var t0 = samples[0].t, tEnd = samples[n - 1].t;\n  var epochs = [];\n  for (var e = t0; e < tEnd; e += PPG_EPOCH_MS) { epochs.push({ from: e, to: e + PPG_EPOCH_MS }); }\n  var rr = [];\n  var rejected = 0;\n  for (var k = 0; k < epochs.length; k++) {\n    var ep = epochs[k];\n    var idx = [];\n    for (var i = 0; i < n; i++) { if (ac[i].t >= ep.from && ac[i].t < ep.to) { idx.push(i); } }\n    if (idx.length < 10) { rejected++; continue; }\n    var lo = Infinity, hi = -Infinity;\n    for (var i = 0; i < idx.length; i++) {\n      var v = ac[idx[i]].v;\n      if (v < lo) lo = v;\n      if (v > hi) hi = v;\n    }\n    var ampl = hi - lo;\n    if (ampl < PPG_AMPL_NOISE_X * noise) { rejected++; continue; }\n    var thr = lo + 0.6 * ampl;\n    var peaks = [];\n    var lastPeakT = -Infinity;\n    for (var i = 1; i < idx.length - 1; i++) {\n      var t = ac[idx[i]].t, v = ac[idx[i]].v;\n      if (v > thr && v >= ac[idx[i - 1]].v && v >= ac[idx[i + 1]].v && t - lastPeakT >= PPG_REFRACTORY_MS) {\n        peaks.push(t); lastPeakT = t;\n      }\n    }\n    if (peaks.length < 5) { rejected++; continue; }\n    var okEpoch = true;\n    var epRR = [];\n    for (var i = 1; i < peaks.length; i++) {\n      var d = peaks[i] - peaks[i - 1];\n      if (d < PPG_RR_MIN || d > PPG_RR_MAX) { okEpoch = false; break; }\n      epRR.push(d);\n    }\n    if (!okEpoch) { rejected++; continue; }\n    var mean = epRR.reduce(function (a, b) { return a + b; }, 0) / epRR.length;\n    var vari = epRR.reduce(function (a, b) { return a + (b - mean) * (b - mean); }, 0) / epRR.length;\n    var cv = Math.sqrt(vari) / mean;\n    if (cv > PPG_CV_MAX) { rejected++; continue; }\n    for (var i = 0; i < epRR.length; i++) { rr.push(epRR[i]); }\n  }\n  var epochsTotal = epochs.length;\n  return { rr: rr, epochsTotal: epochsTotal, epochsRejected: rejected, reason: \"\" };\n}\n\n// Громкий отказ сборки RR: возвращает строку отказа или пустую строку.\nfunction ppgQualityRefusal(ex) {\n  if (ex.epochsTotal < 2) { return \"брак: запись короче двух эпох (\" + ex.epochsTotal + \")\"; }\n  var share = ex.epochsRejected / ex.epochsTotal;\n  if (share > 0.5) { return \"брак: отбраковано эпох \" + ex.epochsRejected + \" из \" + ex.epochsTotal + \" — сигнала пульса нет\"; }\n  if (ex.rr.length < 8) { return \"брак: восстановлено RR \" + ex.rr.length + \" (< 8)\"; }\n  return \"\";\n}\n// PpgEngine-END\n\n// ── Протокол перебора (Н2-06) ───────────────────────────────────────────\n// SweepEngine-START (маркер скрипт-проверки: сборка RR-сегментов)\n// Каждому шагу пейсера — свой RR-сегмент: камера пишет пульс на протяжении\n// шага (инвариант 7: кадры умирают в canvas, наружу идёт только итоговый\n// RR), на финише сегмент проходит QC движка Н2-05 и попадает в отметку\n// {step, tempo_bpm, rr, rr_reason}. Сервер считает спектры билтинами\n// Ломба–Скаргла (№591), фиксирует резонанс в sweep_result и kv; анализ\n// запускается только финальным закрытием сессии (final=1).\nvar stepSamples = [];\nvar stepPpgOn = false;   // семплирование текущего шага идёт\n\nfunction sweepStepStart() {\n  ppgStart_ = performance.now();\n  stepSamples = [];\n  if (ppgStream) { stepPpgOn = true; stepSampleFrame(); return; }\n  if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {\n    status(\"Камера недоступна: нужен защищённый контекст (https) — шаг пойдёт без пульса\", \"err\");\n    return;\n  }\n  navigator.mediaDevices.getUserMedia({ video: { facingMode: \"user\", width: 320, height: 240 }, audio: false })\n    .then(function (stream) {\n      ppgStream = stream;\n      var video = document.getElementById(\"ppg-video\");\n      video.srcObject = stream;\n      video.play();\n      stepPpgOn = true;\n      stepSampleFrame();\n    })\n    .catch(function (e) { status(\"Камера отказала громко: \" + e.name + \" — шаг пойдёт без пульса\", \"err\"); });\n}\n\nfunction stepSampleFrame() {\n  if (!stepPpgOn) { return; }\n  var video = document.getElementById(\"ppg-video\");\n  if (video.videoWidth > 0) {\n    ppgCtx.drawImage(video, 8, 8, 16, 16, 0, 0, 8, 8);\n    var d = ppgCtx.getImageData(0, 0, 8, 8).data;\n    var sum = 0;\n    for (var i = 0; i < d.length; i += 4) { sum += d[i + 1]; }\n    stepSamples.push({ t: performance.now() - ppgStart_, v: sum / (d.length / 4) });\n  }\n  requestAnimationFrame(stepSampleFrame);\n}\n\nfunction stepMark() {\n  // Отметка шага: RR-сегмент (если пульс писался) едет в отметке; брак\n  // едет громко в rr_reason — протокол продолжается, сервер считает\n  // шаг негодным. Поле rr присутствует ВСЕГДА — сервер отличает отметку\n  // Н2-06 от старого формата по наличию ключа.\n  var rec = { step: stepNo, tempo_bpm: tempo, rr: [], rr_reason: \"\" };\n  if (stepPpgOn) {\n    stepPpgOn = false;\n    var ex = ppgExtractRR(stepSamples);\n    var refusal = ppgQualityRefusal(ex);\n    if (refusal !== \"\") { rec.rr_reason = refusal; }\n    else { rec.rr = ex.rr; }\n    stepSamples = [];\n  }\n  return rec;\n}\n\nfunction sweepStopCam() {\n  // Камера протокола гасится вместе с сессией; если вкладка «Пульс»\n  // сейчас ведёт свою запись — её стрим не трогаем.\n  if (ppgStream && !ppgSampling) {\n    var tracks = ppgStream.getTracks();\n    for (var i = 0; i < tracks.length; i++) { tracks[i].stop(); }\n    ppgStream = null;\n  }\n}\n// SweepEngine-END\n\nvar rrBuffer = [];\nvar ppgStream = null;\nvar ppgSampling = false;\nvar ppgStart_ = 0;\nvar ppgCanvas = document.createElement(\"canvas\");\nppgCanvas.width = 32; ppgCanvas.height = 32;\nvar ppgCtx = ppgCanvas.getContext(\"2d\", { willReadFrequently: true });\nvar ppgSamples = [];\n\nfunction ppgStart() {\n  if (ppgSampling) { return; }\n  if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {\n    status(\"Камера недоступна: нужен защищённый контекст (https) — канал ADR-0002 (а) его даёт, http-закладка нет\", \"err\");\n    return;\n  }\n  navigator.mediaDevices.getUserMedia({ video: { facingMode: \"user\", width: 320, height: 240 }, audio: false })\n    .then(function (stream) {\n      ppgStream = stream;\n      var video = document.getElementById(\"ppg-video\");\n      video.srcObject = stream;\n      video.play();\n      ppgSamples = [];\n      rrBuffer = [];\n      ppgSampling = true;\n      ppgStart_ = performance.now();\n      document.getElementById(\"ppg-start-btn\").disabled = true;\n      document.getElementById(\"ppg-stop-btn\").disabled = false;\n      document.getElementById(\"ppg-save-btn\").disabled = true;\n      document.getElementById(\"ppg-summary\").textContent = \"\";\n      ppgSampleFrame();\n    })\n    .catch(function (e) { status(\"Камера отказала громко: \" + e.name, \"err\"); });\n}\n\nfunction ppgSampleFrame() {\n  if (!ppgSampling) { return; }\n  var video = document.getElementById(\"ppg-video\");\n  if (video.videoWidth > 0) {\n    // Центральная область кадра — средний зелёный канал (самый\n    // пульсативный). Кадр умирает в canvas: ни копий, ни передачи.\n    ppgCtx.drawImage(video, 8, 8, 16, 16, 0, 0, 8, 8);\n    var d = ppgCtx.getImageData(0, 0, 8, 8).data;\n    var sum = 0;\n    for (var i = 0; i < d.length; i += 4) { sum += d[i + 1]; }\n    ppgSamples.push({ t: performance.now() - ppgStart_, v: sum / (d.length / 4) });\n  }\n  var el = Math.round((performance.now() - ppgStart_) / 1000);\n  document.getElementById(\"ppg-timer\").textContent = \"Запись: \" + el + \" с (отсчётов \" + ppgSamples.length + \")\";\n  requestAnimationFrame(ppgSampleFrame);\n}\n\nfunction ppgStop() {\n  if (!ppgSampling) { return; }\n  ppgSampling = false;\n  if (ppgStream) {\n    var tracks = ppgStream.getTracks();\n    for (var i = 0; i < tracks.length; i++) { tracks[i].stop(); }\n    ppgStream = null;\n  }\n  document.getElementById(\"ppg-start-btn\").disabled = false;\n  document.getElementById(\"ppg-stop-btn\").disabled = true;\n  var ex = ppgExtractRR(ppgSamples);\n  var refusal = ppgQualityRefusal(ex);\n  if (refusal !== \"\") {\n    status(refusal + \" — запись НЕ сохранена, повторите с хорошим сигналом\", \"err\");\n    document.getElementById(\"ppg-summary\").textContent = \"Эпох: \" + ex.epochsTotal + \", отбраковано: \" + ex.epochsRejected;\n    return;\n  }\n  rrBuffer = ex.rr;\n  var mean = ex.rr.reduce(function (a, b) { return a + b; }, 0) / ex.rr.length;\n  document.getElementById(\"ppg-save-btn\").disabled = false;\n  document.getElementById(\"ppg-summary\").textContent =\n    \"RR: \" + ex.rr.length + \" · средний \" + Math.round(mean) + \" мс (\" + Math.round(60000 / mean) + \" уд/мин) · эпохи: \" +\n    (ex.epochsTotal - ex.epochsRejected) + \"/\" + ex.epochsTotal + \" годных\";\n  status(\"Сигнал годен — сохраните в сессию или перепишите\", \"ok\");\n}\n\nfunction ppgSave() {\n  if (!sessionId) { status(\"Сначала начните сессию (это отдельная сессия PPG)\", \"err\"); return; }\n  if (!rrBuffer.length) { status(\"RR-ряда нет — сначала запишите сигнал\", \"err\"); return; }\n  api(\"/miniapp/session/close\", {\n    id: String(sessionId),\n    steps_done: String(marks.length),\n    step_marks: JSON.stringify(marks),\n    rr_json: JSON.stringify(rrBuffer),\n    rr_source: \"ppg\"\n  })\n    .then(function (res) {\n      if (res.code === 403 && res.body.indexOf(\"CSRF\") >= 0) { location.reload(); return; }\n      if (res.code !== 200) { status(\"Отказ сервера: \" + res.code + \" \" + res.body, \"err\"); return; }\n      status(\"RR-ряд (\" + rrBuffer.length + \" интервалов) записан в сессию \" + sessionId, \"ok\");\n    })\n    .catch(function (e) { status(\"Ошибка сети: \" + e, \"err\"); });\n}\n</script>\n</body>\n</html>\n"
}

// Open a practice session (the Н2-03 skeleton writer; the Н2-04/Н2-05
// screens are its clients). BOUNDARY pattern (the process_updates
// precedent of Н1-06): the route validates shapes loudly (whitelists,
// numeric guards over the escape bridge) and passes the values; inside
// the annotated parameters the data is sanctioned and the writers run.
// arm_id/trial_id below 1 mean "no linkage" and land as SQL NULL (the
// CASE form keeps ONE parameterized statement; 0 is never stored, so
// the FK clauses stay truthful under the enforced-references replay).
// Returns the new row id.
pattern miniapp_session_open(kind: String<public, trusted>, tempo_bpm: Float, steps_total: Float,
                             session_date: String<public, trusted>, arm_id: Float, trial_id: Float) -> Float {
  let _ = db_execute("INSERT INTO practice_session (kind, tempo_bpm, steps_total, session_date, arm_id, trial_id) VALUES (?, ?, ?, ?, CASE WHEN ? > 0 THEN ? END, CASE WHEN ? > 0 THEN ? END)", [kind, tempo_bpm, steps_total, session_date, arm_id, arm_id, trial_id, trial_id])
  let rows = query("SELECT last_insert_rowid() AS id", [])
  return rows[0].id
}

// Close/update a session: the completed-step count, the per-step marks
// and (from Н2-05) the RR series. BOUNDARY pattern: the raw JSON
// strings arrive trusted-by-annotation (the route capped their size
// and the parameterized UPDATE carries them verbatim — SQL-injection
// impossible); the JSON shape is validated by parse_json at every
// READ (garbage never decodes silently). Returns the number of
// updated rows (0 = unknown id — the route answers 404 loudly).
pattern miniapp_session_close(sid: Float, steps_done: Float, step_marks: String<public, trusted>,
                              rr_json: String<public, trusted>, rr_source: String<public, trusted>) -> Float {
  let _ = db_execute("UPDATE practice_session SET steps_done = ?, step_marks = ?, rr_json = ?, rr_source = ? WHERE id = ?", [steps_done, step_marks, rr_json, rr_source, sid])
  let rows = query("SELECT changes() AS n", [])
  return rows[0].n
}

// Read one session back (the module tests + the read path of
// Н2-06/Н2-07; a third-party sqlite3 client reads the same rows —
// invariant 6).
pattern miniapp_session_get(sid: Float) -> List {
  return query("SELECT id, kind, arm_id, trial_id, tempo_bpm, steps_total, steps_done, step_marks, rr_json, rr_source, session_date FROM practice_session WHERE id = ?", [sid])
}
// ── APP-MIRROR-END: miniapp-core ─────────────────────────────────────────


// ── Tests ───────────────────────────────────────────────────────────────
// No loops in test bodies (the house discipline since the D2 family);
// every mutation path is exercised through the same public patterns the
// routes call.

test "the page literal is byte-pinned to self-host/miniapp/index.html" {
  assert_eq(miniapp_html(), read_file("self-host/miniapp/index.html"))
}

test "the page carries the two screen carcasses, the session API and no external origin" {
  let h = miniapp_html()
  assert_contains(h, "screen-pacer")
  assert_contains(h, "screen-ppg")
  assert_contains(h, "/miniapp/session")
  assert_contains(h, "viewport")
  // invariant 7: the page never phones home — no external origin in the
  // markup (inline CSS/JS only, same-origin fetches only)
  // contains() on 0.30.0 returns Bool (the REFERENCE row says Float —
  // the doc drift is declared in the naryad worklog)
  assert_eq(contains(h, "http://"), false)
  assert_eq(contains(h, "https://"), false)
}

test "the token guard fails closed on an unconfigured token" {
  assert_eq(miniapp_check_token("", "anything"), false)
  assert_eq(miniapp_check_token("", ""), false)
}

test "the token guard admits exactly the stored token" {
  assert_eq(miniapp_check_token("s3cret", "s3cret"), true)
  assert_eq(miniapp_check_token("s3cret", "wrong"), false)
  assert_eq(miniapp_check_token("s3cret", ""), false)
}

test "practice session open/close roundtrip reads back through sqlite" {
  // A linkage-free session: arm_id/trial_id land as SQL NULL (the CASE
  // form), and the NULL reads back as Unit on 0.30.0 (the Н2-01 probe
  // behavior — pinned here on the practice_session path too).
  let sid = miniapp_session_open("pacer", 5.5, 6.0, "2026-10-09", 0.0, 0.0)
  let rows = miniapp_session_get(sid)
  assert_eq(rows[0].kind, "pacer")
  assert_eq(rows[0].tempo_bpm, 5.5)
  assert_eq(rows[0].steps_total, 6.0)
  assert_eq(rows[0].session_date, "2026-10-09")
  assert_eq(type_of(rows[0].arm_id), "Unit")
  assert_eq(type_of(rows[0].trial_id), "Unit")
  // A linked session: real FK parents first (the enforced-references
  // replay of №611 refuses dangling linkages loudly).
  let _ = db_execute("INSERT INTO arm (name, group_name, day_window) VALUES ('miniapp-test-arm', 'test', 'morning')", [])
  let aid_rows = query("SELECT last_insert_rowid() AS id", [])
  let aid = aid_rows[0].id
  let _ = db_execute("INSERT INTO trial (trial_date, day_window, arm_id) VALUES ('2026-10-09', 'morning', ?)", [aid])
  let tid_rows = query("SELECT last_insert_rowid() AS id", [])
  let tid = tid_rows[0].id
  let sid2 = miniapp_session_open("ppg", 0.0, 0.0, "2026-10-09", aid, tid)
  let rows2 = miniapp_session_get(sid2)
  assert_eq(rows2[0].arm_id, aid)
  assert_eq(rows2[0].trial_id, tid)
  // Close: the marks land, the rowcount is exactly 1.
  let n = miniapp_session_close(sid, 3.0, "[{\"step\":1},{\"step\":2},{\"step\":3}]", "", "")
  assert_eq(n, 1.0)
  let rows3 = miniapp_session_get(sid)
  assert_eq(rows3[0].steps_done, 3.0)
  assert_contains(rows3[0].step_marks, "\"step\":2")
  // Closing an unknown id updates nothing (the route answers 404 on 0).
  let n0 = miniapp_session_close(999999.0, 0.0, "[]", "", "")
  assert_eq(n0, 0.0)
}

test "the practice_session DDL literal is idempotent (replay twice)" {
  let _ = db_execute("CREATE TABLE IF NOT EXISTS practice_session (id INTEGER PRIMARY KEY AUTOINCREMENT, kind TEXT DEFAULT 'pacer', arm_id INTEGER REFERENCES arm(id), trial_id INTEGER REFERENCES trial(id), tempo_bpm REAL DEFAULT '0.0', steps_total INTEGER DEFAULT '0', steps_done INTEGER DEFAULT '0', step_marks TEXT DEFAULT '', rr_json TEXT DEFAULT '', rr_source TEXT DEFAULT '', session_date TEXT DEFAULT '', created_at TEXT DEFAULT (datetime('now')))", [])
  let _ = db_execute("CREATE TABLE IF NOT EXISTS practice_session (id INTEGER PRIMARY KEY AUTOINCREMENT, kind TEXT DEFAULT 'pacer', arm_id INTEGER REFERENCES arm(id), trial_id INTEGER REFERENCES trial(id), tempo_bpm REAL DEFAULT '0.0', steps_total INTEGER DEFAULT '0', steps_done INTEGER DEFAULT '0', step_marks TEXT DEFAULT '', rr_json TEXT DEFAULT '', rr_source TEXT DEFAULT '', session_date TEXT DEFAULT '', created_at TEXT DEFAULT (datetime('now')))", [])
  let rows = query("SELECT count(*) AS n FROM sqlite_master WHERE type = 'table' AND name = 'practice_session'", [])
  assert_eq(rows[0].n, 1.0)
}
