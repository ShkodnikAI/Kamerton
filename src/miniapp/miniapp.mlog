// Kamerton mini-app core (naryad Н2-03): src/miniapp/
//
// The Mini App is the M2 practice surface (docs/concept-v2.md, фаза
// M2): the pacer and the PPG screens run in the owner's phone browser;
// HTML/JS is the single §1 AGENTS.md exception. Delivery channel per
// ADR-0002 (variant (а), private tunnel): the page is served by the
// app.mlog /miniapp route from the TRUSTED literal — read_file output
// carries 'public, untrusted' and the №391 sink clearance refuses
// respond(read_file(...)) (probe n203-serve-1), so this module carries
// the serving literal and self-host/miniapp/index.html is the
// byte-pinned canon (the lockstep test below).
//
// The practice sessions live in SQLite (invariant 6): the
// practice_session table is declared additively in the schema block
// below, in the app ensure_schema() DDL path (byte-identical in both
// db-cycle copies) and in the operator mirror migrations/0001_init.sql
// (the Н1-03 rules: CREATE TABLE IF NOT EXISTS only, no down-migration;
// the rollback path is backup restore, deploy/backup.sh).
//
// The §miniapp-core block (token guard + page literal + session
// writers) is byte-mirrored into app.mlog and
// src/telegram/telegram.mlog (the app↔tg prefix discipline); the
// equality is verified by the verifier script recorded in the naryad
// worklog.
//
// The route bodies (app.mlog) consume QUERY PARAMS only: on 0.30.0 the
// request-body parsers (json_body/form_data/request_body) return an
// EMPTY struct (probe n203-json4, declared loudly per §2 — задание
// агенту Metalogos-), so the session API takes its fields through the
// percent-decoded query params (query_param, №257 semantics,
// probe-green) and answers plain text.

entity db_raw: String = env_or("KAMERTON_DB", ":memory:")

entity db_url: String = "sqlite:" + db_raw

db { url: db_url }

schema kamerton {

  table arm {
    id: Int primary_key auto_increment,
    name: String,
    group_name: String,
    day_window: String,
    duration_min: Int default("10"),
    prior_mean: Float default("0.0"),
    prior_std: Float default("1.0"),
    active: Int default("1"),
    created_at: String default(now())
  }

  table note {
    id: Int primary_key auto_increment,
    body: String,
    active: Int default("1"),
    created_at: String default(now())
  }

  table trial {
    id: Int primary_key auto_increment,
    trial_date: String,
    day_window: String,
    arm_id: Int references(arm.id),
    note_id: Int references(note.id),
    status: String default("proposed"),
    prediction_depth: Float default("0.0"),
    prediction_confidence: Float default("0.0"),
    moment_value: Float default("0.0"),
    moment_present: Int default("0"),
    moment_source: String default(""),
    next_day_value: Float default("0.0"),
    next_day_present: Int default("0"),
    action_value: Float default("0.0"),
    action_present: Int default("0"),
    reward: Float default("0.0"),
    free_note: String default(""),
    closed_at: String default(""),
    created_at: String default(now())
  }

  table response {
    id: Int primary_key auto_increment,
    trial_id: Int references(trial.id),
    kind: String,
    depth: Float default("0.0"),
    details: String default(""),
    created_at: String default(now())
  }

  table context {
    id: Int primary_key auto_increment,
    trial_id: Int references(trial.id),
    moon_phase: String default(""),
    weather: String default(""),
    sound_mode: String default(""),
    sleep_quality: Float default("0.0"),
    logged_at: String default(now())
  }

  table candidate {
    id: Int primary_key auto_increment,
    name: String,
    kind: String default("non_periodic"),
    status: String default("candidate"),
    stat_value: Float default("0.0"),
    threshold: Float default("0.0"),
    tested_at: String default(""),
    note: String default("")
  }

  table practice_session {
    id: Int primary_key auto_increment,
    kind: String default("pacer"),
    arm_id: Int references(arm.id),
    trial_id: Int references(trial.id),
    tempo_bpm: Float default("0.0"),
    steps_total: Int default("0"),
    steps_done: Int default("0"),
    step_marks: String default(""),
    rr_json: String default(""),
    rr_source: String default(""),
    session_date: String default(""),
    created_at: String default(now())
  }
}

// ── APP-MIRROR-START: miniapp-core (byte-identical to
//    src/miniapp/miniapp.mlog §miniapp-core) ────────────────────────────

// Mini App core (Н2-03): the token guard, the page literal and the
// practice-session writers. The page is served from the TRUSTED
// literal: read_file output carries 'public, untrusted' and the №391
// sink clearance refuses respond(read_file(...)) (probe n203-serve-1),
// so self-host/miniapp/index.html is the byte-pinned canon and this
// literal is its serving copy; the lockstep test in the miniapp module
// pins the byte equality.

// The token guard — PURE function (the test lane has no env gate): the
// route passes the allowlisted stored value and the SANITIZED provided
// one (the escape_html bridge over query_param — the repo's
// sanitize-then-decide convention; the deploy token charset is
// alphanumeric, so the bridge is exact). Fail-closed: an unconfigured
// token (empty stored value) denies everything.
pattern miniapp_check_token(stored: String, provided: String) -> Bool {
  if stored == "" {
    return false
  }
  return provided == stored
}

// The page literal — byte-pinned to self-host/miniapp/index.html (see
// the miniapp module tests). No external origin anywhere in the markup
// (invariant 7): inline CSS/JS only, same-origin fetches only.
pattern miniapp_html() -> String {
  return "<!doctype html>\n<html lang=\"ru\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Камертон — практики</title>\n<style>\n  :root { --bg:#0f1115; --fg:#e8e6e3; --dim:#9a9a93; --accent:#e8862c; --ok:#4f9d69; --err:#c94f4f; }\n  * { box-sizing: border-box; margin: 0; }\n  body { background: var(--bg); color: var(--fg); font: 16px/1.5 system-ui, sans-serif; max-width: 480px; margin: 0 auto; padding: 16px; }\n  h1 { font-size: 20px; margin-bottom: 12px; }\n  nav { display: flex; gap: 8px; margin-bottom: 16px; }\n  nav button { flex: 1; padding: 10px; background: #1a1d24; color: var(--fg); border: 1px solid #2a2e37; border-radius: 8px; font-size: 15px; }\n  nav button.on { border-color: var(--accent); color: var(--accent); }\n  .screen { display: none; }\n  .screen.on { display: block; }\n  .card { background: #161920; border: 1px solid #2a2e37; border-radius: 12px; padding: 16px; margin-bottom: 12px; }\n  .circle { width: 160px; height: 160px; border-radius: 50%; background: radial-gradient(circle at 35% 35%, #3a4152, #22262f); margin: 24px auto; }\n  .lbl { color: var(--dim); font-size: 13px; }\n  .row { display: flex; gap: 8px; margin-top: 8px; flex-wrap: wrap; }\n  button.act { padding: 10px 14px; border: 0; border-radius: 8px; background: var(--accent); color: #14100b; font-size: 15px; }\n  button.act.sec { background: #2a2e37; color: var(--fg); }\n  #status { font-size: 13px; color: var(--dim); min-height: 20px; margin-top: 8px; white-space: pre-wrap; }\n  .ok { color: var(--ok); } .err { color: var(--err); }\n</style>\n</head>\n<body>\n<h1>Камертон</h1>\n<nav>\n  <button id=\"tab-pacer\" class=\"on\" onclick=\"show('pacer')\">Пейсер</button>\n  <button id=\"tab-ppg\" onclick=\"show('ppg')\">Пульс</button>\n</nav>\n\n<section id=\"screen-pacer\" class=\"screen on\">\n  <div class=\"card\">\n    <div class=\"circle\" id=\"pacer-circle\"></div>\n    <p class=\"lbl\" id=\"pacer-phase\">&nbsp;</p>\n    <p class=\"lbl\">Темп: <b id=\"pacer-tempo\">5.5</b> вдохов/мин (диапазон 4.5–7.0, шаг 0.25)</p>\n    <div class=\"row\">\n      <button class=\"act sec\" onclick=\"tempoDown()\">−</button>\n      <button class=\"act sec\" onclick=\"tempoUp()\">+</button>\n      <button class=\"act\" id=\"pacer-step-btn\" onclick=\"startStep()\">Старт шага (2 мин)</button>\n    </div>\n    <p class=\"lbl\" id=\"pacer-timer\">&nbsp;</p>\n  </div>\n  <div class=\"card\">\n    <p class=\"lbl\">Журнал сессии (таблица practice_session, SQLite)</p>\n    <div class=\"row\">\n      <button class=\"act\" onclick=\"openSession('pacer')\">Начать сессию</button>\n      <button class=\"act sec\" onclick=\"closeSession()\">Завершить</button>\n    </div>\n    <p id=\"pacer-marks\" class=\"lbl\"></p>\n  </div>\n</section>\n\n<section id=\"screen-ppg\" class=\"screen\">\n  <div class=\"card\">\n    <div class=\"circle\"></div>\n    <p class=\"lbl\">Экран PPG — каркас. Съёмка пульса через камеру и RR-ряд входят нарядом Н2-05.</p>\n  </div>\n</section>\n\n<p id=\"status\"></p>\n\n<script>\n\"use strict\";\n// Канал ADR-0002 (вариант «а», приватный туннель): страница отдаётся\n// маршрутом /miniapp программы Камертона; токен владельца передаётся в\n// каждом запросе (параметр t из адреса страницы). Наружу страница не\n// ходит: вся работа против того же origin, внешних ресурсов нет —\n// инвариант 7 (данные не покидают машину владельца).\nvar TOKEN = new URLSearchParams(location.search).get(\"t\") || \"\";\nvar sessionId = 0;\nvar marks = [];\n\nfunction show(name) {\n  var names = [\"pacer\", \"ppg\"];\n  for (var i = 0; i < names.length; i++) {\n    document.getElementById(\"screen-\" + names[i]).className = names[i] === name ? \"screen on\" : \"screen\";\n    document.getElementById(\"tab-\" + names[i]).className = names[i] === name ? \"on\" : \"\";\n  }\n}\n\nfunction status(msg, cls) {\n  var el = document.getElementById(\"status\");\n  el.textContent = msg;\n  el.className = cls || \"\";\n}\n\nfunction api(path, params) {\n  var q = new URLSearchParams(params || {});\n  q.set(\"t\", TOKEN);\n  return fetch(path + \"?\" + q.toString(), {\n    method: \"POST\",\n    headers: { \"X-CSRF-Token\": csrfToken() }\n  })\n    .then(function (r) {\n      return r.text().then(function (body) { return { code: r.status, body: body }; });\n    });\n}\n\n// CSRF-мидлварь сервера (double-submit): GET страницы выдаёт куку\n// _mlog_csrf, каждый POST обязан нести её значение в X-CSRF-Token.\n// TTL токена — 15 минут; истёкший/чужой токен отвечает 403 с «CSRF»\n// в теле — перезагружаем страницу (GET перевыпустит куку). Отметки\n// шагов пишутся инкрементально, поэтому перезагрузка теряет максимум\n// текущий неотмеченный шаг.\nfunction csrfToken() {\n  var m = document.cookie.match(/(?:^|;\\s*)_mlog_csrf=([^;]+)/);\n  return m ? m[1] : \"\";\n}\n\nfunction openSession(kind) {\n  api(\"/miniapp/session\", { kind: kind, tempo_bpm: String(tempo), steps_total: String(STEPS_TOTAL), arm_id: \"0\", trial_id: \"0\" })\n    .then(function (res) {\n      if (res.code === 403 && res.body.indexOf(\"CSRF\") >= 0) { location.reload(); return; }\n      if (res.code !== 200) { status(\"Отказ сервера: \" + res.code + \" \" + res.body, \"err\"); return; }\n      var d = JSON.parse(res.body);\n      sessionId = d.id;\n      marks = [];\n      document.getElementById(\"pacer-marks\").textContent = \"Сессия №\" + sessionId + \", шагов: 0\";\n      status(\"Сессия \" + sessionId + \" открыта: протокол \" + STEPS_TOTAL + \" шагов по 2 минуты\", \"ok\");\n    })\n    .catch(function (e) { status(\"Ошибка сети: \" + e, \"err\"); });\n}\n\n// ── Пейсер (Н2-04) ──────────────────────────────────────────────────────\n// Протокол концепции: перебор темпов 4.5–7.0 вдох/мин с шагом 0.25,\n// по две минуты на темп; отметка завершения шага пишется в сессию\n// инкрементально (писцы Н2-03). Чистая математика фазы вынесена в\n// pacerState — её пиннет скрипт-проверка против эталонной раскадки\n// (self-host/miniapp/test/pacer-test.mjs).\n// PacerEngine-START (маркер скрипт-проверки: источник математики)\nvar TEMPO_MIN = 4.5;\nvar TEMPO_MAX = 7.0;\nvar TEMPO_STEP = 0.25;\nvar STEP_MS = 120000;   // две минуты на темп — протокол концепции\nvar STEPS_TOTAL = 11;   // (7.0 − 4.5) / 0.25 + 1\n\n// Плавная синусоида: равные половины вдоха/выдоха, масштаб 0.10–1.00,\n// старт из середины (0.55) на вдохе. Никакого накопления дрейфа: фаза\n// всегда считается от времени старта шага, а не приращением.\nfunction pacerState(tempoBpm, tMs) {\n  var periodMs = 60000 / tempoBpm;\n  var phase = (tMs % periodMs) / periodMs;\n  var s = Math.sin(2 * Math.PI * phase);\n  return {\n    periodMs: periodMs,\n    phase: phase,\n    dir: phase < 0.5 ? \"вдох\" : \"выдох\",\n    scale: 0.55 + 0.45 * s\n  };\n}\n// PacerEngine-END\n\nvar tempo = 5.5;\nvar stepRunning = false;\nvar stepStart = 0;\nvar stepNo = 0;\nvar rafId = 0;\n\nfunction tempoUp() {\n  tempo = Math.min(TEMPO_MAX, Math.round((tempo + TEMPO_STEP) * 100) / 100);\n  document.getElementById(\"pacer-tempo\").textContent = tempo.toFixed(2);\n}\n\nfunction tempoDown() {\n  tempo = Math.max(TEMPO_MIN, Math.round((tempo - TEMPO_STEP) * 100) / 100);\n  document.getElementById(\"pacer-tempo\").textContent = tempo.toFixed(2);\n}\n\nfunction startStep() {\n  if (stepRunning) { return; }\n  if (!sessionId) { status(\"Сначала начните сессию\", \"err\"); return; }\n  stepRunning = true;\n  stepNo = marks.length + 1;\n  stepStart = performance.now();\n  document.getElementById(\"pacer-step-btn\").disabled = true;\n  paceFrame();\n}\n\nfunction paceFrame() {\n  var t = performance.now() - stepStart;\n  if (t >= STEP_MS) {\n    finishStep();\n    return;\n  }\n  var st = pacerState(tempo, t);\n  document.getElementById(\"pacer-circle\").style.transform = \"scale(\" + st.scale.toFixed(4) + \")\";\n  document.getElementById(\"pacer-phase\").textContent = st.dir;\n  var left = Math.ceil((STEP_MS - t) / 1000);\n  document.getElementById(\"pacer-timer\").textContent = \"Шаг \" + stepNo + \" · осталось \" + left + \" с\";\n  rafId = requestAnimationFrame(paceFrame);\n}\n\nfunction finishStep() {\n  stepRunning = false;\n  cancelAnimationFrame(rafId);\n  document.getElementById(\"pacer-circle\").style.transform = \"scale(0.55)\";\n  document.getElementById(\"pacer-phase\").textContent = \"\\u00a0\";\n  document.getElementById(\"pacer-timer\").textContent = \"\\u00a0\";\n  document.getElementById(\"pacer-step-btn\").disabled = false;\n  var rec = { step: stepNo, tempo_bpm: tempo };\n  api(\"/miniapp/session/close\", {\n    id: String(sessionId),\n    steps_done: String(marks.length + 1),\n    step_marks: JSON.stringify(marks.concat([rec])),\n    rr_json: \"\",\n    rr_source: \"\"\n  })\n    .then(function (res) {\n      if (res.code === 403 && res.body.indexOf(\"CSRF\") >= 0) { location.reload(); return; }\n      if (res.code !== 200) { status(\"Отказ сервера: \" + res.code + \" \" + res.body, \"err\"); return; }\n      marks.push(rec);\n      document.getElementById(\"pacer-marks\").textContent = \"Сессия №\" + sessionId + \", шагов: \" + marks.length + \" · последний темп \" + tempo.toFixed(2);\n      status(\"Шаг \" + stepNo + \" (темп \" + tempo.toFixed(2) + \") записан в журнал — смените темп и повторите\", \"ok\");\n    })\n    .catch(function (e) { status(\"Ошибка сети: \" + e, \"err\"); });\n}\n\nfunction closeSession() {\n  if (!sessionId) { status(\"Сессия не открыта\", \"err\"); return; }\n  api(\"/miniapp/session/close\", {\n    id: String(sessionId),\n    steps_done: String(marks.length),\n    step_marks: JSON.stringify(marks),\n    rr_json: \"\",\n    rr_source: \"\"\n  })\n    .then(function (res) {\n      if (res.code === 403 && res.body.indexOf(\"CSRF\") >= 0) { location.reload(); return; }\n      if (res.code !== 200) { status(\"Отказ сервера: \" + res.code + \" \" + res.body, \"err\"); return; }\n      status(\"Сессия \" + sessionId + \" закрыта: шагов \" + marks.length, \"ok\");\n      sessionId = 0; marks = [];\n      document.getElementById(\"pacer-marks\").textContent = \"\";\n    })\n    .catch(function (e) { status(\"Ошибка сети: \" + e, \"err\"); });\n}\n</script>\n</body>\n</html>\n"
}

// Open a practice session (the Н2-03 skeleton writer; the Н2-04/Н2-05
// screens are its clients). BOUNDARY pattern (the process_updates
// precedent of Н1-06): the route validates shapes loudly (whitelists,
// numeric guards over the escape bridge) and passes the values; inside
// the annotated parameters the data is sanctioned and the writers run.
// arm_id/trial_id below 1 mean "no linkage" and land as SQL NULL (the
// CASE form keeps ONE parameterized statement; 0 is never stored, so
// the FK clauses stay truthful under the enforced-references replay).
// Returns the new row id.
pattern miniapp_session_open(kind: String<public, trusted>, tempo_bpm: Float, steps_total: Float,
                             session_date: String<public, trusted>, arm_id: Float, trial_id: Float) -> Float {
  let _ = db_execute("INSERT INTO practice_session (kind, tempo_bpm, steps_total, session_date, arm_id, trial_id) VALUES (?, ?, ?, ?, CASE WHEN ? > 0 THEN ? END, CASE WHEN ? > 0 THEN ? END)", [kind, tempo_bpm, steps_total, session_date, arm_id, arm_id, trial_id, trial_id])
  let rows = query("SELECT last_insert_rowid() AS id", [])
  return rows[0].id
}

// Close/update a session: the completed-step count, the per-step marks
// and (from Н2-05) the RR series. BOUNDARY pattern: the raw JSON
// strings arrive trusted-by-annotation (the route capped their size
// and the parameterized UPDATE carries them verbatim — SQL-injection
// impossible); the JSON shape is validated by parse_json at every
// READ (garbage never decodes silently). Returns the number of
// updated rows (0 = unknown id — the route answers 404 loudly).
pattern miniapp_session_close(sid: Float, steps_done: Float, step_marks: String<public, trusted>,
                              rr_json: String<public, trusted>, rr_source: String<public, trusted>) -> Float {
  let _ = db_execute("UPDATE practice_session SET steps_done = ?, step_marks = ?, rr_json = ?, rr_source = ? WHERE id = ?", [steps_done, step_marks, rr_json, rr_source, sid])
  let rows = query("SELECT changes() AS n", [])
  return rows[0].n
}

// Read one session back (the module tests + the read path of
// Н2-06/Н2-07; a third-party sqlite3 client reads the same rows —
// invariant 6).
pattern miniapp_session_get(sid: Float) -> List {
  return query("SELECT id, kind, arm_id, trial_id, tempo_bpm, steps_total, steps_done, step_marks, rr_json, rr_source, session_date FROM practice_session WHERE id = ?", [sid])
}
// ── APP-MIRROR-END: miniapp-core ─────────────────────────────────────────


// ── Tests ───────────────────────────────────────────────────────────────
// No loops in test bodies (the house discipline since the D2 family);
// every mutation path is exercised through the same public patterns the
// routes call.

test "the page literal is byte-pinned to self-host/miniapp/index.html" {
  assert_eq(miniapp_html(), read_file("self-host/miniapp/index.html"))
}

test "the page carries the two screen carcasses, the session API and no external origin" {
  let h = miniapp_html()
  assert_contains(h, "screen-pacer")
  assert_contains(h, "screen-ppg")
  assert_contains(h, "/miniapp/session")
  assert_contains(h, "viewport")
  // invariant 7: the page never phones home — no external origin in the
  // markup (inline CSS/JS only, same-origin fetches only)
  // contains() on 0.30.0 returns Bool (the REFERENCE row says Float —
  // the doc drift is declared in the naryad worklog)
  assert_eq(contains(h, "http://"), false)
  assert_eq(contains(h, "https://"), false)
}

test "the token guard fails closed on an unconfigured token" {
  assert_eq(miniapp_check_token("", "anything"), false)
  assert_eq(miniapp_check_token("", ""), false)
}

test "the token guard admits exactly the stored token" {
  assert_eq(miniapp_check_token("s3cret", "s3cret"), true)
  assert_eq(miniapp_check_token("s3cret", "wrong"), false)
  assert_eq(miniapp_check_token("s3cret", ""), false)
}

test "practice session open/close roundtrip reads back through sqlite" {
  // A linkage-free session: arm_id/trial_id land as SQL NULL (the CASE
  // form), and the NULL reads back as Unit on 0.30.0 (the Н2-01 probe
  // behavior — pinned here on the practice_session path too).
  let sid = miniapp_session_open("pacer", 5.5, 6.0, "2026-10-09", 0.0, 0.0)
  let rows = miniapp_session_get(sid)
  assert_eq(rows[0].kind, "pacer")
  assert_eq(rows[0].tempo_bpm, 5.5)
  assert_eq(rows[0].steps_total, 6.0)
  assert_eq(rows[0].session_date, "2026-10-09")
  assert_eq(type_of(rows[0].arm_id), "Unit")
  assert_eq(type_of(rows[0].trial_id), "Unit")
  // A linked session: real FK parents first (the enforced-references
  // replay of №611 refuses dangling linkages loudly).
  let _ = db_execute("INSERT INTO arm (name, group_name, day_window) VALUES ('miniapp-test-arm', 'test', 'morning')", [])
  let aid_rows = query("SELECT last_insert_rowid() AS id", [])
  let aid = aid_rows[0].id
  let _ = db_execute("INSERT INTO trial (trial_date, day_window, arm_id) VALUES ('2026-10-09', 'morning', ?)", [aid])
  let tid_rows = query("SELECT last_insert_rowid() AS id", [])
  let tid = tid_rows[0].id
  let sid2 = miniapp_session_open("ppg", 0.0, 0.0, "2026-10-09", aid, tid)
  let rows2 = miniapp_session_get(sid2)
  assert_eq(rows2[0].arm_id, aid)
  assert_eq(rows2[0].trial_id, tid)
  // Close: the marks land, the rowcount is exactly 1.
  let n = miniapp_session_close(sid, 3.0, "[{\"step\":1},{\"step\":2},{\"step\":3}]", "", "")
  assert_eq(n, 1.0)
  let rows3 = miniapp_session_get(sid)
  assert_eq(rows3[0].steps_done, 3.0)
  assert_contains(rows3[0].step_marks, "\"step\":2")
  // Closing an unknown id updates nothing (the route answers 404 on 0).
  let n0 = miniapp_session_close(999999.0, 0.0, "[]", "", "")
  assert_eq(n0, 0.0)
}

test "the practice_session DDL literal is idempotent (replay twice)" {
  let _ = db_execute("CREATE TABLE IF NOT EXISTS practice_session (id INTEGER PRIMARY KEY AUTOINCREMENT, kind TEXT DEFAULT 'pacer', arm_id INTEGER REFERENCES arm(id), trial_id INTEGER REFERENCES trial(id), tempo_bpm REAL DEFAULT '0.0', steps_total INTEGER DEFAULT '0', steps_done INTEGER DEFAULT '0', step_marks TEXT DEFAULT '', rr_json TEXT DEFAULT '', rr_source TEXT DEFAULT '', session_date TEXT DEFAULT '', created_at TEXT DEFAULT (datetime('now')))", [])
  let _ = db_execute("CREATE TABLE IF NOT EXISTS practice_session (id INTEGER PRIMARY KEY AUTOINCREMENT, kind TEXT DEFAULT 'pacer', arm_id INTEGER REFERENCES arm(id), trial_id INTEGER REFERENCES trial(id), tempo_bpm REAL DEFAULT '0.0', steps_total INTEGER DEFAULT '0', steps_done INTEGER DEFAULT '0', step_marks TEXT DEFAULT '', rr_json TEXT DEFAULT '', rr_source TEXT DEFAULT '', session_date TEXT DEFAULT '', created_at TEXT DEFAULT (datetime('now')))", [])
  let rows = query("SELECT count(*) AS n FROM sqlite_master WHERE type = 'table' AND name = 'practice_session'", [])
  assert_eq(rows[0].n, 1.0)
}
